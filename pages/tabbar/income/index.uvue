<template>
	<cl-page :pt="{ className: 'inc-page' }" :back-top="false">
		<view class="inc-page">
<view class="employee-heading inc-fixed-heading"><text>收益台</text></view>
			<scroll-view class="inc-scroll" scroll-y="true" :show-scrollbar="false" :lower-threshold="120"
				@scrolltolower="onOrderScrollToLower">
				<view class="inc-scroll-inner">

					<view class="inc-summary-card">
<view class="inc-summary-top"><text class="inc-summary-label">个人收益（元）</text><text class="inc-wallet-entry-text" @tap="toWallet">钱包 ›</text></view>
<view class="inc-compact-totals">
<text class="inc-summary-amount">{{ staffSummary.total_revenue || '0.00' }}</text>
<view class="inc-compact-status"><text class="inc-summary-stat-label">待结算</text><text class="inc-summary-stat-value">{{ staffSummary.pending_settlement || '0.00' }}</text></view>
<view class="inc-compact-status"><text class="inc-summary-stat-label">已结算</text><text class="inc-summary-stat-value">{{ staffSummary.settled_revenue || '0.00' }}</text></view>
</view>
<view class="inc-time-stats">
<view class="inc-time-stat"><text class="inc-summary-stat-label">今日收益</text><text class="inc-time-value">{{ todayRevenue }}<text class="inc-unit">元</text></text></view>
<view class="inc-time-stat"><text class="inc-summary-stat-label">近7天收益</text><text class="inc-time-value">{{ weekRevenue }}<text class="inc-unit">元</text></text></view>
</view>
<text v-if="revenueError" class="inc-revenue-error" @tap="retryRevenue">统计暂不可用 · 重试</text>
</view>

<view v-if="showTeamSummary" class="inc-team-card"><view class="inc-team-head"><text>组员统计</text><text>{{ teamMemberCount }} 人</text></view><view class="inc-team-stats"><view><text>组员订单收益</text><text>{{ teamOrderRevenue }}元</text></view><view><text>我的团队分佣</text><text>{{ teamCommissionRevenue }}元</text></view></view></view>

<view class="inc-panel">
						<view class="inc-period-bar">
							<view class="inc-period-row">
								<view v-for="(item, index) in periodTabs" :key="index" class="inc-period-item"
									:class="{ 'inc-period-item--active': activePeriod == index && !isCustomRange }"
									@tap="selectPeriod(index)">
									<text class="inc-period-text">{{ item }}</text>
								</view>
							</view>
							<view class="inc-period-cal" :class="{ 'inc-period-cal--active': isCustomRange }"
								@tap="onCalendarTap">
								<cl-icon name="calendar-line" :size="16"
									:color="isCustomRange ? '#ffffff' : '#666666'"></cl-icon>
							</view>
						</view>

<view v-if="selectedPeriodLabel != ''" class="inc-selected-stat">
<view class="inc-selected-copy"><text class="inc-summary-stat-label">{{ isCustomRange ? '时间段收益' : periodTabs[activePeriod] + '收益' }}</text><text class="inc-selected-date">{{ selectedPeriodLabel }}</text></view>
<text class="inc-time-value">{{ selectedRevenue }}<text class="inc-unit">元</text></text>
</view>
					</view>

					<view class="inc-body">
							<view class="inc-list-tabs"><view :class="{ active: incomeListTab == 'orders' }" @tap="incomeListTab = 'orders'"><text>订单明细</text></view><view :class="{ active: incomeListTab == 'keywords' }" @tap="incomeListTab = 'keywords'"><text>关键词统计</text></view></view>
							<view v-if="incomeListTab == 'keywords'" class="inc-keyword-list"><view v-if="keywordLoading" class="inc-list-state"><cl-loading :loading="true" :size="24" color="#5375ed"></cl-loading></view><view v-else-if="keywordStats.length == 0" class="inc-list-state"><text class="inc-list-state-text">暂无关键词数据</text></view><view v-for="item in keywordStats" :key="item.name" class="inc-keyword-row"><view><text class="inc-keyword-name">{{ item.name }}</text><text class="inc-keyword-count">{{ item.count }} 笔订单</text></view><text class="inc-keyword-amount">{{ item.amount }}元</text></view></view>

							<view v-else-if="listLoading && orderList.length == 0" class="inc-list-state">
							<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
							<text class="inc-list-state-text">加载中...</text>
						</view>
						<view v-else-if="orderList.length == 0" class="inc-list-state">
							<text class="inc-list-state-text">暂无收益数据</text>
						</view>
						<view v-else class="inc-order-list">
							<view class="inc-order-card" v-for="item in orderList" :key="item.id">
								<view class="inc-order-head">
									<text class="inc-order-title">{{ item.project_title }}</text>
									<view v-if="item.payment_status_text && item.is_virtual != 1" class="inc-order-status"
										:class="'inc-order-status--' + resolveStatusTone(`${item.payment_status_text}`)">
										<text class="inc-order-status-text">{{ item.payment_status_text }}</text>
									</view>
								</view>

								<view class="inc-order-divider"></view>

								<view class="inc-order-body">
									<view class="inc-order-field">
										<text class="inc-order-field-label">关键词</text>
										<text class="inc-order-field-value">{{ item.keyword }}</text>
									</view>
									<view class="inc-order-field">
										<text class="inc-order-field-label">订单日期</text>
										<text class="inc-order-field-value">{{ item.import_time }}</text>
									</view>
									<view class="inc-order-field">
										<text class="inc-order-field-label">收益</text>
										<text
											class="inc-order-field-value inc-order-field-value--profit">{{ item.user_profit }}</text>
									</view>
								</view>
								<!-- <view v-if="item.remark && item.remark != '虚拟订单' && item.is_virtual != 1" class="inc-order-remark">
									<text class="inc-order-remark-label">备注</text>
									<text class="inc-order-remark-value">{{ item.remark }}</text>
								</view> -->
							</view>
							<view v-if="orderList.length > 0" class="inc-list-footer" @tap="onOrderLoadMoreTap">
								<cl-loadmore :loading="listLoadingMore" :finish="!hasMore" finish-text="没有更多了"
									loading-text="加载中..."></cl-loadmore>
								<text v-if="orderTotal > 0" class="inc-list-footer-count">
									已加载 {{ orderList.length }} / {{ orderTotal }} 条
								</text>
								<text v-else-if="hasMore && !listLoadingMore"
									class="inc-list-footer-text">上拉或点击加载更多</text>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>

			<custom-tabbar :show-spacer="true"></custom-tabbar>

			<cl-popup v-model="rangePopupVisible" direction="bottom" :show-header="false" :show-close="false"
				:pt="{ className: 'inc-range-popup-wrap', inner: { className: 'inc-range-popup-inner' } }"
				:swipeClose="false">
				<view class="inc-range-popup">
					<view class="inc-range-popup-head">
						<text class="inc-range-popup-cancel" @tap="closeRangePopup">取消</text>
						<text class="inc-range-popup-title">选择时间区间</text>
						<text class="inc-range-popup-apply" @tap="applyRangePopup">应用</text>
					</view>

					<text class="inc-range-popup-section">快捷选择</text>
					<view class="inc-range-popup-quick">
						<view class="inc-range-popup-quick-row">
							<view class="inc-range-popup-quick-item"
								:class="{ 'inc-range-popup-quick-item--active': draftQuickKey == item.key }"
								v-for="(item, index) in quickRangesPrimary" :key="index" @tap="pickQuick(item)">
								<text class="inc-range-popup-quick-text">{{ item.label }}</text>
							</view>
						</view>
						<view class="inc-range-popup-quick-row">
							<view class="inc-range-popup-quick-item"
								:class="{ 'inc-range-popup-quick-item--active': draftQuickKey == item.key }"
								v-for="(item, index) in quickRangesSecondary" :key="index" @tap="pickQuick(item)">
								<text class="inc-range-popup-quick-text">{{ item.label }}</text>
							</view>
						</view>
					</view>

					<text class="inc-range-popup-section">自定义区间</text>
					<view class="inc-range-popup-custom">
						<view class="inc-range-popup-date" @tap="pickDraftStart">
							<text class="inc-range-popup-date-label">开始</text>
							<text class="inc-range-popup-date-value">{{ formatSlash(draftStart) }}</text>
							<cl-icon name="calendar-line" :size="16" color="#999999"></cl-icon>
						</view>
						<text class="inc-range-popup-arrow">→</text>
						<view class="inc-range-popup-date" @tap="pickDraftEnd">
							<text class="inc-range-popup-date-label">结束</text>
							<text class="inc-range-popup-date-value">{{ formatSlash(draftEnd) }}</text>
							<cl-icon name="calendar-line" :size="16" color="#999999"></cl-icon>
						</view>
					</view>

					<view class="inc-range-popup-summary">
						<cl-icon name="check-line" :size="14" color="#1a2744"></cl-icon>
						<text class="inc-range-popup-summary-text">共 {{ rangeDays }} 天</text>
					</view>

					<view class="inc-range-popup-btn" @tap="applyRangePopup">
						<text class="inc-range-popup-btn-text">应用区间</text>
					</view>
				</view>
			</cl-popup>

			<cl-calendar-select ref="draftStartSelectRef" :show-trigger="false" :swipe-close="false" mode="single"
				v-model="draftStart" :end="draftEnd" title="选择开始日期" @change="onDraftStartChange"></cl-calendar-select>
			<cl-calendar-select ref="draftEndSelectRef" :show-trigger="false" :swipe-close="false" mode="single"
				v-model="draftEnd" :start="draftStart" title="选择结束日期" @change="onDraftEndChange"></cl-calendar-select>
		</view>
	</cl-page>
</template>

<script lang="uts">
	export default {
		onShow() {
			uni.setNavigationBarColor({
				frontColor: "#000000",
				backgroundColor: "#f7f8fa"
			});
		}
	};
</script>

<script lang="ts" setup>
	import { computed, nextTick, ref } from "vue";
	import { getStaff } from "@/.cool/api/staff";
	import { getOrderList } from "@/.cool/api/order";
	import { getUserProfile } from "@/.cool/api/login";
	import { dayUts, getApiMessage, isApiSuccess, router } from "@/.cool";
	import type { OrderListItem, OrderListParams, OrderListPayload } from "@/.cool/types/order";
	import type { StaffListData, StaffListItem, StaffStats } from "@/.cool/types/staff";
	import CustomTabbar from "@/components/tabbar.uvue";
	import { syncTabbarRoutePath } from "@/.cool/store/tabbar";

	type QuickRangeKey = "last_7_days" | "last_30_days" | "this_month" | "last_month" | "this_year";
	type QuickRange = { label : string; key : QuickRangeKey };
	type OrderStatusTone = "success" | "pending" | "danger" | "default";
	type CalendarDimension = "day" | "month" | "year";
	type CalendarCell = { key: string; label: string; amount: string; placeholder: boolean; isToday: boolean };

	const staffSummary = ref<StaffStats>({});
	/** profile.can_withdraw：1 才展示进入钱包 */
	const canWithdraw = ref(0);
	const orderList = ref<OrderListItem[]>([]);
	const orderPage = ref(1);
	const orderTotal = ref(0);
	const ORDER_LIMIT = 15;
	const hasMore = ref(true);
	const listLoading = ref(false);
	const listLoadingMore = ref(false);
	const staffSummaryLoading = ref(false);
	const todayRevenue = ref("—");
	const weekRevenue = ref("—");
	const selectedRevenue = ref("—");
	const revenueError = ref(false);
	const incomeListTab = ref("orders");
	type KeywordStat = { name: string; count: number; amount: string };
	const keywordStats = ref<KeywordStat[]>([]);
	const keywordLoading = ref(false);
	let keywordSeq = 0;
	const teamMemberCount = computed(() => `${staffSummary.value.related_member_count ?? staffSummary.value.group_member_count ?? 0}`);
	const teamOrderRevenue = computed(() => formatRevenueAmount(staffSummary.value.team_order_revenue ?? staffSummary.value.group_order_revenue ?? 0));
	const teamCommissionRevenue = computed(() => formatRevenueAmount(staffSummary.value.team_commission_revenue ?? staffSummary.value.group_commission_revenue ?? 0));
	const showTeamSummary = computed(() => Number(teamMemberCount.value) > 0 || Number(teamOrderRevenue.value) > 0 || Number(teamCommissionRevenue.value) > 0);
	let revenueSeq = 0;
	const selectedPeriodLabel = computed(() => {
		if (isCustomRange.value) return `${rangeStart.value.replace(/-/g, ".")} ~ ${rangeEnd.value.replace(/-/g, ".")}`;
		if (activePeriod.value == 4) return "";
		const today = dayUts();
		const offsets = [0, 1, 6, 29];
		const start = today.subtract(offsets[activePeriod.value] ?? 0, "day").format("YYYY.MM.DD");
		const end = activePeriod.value == 1 ? start : today.format("YYYY.MM.DD");
		return `${start} ~ ${end}`;
	});
	function readRevenue(payload: OrderListPayload | null): string {
		const raw = payload?.summary?.staff_revenue;
		if (raw == null || `${raw}`.trim() == "" || !Number.isFinite(Number(raw))) throw new Error("Missing revenue summary");
		return Number(raw).toFixed(2);
	}
	async function loadPeriodRevenue() {
		const seq = ++revenueSeq;
		todayRevenue.value = "—"; weekRevenue.value = "—"; revenueError.value = false;
		const query = buildOrderListParams(1);
		delete query.start_date; delete query.end_date;
		await Promise.all(["today", "last_7_days"].map(async (period) => {
			try {
				const result = await getOrderList({ ...query, limit: 1, period });
				if (seq != revenueSeq) return;
				const amount = readRevenue(parseOrderListPayload(result));
				if (period == "today") todayRevenue.value = amount; else weekRevenue.value = amount;
			} catch (_) { if (seq == revenueSeq) revenueError.value = true; }
		}));
	}
	function retryRevenue() { loadPeriodRevenue(); loadOrderList(); }
	function formatRevenueAmount(value: string | number | null | undefined): string {
		const amount = Number(value ?? 0);
		return Number.isFinite(amount) ? amount.toFixed(2) : "0.00";
	}
	function loadKeywordStats() {
		const seq = ++keywordSeq;
		keywordLoading.value = true;
		keywordStats.value = [];
		getOrderList({ ...buildOrderListParams(1), limit: 500 }).then((res) => {
			if (seq != keywordSeq) return;
			const rows = parseOrderListPayload(res)?.list ?? [];
			const grouped: Record<string, { count: number; amount: number }> = {};
			for (let i = 0; i < rows.length; i++) {
				const name = `${rows[i].keyword ?? "未填写关键词"}`.trim() || "未填写关键词";
				if (grouped[name] == null) grouped[name] = { count: 0, amount: 0 };
				grouped[name].count += 1;
				grouped[name].amount += Number(rows[i].user_profit ?? 0) || 0;
			}
			keywordStats.value = Object.keys(grouped).map((name) => ({ name, count: grouped[name].count, amount: grouped[name].amount.toFixed(2) })).sort((a, b) => b.count - a.count);
		}).catch(() => { if (seq == keywordSeq) keywordStats.value = []; }).finally(() => { if (seq == keywordSeq) keywordLoading.value = false; });
	}

	let orderListSeq = 0;

	const activePeriod = ref<number>(4);
	const isCustomRange = ref<boolean>(false);
	const rangePopupVisible = ref<boolean>(false);
	const draftQuickKey = ref<QuickRangeKey | "">("");
	const draftStartSelectRef = ref<ClCalendarSelectComponentPublicInstance | null>(null);
	const draftEndSelectRef = ref<ClCalendarSelectComponentPublicInstance | null>(null);
	const periodTabs = ["今日", "昨日", "近7天", "近30天", "累计"];
	const calendarDimensions: { key: CalendarDimension; label: string }[] = [
		{ key: "day", label: "日" }, { key: "month", label: "月" }, { key: "year", label: "年度" }
	];
	const calendarWeekdays = ["日", "一", "二", "三", "四", "五", "六"];
	const calendarDimension = ref<CalendarDimension>("day");
	const calendarCursor = ref(new Date());
	const selectedCalendarKey = ref("");

	function padCalendar(value: number): string { return value < 10 ? `0${value}` : `${value}`; }
	function dateKey(date: Date): string { return `${date.getFullYear()}-${padCalendar(date.getMonth() + 1)}-${padCalendar(date.getDate())}`; }
	function monthKey(date: Date): string { return `${date.getFullYear()}-${padCalendar(date.getMonth() + 1)}`; }
	function orderSettlementKey(item: OrderListItem): string {
		const value = `${item.settlement_time ?? item.payment_time ?? item.audit_time ?? ""}`;
		return value.length >= 10 ? value.substring(0, 10) : "";
	}
	function calendarAmount(key: string, dimension: CalendarDimension): string {
		let total = 0;
		for (let i = 0; i < orderList.value.length; i++) {
			const settlementKey = orderSettlementKey(orderList.value[i]);
			const matched = dimension == "day" ? settlementKey == key : settlementKey.indexOf(key) == 0;
			if (matched) total += parseFloat(`${orderList.value[i].user_profit ?? 0}`) || 0;
		}
		return total.toFixed(2);
	}
	function sumCalendarRange(start: Date, end: Date): string {
		let total = 0;
		for (let i = 0; i < orderList.value.length; i++) {
			const key = orderSettlementKey(orderList.value[i]);
			if (key == "") continue;
			const date = new Date(key.replace(/-/g, "/"));
			if (date.getTime() >= start.getTime() && date.getTime() <= end.getTime()) total += parseFloat(`${orderList.value[i].user_profit ?? 0}`) || 0;
		}
		return total.toFixed(2);
	}
	const calendarSummary = computed(() => {
		const today = new Date();
		const day = today.getDay();
		const mondayOffset = day == 0 ? -6 : 1 - day;
		const weekStart = new Date(today.getFullYear(), today.getMonth(), today.getDate() + mondayOffset);
		const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
		const yearStart = new Date(today.getFullYear(), 0, 1);
		const end = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 23, 59, 59);
		return { week: sumCalendarRange(weekStart, end), month: sumCalendarRange(monthStart, end), year: sumCalendarRange(yearStart, end) };
	});

	const calendarPeriodTitle = computed(() => {
		const date = calendarCursor.value;
		if (calendarDimension.value == "year") return `${date.getFullYear() - 5} - ${date.getFullYear() + 6}`;
		if (calendarDimension.value == "month") return `${date.getFullYear()}年`;
		return `${date.getFullYear()}年${date.getMonth() + 1}月`;
	});

	const calendarCells = computed((): CalendarCell[] => {
		const result: CalendarCell[] = [];
		const cursor = calendarCursor.value;
		const todayKey = dateKey(new Date());
		if (calendarDimension.value == "year") {
			for (let offset = -5; offset <= 6; offset++) {
				const year = cursor.getFullYear() + offset;
				result.push({ key: `${year}`, label: `${year}年`, amount: calendarAmount(`${year}`, "year"), placeholder: false, isToday: year == new Date().getFullYear() });
			}
			return result;
		}
		if (calendarDimension.value == "month") {
			for (let month = 0; month < 12; month++) {
				const date = new Date(cursor.getFullYear(), month, 1);
				const key = monthKey(date);
				result.push({ key: key, label: `${month + 1}月`, amount: calendarAmount(key, "month"), placeholder: false, isToday: key == monthKey(new Date()) });
			}
			return result;
		}
		const firstWeekday = new Date(cursor.getFullYear(), cursor.getMonth(), 1).getDay();
		for (let blank = 0; blank < firstWeekday; blank++) result.push({ key: `blank-${blank}`, label: "", amount: "", placeholder: true, isToday: false });
		const days = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0).getDate();
		for (let day = 1; day <= days; day++) {
			const date = new Date(cursor.getFullYear(), cursor.getMonth(), day);
			const key = dateKey(date);
			result.push({ key: key, label: `${day}`, amount: calendarAmount(key, "day"), placeholder: false, isToday: key == todayKey });
		}
		return result;
	});

	function syncCalendarSelection() {
		const date = calendarCursor.value;
		selectedCalendarKey.value = calendarDimension.value == "year" ? `${date.getFullYear()}` : calendarDimension.value == "month" ? monthKey(date) : dateKey(date);
	}
	function selectCalendarDimension(value: CalendarDimension) { calendarDimension.value = value; syncCalendarSelection(); }
	function selectCalendarCell(cell: CalendarCell) { if (!cell.placeholder) selectedCalendarKey.value = cell.key; }
	function moveCalendar(direction: number) {
		const date = new Date(calendarCursor.value.getTime());
		if (calendarDimension.value == "day") date.setMonth(date.getMonth() + direction);
		else if (calendarDimension.value == "month") date.setFullYear(date.getFullYear() + direction);
		else date.setFullYear(date.getFullYear() + direction * 3);
		calendarCursor.value = date;
		syncCalendarSelection();
	}
	syncCalendarSelection();

	function getDefaultCustomRange() : { start : string; end : string } {
		const today = dayUts();
		const todayStr = today.format("YYYY-MM-DD");
		return {
			start: today.subtract(6, "day").format("YYYY-MM-DD"),
			end: todayStr
		};
	}

	const defaultCustomRange = getDefaultCustomRange();
	const rangeStart = ref<string>(defaultCustomRange.start);
	const rangeEnd = ref<string>(defaultCustomRange.end);
	const draftStart = ref<string>(defaultCustomRange.start);
	const draftEnd = ref<string>(defaultCustomRange.end);

	const quickRanges : QuickRange[] = [
		{ label: "近7天", key: "last_7_days" },
		{ label: "近30天", key: "last_30_days" },
		{ label: "本月", key: "this_month" },
		{ label: "上月", key: "last_month" },
		{ label: "本年", key: "this_year" }
	];
	const quickRangesPrimary = quickRanges.slice(0, 3);
	const quickRangesSecondary = quickRanges.slice(3, 5);

	const rangeDays = computed(() => calcDays(draftStart.value, draftEnd.value));

	function calcDays(start : string, end : string) : number {
		const s = new Date(start.replace(/-/g, "/"));
		const e = new Date(end.replace(/-/g, "/"));
		return Math.floor((e.getTime() - s.getTime()) / 86400000) + 1;
	}

	function formatSlash(date : string) : string {
		return date.replace(/-/g, "/");
	}

	function resolveStatusTone(statusText : string) : OrderStatusTone {
		if (statusText == "—" || statusText == "") {
			return "default";
		}
		if (
			statusText.indexOf("已") >= 0 ||
			statusText.indexOf("完成") >= 0 ||
			statusText.indexOf("通过") >= 0
		) {
			return "success";
		}
		if (
			statusText.indexOf("驳") >= 0 ||
			statusText.indexOf("拒") >= 0 ||
			statusText.indexOf("失败") >= 0 ||
			statusText.indexOf("异常") >= 0
		) {
			return "danger";
		}
		if (
			statusText.indexOf("待") >= 0 ||
			statusText.indexOf("中") >= 0 ||
			statusText.indexOf("未") >= 0
		) {
			return "pending";
		}
		return "default";
	}

	function getPeriodKey() : string {
		if (isCustomRange.value) {
			return "custom";
		}
		const keys = ["today", "yesterday", "last_7_days", "last_30_days", "total"];
		const idx = activePeriod.value;
		if (idx >= 0 && idx < keys.length) {
			return keys[idx];
		}
		return "total";
	}

	function buildOrderListParams(page : number) : OrderListParams {
		const params : OrderListParams = {
			page: page,
			limit: ORDER_LIMIT,
			period: getPeriodKey(),
			audit_status: "approved",
			settlement_status: "settled",
			time_field: "settlement_time"
		};
		if (isCustomRange.value) {
			params.start_date = rangeStart.value;
			params.end_date = rangeEnd.value;
		}
		return params;
	}

	function parseOrderListPayload(res : any | null) : OrderListPayload | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const code = envelope["code"];
		if (code != null && !isApiSuccess(code)) {
			return null;
		}
		const raw = envelope["data"] ?? envelope;
		if (raw == null) {
			return null;
		}
		if (raw instanceof Array) {
			return { list: raw as OrderListPayload["list"] };
		}
		return raw as OrderListPayload;
	}

	function updateOrderHasMore(rawListLength : number, count : number, page : number) {
		if (count > 0) {
			orderTotal.value = count;
			hasMore.value = page * ORDER_LIMIT < count;
			return;
		}
		hasMore.value = rawListLength >= ORDER_LIMIT;
	}

	function fetchOrderList(reset : boolean) {
		if (reset) {
			orderListSeq++;
			selectedRevenue.value = "—";
			listLoadingMore.value = false;
			listLoading.value = true;
			orderList.value = [];
			orderPage.value = 1;
			orderTotal.value = 0;
			hasMore.value = true;
		} else {
			if (listLoadingMore.value || !hasMore.value || listLoading.value) {
				return;
			}
			listLoadingMore.value = true;
		}
		const currentSeq = orderListSeq;
		const reqPage = reset ? 1 : orderPage.value + 1;
		getOrderList(buildOrderListParams(reqPage))
			.then((res) => {
				if (currentSeq != orderListSeq) {
					return;
				}
				const payload = parseOrderListPayload(res);
				if (payload == null) {
					if (res != null) {
						const code = (res as UTSJSONObject)["code"];
						if (code != null && !isApiSuccess(code)) {
							uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
						}
					}
					if (reset) {
						orderList.value = [];
					}
					hasMore.value = false;
					return;
				}
				if (reset && selectedPeriodLabel.value != "") {
					try { selectedRevenue.value = readRevenue(payload); } catch (_) { revenueError.value = true; }
				}
				const listRaw = payload.list ?? [];
				if (reset) {
					orderList.value = listRaw as OrderListItem[];
				} else {
					orderList.value = orderList.value.concat(listRaw as OrderListItem[]);
				}
				orderPage.value = reqPage;
				const totalVal = payload.count;
				let count = 0;
				if (totalVal != null && !isNaN(parseInt(`${totalVal}`, 10))) {
					count = parseInt(`${totalVal}`, 10);
				}
				updateOrderHasMore(listRaw.length, count, reqPage);
			})
			.catch((err) => {
				if (currentSeq != orderListSeq) {
					return;
				}
				revenueError.value = true;
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				if (currentSeq != orderListSeq) return;
				if (reset) {
					if (currentSeq != orderListSeq) {
						return;
					}
					listLoading.value = false;
					return;
				}
				listLoadingMore.value = false;
			});
	}

	function loadOrderList() {
		fetchOrderList(true);
		loadKeywordStats();
	}

	function loadMoreOrderList() {
		fetchOrderList(false);
	}

	function onOrderScrollToLower() {
		if (!hasMore.value || listLoadingMore.value || listLoading.value) {
			return;
		}
		loadMoreOrderList();
	}

	function onOrderLoadMoreTap() {
		onOrderScrollToLower();
	}

	function selectPeriod(index : number) {
		isCustomRange.value = false;
		activePeriod.value = index;
		loadOrderList();
	}

	function matchQuickKey(start : string, end : string) : QuickRangeKey | "" {
		for (let i = 0; i < quickRanges.length; i++) {
			const key = quickRanges[i].key;
			const range = resolveQuickRange(key);
			if (range.start == start && range.end == end) {
				return key;
			}
		}
		return "";
	}

	function resolveQuickRange(key : QuickRangeKey) : { start : string; end : string } {
		const today = dayUts();
		const todayStr = today.format("YYYY-MM-DD");
		if (key == "last_7_days") {
			return { start: today.subtract(6, "day").format("YYYY-MM-DD"), end: todayStr };
		}
		if (key == "last_30_days") {
			return { start: today.subtract(29, "day").format("YYYY-MM-DD"), end: todayStr };
		}
		if (key == "this_month") {
			return { start: today.startOf("month").format("YYYY-MM-DD"), end: todayStr };
		}
		if (key == "last_month") {
			const lastMonth = today.subtract(1, "month");
			return {
				start: lastMonth.startOf("month").format("YYYY-MM-DD"),
				end: lastMonth.endOf("month").format("YYYY-MM-DD")
			};
		}
		return { start: today.startOf("year").format("YYYY-MM-DD"), end: todayStr };
	}

	function applyQuickDraft(key : QuickRangeKey) {
		const range = resolveQuickRange(key);
		draftStart.value = range.start;
		draftEnd.value = range.end;
		draftQuickKey.value = key;
		ensureDraftRangeOrder();
	}

	function compareDate(start : string, end : string) : number {
		const s = new Date(start.replace(/-/g, "/"));
		const e = new Date(end.replace(/-/g, "/"));
		return s.getTime() - e.getTime();
	}

	function ensureDraftRangeOrder() {
		if (compareDate(draftStart.value, draftEnd.value) > 0) {
			draftEnd.value = draftStart.value;
		}
	}

	function ensureDraftDates() {
		const todayStr = dayUts().format("YYYY-MM-DD");
		if (draftStart.value.trim() == "") {
			draftStart.value = todayStr;
		}
		if (draftEnd.value.trim() == "") {
			draftEnd.value = todayStr;
		}
		ensureDraftRangeOrder();
	}

	function pickDraftStart() {
		ensureDraftDates();
		nextTick(() => {
			draftStartSelectRef.value?.open(null);
		});
	}

	function pickDraftEnd() {
		ensureDraftDates();
		nextTick(() => {
			draftEndSelectRef.value?.open(null);
		});
	}

	function onDraftStartChange(value : string) {
		draftStart.value = value;
		ensureDraftRangeOrder();
		draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
	}

	function onDraftEndChange(value : string) {
		draftEnd.value = value;
		ensureDraftRangeOrder();
		draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
	}

	function openRangePopup(preserveApplied : boolean = false) {
		if (preserveApplied) {
			draftStart.value = rangeStart.value;
			draftEnd.value = rangeEnd.value;
			draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
		} else {
			applyQuickDraft("last_7_days");
		}
		rangePopupVisible.value = true;
	}

	function closeRangePopup() {
		rangePopupVisible.value = false;
	}

	function applyRangePopup() {
		if (compareDate(draftStart.value, draftEnd.value) > 0) {
			uni.showToast({ title: "开始日期不能晚于结束日期", icon: "none" });
			return;
		}
		isCustomRange.value = true;
		activePeriod.value = -1;
		rangeStart.value = draftStart.value;
		rangeEnd.value = draftEnd.value;
		rangePopupVisible.value = false;
		loadOrderList();
	}

	function pickQuick(item : QuickRange) {
		applyQuickDraft(item.key);
	}

	function onCalendarTap() {
		openRangePopup();
	}

	function toWallet() {
		if (canWithdraw.value != 1) {
			uni.showToast({ title: "当前账号暂未开通钱包", icon: "none" });
			return;
		}
		router.push({ path: "/pages/wallet/index" });
	}

	function loadCanWithdraw() {
		getUserProfile()
			.then((res) => {
				if (res == null) {
					canWithdraw.value = 0;
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					canWithdraw.value = 0;
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				const flag = data["can_withdraw"];
				if (flag == null) {
					canWithdraw.value = 0;
					return;
				}
				const n = parseInt(`${flag}`);
				canWithdraw.value = isNaN(n) ? 0 : n;
			})
			.catch(() => {
				canWithdraw.value = 0;
			});
	}

	function applyStaffSummaryFromItem(item : StaffListItem) {
		staffSummary.value = item.stats ?? {};
	}

	function parseStaffSummaryPayload(res : any | null) : StaffListData | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const code = envelope["code"];
		if (code != null && !isApiSuccess(code)) {
			return null;
		}
		const raw = envelope["data"] ?? envelope;
		if (raw == null) {
			return null;
		}
		if (raw instanceof Array) {
			return { list: raw as StaffListData["list"] };
		}
		return raw as StaffListData;
	}

	function loadStaffSummary() {
		if (staffSummaryLoading.value) {
			return;
		}
		staffSummaryLoading.value = true;
		getStaff()
			.then((res) => {
				const payload = parseStaffSummaryPayload(res);
				if (payload == null) {
					if (res != null) {
						const code = (res as UTSJSONObject)["code"];
						if (code != null && !isApiSuccess(code)) {
							uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
						}
					}
					return;
				}
				const list = payload.list ?? [];
				if (list.length > 0) {
					applyStaffSummaryFromItem(list[0] as StaffListItem);
				}
			})
			.catch(() => { })
			.finally(() => {
				staffSummaryLoading.value = false;
			});
	}

	onShow(() => {
		syncTabbarRoutePath();
		loadCanWithdraw();
		loadStaffSummary();
		loadPeriodRevenue();
		loadOrderList();
	});
</script>

