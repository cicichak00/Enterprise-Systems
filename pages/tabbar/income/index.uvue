		box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
		margin-bottom: 20rpx;
		overflow: hidden;

		.inc-order-head {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 24rpx 24rpx 20rpx;
		}

		.inc-order-title {
			flex: 1;
			min-width: 0;
			font-size: 30rpx;
			font-weight: 600;
			color: #333333;
			line-height: 42rpx;
			word-break: break-all;
			padding-right: 16rpx;
		}

		.inc-order-status {
			flex-shrink: 0;
			padding: 4rpx 12rpx;
			border-radius: 8rpx;
			background-color: #eef3fc;

			&--success {
				background-color: #ecfdf3;

				.inc-order-status-text {
					color: #16a34a;
				}
			}

			&--pending {
				background-color: #fff7ed;

				.inc-order-status-text {
					color: #ea580c;
				}
			}

			&--danger {
				background-color: #fef2f2;

				.inc-order-status-text {
					color: #dc2626;
				}
			}

			&--default {
				background-color: #eef3fc;

				.inc-order-status-text {
					color: #2b59c3;
				}
			}
		}

		.inc-order-status-text {
			font-size: 20rpx;
			font-weight: 600;
			color: #2b59c3;
			line-height: 28rpx;
		}

		.inc-order-divider {
			height: 1rpx;
			background-color: #f0f0f0;
		}

		.inc-order-body {
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			padding: 20rpx 16rpx 24rpx;
		}

		.inc-order-field {
			flex: 1;
			min-width: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-start;
			box-sizing: border-box;
			position: relative;

			&:not(:last-child)::after {
				content: "";
				position: absolute;
				right: 0;
				top: 0;
				bottom: 0;
				width: 1rpx;
				background-color: #eeeeee;
			}
		}

		.inc-order-remark {
			margin: 0 24rpx 20rpx;
			padding: 16rpx 20rpx;
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			background-color: #f7f8fa;
			border-radius: 12rpx;
		}

		.inc-order-remark-label {
			flex-shrink: 0;
			font-size: 22rpx;
			color: #999999;
			line-height: 34rpx;
			margin-right: 12rpx;
		}

		.inc-order-remark-value {
			flex: 1;
			min-width: 0;
			font-size: 24rpx;
			color: #666666;
			line-height: 34rpx;
			word-break: break-all;
		}

		.inc-order-field-label {
			font-size: 22rpx;
			color: #999999;
			line-height: 30rpx;
			text-align: center;
		}

		.inc-order-field-value {
			margin-top: 8rpx;
			font-size: 26rpx;
			font-weight: 600;
			color: #333333;
			line-height: 36rpx;
			word-break: break-all;
			text-align: center;

			&--profit {
				color: #2b59c3;
			}
		}
	}

	.inc-list-footer {
		padding: 16rpx 0 32rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.inc-list-footer-count {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
	}

	.inc-list-footer-text {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
	}

	.inc-range-popup {
		padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
		background-color: #ffffff;
		border-radius: 24rpx 24rpx 0 0;
	}

	.inc-range-popup-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 28rpx;
	}

	.inc-range-popup-cancel,
	.inc-range-popup-apply {
		font-size: 28rpx;
		color: #2b59c3;
		line-height: 40rpx;
	}

	.inc-range-popup-title {
		font-size: 32rpx;
		font-weight: 700;
		color: #333333;
		line-height: 44rpx;
	}

	.inc-range-popup-section {
		display: block;
		margin-bottom: 16rpx;
		font-size: 26rpx;
		font-weight: 600;
		color: #333333;
		line-height: 36rpx;
	}

	.inc-range-popup-quick-row {
		display: flex;
		flex-direction: row;
		margin-bottom: 12rpx;
	}

	.inc-range-popup-quick-item {
		flex: 1;
		margin-right: 12rpx;
		padding: 16rpx 0;
		border-radius: 12rpx;
		background-color: #f3f4f6;
		display: flex;
		align-items: center;
		justify-content: center;

		&:last-child {
			margin-right: 0;
		}

		&--active {
			background-color: #eef3fc;
			border: 1rpx solid #2b59c3;
		}
	}

	.inc-range-popup-quick-text {
		font-size: 24rpx;
		color: #666666;
		line-height: 34rpx;
	}

	.inc-range-popup-quick-item--active .inc-range-popup-quick-text {
		color: #2b59c3;
		font-weight: 600;
	}

	.inc-range-popup-custom {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 20rpx;
	}

	.inc-range-popup-date {
		flex: 1;
		padding: 20rpx;
		border-radius: 16rpx;
		background-color: #f7f8fa;
		display: flex;
		flex-direction: column;
	}

	.inc-range-popup-date-label {
		font-size: 22rpx;
		color: #999999;
		line-height: 30rpx;
	}

	.inc-range-popup-date-value {
		margin: 8rpx 0;
		font-size: 28rpx;
		font-weight: 600;
		color: #333333;
		line-height: 40rpx;
	}

	.inc-range-popup-arrow {
		margin: 0 12rpx;
		font-size: 28rpx;
		color: #999999;
	}

	.inc-range-popup-summary {
		margin-bottom: 24rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.inc-range-popup-summary-text {
		margin-left: 8rpx;
		font-size: 24rpx;
		color: #666666;
		line-height: 34rpx;
	}

	.inc-range-popup-btn {
		height: 88rpx;
		border-radius: 16rpx;
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.inc-range-popup-btn-text {
		font-size: 30rpx;
		font-weight: 600;
		color: #ffffff;
		line-height: 42rpx;
	}
</style><style lang="scss" scoped>
@import "@/styles/employee-workbench.scss";
.inc-page { background: $background; }
.inc-scroll-inner { width: 100%; padding-top: 14px; padding-bottom: calc(80px + env(safe-area-inset-bottom)); max-width: 800px; margin: 0 auto; }
.employee-heading { margin-left: 14px; margin-right: 14px; }
.inc-summary-card { @include feature; margin: 0 14px 12px; padding: 16px; }
.inc-summary-amount { color: $primary; font-size: 32px; line-height: 42px; }
.inc-summary-label, .inc-summary-stat-label { font-size: 12px; color: $muted; }
.inc-summary-stat-value { font-size: 16px; color: $text; }
.inc-panel { @include card; margin: 0 14px 12px; padding: 12px; }
.inc-body { padding: 0 14px; }
.inc-section-title { @include section; }
.inc-order-card { @include card; padding: 14px; margin-bottom: 10px; }
.inc-order-card .inc-order-title { font-size: 14px; color: $text; }
.inc-order-card .inc-order-field-label { font-size: 12px; color: $muted; }
.inc-order-card .inc-order-field-value { font-size: 13px; overflow-wrap: anywhere; }
</style>
<style lang="scss" scoped>
.inc-fixed-heading { flex-shrink: 0; width: 100%; max-width: 800px; box-sizing: border-box; margin: 0 auto; padding: calc(14px + env(safe-area-inset-top)) 14px 10px; background: #f4f5f7; }
.inc-scroll-inner { padding-top: 0; }
.inc-summary-stats { margin-top: 12px; padding-top: 12px; }
.inc-time-stats { display: flex; flex-direction: row; gap: 12px; border-top: 1px solid #dfe4f3; padding-top: 14px; margin-top: 14px; }
.inc-time-stat { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
.inc-time-value { display: block; color: #5375ed; font-size: 21px; line-height: 28px; font-weight: 600; overflow-wrap: anywhere; }
.inc-unit { font-size: 12px; font-weight: 400; margin-left: 4px; }
.inc-selected-stat { margin-top: 14px; padding: 12px; border-radius: 10px; background: #ffffffa8; }
.inc-selected-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 8px; }
.inc-select-action { font-size: 12px; color: #5375ed; }
.inc-select-hint { display: block; margin-top: 8px; font-size: 12px; line-height: 20px; color: #89909e; }
.inc-selected-date { display: block; margin: 8px 0 4px; font-size: 12px; line-height: 20px; color: #71798b; }
.inc-revenue-error { display: block; color: #ad642d; font-size: 12px; line-height: 20px; margin-top: 8px; }
</style>

<style lang="scss" scoped>
.inc-summary-card { padding: 12px 14px; margin-bottom: 10px; }
