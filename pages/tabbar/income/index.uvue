@media(max-width:350px) { .inc-time-stat { gap: 2px; } .inc-time-value { font-size: 15px; } }
.inc-team-card { margin: 0 14px 10px; padding: 12px 14px; border-radius: 12px; background: #fff; }
.inc-team-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 9px; border-bottom: 1px solid #edf0f5; }
.inc-team-head > text:first-child { font-size: 14px; line-height: 21px; font-weight: 600; color: #303649; }
.inc-team-head > text:last-child { font-size: 12px; color: #5375ed; }
.inc-team-stats { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; padding-top: 10px; }
.inc-team-stats > view { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.inc-team-stats > view > text:first-child { font-size: 11px; line-height: 17px; color: #89909e; }
.inc-team-stats > view > text:last-child { font-size: 16px; line-height: 23px; color: #5375ed; font-weight: 600; overflow-wrap: anywhere; }
.inc-list-tabs { display: flex; flex-direction: row; gap: 4px; padding: 3px; margin-bottom: 10px; border-radius: 9px; background: #e9ecf2; }
.inc-list-tabs > view { flex: 1; padding: 6px 0; text-align: center; border-radius: 7px; }
.inc-list-tabs > view > text { font-size: 12px; line-height: 18px; color: #7b8499; }
.inc-list-tabs > view.active { background: #fff; }
.inc-list-tabs > view.active > text { color: #5375ed; font-weight: 600; }
.inc-keyword-list { display: flex; flex-direction: column; gap: 8px; }
.inc-keyword-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: 10px; background: #fff; }
.inc-keyword-row > view { min-width: 0; }
.inc-keyword-name { display: block; font-size: 13px; line-height: 20px; color: #303649; overflow-wrap: anywhere; }
.inc-keyword-count { display: block; margin-top: 2px; font-size: 11px; line-height: 17px; color: #89909e; }
.inc-keyword-amount { flex-shrink: 0; font-size: 15px; line-height: 22px; color: #5375ed; font-weight: 600; }
</style>
