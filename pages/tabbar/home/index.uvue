						<text class="ov-range-popup-date-value">{{ formatSlash(draftStart) }}</text>
						<cl-icon name="calendar-line" :size="16" color="#999999"></cl-icon>
					</view>
					<text class="ov-range-popup-arrow">→</text>
					<view class="ov-range-popup-date" @tap="pickDraftEnd">
						<text class="ov-range-popup-date-label">结束</text>
						<text class="ov-range-popup-date-value">{{ formatSlash(draftEnd) }}</text>
						<cl-icon name="calendar-line" :size="16" color="#999999"></cl-icon>
					</view>
				</view>

				<view class="ov-range-popup-summary">
					<cl-icon name="check-line" :size="14" color="#1a2744"></cl-icon>
