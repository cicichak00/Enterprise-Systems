                <view v-else class="wb-invite-state"><cl-loading v-if="enterpriseInfoLoading" :loading="true" :size="24"></cl-loading><text>{{ enterpriseInfoLoading ? '邀请码加载中' : '邀请码暂不可用' }}</text><text v-if="!enterpriseInfoLoading" class="wb-link" @tap="loadEnterpriseInfo">点击重试</text></view>
