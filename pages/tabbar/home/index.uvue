	}

	.ov-metric-cell--full {
		width: 100%;
		border-right-width: 0;
	}

	.ov-metric-cell--hero {
		padding: min(2.1333vw, 9.60px) min(1.8667vw, 8.40px) min(2.4000vw, 10.80px);
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
	}

	.ov-metric-cell--stack {
		min-height: min(11.7333vw, 52.80px);
		padding: min(1.6000vw, 7.20px) min(1.8667vw, 8.40px);
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
	}

	.ov-metric-cell--hero .ov-metric-money,
	.ov-metric-cell--stack .ov-metric-money,
	.ov-metric-cell--stack > .ov-metric-value {
		margin-top: min(0.5333vw, 2.40px);
	}

