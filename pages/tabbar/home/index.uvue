			title="选择开始日期"
			@change="onDraftStartChange"
		></cl-calendar-select>
		<cl-calendar-select
			ref="draftEndSelectRef"
			:show-trigger="false"
			:swipe-close="false"
			mode="single"
			v-model="draftEnd"
			:start="draftStart"
			title="选择结束日期"
			@change="onDraftEndChange"
