<script lang="uts">
	export default {
		onShow() {
			uni.setNavigationBarColor({
				frontColor: "#000000",
				backgroundColor: "#ffffff"
			});
		}
	};
</script>

<script lang="ts" setup>
	import { computed, nextTick, onMounted, ref } from "vue";
	import { getAppSystem } from "@/.cool/api/app";
	import { getMessageList } from "@/.cool/api/message";
	import { resolveInviteQrContent } from "@/.cool/utils/invite-qrcode";
	import { getEnterpriseInfo } from "@/.cool/api/enterprise";
	import { fetchMessageUnreadCount, formatMessageUnreadBadgeText } from "@/.cool/utils/message";
	import { getOrderList } from "@/.cool/api/order";
	import type { OrderListItem } from "@/.cool/types/order";
	import {
		getAllowedEntryPath,
		parseAppSystemRouteState,
		shouldBlockHomeOverview
	} from "@/.cool/navigation/appSystemNavigation";
	import { dayUts, isApiSuccess, getApiMessage, router, useStore } from "@/.cool";
	import type { EnterpriseInfo, Response } from "@/.cool";
	import CustomTabbar from "@/components/tabbar.uvue";
	import { applyAppSystemResponse, pushToMenuPath, syncTabbarRoutePath } from "@/.cool/store/tabbar";

	const { user } = useStore();

    const enterpriseLogo = ref("");
    const inviteContent = ref("");
    const inviteVisible = ref(false);
    const activityTitle = ref("暂无消息");
    const monthCount = ref("—");
    const monthPromoRevenue = ref("—");
    const monthRevenue = ref("—");
    const monthStaffRevenue = ref("—");
    const monthError = ref("");
    const monthLoading = ref(false);
        const workbenchLoading = computed(() => listLoading.value || monthLoading.value || overviewLoading.value);
    function editProfile() { router.push({ path: "/pages/user/settings" }); }
    function copyWorkbenchInvite() {
        if (!inviteContent.value) return;
        uni.setClipboardData({ data: inviteContent.value, fail: () => uni.showToast({ title: "复制失败，请重试", icon: "none" }) });
    }
    function openWorkbenchInvite() { inviteVisible.value = true; if (!inviteContent.value) loadEnterpriseInfo(); }
    const overviewError = ref("");
    const overviewLoading = ref(false);
    const periodTotalRevenue = computed((): string => monthRevenue.value);
    const enterpriseRevenueShare = computed((): string => {
        const total = parseFloat(periodTotalRevenue.value);
        const enterprise = parseFloat(monthPromoRevenue.value);
        if (isNaN(total) || total <= 0 || isNaN(enterprise)) return "50%";
        return `${Math.round(enterprise / total * 100)}%`;
    });
    const staffRevenueShare = computed((): string => {
        const total = parseFloat(periodTotalRevenue.value);
        const staff = parseFloat(monthStaffRevenue.value);
        if (isNaN(total) || total <= 0 || isNaN(staff)) return "50%";
        return `${Math.round(staff / total * 100)}%`;
    });
    function resetOrderFilters() { staffFilterIndex.value = 0; employeeFilterIndex.value = 0; orderSortIndex.value = 0; }
    function showThisMonth() {
        selectPeriod(2);
    }
    async function loadWorkbenchExtras() {
        if (monthLoading.value) return;
        monthLoading.value = true;
        await Promise.all([
            getMessageList({ page: 1, limit: 1 }).then((res: any) => {
                if (res?.code != null && !isApiSuccess(res.code)) throw new Error("消息加载失败");
                const row = (res?.data ?? res)?.list?.[0];
                activityTitle.value = row ? (row.title || row.content || "你有一条最新消息").replace(/<[^>]*>/g, "") : "暂无消息";
            }).catch(() => { activityTitle.value = "消息加载失败，点击进入消息中心"; })
        ]);
        monthLoading.value = false;
    }
    function refreshWorkbench() {
        if (workbenchLoading.value) return;
        loadOrderList(); loadWorkbenchExtras(); loadMessageUnreadCount(); loadEnterpriseInfo();
    }

	const DEFAULT_ENTERPRISE_NAME = "企业号";
	const DEFAULT_ENTERPRISE_INTRO = "";
	const enterpriseName = ref(DEFAULT_ENTERPRISE_NAME);
	const enterpriseIntro = ref(DEFAULT_ENTERPRISE_INTRO);
	const enterpriseInfoLoading = ref(false);
	const messageUnreadCount = ref(0);
	const messageUnreadLoading = ref(false);
	const messageUnreadBadgeText = computed((): string => {
		return formatMessageUnreadBadgeText(messageUnreadCount.value);
	});

	type QuickRangeKey = "last_7_days" | "last_30_days" | "this_month" | "last_month" | "this_year";
	type QuickRange = { label: string; key: QuickRangeKey };

	const activePeriod = ref<number>(2);
	const detailStatsExpanded = ref<boolean>(false);
	const isCustomRange = ref<boolean>(false);
	const rangePopupVisible = ref<boolean>(false);
	const draftQuickKey = ref<QuickRangeKey | "">("");
	const draftStartSelectRef = ref<ClCalendarSelectComponentPublicInstance | null>(null);
	const draftEndSelectRef = ref<ClCalendarSelectComponentPublicInstance | null>(null);
	const periodTabs = ["今天", "7天", "本月", "累计"];
	const listLoading = ref(false);
	const currentPeriodLabel = computed((): string => {
		if (isCustomRange.value) {
			return `${rangeStart.value} 至 ${rangeEnd.value}`;
		}
		const idx = activePeriod.value;
		if (idx >= 0 && idx < periodTabs.length) {
			return periodTabs[idx];
		}
		return "近7天";
	});

	function getDefaultCustomRange(): { start: string; end: string } {
		const today = dayUts();
		const todayStr = today.format("YYYY-MM-DD");
		return {
			start: today.subtract(6, "day").format("YYYY-MM-DD"),
			end: todayStr
		};
	}

	const defaultCustomRange = getDefaultCustomRange();
	const rangeStart = ref<string>(defaultCustomRange.start);
	const rangeEnd = ref<string>(defaultCustomRange.end);
	const draftStart = ref<string>(defaultCustomRange.start);
	const draftEnd = ref<string>(defaultCustomRange.end);
	const capsuleLayoutKey = ref(0);

	const quickRanges: QuickRange[] = [
		{ label: "近7天", key: "last_7_days" },
		{ label: "近30天", key: "last_30_days" },
		{ label: "本月", key: "this_month" },
		{ label: "上月", key: "last_month" },
		{ label: "本年", key: "this_year" }
	];

	const quickRangesPrimary = quickRanges.slice(0, 3);
	const quickRangesSecondary = quickRanges.slice(3, 5);

	function matchQuickKey(start: string, end: string): QuickRangeKey | "" {
		for (let i = 0; i < quickRanges.length; i++) {
			const key = quickRanges[i].key;
			const range = resolveQuickRange(key);
			if (range.start == start && range.end == end) {
				return key;
			}
		}
		return "";
	}

	function applyQuickDraft(key: QuickRangeKey) {
		const range = resolveQuickRange(key);
		draftStart.value = range.start;
		draftEnd.value = range.end;
		draftQuickKey.value = key;
		ensureDraftRangeOrder();
	}

	function resolveQuickRange(key: QuickRangeKey): { start: string; end: string } {
		const today = dayUts();
		const todayStr = today.format("YYYY-MM-DD");
		if (key == "last_7_days") {
			return {
				start: today.subtract(6, "day").format("YYYY-MM-DD"),
				end: todayStr
			};
		}
		if (key == "last_30_days") {
			return {
				start: today.subtract(29, "day").format("YYYY-MM-DD"),
				end: todayStr
			};
		}
		if (key == "this_month") {
			return {
				start: today.startOf("month").format("YYYY-MM-DD"),
				end: todayStr
			};
		}
		if (key == "last_month") {
			const lastMonth = today.subtract(1, "month");
			return {
				start: lastMonth.startOf("month").format("YYYY-MM-DD"),
				end: lastMonth.endOf("month").format("YYYY-MM-DD")
			};
		}
		return {
			start: today.startOf("year").format("YYYY-MM-DD"),
			end: todayStr
		};
	}

	const rangeDays = computed(() => calcDays(draftStart.value, draftEnd.value));

	function calcDays(start: string, end: string): number {
		const s = new Date(start.replace(/-/g, "/"));
		const e = new Date(end.replace(/-/g, "/"));
		const diff = e.getTime() - s.getTime();
		return Math.floor(diff / 86400000) + 1;
	}

	function formatSlash(date: string): string {
		return date.replace(/-/g, "/");
	}

	function fieldText(raw: any | null): string {
		if (raw == null) {
			return "";
		}
		const text = `${raw}`.trim();
		if (text == "" || text == "undefined" || text == "null") {
			return "";
		}
		return text;
	}
	function formatMoney(raw: any | null): string {
		const text = fieldText(raw);
		if (text == "") {
			return "0.00";
		}
		if (text.indexOf("¥") >= 0) {
			return text.replace("¥", "").trim();
		}
		const n = parseFloat(text);
		if (isNaN(n)) {
			return text;
		}
		return n.toFixed(2);
	}
	function formatCount(raw: any | null): string {
		const text = fieldText(raw);
		if (text == "") {
			return "0";
		}
		const n = parseInt(text);
		if (isNaN(n)) {
			return text;
		}
		return `${n}`;
	}
	function formatStaffRatio(summary: UTSJSONObject | null): string {
		if (summary == null) {
			return "0/0";
		}
		const staffCountText = fieldText(summary["staff_count"]);
		if (staffCountText.indexOf("/") >= 0) {
			return staffCountText;
		}
		const total = formatCount(
			summary["total_staff_count"] ??
				summary["staff_total_count"] ??
				summary["staff_count"]
		);
		const activeRaw =
			summary["active_staff_count"] ??
			summary["on_job_staff_count"] ??
			summary["employed_staff_count"] ??
			summary["staff_active_count"];
		const active = fieldText(activeRaw) == "" ? total : formatCount(activeRaw);
		return `${active}/${total}`;
	}
	function resolveOrderAvatar(item: OrderListItem): string {
		const name = `${item.user_nickname ?? ""}`.trim();
		return name != "" ? name.charAt(0) : "员";
	}
	function getPeriodKey(): string {
		if (isCustomRange.value) {
			return "custom";
		}
		const keys = ["today", "last_7_days", "custom", "total"];
		const idx = activePeriod.value;
		if (idx >= 0 && idx < keys.length) {
			return keys[idx];
		}
		return "total";
	}

	type RoleStatRow = {
		key: string;
		label: string;
		memberCount: string;
		staffRevenue: string;
		keywordCount: string;
		backfillCount: string;
	};

	type RoleStatConfig = {
		key: string;
		label: string;
		countKeys: string[];
		revenueKeys: string[];
		keywordKeys: string[];
		backfillKeys: string[];
	};

	const ROLE_STAT_CONFIGS: RoleStatConfig[] = [
		{
			key: "normal",
			label: "普通员工",
			countKeys: ["normal_staff_count", "normal_count", "employee_count"],
			revenueKeys: ["normal_staff_revenue", "normal_revenue", "employee_revenue"],
			keywordKeys: ["normal_keyword_count", "normal_task_count", "employee_keyword_count"],
			backfillKeys: ["normal_backfill_count", "employee_backfill_count"]
		},
		{
			key: "leader",
			label: "员工组长",
			countKeys: ["leader_count", "group_leader_count", "team_leader_count"],
			revenueKeys: ["leader_staff_revenue", "leader_revenue", "group_leader_revenue"],
			keywordKeys: ["leader_keyword_count", "leader_task_count", "group_leader_keyword_count"],
			backfillKeys: ["leader_backfill_count", "group_leader_backfill_count"]
		},
		{
			key: "member",
			label: "员工组员",
			countKeys: ["member_count", "group_member_count", "team_member_count"],
			revenueKeys: ["member_staff_revenue", "member_revenue", "group_member_revenue"],
			keywordKeys: ["member_keyword_count", "member_task_count", "group_member_keyword_count"],
			backfillKeys: ["member_backfill_count", "group_member_backfill_count"]
		}
	];

	function pickFirstValue(source: UTSJSONObject | null, keys: string[]): any | null {
		if (source == null) {
			return null;
		}
		for (let i = 0; i < keys.length; i++) {
			const value = source[keys[i]];
			if (fieldText(value) != "") {
				return value;
			}
		}
		return null;
	}

	function normalizeRoleKey(raw: any | null): string {
		const text = fieldText(raw).toLowerCase();
		if (
			text == "1" ||
			text.indexOf("leader") >= 0 ||
			text.indexOf("组长") >= 0
		) {
			return "leader";
		}
		if (
			text == "2" ||
			text.indexOf("member") >= 0 ||
			text.indexOf("组员") >= 0
		) {
			return "member";
		}
		if (
			text == "0" ||
			text.indexOf("normal") >= 0 ||
			text.indexOf("ordinary") >= 0 ||
			text.indexOf("普通") >= 0
		) {
			return "normal";
		}
		return "";
	}

	function findRoleStatSource(summary: UTSJSONObject, roleKey: string): UTSJSONObject | null {
		const raw =
			summary["role_stats"] ??
			summary["staff_role_stats"] ??
			summary["detail_stats"] ??
			summary["staff_stats"];
		if (raw == null || !Array.isArray(raw)) {
			return null;
		}
		const rows = raw as UTSJSONObject[];
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i];
			const key = normalizeRoleKey(
				row["role_key"] ??
					row["role"] ??
					row["role_name"] ??
					row["staff_type"] ??
					row["staff_type_text"]
			);
			if (key == roleKey) {
				return row;
			}
		}
		return null;
	}

	function buildRoleStats(summary: UTSJSONObject | null): RoleStatRow[] {
		const result: RoleStatRow[] = [];
		for (let i = 0; i < ROLE_STAT_CONFIGS.length; i++) {
			const config = ROLE_STAT_CONFIGS[i];
			const nested = summary != null ? findRoleStatSource(summary, config.key) : null;
			const countRaw =
				pickFirstValue(nested, ["member_count", "staff_count", "count"]) ??
				pickFirstValue(summary, config.countKeys);
			const revenueRaw =
				pickFirstValue(nested, ["staff_revenue", "revenue", "amount"]) ??
				pickFirstValue(summary, config.revenueKeys);
			const keywordRaw =
				pickFirstValue(nested, ["keyword_count", "task_count", "promo_count"]) ??
				pickFirstValue(summary, config.keywordKeys);
			const backfillRaw =
				pickFirstValue(nested, ["backfill_count", "fill_count"]) ??
				pickFirstValue(summary, config.backfillKeys);
			result.push({
				key: config.key,
				label: config.label,
				memberCount: formatCount(countRaw),
				staffRevenue: formatMoney(revenueRaw),
				keywordCount: formatCount(keywordRaw),
				backfillCount: formatCount(backfillRaw)
			});
		}
		return result;
	}

	function applySummary(summary: UTSJSONObject | null) {
		if (summary == null) {
			headlineMetrics.value = [
				{ label: "推广总收益（元）", value: "0.00" },
				{ label: "企业总收益（元）", value: "0.00" }
			];
			topMetrics.value = [
				{ label: "总员工", value: "0/0", resourceTab: "employee" },
				{ label: "推广任务总量", value: "0", resourceTab: "" },
				{ label: "回填总量", value: "0", resourceTab: "" },
				{ label: "员工总收益", value: "0.00", resourceTab: "" }
			];
			roleStats.value = buildRoleStats(null);
			return;
		}
		headlineMetrics.value = [
			{ label: "推广总收益（元）", value: formatMoney(summary["promo_revenue"]) },
			{ label: "企业总收益（元）", value: formatMoney(summary["enterprise_revenue"]) }
		];
		topMetrics.value = [
			{ label: "总员工", value: formatStaffRatio(summary), resourceTab: "employee" },
			{ label: "推广任务总量", value: formatCount(summary["keyword_count"]), resourceTab: "" },
			{ label: "回填总量", value: formatCount(summary["backfill_count"]), resourceTab: "" },
			{ label: "员工总收益", value: formatMoney(summary["staff_revenue"]), resourceTab: "" }
		];
		roleStats.value = buildRoleStats(summary);
	}
    let orderRequestVersion = 0;
    const orderError = ref("");
    function fetchOrderList(reset: boolean) {
        if (!reset && (listLoadingMore.value || !hasMore.value || listLoading.value)) return;
        const version = ++orderRequestVersion;
        if (reset) {
            listLoading.value = true; listLoadingMore.value = false;
            orderList.value = []; employeeFilterIndex.value = 0; orderPage.value = 1;
            hasMore.value = true;
        } else { listLoadingMore.value = true; }
        orderError.value = "";
        const reqPage = reset ? 1 : orderPage.value;
        const useRange = isCustomRange.value || activePeriod.value == 2;
        getOrderList({ page: reqPage, limit: ORDER_LIMIT, period: getPeriodKey(),
            start_date: useRange ? rangeStart.value : "",
            end_date: useRange ? rangeEnd.value : ""
        }).then((res: any) => {
            if (version != orderRequestVersion) return;
            if (!res || (res.code != null && !isApiSuccess(res.code))) throw new Error(getApiMessage(res, "订单加载失败"));
            const data = res.data ?? res;
            const rows: OrderListItem[] = Array.isArray(data.list) ? data.list : [];
            orderList.value = reset ? rows : orderList.value.concat(rows);
            const total = data.count ?? data.total;
            if (reset) {
                const summary = data.summary ?? null;
                applySummary(summary);
                overviewError.value = "";
                monthCount.value = total != null ? formatCount(total) : formatCount(summary?.order_count);
                monthPromoRevenue.value = formatMoney(summary?.promo_revenue);
                monthRevenue.value = formatMoney(summary?.enterprise_revenue);
                monthStaffRevenue.value = formatMoney(summary?.staff_revenue);
                monthError.value = "";
            }
            hasMore.value = rows.length > 0 && (total != null ? orderList.value.length < Number(total) : rows.length >= ORDER_LIMIT);
            orderPage.value = reqPage + 1;
        }).catch((err) => {
            if (version == orderRequestVersion) {
                orderError.value = getApiMessage(err, "订单加载失败");
                monthError.value = "当前时段数据加载失败，请点击刷新重试";
                overviewError.value = "当前时段数据加载失败";
            }
        }).finally(() => {
            if (version != orderRequestVersion) return;
            listLoading.value = false; listLoadingMore.value = false;
        });
    }
	function loadOrderList() {
		fetchOrderList(true);
	}
	function loadMoreOrderList() {
		fetchOrderList(false);
	}
	function selectPeriod(index: number) {
		isCustomRange.value = false;
		activePeriod.value = index;
		if (index == 2) {
			const range = resolveQuickRange("this_month");
			rangeStart.value = range.start;
			rangeEnd.value = range.end;
		}
		loadOrderList();
	}

	function onCalendarTap() {
		openRangePopup(isCustomRange.value);
	}

	function compareDate(start: string, end: string): number {
		const s = new Date(start.replace(/-/g, "/"));
		const e = new Date(end.replace(/-/g, "/"));
		return s.getTime() - e.getTime();
	}

	function ensureDraftRangeOrder() {
		if (compareDate(draftStart.value, draftEnd.value) > 0) {
			draftEnd.value = draftStart.value;
		}
	}

	function ensureDraftDates() {
		const todayStr = dayUts().format("YYYY-MM-DD");
		if (draftStart.value.trim() == "") {
			draftStart.value = todayStr;
		}
		if (draftEnd.value.trim() == "") {
			draftEnd.value = todayStr;
		}
		ensureDraftRangeOrder();
	}

	function pickDraftStart() {
		ensureDraftDates();
		nextTick(() => {
			draftStartSelectRef.value?.open(null);
		});
	}

	function pickDraftEnd() {
		ensureDraftDates();
		nextTick(() => {
			draftEndSelectRef.value?.open(null);
		});
	}

	function onDraftStartChange(value: string) {
		draftStart.value = value;
		ensureDraftRangeOrder();
		draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
	}

	function onDraftEndChange(value: string) {
		draftEnd.value = value;
		ensureDraftRangeOrder();
		draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
	}

	function openRangePopup(preserveApplied: boolean = false) {
		if (preserveApplied) {
			draftStart.value = rangeStart.value;
			draftEnd.value = rangeEnd.value;
			draftQuickKey.value = matchQuickKey(draftStart.value, draftEnd.value);
		} else {
			applyQuickDraft("last_7_days");
		}
		rangePopupVisible.value = true;
	}

	function closeRangePopup() {
		rangePopupVisible.value = false;
	}

	function applyRangePopup() {
		if (compareDate(draftStart.value, draftEnd.value) > 0) {
			uni.showToast({ title: "开始日期不能晚于结束日期", icon: "none" });
			return;
		}
		isCustomRange.value = true;
		activePeriod.value = -1;
		rangeStart.value = draftStart.value;
		rangeEnd.value = draftEnd.value;
		rangePopupVisible.value = false;
		loadOrderList();
	}

	function pickQuick(item: QuickRange) {
		applyQuickDraft(item.key);
	}

	function toNotice() {
		router.push({ path: "/pages/notice/index" });
	}

	function toBusinessTab(resourceTab: string) {
		uni.setStorageSync("businessResourceTab", resourceTab);
		uni.switchTab({
			url: "/pages/tabbar/business/index"
		});
	}

	function toBusiness() {
		toBusinessTab("employee");
	}

	function toIncomeCalendar() {
		router.push({ path: "/pages/revenue/calendar" });
	}


	function onMetricTap(item: TopMetric) {
		if (item.resourceTab == "employee") {
			toBusinessTab("employee");
			return;
		}
		if (item.resourceTab == "account") {
			toBusinessTab("employee");
		}
	}

	type TopMetric = {
		label: string;
		value: string;
		resourceTab: string;
	};

	type HeadlineMetric = {
		label: string;
		value: string;
	};

	const headlineMetrics = ref<HeadlineMetric[]>([
		{ label: "推广总收益（元）", value: "0.00" },
		{ label: "企业总收益（元）", value: "0.00" }
	]);
	const topMetrics = ref<TopMetric[]>([
		{ label: "总员工", value: "0/0", resourceTab: "employee" },
		{ label: "推广任务总量", value: "0", resourceTab: "" },
		{ label: "回填总量", value: "0", resourceTab: "" },
		{ label: "员工总收益", value: "0.00", resourceTab: "" }
	]);
	const roleStats = ref<RoleStatRow[]>(buildRoleStats(null));
	const orderList = ref<OrderListItem[]>([]);
	const orderPage = ref(1);
	const ORDER_LIMIT = 10;
	const hasMore = ref(true);
	const listLoadingMore = ref(false);

	const orderSortOptions = ["订单排序", "由近到远", "由远到近", "收益从高到低", "收益从低到高"];
	const staffFilterOptions = ["员工类型", "普通员工", "员工组长", "员工组员"];
	const orderSortIndex = ref(0);
	const staffFilterIndex = ref(0);
	const employeeFilterIndex = ref(0);
	const employeeFilterEntries = computed((): { label: string; key: string }[] => {
		const entries: { label: string; key: string }[] = [{ label: "全部员工", key: "" }];
		const keys: string[] = [];
		for (let i = 0; i < orderList.value.length; i++) {
			const item = orderList.value[i];
			const key = resolveOrderEmployeeKey(item);
			if (key == "" || keys.indexOf(key) >= 0) continue;
			keys.push(key);
			const name = fieldText(item.user_nickname);
			entries.push({ label: name != "" ? name : `员工${key}`, key });
		}
		return entries;
	});
	const employeeFilterOptions = computed((): string[] => {
		return employeeFilterEntries.value.map((item) => item.label);
	});
	const activeRoleKey = computed((): string => {
		if (staffFilterIndex.value == 1) return "normal";
		if (staffFilterIndex.value == 2) return "leader";
		if (staffFilterIndex.value == 3) return "member";
		return "";
	});
	const orderListMeta = computed((): string => {
		const label = employeeFilterOptions.value[employeeFilterIndex.value] ?? "全部员工";
		return `${label} · ${displayOrderList.value.length} 条`;
	});

	function resolvePickerIndex(event: UniPickerChangeEvent): number {
		const value = event.detail.value;
		const parsed = parseInt(`${value}`);
		return isNaN(parsed) ? 0 : parsed;
	}

	function onOrderSortChange(event: UniPickerChangeEvent) {
		orderSortIndex.value = resolvePickerIndex(event);
	}

	function onStaffFilterChange(event: UniPickerChangeEvent) {
		staffFilterIndex.value = resolvePickerIndex(event);
	}

	function onEmployeeFilterChange(event: UniPickerChangeEvent) {
		employeeFilterIndex.value = resolvePickerIndex(event);
	}

	function onRoleStatTap(roleKey: string) {
		const target = roleKey == "normal" ? 1 : roleKey == "leader" ? 2 : roleKey == "member" ? 3 : 0;
		staffFilterIndex.value = staffFilterIndex.value == target ? 0 : target;
	}

	function toggleDetailStats() {
		detailStatsExpanded.value = !detailStatsExpanded.value;
	}

	function resolveStaffRoleKey(item: OrderListItem): string {
		return normalizeRoleKey(
			item.staff_role ??
				item.staff_role_text ??
				item.staff_type ??
				item.staff_type_text ??
				item["role"] ??
				item["role_name"]
		);
	}

	function resolveStaffRoleLabel(item: OrderListItem): string {
		const key = resolveStaffRoleKey(item);
		if (key == "leader") {
			return "员工组长";
		}
		if (key == "member") {
			return "员工组员";
		}
		if (key == "normal") {
			return "普通员工";
		}
		return fieldText(item.staff_role_text ?? item.staff_type_text ?? item["role_name"]);
	}

	function resolveEmploymentStatus(item: OrderListItem): string {
		const direct = fieldText(
			item.employment_status_text ??
				item.user_status_text ??
				item["staff_status_text"] ??
				item["status_text"]
		);
		if (direct != "") {
			return direct;
		}
		const snapshot = item.employment_status_snapshot ?? item.employment_status;
		if (`${snapshot}` == "1") {
			return "在职";
		}
		if (`${snapshot}` == "0") {
			return "离职";
		}
		const active = item["is_active"] ?? item["is_employed"];
		if (`${active}` == "1" || `${active}` == "true") {
			return "在职";
		}
		return "";
	}

	function resolveOrderTime(item: OrderListItem): number {
		const raw = fieldText(item.audit_time ?? item.payment_time ?? item.import_time);
		if (raw == "") {
			return 0;
		}
		const time = new Date(raw.replace(/-/g, "/")).getTime();
		return isNaN(time) ? 0 : time;
	}

	function resolveOrderEmployeeKey(item: OrderListItem): string {
		return fieldText(item.user_id ?? item.user_sn ?? item.user_nickname);
	}

	function resolveSettlementStatus(item: OrderListItem): string {
		const direct = fieldText(item["settlement_status_text"] ?? item.payment_status_text);
		if (direct != "") return direct;
		const raw = item["settlement_status"] ?? item["payment_status"] ?? item.status;
		return `${raw}` == "1" ? "已结算" : "未结算";
	}

	function resolveOrderRevenue(item: OrderListItem): number {
		const raw =
			item.is_virtual == 1
				? fieldText(item.user_profit)
				: fieldText(item.enterprise_profit ?? item.user_profit);
		const value = parseFloat(raw.replace("¥", ""));
		return isNaN(value) ? 0 : value;
	}

	function escapeCsvCell(value: any | null): string {
		const raw = fieldText(value);
        const text = (/^[=+@\-\t\r]/.test(raw) ? "'" + raw : raw).replace(/"/g, '""');
		return `"${text}"`;
	}

	function buildRevenueCsv(rows: OrderListItem[]): string {
		const header = [
			"序号",
			"员工昵称",
			"员工ID",
			"员工类型",
			"在职状态",
			"项目",
			"关键词",
			"推广收益",
			"员工收益",
			"企业收益",
			"分佣比例",
			"结算日期"
		];
		const lines: string[] = [header.map((item) => escapeCsvCell(item)).join(",")];
		for (let i = 0; i < rows.length; i++) {
			const item = rows[i];
			const values = [
				`${i + 1}`,
				item.user_nickname,
				item.user_sn ?? item.user_id,
				resolveStaffRoleLabel(item),
				resolveEmploymentStatus(item),
				item.project_title,
				item.keyword,
				item.share_profit,
				item.user_profit,
				item.enterprise_profit,
				item.user_rate,
				item.audit_time ?? item.settlement_time ?? item.payment_time
			];
			lines.push(values.map((value) => escapeCsvCell(value)).join(","));
		}
		return `\ufeff${lines.join("\r\n")}`;
	}

	function exportRevenueList() {
        if (listLoading.value) return;
		const rows = displayOrderList.value;
		if (rows.length == 0) {
			uni.showToast({ title: "暂无可导出的收益数据", icon: "none" });
			return;
		}

		// #ifdef H5
		const csv = buildRevenueCsv(rows);
		const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
		const url = URL.createObjectURL(blob);
		const anchor = document.createElement("a");
		const safeEnterpriseName = enterpriseName.value.replace(/[\\/:*?"<>|\s]+/g, "-");
		const safePeriod = currentPeriodLabel.value.replace(/[\\/:*?"<>|\s]+/g, "-");
		anchor.href = url;
		anchor.download = `${safeEnterpriseName || "企业号"}-订单收益-${safePeriod}.csv`;
		anchor.style.display = "none";
		document.body.appendChild(anchor);
		anchor.click();
		document.body.removeChild(anchor);
		setTimeout(() => URL.revokeObjectURL(url), 1000);
		uni.showToast({ title: `已导出 ${rows.length} 条`, icon: "none" });
		// #endif

		// #ifndef H5
		uni.showToast({ title: "请在网页端导出", icon: "none" });
		// #endif
	}

	const displayOrderList = computed((): OrderListItem[] => {
		const targetRole =
			staffFilterIndex.value == 1
				? "normal"
				: staffFilterIndex.value == 2
					? "leader"
					: staffFilterIndex.value == 3
						? "member"
						: "";
		const employeeEntry = employeeFilterEntries.value[employeeFilterIndex.value];
		const targetEmployee = employeeEntry != null ? employeeEntry.key : "";
		const rows: OrderListItem[] = [];
		for (let i = 0; i < orderList.value.length; i++) {
			const item = orderList.value[i];
			const roleMatched = targetRole == "" || resolveStaffRoleKey(item) == targetRole;
			const employeeMatched = targetEmployee == "" || resolveOrderEmployeeKey(item) == targetEmployee;
			if (roleMatched && employeeMatched) {
				rows.push(item);
			}
		}
		if (orderSortIndex.value == 0 || orderSortIndex.value == 1) {
			rows.sort((a, b) => resolveOrderTime(b) - resolveOrderTime(a));
		} else if (orderSortIndex.value == 2) {
			rows.sort((a, b) => resolveOrderTime(a) - resolveOrderTime(b));
		} else if (orderSortIndex.value == 3) {
			rows.sort((a, b) => resolveOrderRevenue(b) - resolveOrderRevenue(a));
		} else if (orderSortIndex.value == 4) {
			rows.sort((a, b) => resolveOrderRevenue(a) - resolveOrderRevenue(b));
		}
		return rows;
	});

	function parseEnterpriseInfo(res: any | null): EnterpriseInfo | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (data == null) {
			return null;
		}
		return data as EnterpriseInfo;
	}

	function applyEnterpriseInfo(info: EnterpriseInfo) {
		const name = `${info.name ?? ""}`.trim();
		const intro = `${info.intro ?? ""}`.trim();
		enterpriseName.value = name != "" ? name : DEFAULT_ENTERPRISE_NAME;
		enterpriseIntro.value = intro;
        enterpriseLogo.value = `${info.logo ?? ""}`;
        inviteContent.value = resolveInviteQrContent(info as UTSJSONObject);

	}

	function loadEnterpriseInfo() {
		if (enterpriseInfoLoading.value) {
			return;
		}
		enterpriseInfoLoading.value = true;
		getEnterpriseInfo()
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					return;
				}
				const info = parseEnterpriseInfo(res);
				if (info == null) {
					return;
				}
				applyEnterpriseInfo(info);
			})
			.catch((_err) => {})
			.finally(() => {
				enterpriseInfoLoading.value = false;
			});
	}

	function loadMessageUnreadCount() {
		if (messageUnreadLoading.value) {
			return;
		}
		messageUnreadLoading.value = true;
		fetchMessageUnreadCount()
			.then((count) => {
				messageUnreadCount.value = count;
			})
			.finally(() => {
				messageUnreadLoading.value = false;
			});
	}

	function guardHomeOverviewAccess() {
		if (!user.isLoggedIn() || user.isInLoginGrace()) {
			return;
		}
		getAppSystem()
			.then((res) => {
				applyAppSystemResponse(res);
				const state = parseAppSystemRouteState(res);
				if (!shouldBlockHomeOverview(state)) {
					return;
				}
				pushToMenuPath(getAllowedEntryPath(state));
			})
			.catch(() => {});
	}

	onMounted(() => {
		setTimeout(() => {
			capsuleLayoutKey.value += 1;
		}, 50);
		const monthRange = resolveQuickRange("this_month");
		rangeStart.value = monthRange.start;
		rangeEnd.value = monthRange.end;
		loadOrderList();
	});
	onShow(() => {
		guardHomeOverviewAccess();
		syncTabbarRoutePath();
		loadEnterpriseInfo();
        loadWorkbenchExtras();
		loadMessageUnreadCount();
		loadOrderList();
	});
	onReachBottom(() => {
		loadMoreOrderList();
	});
</script>

