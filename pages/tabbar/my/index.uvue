<template>
	<cl-page :pt="{ className: 'me-page' }">
		<view class="me-page">
			<view class="me-profile" :style="profileStyle">
				<view class="me-profile-main">
					<view class="me-avatar">
						<image
							v-if="profileLogo != ''"
							class="me-avatar-img"
							:src="profileLogo"
							mode="aspectFill"
						></image>
						<text v-else class="me-avatar-text">{{ profileAvatarText }}</text>
					</view>
					<view class="me-profile-copy">
						<view class="me-name-row">
							<text class="me-name">{{ profileName }}</text>
						</view>
					</view>
				</view>
				<view class="me-profile-actions">
					<view class="me-action-icon" @tap="toNotice">
						<cl-icon name="notification-4-line" :size="20" color="#333333"></cl-icon>
						<view class="me-action-badge" v-if="messageUnreadCount > 0">
							<text class="me-action-badge-text">{{ messageUnreadBadgeText }}</text>
						</view>
					</view>
					<view class="me-action-icon" @tap="toAccount">
						<cl-icon name="settings-line" :size="20" color="#333333"></cl-icon>
					</view>
				</view>
			</view>

			<view v-if="mineDataReady && revenueCardReady" class="me-wallet-card">
				<view class="me-wallet-label-wrap">
					<view class="me-wallet-label-tag">
						<view class="me-wallet-dot"></view>
						<text class="me-wallet-label">{{ revenueTitle }}</text>
					</view>
				</view>
				<view class="me-wallet-amount">{{ revenueAmount }}</view>
				<view class="me-wallet-divider"></view>
				<view v-if="walletStats.length > 0" class="me-wallet-stats">
					<view
						class="me-wallet-stat"
						v-for="(item, index) in walletStats"
						:key="index"
						:class="{ 'me-wallet-stat--divider': index > 0, 'me-wallet-stat--recovery': item.highlight == true, 'me-wallet-stat--clickable': item.clickable == true }"
						@tap="onWalletStatTap(item)"
					>
						<view class="me-wallet-stat-label-row">
							<text class="me-wallet-stat-label">{{ item.label }}</text>
							<cl-icon v-if="item.clickable == true" name="arrow-right-s-line" :size="11" color="rgba(134,239,172,0.9)"></cl-icon>
						</view>
						<text class="me-wallet-stat-value">{{ item.value }}</text>
					</view>
				</view>
<!-- 				<view class="me-wallet-btn" @tap="toWallet">
					<text class="me-wallet-btn-text">进入企业钱包</text>
				</view> -->
			</view>

			<view v-if="mineDataReady && quickActions.length > 0" class="me-quick-grid">
				<block v-for="(item, index) in quickActions" :key="index">
					<view class="me-quick-item" @tap="onQuickAction(item)">
						<view class="me-quick-icon">
							<cl-icon :name="item.icon" :size="22" color="#2b59c3"></cl-icon>
						</view>
						<text class="me-quick-title">{{ item.title }}</text>
						<text v-if="item.sub != ''" class="me-quick-sub">{{ item.sub }}</text>
					</view>
					<view v-if="index < quickActions.length - 1" class="me-quick-divider"></view>
				</block>
			</view>

			<view class="me-section-head">
				<text class="me-section-label">设置</text>
			</view>
			<view class="me-settings">
				<view
					class="me-setting-item"
					v-for="(item, index) in settingItems"
					:key="index"
					@tap="onSettingTap(item)"
				>
					<text class="me-setting-text">{{ item }}</text>
					<cl-icon name="arrow-right-s-line" :size="18" color="#cccccc"></cl-icon>
				</view>
			</view>
		</view>

		<custom-tabbar></custom-tabbar>

		<cl-popup
			v-model="invitePopupVisible"
			direction="bottom"
			:show-header="false"
			:show-close="false"
			:mask-closable="false"
			:pt="{ className: 'me-invite-popup-wrap' }"
		>
			<view class="me-invite-popup">
				<view class="me-invite-header">
					<text class="me-invite-title">获取员工邀请码</text>
					<view class="me-invite-close" @tap="onInviteCloseTap">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>

				<view class="me-invite-tabs">
					<view
						class="me-invite-tab"
						:class="{ 'me-invite-tab--active': inviteTab == 'setting' }"
						@tap="inviteTab = 'setting'"
					>
						<text class="me-invite-tab-text">邀请设置</text>
						<view v-if="inviteTab == 'setting'" class="me-invite-tab-line"></view>
					</view>
					<view
						class="me-invite-tab"
						:class="{ 'me-invite-tab--active': inviteTab == 'preset' }"
						@tap="onInvitePresetTab"
					>
						<text class="me-invite-tab-text">项目预设</text>
						<view v-if="inviteTab == 'preset'" class="me-invite-tab-line"></view>
					</view>
				</view>

				<view class="me-invite-panel">
					<view v-if="inviteTab == 'setting'" class="me-invite-body">
					<scroll-view class="me-invite-scroll" scroll-y="true" :show-scrollbar="false">
					<view class="me-invite-qr-section">
						<view class="me-invite-qr-card">
							<view class="me-invite-qr-copy">
								<text class="me-invite-qr-title">微信扫码即可参与企业号任务</text>
								<text class="me-invite-qr-desc">邀请微信好友扫码加入你的企业号，统一结算提高效率</text>
							</view>
							<view class="me-invite-qr-box">
								<image
									v-if="inviteQrImageSrc != ''"
									class="me-invite-qr-image"
									:src="inviteQrImageSrc"
									mode="aspectFit"
									show-menu-by-longpress
								></image>
								<cl-loading
									v-else-if="inviteQrText != ''"
									:loading="true"
									:size="28"
									color="#2b59c3"
								></cl-loading>
								<view
									v-if="invitePopupVisible && inviteQrText != ''"
									class="me-invite-qr-canvas-host"
								>
									<cl-qrcode
										ref="inviteQrRef"
										:key="inviteQrKey"
										:text="inviteQrText"
										:width="inviteQrSize"
										:height="inviteQrSize"
										mode="rect"
										foreground="#000000"
										background="#ffffff"
										:padding="12"
									></cl-qrcode>
								</view>
							</view>
						</view>

						<view class="me-invite-qr-btn" @tap="copyInviteLink">
							<text class="me-invite-qr-btn-text">长按识别二维码 · 点击复制链接</text>
						</view>
					</view>

					<view class="me-invite-field">
						<text class="me-invite-field-label">设置企业号品牌</text>
						<text class="me-invite-field-sub">员工端顶部品牌标识</text>
						<input
							class="me-invite-input"
							v-model="brandName"
							placeholder="请输入品牌名称"
							placeholder-class="me-invite-input-placeholder"
						/>
					</view>

					<view class="me-invite-perm">
						<view class="me-invite-perm-head">
							<text class="me-invite-perm-label">员工权限预设</text>
							<text class="me-invite-perm-tip">*仅对更改设置后新加入的员工生效</text>
						</view>
						<view class="me-invite-switch-card">
							<view class="me-invite-switch-copy">
								<text class="me-invite-switch-title">收益数据</text>
								<text class="me-invite-switch-desc">开启后协作者可观看收益数据</text>
							</view>
							<cl-switch v-model="incomeDataEnabled" :height="24" :width="44"></cl-switch>
						</view>
					</view>
					</scroll-view>

					<view class="me-invite-save-btn" @tap="saveInviteConfig">
						<text class="me-invite-save-text">保存并启用配置</text>
					</view>
					</view>

					<view v-else class="me-invite-preset">
					<view class="me-preset-search">
						<view class="me-preset-search-field">
							<input
								class="me-preset-search-input"
								v-model="presetKeyword"
								placeholder="请输入项目名称"
								placeholder-class="me-preset-search-placeholder"
								confirm-type="search"
								@confirm="searchPresetProjectList"
							/>
						</view>
						<view class="me-preset-search-btn" @tap="searchPresetProjectList">
							<text class="me-preset-search-btn-text">搜索</text>
						</view>
					</view>

					<view class="me-preset-filter-panel">
						<cl-tabs
							v-model="activePresetFilterId"
							:list="presetFilterTabList"
							height="56rpx"
							:gutter="0"
							:show-line="false"
                            scroll-align="previous"
							:pt="presetTabsPt"
							@change="onPresetFilterChange"
						>
							<template #item="{ item, active }">
								<view
									class="me-preset-chip"
									:class="{ 'me-preset-chip--active': active }"
								>
									<text
										class="me-preset-chip-text"
										:class="{ 'me-preset-chip-text--active': active }"
									>{{ item.label }}</text>
								</view>
							</template>
						</cl-tabs>
					</view>

					<view v-if="!presetLoading && presetProjects.length > 0" class="me-preset-bulk-row">
						<text class="me-preset-bulk-title">一键操作</text>
						<view class="me-preset-switch-wrap">
							<cl-switch
								:model-value="presetBulkAllEnabled"
								:disabled="!presetHasOperableProjects"
								:height="24"
								:width="44"
								@change="onPresetBulkSwitchChange"
							></cl-switch>
						</view>
					</view>

					<view class="me-preset-list-wrap">
						<scroll-view
							v-if="!presetLoading"
							class="me-preset-list"
							scroll-y="true"
							:show-scrollbar="false"
						>
							<view
								v-if="presetProjects.length == 0"
								class="me-preset-state"
							>
								<text class="me-preset-state-text">暂无项目</text>
							</view>
							<block v-else>
							<view
								class="me-preset-item"
								v-for="(item, index) in presetProjects"
								:key="'preset-row-' + index + '-' + item.rowId"
							>
								<image
									v-if="item.logo != ''"
									class="me-preset-logo"
									:src="item.logo"
									mode="aspectFill"
								></image>
								<view v-else class="me-preset-icon" :style="{ backgroundColor: item.color }">
									<text class="me-preset-icon-text">{{ item.avatar }}</text>
								</view>
								<text class="me-preset-name">{{ item.name }}</text>
								<view class="me-preset-switch-wrap">
									<cl-switch
										:model-value="item.enabled"
										:disabled="item.projectId <= 0"
										:height="24"
										:width="44"
										@change="onPresetToggle(item.uid, item.projectId, $event as boolean)"
									></cl-switch>
								</view>
							</view>
							</block>
						</scroll-view>
						<view v-if="presetLoading" class="me-preset-loading-mask">
							<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
							<text class="me-preset-loading-text">加载中...</text>
						</view>
					</view>

					<view class="me-preset-sync-btn" @tap="syncPresetConfig">
						<text class="me-preset-sync-text">将设置同步给所有协作者</text>
					</view>
					</view>
				</view>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="ts" setup>
	import { computed, ref, watch } from "vue";
	import type { ClTabsItem } from "@/uni_modules/cool-ui/types/index";
	import { getMine } from "@/.cool/api/mine";
	import {
		getEnterpriseInfo,
		getEnterpriseProjectList,
		saveEnterpriseInviteConfig,
		syncEnterpriseInvitePreset
	} from "@/.cool/api/enterprise";
	import { getProjectTypes } from "@/.cool/api/project";
	import type { EnterpriseProjectItem, GetEnterpriseProjectListParams } from "@/.cool/types/enterprise";
	import type { ProjectTypeItem } from "@/.cool/types/project";
	import type { MinePageData, MineShortcut } from "@/.cool/types/mine";
	import { resolveInviteQrContent } from "@/.cool/utils/invite-qrcode";
	import { fetchMessageUnreadCount, formatMessageUnreadBadgeText } from "@/.cool/utils/message";
	import { isLocalUiPreview } from "@/.cool/utils/local-preview";
	import { getCapsuleNavStyle, getCapsuleSafeTopHeight, isApiSuccess, getApiMessage, router } from "@/.cool";
	import CustomTabbar from "@/components/tabbar.uvue";
	import { syncTabbarRoutePath } from "@/.cool/store/tabbar";

	type QuickAction = {
		key: string;
		icon: string;
		title: string;
		sub: string;
	};

	type WalletStat = {
		key: string;
		label: string;
		value: string;
		highlight?: boolean;
		clickable?: boolean;
	};

	const messageUnreadCount = ref(0);
	const messageUnreadLoading = ref(false);

	const messageUnreadBadgeText = computed((): string => {
		return formatMessageUnreadBadgeText(messageUnreadCount.value);
	});

	const mineLoading = ref<boolean>(false);
	const mineDataReady = ref<boolean>(false);
	const revenueCardReady = ref<boolean>(false);
	const profileName = ref<string>("");
	const profileLogo = ref<string>("");
	const profileAvatarText = ref<string>("");
	const revenueTitle = ref<string>("");
	const revenueAmount = ref<string>("");
	const walletStats = ref<WalletStat[]>([]);
	const quickActions = ref<QuickAction[]>([]);

	const invitePopupVisible = ref<boolean>(false);
	const inviteTab = ref<string>("setting");
	const brandName = ref<string>("");
	const incomeDataEnabled = ref<boolean>(false);
	const inviteInfoLoading = ref<boolean>(false);
	const inviteSaving = ref<boolean>(false);
	const inviteQrText = ref<string>("");
	const inviteQrImageSrc = ref<string>("");
	const inviteQrKey = ref<number>(0);
	const inviteQrSize = 240;
	const inviteQrRef = ref<any | null>(null);
	const presetKeyword = ref<string>("");
	type PresetFilterItem = {
		id: number;
		label: string;
	};
	const PRESET_FILTER_ALL_ID = 0;
	const presetFilters = ref<PresetFilterItem[]>([{ id: PRESET_FILTER_ALL_ID, label: "全部" }]);
	const activePresetFilterId = ref<number>(PRESET_FILTER_ALL_ID);
	const presetTypesLoading = ref<boolean>(false);
	const presetTypesLoaded = ref<boolean>(false);

	const presetFilterTabList = computed((): ClTabsItem[] => {
		return presetFilters.value.map((item) => {
			return {
				label: item.label,
				value: item.id
			} as ClTabsItem;
		});
	});

	const presetTabsPt = {
		className: "me-preset-cl-tabs",
		item: {
			className: "me-preset-cl-tabs-item"
		}
	};

	const presetLoading = ref<boolean>(false);
	const presetListRequestId = ref<number>(0);
	const PRESET_LIMIT = 2000;
	const presetSyncing = ref<boolean>(false);
	const presetDirty = ref<boolean>(false);
	const presetInviteInfoReady = ref<boolean>(false);
	const presetDisabledSeeded = ref<boolean>(false);
	const presetSavedDisabledIds = ref<number[]>([]);
	const presetDisabledIds = ref<number[]>([]);
	const PRESET_AVATAR_COLORS = ["#2b59c3", "#6366f1", "#1e3a5f", "#9ca3af", "#f97316", "#22c55e"];

	type PresetProject = {
		uid: string;
		rowId: number;
		id: string;
		projectId: number;
		name: string;
		category: string;
		avatar: string;
		color: string;
		logo: string;
		enabled: boolean;
	};

	type EnterpriseProjectListPayload = {
		list: EnterpriseProjectItem[];
		disabledProjectIds: number[];
	};

	const presetProjects = ref<PresetProject[]>([]);

	const presetBulkAllEnabled = computed(() => {
		const list = presetProjects.value;
		let hasProject = false;
		for (let i = 0; i < list.length; i++) {
			if (list[i].projectId <= 0) {
				continue;
			}
			hasProject = true;
			if (!list[i].enabled) {
				return false;
			}
		}
		return hasProject;
	});

	const presetHasOperableProjects = computed(() => {
		const list = presetProjects.value;
		for (let i = 0; i < list.length; i++) {
			if (list[i].projectId > 0) {
				return true;
			}
		}
		return false;
	});

	function resolvePresetFilterId(value: string | number | null | undefined): number {
		if (value == null) {
			return activePresetFilterId.value;
		}
		if (typeof value == "number") {
			return value as number;
		}
		const n = parseInt(`${value}`);
		return isNaN(n) ? activePresetFilterId.value : n;
	}

	function onPresetFilterChange(value: string | number) {
		loadEnterpriseProjectList(resolvePresetFilterId(value));
	}

	function normalizePresetDisabledIds(ids: number[]): number[] {
		const result: number[] = [];
		for (let i = 0; i < ids.length; i++) {
			const n = ids[i];
			if (n > 0 && result.indexOf(n) < 0) {
				result.push(n);
			}
		}
		result.sort((a, b) => {
			if (a < b) {
				return -1;
			}
			if (a > b) {
				return 1;
			}
			return 0;
		});
		return result;
	}

	function arePresetDisabledIdsEqual(a: number[], b: number[]): boolean {
		const left = normalizePresetDisabledIds(a);
		const right = normalizePresetDisabledIds(b);
		if (left.length != right.length) {
			return false;
		}
		for (let i = 0; i < left.length; i++) {
			if (left[i] != right[i]) {
				return false;
			}
		}
		return true;
	}

	function hasPresetUnsavedChanges(): boolean {
		return !arePresetDisabledIdsEqual(
			collectPresetDisabledIdsForSync(),
			presetSavedDisabledIds.value
		);
	}

	function applyPresetSavedDisabledIds(ids: number[]) {
		const normalized = normalizePresetDisabledIds(ids);
		presetSavedDisabledIds.value = normalized.slice();
		presetDisabledIds.value = normalized.slice();
		presetDirty.value = false;
	}

	function shouldConfirmPresetClose(): boolean {
		return presetDirty.value || hasPresetUnsavedChanges();
	}

	function showPresetCloseConfirm(onConfirm: () => void) {
		uni.showModal({
			title: "提示",
			content: "项目预设配置尚未同步，确定要关闭吗？",
			confirmText: "确定",
			cancelText: "取消",
			success(res) {
				if (res.confirm) {
					onConfirm();
				}
			}
		});
	}

	function getPresetAvatarText(name: string): string {
		const text = name.trim();
		if (text == "") {
			return "项";
		}
		return text.charAt(0);
	}

	function parsePresetDisabledIds(raw: any | null): number[] {
		if (raw == null) {
			return [];
		}
		let arr: any[] | null = null;
		if (Array.isArray(raw)) {
			arr = raw as any[];
		} else if (typeof raw == "string") {
			const text = (raw as string).trim();
			if (text != "" && text.startsWith("[")) {
				try {
					const parsed = JSON.parse(text) as any[] | null;
					if (parsed != null && Array.isArray(parsed)) {
						arr = parsed;
					}
				} catch (_e) {
					arr = null;
				}
			}
		}
		if (arr == null) {
			return [];
		}
		const ids: number[] = [];
		for (let i = 0; i < arr.length; i++) {
			const n = parseInt(`${arr[i]}`);
			if (!isNaN(n) && n > 0) {
				ids.push(n);
			}
		}
		return ids;
	}

	function syncPresetListToDisabledIds() {
		const ids = presetDisabledIds.value.slice();
		const list = presetProjects.value;
		for (let i = 0; i < list.length; i++) {
			const projectId = list[i].projectId;
			if (projectId <= 0) {
				continue;
			}
			const idx = ids.indexOf(projectId);
			if (!list[i].enabled) {
				if (idx < 0) {
					ids.push(projectId);
				}
			} else if (idx >= 0) {
				ids.splice(idx, 1);
			}
		}
		presetDisabledIds.value = ids;
	}

	function collectPresetDisabledIdsForSync(): number[] {
		syncPresetListToDisabledIds();
		return normalizePresetDisabledIds(presetDisabledIds.value);
	}

	function isPresetProjectDisabled(projectId: number): boolean {
		return presetDisabledIds.value.indexOf(projectId) >= 0;
	}

	function setPresetProjectDisabled(projectId: number, disabled: boolean) {
		const ids = presetDisabledIds.value.slice();
		const idx = ids.indexOf(projectId);
		if (disabled) {
			if (idx < 0) {
				ids.push(projectId);
			}
		} else if (idx >= 0) {
			ids.splice(idx, 1);
		}
		presetDisabledIds.value = ids;
	}

	function setPresetProjectEnabled(uid: string, projectId: number, enabled: boolean): boolean {
		if (projectId <= 0) {
			return false;
		}
		const list = presetProjects.value;
		let found = false;
		for (let i = 0; i < list.length; i++) {
			if (list[i].uid == uid) {
				list[i].enabled = enabled;
				found = true;
				break;
			}
		}
		if (!found) {
			return false;
		}
		setPresetProjectDisabled(projectId, !enabled);
		return true;
	}

	function parseEnterpriseProjectListPayload(res: any | null): EnterpriseProjectListPayload {
		const empty: EnterpriseProjectListPayload = {
			list: [],
			disabledProjectIds: []
		};
		if (res == null) {
			return empty;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return {
				list: data as EnterpriseProjectItem[],
				disabledProjectIds: []
			};
		}
		const obj = data as UTSJSONObject;
		const list = obj["list"];
		const listArr =
			list != null && Array.isArray(list) ? (list as EnterpriseProjectItem[]) : [];
		const disabledRaw = obj["disabled_project_ids"] ?? obj["preset_disabled_project_ids"];
		return {
			list: listArr,
			disabledProjectIds: parsePresetDisabledIds(disabledRaw)
		};
	}

	function seedPresetDisabledFromApi(payload: EnterpriseProjectListPayload) {
		if (presetDirty.value || presetDisabledSeeded.value) {
			return;
		}
		if (presetSavedDisabledIds.value.length > 0) {
			presetDisabledSeeded.value = true;
			return;
		}
		const apiIds = payload.disabledProjectIds;
		if (apiIds.length > 0) {
			presetDisabledIds.value = normalizePresetDisabledIds(apiIds);
			presetDisabledSeeded.value = true;
			return;
		}
		const ids = presetDisabledIds.value.slice();
		const items = payload.list;
		for (let i = 0; i < items.length; i++) {
			const projectId = toPresetProjectId(items[i]);
			if (projectId <= 0) {
				continue;
			}
			const idx = ids.indexOf(projectId);
			if ((items[i].status ?? 0) == 1) {
				if (idx >= 0) {
					ids.splice(idx, 1);
				}
			} else if (idx < 0) {
				ids.push(projectId);
			}
		}
		presetDisabledIds.value = normalizePresetDisabledIds(ids);
		presetDisabledSeeded.value = true;
	}

	function readPresetNumber(value: any | null): number {
		if (value == null) {
			return 0;
		}
		const n = typeof value == "number" ? (value as number) : parseInt(`${value}`);
		return isNaN(n) ? 0 : n;
	}

	function readPresetRowRecordId(row: EnterpriseProjectItem, index: number): number {
		const obj = row as UTSJSONObject;
		const recordId = readPresetNumber(obj["id"]);
		return recordId > 0 ? recordId : index + 1;
	}

	function toPresetProjectId(row: EnterpriseProjectItem): number {
		const obj = row as UTSJSONObject;
		const subProjectId = readPresetNumber(obj["sub_project_id"] ?? obj["subProjectId"]);
		if (subProjectId > 0) {
			return subProjectId;
		}
		const rowId = readPresetNumber(obj["id"]);
		const parentProjectId = readPresetNumber(
			obj["project_id"] ?? obj["projectId"] ?? obj["projectID"]
		);
		const isSubProject = readPresetNumber(obj["is_sub_project"] ?? obj["isSubProject"]) == 1;
		if (isSubProject && rowId > 0) {
			return rowId;
		}
		if (rowId > 0 && parentProjectId > 0 && rowId != parentProjectId) {
			return rowId;
		}
		if (parentProjectId > 0) {
			return parentProjectId;
		}
		return rowId > 0 ? rowId : 0;
	}

	function mapEnterpriseProject(row: EnterpriseProjectItem, index: number): PresetProject {
		const safeId = toPresetProjectId(row);
		const rowId = readPresetRowRecordId(row, index);
		const title = row.title ?? "";
		const logo = row.logo ?? "";
		const categoryRaw = row.category_name ?? row.category_title ?? "";
		const category = `${categoryRaw}`.trim();
		const disabled = isPresetProjectDisabled(safeId);
		return {
			uid: `preset-row-${rowId}-${index}`,
			rowId: rowId,
			id: safeId > 0 ? `${safeId}` : `preset-${index}`,
			projectId: safeId,
			name: title != "" ? title : "未命名项目",
			category: category,
			avatar: getPresetAvatarText(title),
			color: PRESET_AVATAR_COLORS[index % PRESET_AVATAR_COLORS.length],
			logo: logo != "" ? logo : "",
			enabled: !disabled
		};
	}

	function parseProjectTypeList(res: any | null): PresetFilterItem[] {
		const items: PresetFilterItem[] = [{ id: PRESET_FILTER_ALL_ID, label: "全部" }];
		if (res == null) {
			return items;
		}
		const envelope = res as UTSJSONObject;
		const code = envelope["code"];
		if (code != null && !isApiSuccess(code)) {
			return items;
		}
		const data = envelope["data"] ?? envelope;
		if (!Array.isArray(data)) {
			return items;
		}
		const rows = data as ProjectTypeItem[];
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i];
			const idVal = row.id ?? 0;
			const id = typeof idVal == "number" ? (idVal as number) : parseInt(`${idVal}`);
			if (isNaN(id) || id <= 0) {
				continue;
			}
			const labelRaw = row.label ?? row.title ?? "";
			const label = `${labelRaw}`.trim();
			if (label == "") {
				continue;
			}
			const exists = items.find((item) => item.id == id);
			if (exists != null) {
				continue;
			}
			items.push({ id: id, label: label });
		}
		return items;
	}

	function loadPresetProjectTypes(andLoadList: boolean = true) {
		if (presetTypesLoading.value) {
			return;
		}
		if (presetTypesLoaded.value) {
			if (andLoadList) {
				loadEnterpriseProjectList();
			}
			return;
		}
		presetTypesLoading.value = true;
		getProjectTypes()
			.then((res) => {
				presetFilters.value = parseProjectTypeList(res);
				presetTypesLoaded.value = true;
				if (activePresetFilterId.value != PRESET_FILTER_ALL_ID) {
					const exists = presetFilters.value.find((item) => item.id == activePresetFilterId.value);
					if (exists == null) {
						activePresetFilterId.value = PRESET_FILTER_ALL_ID;
					}
				}
				if (andLoadList) {
					loadEnterpriseProjectList();
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载分类失败"), icon: "none" });
				if (andLoadList) {
					loadEnterpriseProjectList();
				}
			})
			.finally(() => {
				presetTypesLoading.value = false;
			});
	}

	function fetchPresetProjectList(categoryId: number = activePresetFilterId.value) {
		const targetFilterId = categoryId;
		const requestId = ++presetListRequestId.value;
		presetLoading.value = true;
		const listParams: GetEnterpriseProjectListParams = {
			keyword: presetKeyword.value.trim(),
			page: 1,
			limit: PRESET_LIMIT,
			format: "auth"
		};
		if (targetFilterId > PRESET_FILTER_ALL_ID) {
			listParams.category_id = targetFilterId;
		}
		getEnterpriseProjectList(listParams)
			.then((res) => {
				if (requestId != presetListRequestId.value) {
					return;
				}
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
					return;
				}
				const payload = parseEnterpriseProjectListPayload(res);
				seedPresetDisabledFromApi(payload);
				const mapped: PresetProject[] = [];
				for (let i = 0; i < payload.list.length; i++) {
					mapped.push(mapEnterpriseProject(payload.list[i], i));
				}
				presetProjects.value = mapped;
			})
			.catch((err) => {
				if (requestId != presetListRequestId.value) {
					return;
				}
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				if (requestId != presetListRequestId.value) {
					return;
				}
				presetLoading.value = false;
			});
	}

	function loadEnterpriseProjectList(categoryId: number = activePresetFilterId.value) {
		activePresetFilterId.value = categoryId;
		fetchPresetProjectList(categoryId);
	}

	function searchPresetProjectList() {
		loadEnterpriseProjectList(PRESET_FILTER_ALL_ID);
	}

	function onInvitePresetTab() {
		inviteTab.value = "preset";
		if (presetInviteInfoReady.value) {
			loadPresetProjectTypes(true);
			return;
		}
		loadInviteEnterpriseInfo();
	}

	const profileStyle = computed(() => {
		const style = getCapsuleNavStyle(8);
		return {
			paddingRight: style.paddingRight
		};
	});

	function formatMoneyDisplay(raw: string): string {
		const text = `${raw}`.trim();
		if (text == "") {
			return "";
		}
		if (text.startsWith("¥")) {
			return text;
		}
		return `¥${text}`;
	}

	function normalizeQuickKey(key: string): string {
		const k = key.trim().toLowerCase();
		if (k == "staff" || k == "employee") {
			return "staff";
		}
		if (k == "keyword" || k == "account") {
			return "keyword";
		}
		if (k == "invite") {
			return "invite";
		}
		if (k == "settings" || k == "setting") {
			return "settings";
		}
		return k;
	}

	function resolveShortcutIcon(key: string): string {
		const k = normalizeQuickKey(key);
		if (k == "staff") {
			return "group-line";
		}
		if (k == "keyword") {
			return "account-box-line";
		}
		if (k == "invite") {
			return "qr-code-line";
		}
		if (k == "settings") {
			return "settings-line";
		}
		return "apps-line";
	}

	function mapShortcut(item: MineShortcut): QuickAction {
		const keyRaw = `${item.key ?? ""}`.trim();
		const key = normalizeQuickKey(keyRaw);
		const title = `${item.title ?? ""}`.trim();
		return {
			key: key,
			icon: resolveShortcutIcon(key),
			title: title,
			sub: `${item.subtitle ?? ""}`.trim()
		};
	}

	function createLocalPreviewMineData(): MinePageData {
		return {
			profile: {
				name: "哪哪拉拉溪"
			},
			revenue_card: {
				title: "累计企业收益",
				// 企业收益总值已包含离职回收金额：41.59 + 104.00。
				revenue: "145.59",
				pending_settlement: "41.59",
				departure_recovery_amount: "104.00",
				staff_normal: 5,
				staff_count: 8,
				keyword_count: 174
			},
			shortcuts: [
				{ key: "staff", title: "员工", subtitle: "8人" },
				{ key: "keyword", title: "账号", subtitle: "推广账号" },
				{ key: "invite", title: "邀请码", subtitle: "扫码员工" },
				{ key: "settings", title: "设置", subtitle: "资料/合规" }
			]
		};
	}

	function applyMineData(data: MinePageData) {
		mineDataReady.value = true;
		revenueCardReady.value = false;
		profileName.value = "";
		profileLogo.value = "";
		profileAvatarText.value = "";
		revenueTitle.value = "";
		revenueAmount.value = "";
		walletStats.value = [];
		quickActions.value = [];
		const profile = data.profile;
		if (profile != null) {
			const name = `${profile.name ?? ""}`.trim();
			if (name != "") {
				profileName.value = name;
				profileAvatarText.value = name.charAt(0);
			}
			const logo = `${profile.logo ?? ""}`.trim();
			profileLogo.value = logo;
		}
		const card = data.revenue_card;
		if (card != null) {
			const title = `${card.title ?? ""}`.trim();
			revenueTitle.value = title;
			const rev = `${card.revenue ?? ""}`.trim();
			revenueAmount.value = formatMoneyDisplay(rev);
			revenueCardReady.value = title != "" || rev != "";
			const pending = `${card.pending_settlement ?? ""}`.trim();
			const stats: WalletStat[] = [];
			if (pending != "") {
				stats.push({ key: "pending", label: "待结算", value: formatMoneyDisplay(pending) });
			}
			const recoveryAmountRaw =
				card.resigned_staff_recovery_amount ??
				card.former_staff_recovery_amount ??
				card.departure_recovery_amount;
			const recoveryAmount = recoveryAmountRaw ?? (isLocalUiPreview() ? 104 : null);
			if (recoveryAmount != null) {
				stats.push({
					key: "departure_recovery",
					label: "离职回收金额",
					value: formatMoneyDisplay(`${recoveryAmount}`),
					highlight: true,
					clickable: true
				});
			}
			if (card.staff_normal != null || card.staff_count != null) {
				const staffN = card.staff_normal != null ? `${card.staff_normal}` : "";
				const staffC = card.staff_count != null ? `${card.staff_count}` : "";
				stats.push({ key: "staff", label: "在职员工", value: staffN != "" && staffC != "" ? `${staffN}/${staffC}` : staffN != "" ? staffN : staffC });
			}
			if (card.keyword_count != null) {
				stats.push({ key: "keyword", label: "推广任务", value: `${card.keyword_count}` });
			}
			walletStats.value = stats;
		}
		const shortcuts = data.shortcuts;
		if (shortcuts != null && shortcuts.length > 0) {
			const mapped: QuickAction[] = [];
			for (let i = 0; i < shortcuts.length; i++) {
				const row = mapShortcut(shortcuts[i]);
				if (row.title != "") {
					mapped.push(row);
				}
			}
			if (mapped.length > 0) {
				quickActions.value = mapped;
			}
		}
	}

	function loadMine() {
		if (mineLoading.value) {
			return;
		}
		mineLoading.value = true;
		const localPreview = isLocalUiPreview();
		if (localPreview) {
			applyMineData(createLocalPreviewMineData());
		} else if (!mineDataReady.value) {
			mineDataReady.value = false;
			revenueCardReady.value = false;
		}
		getMine()
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				if (localPreview && data["profile"] == null && data["revenue_card"] == null) {
					return;
				}
				applyMineData(data as MinePageData);
			})
			.catch(() => {})
			.finally(() => {
				mineLoading.value = false;
			});
	}

	function loadMessageUnreadCount() {
		if (messageUnreadLoading.value) {
			return;
		}
		messageUnreadLoading.value = true;
		fetchMessageUnreadCount()
			.then((count) => {
				messageUnreadCount.value = count;
			})
			.finally(() => {
				messageUnreadLoading.value = false;
			});
	}

	function toNotice() {
		router.push({ path: "/pages/notice/index" });
	}

	function toWallet() {
		router.push({ path: "/pages/wallet/index" });
	}

	function onWalletStatTap(item: WalletStat) {
		if (item.key != "departure_recovery") return;
		uni.navigateTo({ url: "/pages/wallet/departure-recovery" });
	}

	function toSettings() {
		router.push({ path: "/pages/user/settings" });
	}

	function toAccount() {
		router.push({ path: "/pages/user/account" });
	}

	function toCompliance() {
		router.push({ path: "/pages/user/compliance" });
	}

	function toHelp() {
		router.push({ path: "/pages/user/help" });
	}

	function toSecurity() {
		router.push({ path: "/pages/user/security" });
	}

	function toAbout() {
		router.push({ path: "/pages/user/about" });
	}

	function toBusinessTab(resourceTab: string) {
		uni.setStorageSync("businessResourceTab", resourceTab);
		uni.switchTab({
			url: "/pages/tabbar/business/index"
		});
	}

	function onQuickAction(item: QuickAction) {
		const key = item.key;
		if (key == "staff" || key == "employee") {
			toBusinessTab("employee");
		} else if (key == "keyword" || key == "account") {
			toBusinessTab("account");
		} else if (key == "invite") {
			openInvitePopup();
		} else if (key == "settings" || key == "setting") {
			toSettings();
		}
	}

	function onSettingTap(item: string) {
		if (item == "账户安全") {
			toSecurity();
		} else if (item == "协议与合规") {
			toCompliance();
		} else if (item == "帮助中心") {
			toHelp();
		} else if (item == "关于企业号") {
			toAbout();
		}
	}

	function exportInviteQrImage() {
		const comp = inviteQrRef.value;
		if (comp == null) {
			return;
		}
		comp
			.toPng()
			.then((path: string) => {
				if (path != null && `${path}`.trim() != "") {
					inviteQrImageSrc.value = `${path}`.trim();
				}
			})
			.catch((err) => {
				console.error("invite qrcode export failed", err);
			});
	}

	function copyInviteLink() {
		const link = inviteQrText.value.trim();
		if (link == "") {
			uni.showToast({ title: "邀请链接生成中", icon: "none" });
			return;
		}
		uni.setClipboardData({
			data: link,
			success: () => {
				uni.showToast({ title: "链接已复制", icon: "none" });
			}
		});
	}

	function refreshInviteQrcode() {
		if (!invitePopupVisible.value || inviteQrText.value == "") {
			return;
		}
		inviteQrImageSrc.value = "";
		inviteQrKey.value += 1;
		setTimeout(() => {
			exportInviteQrImage();
		}, 600);
	}

	function toRevenueSwitchEnabled(raw: any | null): boolean {
		if (raw == null) {
			return false;
		}
		if (typeof raw == "boolean") {
			return raw as boolean;
		}
		const text = `${raw}`.trim();
		return text == "1" || text == "true";
	}

	function applyInviteEnterpriseInfo(data: UTSJSONObject) {
		const enterprise = data["enterprise"] as UTSJSONObject | null;
		const nameRaw = enterprise != null ? enterprise["name"] : data["name"];
		const name = nameRaw != null ? `${nameRaw}`.trim() : "";
		brandName.value = name;
		incomeDataEnabled.value = toRevenueSwitchEnabled(data["preset_can_view_revenue"]);
		inviteQrText.value = resolveInviteQrContent(data);
		presetInviteInfoReady.value = true;
		if (!shouldConfirmPresetClose()) {
			applyPresetSavedDisabledIds(parsePresetDisabledIds(data["preset_disabled_project_ids"]));
			presetDisabledSeeded.value = presetSavedDisabledIds.value.length > 0;
			if (inviteTab.value == "preset") {
				loadPresetProjectTypes(true);
			}
		}
		refreshInviteQrcode();
	}

	watch(invitePopupVisible, (visible) => {
		if (visible && inviteQrText.value != "") {
			refreshInviteQrcode();
		}
	});

	function loadInviteEnterpriseInfo() {
		if (inviteInfoLoading.value) {
			return;
		}
		inviteInfoLoading.value = true;
		getEnterpriseInfo()
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject | null;
				if (data == null) {
					uni.showToast({ title: "企业信息为空", icon: "none" });
					return;
				}
				applyInviteEnterpriseInfo(data);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				inviteInfoLoading.value = false;
			});
	}

	function resetPresetPanelState() {
		activePresetFilterId.value = PRESET_FILTER_ALL_ID;
		presetKeyword.value = "";
		presetProjects.value = [];
		presetInviteInfoReady.value = false;
		presetDisabledSeeded.value = false;
		presetSavedDisabledIds.value = [];
		presetDisabledIds.value = [];
		presetDirty.value = false;
	}

	function closeInvitePopup(force: boolean = false) {
		const skipConfirm = force === true;
		if (!skipConfirm && shouldConfirmPresetClose()) {
			showPresetCloseConfirm(() => {
				presetDirty.value = false;
				invitePopupVisible.value = false;
			});
			return;
		}
		invitePopupVisible.value = false;
	}

	function onInviteCloseTap() {
		closeInvitePopup();
	}

	function openInvitePopup() {
		inviteTab.value = "setting";
		inviteQrText.value = "";
		inviteQrImageSrc.value = "";
		resetPresetPanelState();
		invitePopupVisible.value = true;
		loadInviteEnterpriseInfo();
	}

	function saveInviteConfig() {
		if (inviteSaving.value || inviteInfoLoading.value) {
			return;
		}
		const name = brandName.value.trim();
		if (name == "") {
			uni.showToast({ title: "请填写品牌名称", icon: "none" });
			return;
		}
		inviteSaving.value = true;
		uni.showLoading({ title: "保存中..." });
		saveEnterpriseInviteConfig({
			name: name,
			preset_can_view_revenue: incomeDataEnabled.value ? "1" : "0"
		})
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "保存失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: getApiMessage(res, "保存成功"), icon: "success" });
				closeInvitePopup(true);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "保存失败"), icon: "none" });
			})
			.finally(() => {
				uni.hideLoading();
				inviteSaving.value = false;
			});
	}

	function onPresetToggle(uid: string, projectId: number, enabled: boolean) {
		if (setPresetProjectEnabled(uid, projectId, enabled)) {
			presetDirty.value = true;
		}
	}

	function onPresetBulkSwitchChange(enabled: boolean) {
		const list = presetProjects.value;
		for (let i = 0; i < list.length; i++) {
			if (list[i].projectId <= 0) {
				continue;
			}
			list[i].enabled = enabled;
			setPresetProjectDisabled(list[i].projectId, !enabled);
		}
		presetDirty.value = true;
	}

	function syncPresetConfig() {
		if (presetSyncing.value || presetLoading.value) {
			return;
		}
		const disabledIds = collectPresetDisabledIdsForSync();
		presetDisabledIds.value = disabledIds;
		presetSyncing.value = true;
		uni.showLoading({ title: "同步中..." });
		syncEnterpriseInvitePreset({
			preset_disabled_project_ids: disabledIds
		})
			.then((res) => {
				if (res == null) {
					uni.showToast({ title: "同步失败", icon: "none" });
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "同步失败"), icon: "none" });
					return;
				}
				presetSavedDisabledIds.value = normalizePresetDisabledIds(disabledIds);
				presetDirty.value = false;
				uni.showToast({ title: getApiMessage(res, "同步成功"), icon: "success" });
				closeInvitePopup(true);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "同步失败"), icon: "none" });
			})
			.finally(() => {
				uni.hideLoading();
				presetSyncing.value = false;
			});
	}

	const settingItems = ["账户安全", "关于企业号"];

	onShow(() => {
		syncTabbarRoutePath();
		loadMine();
		loadMessageUnreadCount();
	});
</script>

