<style lang="scss" scoped>
@import "@/styles/employee-workbench.scss";
.st-page, .st-top-panel { background: $background; }
.st-top-inner { width: 100%; padding: 14px 14px 0; max-width: 800px; margin: 0 auto; }
.st-scroll-inner { width: 100%; padding: 0 14px calc(80px + env(safe-area-inset-bottom)); max-width: 800px; margin: 0 auto; }
.st-hero-card { @include feature; margin-bottom: 12px; }
.st-hero-top { background: transparent; padding: 14px 12px; }
.st-brand-logo, .st-brand-logo-img { width: 44px; height: 44px; border-radius: 12px; }
.st-brand-copy { margin-left: 10px; }
.st-brand-name { display: block; font-size: 16px; line-height: 22px; color: $text; overflow-wrap: anywhere; }
.st-brand-sub { display: block; font-size: 12px; line-height: 18px; color: $muted; overflow-wrap: anywhere; }
.st-settings-btn { width: 34px; height: 34px; border-radius: 9px; background: #ffffffb3; }
.st-member-line { margin: 0 12px; padding: 11px 0 12px; display: flex; flex-direction: row; align-items: center; border-top: 1px solid rgba(116,137,197,.16); }
.st-member-avatar { width: 30px; height: 30px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #5375ed; }
.st-member-avatar text { font-size: 12px; line-height: 18px; font-weight: 600; color: #fff; }
.st-member-copy { flex: 1; min-width: 0; margin-left: 9px; display: flex; flex-direction: column; }
.st-member-name { font-size: 12px; line-height: 18px; font-weight: 600; color: $text; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st-member-id { margin-top: 1px; font-size: 10px; line-height: 15px; color: $muted; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st-member-tag { margin-left: 8px; padding: 2px 7px; flex-shrink: 0; border-radius: 6px; background: rgba(83,117,237,.1); }
.st-member-tag text { font-size: 10px; line-height: 15px; color: $primary; }
.st-type-card { @include card; padding: 5px 4px; margin-bottom: 12px; }
.st-type-text { font-size: 12px; }
.st-layout-bar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin: 0 0 10px; }
.st-layout-label { @include section; }
.st-layout-options { display: flex; flex-direction: row; padding: 3px; background: #e9ecf2; border-radius: 9px; gap: 2px; }
.st-layout-options button { margin: 0; padding: 0 12px; font-size: 12px; line-height: 30px; color: $muted; background: transparent; border-radius: 7px; }
.st-layout-options button::after { border: none; }
.st-layout-options button.selected { background: white; color: $primary; font-weight: 600; }
.st-task-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
.st-task-card { @include card; display: flex; flex-direction: column; width: auto; min-width: 0; padding: 12px; margin: 0; }
.st-task-head { flex: 1; min-height: 52px; margin-bottom: 10px; }
.st-task-title { display: block; font-size: 14px; line-height: 20px; color: $text; overflow-wrap: anywhere; }
.st-task-date { display: block; font-size: 11px; line-height: 17px; color: $muted; margin-top: 4px; }
.st-task-logo, .st-task-icon { width: 28px; height: 28px; border-radius: 8px; }
.st-task-icon-text { font-size: 13px; }
.st-task-actions { gap: 6px; }
.st-task-btn { flex: 1; width: auto; min-width: 0; height: 34px; border-radius: 8px; }
.st-task-btn-text { font-size: 11px; white-space: nowrap; }
.st-task-btn--primary { background: $primary; }
.st-task-btn--light { background: #eef2ff; }
.st-task-btn-text--primary { color: $primary; }
.st-task-grid--list { grid-template-columns: minmax(0,1fr); }
.st-task-grid--list .st-task-head { min-height: 0; align-items: center; }
.st-task-grid--list .st-task-actions { justify-content: flex-end; }
.st-task-grid--list .st-task-btn { flex: 0 1 100px; }
.st-task-grid--list .st-task-btn-text { font-size: 12px; }
.st-footer { padding-top: 18px; }
	.st-task-preview { width: 100%; max-height: 86vh; padding: 8px 16px calc(16px + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; }
	.st-preview-handle { width: 38px; height: 4px; margin: 0 auto 12px; border-radius: 2px; background: #dfe3eb; }
	.st-preview-head { display: flex; flex-direction: row; align-items: center; padding: 2px 0 16px; }
	.st-preview-logo { width: 50px; height: 50px; flex-shrink: 0; border-radius: 14px; background: #f1f4fa; }
	.st-preview-logo--text { display: flex; align-items: center; justify-content: center; background: #eef2ff; }
	.st-preview-logo--text text { color: $primary; font-size: 18px; font-weight: 700; }
	.st-preview-copy { flex: 1; min-width: 0; margin-left: 12px; display: flex; flex-direction: column; }
	.st-preview-title { color: $text; font-size: 18px; line-height: 25px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.st-preview-meta { margin-top: 4px; color: $muted; font-size: 11px; line-height: 17px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.st-preview-close { width: 32px; height: 32px; margin-left: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3f5f8; }
	.st-preview-guide { margin-bottom: 12px; padding: 14px; display: flex; flex-direction: row; align-items: flex-start; border: 1px solid #e7ebf5; border-radius: 14px; background: #f8faff; }
	.st-preview-guide-icon { width: 36px; height: 36px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #eaf0ff; }
	.st-preview-guide-copy { flex: 1; min-width: 0; margin-left: 10px; display: flex; flex-direction: column; }
	.st-preview-guide-title { color: $text; font-size: 14px; line-height: 20px; font-weight: 600; }
	.st-preview-guide-text { margin-top: 3px; color: $muted; font-size: 12px; line-height: 18px; }
	.st-preview-actions { display: flex; flex-direction: row; gap: 10px; margin-top: 14px; }
	.st-preview-btn { flex: 1; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
	.st-preview-btn text { font-size: 14px; line-height: 20px; font-weight: 600; }
	.st-preview-btn--light { background: #eef2ff; }
	.st-preview-btn--light text { color: $primary; }
	.st-preview-btn--primary { background: $primary; }
	.st-preview-btn--primary text { color: #fff; }
	@media (max-width: 350px) { .st-task-card { padding: 10px; } .st-task-logo, .st-task-icon { width: 24px; height: 24px; } }
	.st-prompt-tools { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-bottom: 10px; }
	.st-prompt-tool { min-width: 0; min-height: 58px; padding: 10px; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; border: 1px solid #e7ebf5; border-radius: 12px; background: #fff; }
	.st-prompt-tool:active { background: #f6f8ff; }
	.st-prompt-tool-icon { width: 34px; height: 34px; margin-right: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 9px; background: #eef2ff; }
	.st-prompt-tool-icon--quick { background: #edf5ff; }
	.st-prompt-tool-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
	.st-prompt-tool-title { font-size: 13px; line-height: 19px; font-weight: 600; color: $text; white-space: nowrap; }
	.st-prompt-tool-sub { margin-top: 2px; font-size: 10px; line-height: 15px; color: $muted; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	@media (max-width: 350px) { .st-prompt-tool { padding: 8px; } .st-prompt-tool-icon { width: 30px; height: 30px; margin-right: 6px; } .st-prompt-tool-sub { display: none; } }
</style>

<style lang="scss">
	.st-task-preview-wrap .cl-popup__inner { border-radius: 20px 20px 0 0; overflow: hidden; background: #fff; }
</style>
