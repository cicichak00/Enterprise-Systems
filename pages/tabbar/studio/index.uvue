<template>
	<cl-page :pt="{ className: 'st-page' }" :back-top="false">
		<view class="st-page">
			<view class="st-top-panel">
				<view class="st-top-inner">
<view class="employee-heading"><text>首页</text><button class="employee-help" @tap="openTutorial">使用教程</button></view>
					<view class="st-hero-card">
						<view class="st-hero-top">
							<view class="st-brand-row">
								<image
									v-if="enterpriseLogo != ''"
									class="st-brand-logo-img"
									:src="enterpriseLogo"
									mode="aspectFill"
								></image>
								<view v-else class="st-brand-logo">
									<text class="st-brand-logo-text">{{ enterpriseLogoText }}</text>
								</view>
								<view class="st-brand-copy">
									<text class="st-brand-name">{{ enterpriseName }}</text>
									<text v-if="enterpriseIntro != ''" class="st-brand-sub">{{ enterpriseIntro }}</text>
								</view>
							</view>
							<view class="st-settings-btn" @tap="onNotificationsTap" role="button" aria-label="消息通知">
								<cl-icon name="notification-4-line" :size="19" color="#5375ed"></cl-icon>
							</view>
						</view>
						<view class="st-member-line">
							<view class="st-member-avatar"><text>{{ employeeAvatarText }}</text></view>
							<view class="st-member-copy"><text class="st-member-name">{{ employeeNickname }}</text><text class="st-member-id">用户 ID：{{ employeeUserId }}</text></view>
							<view class="st-member-tag"><text>员工</text></view>
						</view>
					</view>

						<view v-if="promptToolsEnabled" class="st-prompt-tools">
							<view class="st-prompt-tool" @tap="openComposePrompt">
								<view class="st-prompt-tool-icon"><cl-icon name="apps-2-line" :size="20" color="#5375ed"></cl-icon></view>
								<view class="st-prompt-tool-copy"><text class="st-prompt-tool-title">组合提词</text><text class="st-prompt-tool-sub">多项目组合生成</text></view>
								<cl-icon name="arrow-right-s-line" :size="17" color="#a2a9b5"></cl-icon>
							</view>
							<view class="st-prompt-tool" @tap="openQuickPrompt">
								<view class="st-prompt-tool-icon st-prompt-tool-icon--quick"><cl-icon name="image-2-line" :size="20" color="#5375ed"></cl-icon></view>
								<view class="st-prompt-tool-copy"><text class="st-prompt-tool-title">快捷提词</text><text class="st-prompt-tool-sub">查看并快速复用</text></view>
								<cl-icon name="arrow-right-s-line" :size="17" color="#a2a9b5"></cl-icon>
							</view>
						</view>

						<view class="st-layout-bar"><text class="st-layout-label">全部任务</text><view class="st-layout-options"><button :class="{ selected: taskLayout == 'grid' }" @tap="setTaskLayout('grid')">双列</button><button :class="{ selected: taskLayout == 'list' }" @tap="setTaskLayout('list')">列表</button></view></view>
<view class="st-type-card">
						<cl-tabs
							v-model="activeTypeId"
							:list="typeFilterTabList"
							height="68rpx"
							:gutter="0"
							:show-line="false"
							scroll-align="previous"
							color="#2b529f"
							un-color="#999999"
							:pt="typeTabsPt"
							@change="onTypeFilterChange"
						>
							<template #item="{ item, active }">
								<view class="st-type-tab-inner">
									<text
										class="st-type-text"
										:class="{ 'st-type-text--active': active }"
									>{{ item.label }}</text>
									<view v-if="active" class="st-type-line"></view>
								</view>
							</template>
						</cl-tabs>
					</view>
				</view>
			</view>

			<scroll-view
				class="st-scroll"
				scroll-y="true"
				:show-scrollbar="false"
				:scroll-top="scrollViewTop"
				:scroll-with-animation="true"
				:lower-threshold="120"
				@scroll="onScroll"
				@scrolltolower="onTaskScrollToLower"
			>
				<view class="st-scroll-inner">
					<view v-if="taskLoading && taskRows.length == 0" class="st-task-state">
						<cl-loading :loading="true"></cl-loading>
					</view>
					<view v-else-if="!taskLoading && taskRows.length == 0" class="st-task-state">
						<text class="st-task-state-text">暂无任务</text>
					</view>

					<view v-else class="st-task-grid" :class="{ 'st-task-grid--list': taskLayout == 'list' }">
						<view
							class="st-task-card"
							v-for="(item, index) in taskRows"
							:key="item.id"
						>
							<view class="st-task-head" @tap="onTaskDetail(item)">
								<view class="st-task-copy">
									<text class="st-task-title">{{ item.title }}</text>
									<text class="st-task-date">更新 {{ formatTaskUpdateDate(`${item.update_time ?? ""}`) }}</text>
								</view>
								<image
									v-if="getTaskLogoUrl(item) != ''"
									class="st-task-logo"
									:src="getTaskLogoUrl(item)"
									mode="aspectFill"
								></image>
								<view v-else class="st-task-icon" :style="{ backgroundColor: getTaskIconPalette(index).bg }">
									<text class="st-task-icon-text" :style="{ color: getTaskIconPalette(index).color }">{{ getTaskIconText(`${item.title ?? ""}`) }}</text>
								</view>
							</view>
							<view class="st-task-actions">
								<view class="st-task-btn st-task-btn--light" @tap="onParticipateTask(item)">
									<text class="st-task-btn-text st-task-btn-text--primary">参与任务</text>
								</view>
								<view class="st-task-btn st-task-btn--primary" v-if="item.category_id != 6 && item.category_id != 5" @tap="onBackfill(item)">
									<text class="st-task-btn-text st-task-btn-text--white">立即回填</text>
								</view>
							</view>
						</view>
					</view>

					<view v-if="taskRows.length > 0" class="st-task-loadmore" @tap="onTaskLoadMoreTap">
						<cl-loadmore
							:loading="taskLoadingMore"
							:finish="!taskHasMore"
							finish-text="没有更多了"
							loading-text="加载中..."
						></cl-loadmore>
					</view>

					<view class="st-footer">
						<view
							v-if="enterpriseName != '' || enterpriseFooterLine != ''"
							class="st-footer-banner"
						>
							<view class="st-footer-brand-row">
								<view class="st-footer-brand-inner">
									<image
										v-if="enterpriseLogo != ''"
										class="st-footer-logo-img"
										:src="enterpriseLogo"
										mode="aspectFill"
									></image>
									<view v-else class="st-footer-logo">
										<text class="st-footer-logo-text">{{ enterpriseLogoText }}</text>
									</view>
									<text class="st-footer-name">{{ enterpriseName }}</text>
								</view>
							</view>
							<text v-if="enterpriseFooterLine != ''" class="st-footer-line">{{ enterpriseFooterLine }}</text>
						</view>

					</view>
				</view>
			</scroll-view>
		</view>

		<cl-back-top :top="scrollTop" @back-top="onBackTop"></cl-back-top>
		<custom-tabbar></custom-tabbar>

		<cl-popup
			v-model="taskPreviewVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:mask-closable="true"
			:swipe-close="true"
			:pt="{ className: 'st-task-preview-wrap' }"
		>
			<view v-if="previewTask != null" class="st-task-preview">
				<view class="st-preview-handle"></view>
				<view class="st-preview-head">
					<image v-if="previewLogo != ''" class="st-preview-logo" :src="previewLogo" mode="aspectFill"></image>
					<view v-else class="st-preview-logo st-preview-logo--text"><text>{{ getTaskIconText(`${previewTask?.title ?? ''}`) }}</text></view>
					<view class="st-preview-copy">
						<text class="st-preview-title">{{ previewTask?.title ?? "任务详情" }}</text>
						<text class="st-preview-meta">{{ previewTask?.category_text ?? previewTask?.type_text ?? "项目任务" }} · 更新 {{ formatTaskUpdateDate(`${previewTask?.update_time ?? ''}`) }}</text>
					</view>
					<view class="st-preview-close" @tap="closeTaskPreview"><cl-icon name="close-line" :size="20" color="#7f8798"></cl-icon></view>
				</view>

				<view class="st-preview-guide">
					<view class="st-preview-guide-icon"><cl-icon name="file-list-3-line" :size="20" color="#5375ed"></cl-icon></view>
					<view class="st-preview-guide-copy"><text class="st-preview-guide-title">参与说明</text><text class="st-preview-guide-text">确认项目后进入提词表单，完成内容即可提交参与。</text></view>
				</view>

				<project-whitelist
					v-if="previewNeedsWhitelist"
					:task-id="previewTaskId"
					:project-id="previewProjectId"
				></project-whitelist>

				<view class="st-preview-actions">
					<view class="st-preview-btn st-preview-btn--light" @tap="openPreviewRecords"><text>参与记录</text></view>
					<view class="st-preview-btn st-preview-btn--primary" @tap="continuePreviewTask"><text>{{ previewNeedsWhitelist ? "继续参与" : "立即参与" }}</text></view>
				</view>
			</view>
		</cl-popup>

		<cl-popup
			v-model="resignedNoticeVisible"
			direction="center"
			size="560rpx"
			:show-header="false"
			:show-close="false"
			:mask-closable="false"
			:swipe-close="false"
			:pt="{ className: 'st-resigned-popup-wrap' }"
		>
			<view class="st-resigned-popup">
				<text class="st-resigned-title">提示</text>
				<text class="st-resigned-content">{{ RESIGNED_STATUS_NOTICE }}</text>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="ts" setup>
	import { computed, nextTick, ref } from "vue";
	import { getEnterpriseInfo } from "@/.cool/api/enterprise";
	import { getUserProfile } from "@/.cool/api/login";
	import { getAppSystem } from "@/.cool/api/app";
	import { getProjectTypes } from "@/.cool/api/project";
	import { getTaskList } from "@/.cool/api/task";
	import { getApiMessage, isApiSuccess, router } from "@/.cool";
	import {
		isResignedEmployeeState,
		parseAppSystemRouteState,
		RESIGNED_STATUS_NOTICE
	} from "@/.cool/navigation/appSystemNavigation";
	import type { EnterpriseInfo, Response, TaskListItem } from "@/.cool";
	import type { ProjectTypeItem } from "@/.cool/types/project";
	import type { TaskListParams } from "@/.cool/types/task";
	import type { ClTabsItem } from "@/uni_modules/cool-ui/types/index";
	import CustomTabbar from "@/components/tabbar.uvue";
	import ProjectWhitelist from "@/components/task/project-whitelist.uvue";
	import { syncTabbarRoutePath } from "@/.cool/store/tabbar";

	const taskLayout = ref("grid");
	try { if (uni.getStorageSync("employee-task-layout") == "list") taskLayout.value = "list"; } catch (_) {}
	function setTaskLayout(value: string) {
		taskLayout.value = value;
		try { uni.setStorageSync("employee-task-layout", value); } catch (_) {}
	}
	function openTutorial() { router.push({ path: "/pages/user/tutorial" }); }
	const TASK_PAGE_LIMIT = 20;
	const TYPE_FILTER_ALL_ID = 0;
	const TASK_ICON_PALETTE = [
		{ bg: "#ecfdf5", color: "#16a34a" },
		{ bg: "#1a1a1a", color: "#ffffff" },
		{ bg: "#eff6ff", color: "#2563eb" },
		{ bg: "#fef2f2", color: "#ef4444" },
		{ bg: "#f5f3ff", color: "#7c3aed" }
	];

	type TypeFilterItem = {
		id: number;
		label: string;
	};

	const typeFilters = ref<TypeFilterItem[]>([{ id: TYPE_FILTER_ALL_ID, label: "全部" }]);
	const activeTypeId = ref<number>(TYPE_FILTER_ALL_ID);
	const typesLoaded = ref<boolean>(false);
	const typesLoading = ref<boolean>(false);

	const typeFilterTabList = computed((): ClTabsItem[] => {
		return typeFilters.value.map((item) => {
			return {
				label: item.label,
				value: item.id
			} as ClTabsItem;
		});
	});

	const typeTabsPt = {
		className: "st-type-cl-tabs",
		item: {
			className: "st-type-cl-tabs-item"
		}
	};

	const taskRows = ref<TaskListItem[]>([]);
	const taskPreviewVisible = ref(false);
	const previewTask = ref<TaskListItem | null>(null);
	const previewTaskId = computed((): number => previewTask.value?.id ?? 0);
	const previewProjectId = computed((): number => previewTask.value?.project_id ?? 0);
	const previewLogo = computed((): string => {
		const item = previewTask.value;
		return item == null ? "" : getTaskLogoUrl(item);
	});
	const previewNeedsWhitelist = computed((): boolean => {
		const item = previewTask.value;
		if (item == null) return false;
		return `${item.category_text ?? item.type_text ?? ""}`.indexOf("品牌应用") >= 0;
	});
	const promptToolsEnabled = ref(true);
	const composeEntryTask = computed((): TaskListItem | null => {
		for (let i = 0; i < taskRows.value.length; i++) {
			const item = taskRows.value[i];
			if (`${item.item_type ?? ""}`.toLowerCase() == "compose" || `${item.id ?? ""}` == "900001") return item;
		}
		return null;
	});
	function openComposePrompt() {
		const item = composeEntryTask.value;
		router.push({ path: "/pages/task/combo-prompt", query: { id: item?.id ?? 900001, title: item?.title ?? "组合提词" } });
	}
	function openQuickPrompt() {
		const item = composeEntryTask.value;
		router.push({ path: "/pages/task/prompt-record", query: { id: item?.id ?? 900001, title: item?.title ?? "快捷提词" } });
	}
	function loadPromptPermission() {
		getUserProfile().then((res) => {
			if (res == null) return;
			const envelope = res as UTSJSONObject;
			const data = (envelope["data"] ?? envelope) as UTSJSONObject;
			const staff = data["staff"] as UTSJSONObject | null;
			const nickname = `${data["nickname"] ?? data["nick_name"] ?? data["username"] ?? ""}`.trim();
			const userId = `${data["sn"] ?? data["user_sn"] ?? data["user_id"] ?? data["id"] ?? ""}`.trim();
			employeeNickname.value = nickname != "" ? nickname : "未命名员工";
			employeeUserId.value = userId != "" ? userId : "--";
			const raw = data["can_quick_prompt"] ?? data["quick_prompt_enabled"] ?? staff?.["can_quick_prompt"] ?? staff?.["quick_prompt_enabled"];
			if (raw != null) promptToolsEnabled.value = raw === true || `${raw}` == "1";
		}).catch(() => {});
	}
	const taskLoading = ref(false);
	const taskLoadingMore = ref(false);
	const taskPage = ref(1);
	const taskHasMore = ref(true);
	const taskListRequestId = ref(0);

	const enterpriseName = ref("工作室");
	const enterpriseIntro = ref("");
	const enterpriseLogo = ref("");
	const enterpriseLogoText = ref("企");
	const enterpriseFooterLine = ref("");
	const employeeNickname = ref("未命名员工");
	const employeeUserId = ref("--");
	const employeeAvatarText = computed((): string => {
		const name = employeeNickname.value.trim();
		return name != "" && name != "未命名员工" ? name.substring(0, 1) : "员";
	});
	const enterpriseInfoLoading = ref(false);
	const resignedNoticeVisible = ref(false);

	const scrollTop = ref(0);
	const scrollViewTop = ref(0);

	function onScroll(e: UniScrollEvent) {
		scrollTop.value = Math.floor(e.detail.scrollTop);
	}

	function onBackTop() {
		scrollViewTop.value = 0.01;
		nextTick(() => {
			scrollViewTop.value = 0;
		});
	}

	function getEnterpriseLogoText(name: string): string {
		const text = name.trim();
		if (text == "") {
			return "企";
		}
		return text.substring(0, 1);
	}

	function parseEnterpriseInfo(res: any | null): EnterpriseInfo | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (data == null) {
			return null;
		}
		return data as EnterpriseInfo;
	}

	function applyEnterpriseInfo(info: EnterpriseInfo) {
		const name = `${info.name ?? ""}`.trim();
		const intro = `${info.intro ?? ""}`.trim();
		const logo = `${info.logo ?? ""}`.trim();
		enterpriseName.value = name != "" ? name : "工作室";
		enterpriseIntro.value = intro;
		enterpriseLogo.value = logo;
		enterpriseLogoText.value = getEnterpriseLogoText(enterpriseName.value);
		enterpriseFooterLine.value = intro;
	}

	function loadEnterpriseInfo() {
		if (enterpriseInfoLoading.value) {
			return;
		}
		enterpriseInfoLoading.value = true;
		getEnterpriseInfo()
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const info = parseEnterpriseInfo(res);
				if (info == null) {
					return;
				}
				applyEnterpriseInfo(info);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
			})
			.finally(() => {
				enterpriseInfoLoading.value = false;
			});
	}

	function formatTaskUpdateDate(raw: string): string {
		const text = `${raw}`.trim();
		if (text == "") {
			return "--";
		}
		const spaceIdx = text.indexOf(" ");
		const datePart = spaceIdx >= 0 ? text.substring(0, spaceIdx) : text;
		const parts = datePart.split("-");
		if (parts.length >= 3) {
			return `${parts[1]}-${parts[2]}`;
		}
		return datePart;
	}

	function getTaskIconText(title: string): string {
		const text = title.trim();
		if (text == "") {
			return "任";
		}
		return text.substring(0, 1);
	}

	function getTaskLogoUrl(item: TaskListItem): string {
		return `${item.logo_url ?? item.logo ?? ""}`.trim();
	}

	function getTaskIconPalette(index: number) {
		return TASK_ICON_PALETTE[index % TASK_ICON_PALETTE.length];
	}

	function mapTaskRow(item: TaskListItem): TaskListItem {
		return item;
	}

	function parseTaskListPayload(res: any | null): { list: TaskListItem[]; count: number } {
		if (res == null) {
			return { list: [], count: 0 };
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return { list: data as TaskListItem[], count: data.length };
		}
		const obj = data as UTSJSONObject;
		const list = obj["list"];
		const rawList =
			list != null && Array.isArray(list) ? (list as TaskListItem[]) : ([] as TaskListItem[]);
		const countVal = obj["count"] ?? obj["total"] ?? obj["total_count"];
		let count = 0;
		if (countVal != null) {
			const n = parseInt(`${countVal}`);
			count = isNaN(n) ? 0 : n;
		}
		return { list: rawList, count };
	}

	function parseProjectTypeList(res: any | null): TypeFilterItem[] {
		const items: TypeFilterItem[] = [{ id: TYPE_FILTER_ALL_ID, label: "全部" }];
		if (res == null) {
			return items;
		}
		const envelope = res as UTSJSONObject;
		const code = envelope["code"];
		if (code != null && !isApiSuccess(code)) {
			return items;
		}
		const data = envelope["data"] ?? envelope;
		if (!Array.isArray(data)) {
			return items;
		}
		const rows = data as ProjectTypeItem[];
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i];
			const idVal = row.id ?? 0;
			const id = typeof idVal == "number" ? (idVal as number) : parseInt(`${idVal}`);
			if (isNaN(id) || id <= 0) {
				continue;
			}
			const labelRaw = row.label ?? row.title ?? "";
			const label = `${labelRaw}`.trim();
			if (label == "") {
				continue;
			}
			items.push({ id: id, label: label });
		}
		return items;
	}

	function loadProjectTypes(andLoadTasks: boolean = true) {
		if (typesLoading.value) {
			return;
		}
		if (typesLoaded.value) {
			if (andLoadTasks) {
				loadTaskList(false);
			}
			return;
		}
		typesLoading.value = true;
		getProjectTypes()
			.then((res) => {
				typeFilters.value = parseProjectTypeList(res);
				typesLoaded.value = true;
				if (activeTypeId.value != TYPE_FILTER_ALL_ID) {
					const exists = typeFilters.value.find((item) => item.id == activeTypeId.value);
					if (exists == null) {
						activeTypeId.value = TYPE_FILTER_ALL_ID;
					}
				}
				if (andLoadTasks) {
					loadTaskList(false);
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载分类失败"), icon: "none" });
				if (andLoadTasks) {
					loadTaskList(false);
				}
			})
			.finally(() => {
				typesLoading.value = false;
			});
	}

	function resolveTypeId(value: string | number | null | undefined): number {
		if (value == null) {
			return activeTypeId.value;
		}
		if (typeof value == "number") {
			return value as number;
		}
		const n = parseInt(`${value}`);
		return isNaN(n) ? activeTypeId.value : n;
	}

	function onTypeFilterChange(value: string | number) {
		loadTaskList(false, resolveTypeId(value));
	}

	function updateTaskHasMore(rawListLength: number, count: number, currentPage: number) {
		if (count > 0) {
			taskHasMore.value = currentPage * TASK_PAGE_LIMIT < count;
			return;
		}
		taskHasMore.value = rawListLength >= TASK_PAGE_LIMIT;
	}

	function loadTaskList(more: boolean = false, categoryId?: number) {
		const targetCategoryId = categoryId ?? activeTypeId.value;

		if (more) {
			if (taskLoadingMore.value || !taskHasMore.value || taskLoading.value) {
				return;
			}
			taskLoadingMore.value = true;
			const requestId = taskListRequestId.value;
			const requestPage = taskPage.value + 1;
			const listParams: TaskListParams = {
				page: requestPage,
				limit: TASK_PAGE_LIMIT
			};
			if (targetCategoryId > 0) {
				listParams.category_id = targetCategoryId;
			}
			getTaskList(listParams)
				.then((res) => {
					if (requestId != taskListRequestId.value) {
						return;
					}
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
						return;
					}
					const payload = parseTaskListPayload(res);
					const rows = payload.list.map((item) => mapTaskRow(item));
					taskRows.value = taskRows.value.concat(rows);
					taskPage.value = requestPage;
					updateTaskHasMore(payload.list.length, payload.count, requestPage);
				})
				.catch((err) => {
					if (requestId != taskListRequestId.value) {
						return;
					}
					const res = err as Response;
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
				})
				.finally(() => {
					if (requestId != taskListRequestId.value) {
						return;
					}
					taskLoadingMore.value = false;
				});
			return;
		}

		const requestId = taskListRequestId.value + 1;
		taskListRequestId.value = requestId;
		taskLoading.value = true;
		taskLoadingMore.value = false;
		taskRows.value = [];
		taskPage.value = 1;
		taskHasMore.value = true;

		const requestPage = 1;
		const listParams: TaskListParams = {
			page: requestPage,
			limit: TASK_PAGE_LIMIT
		};
		if (targetCategoryId > 0) {
			listParams.category_id = targetCategoryId;
		}
		getTaskList(listParams)
			.then((res) => {
				if (requestId != taskListRequestId.value) {
					return;
				}
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const payload = parseTaskListPayload(res);
				const rows = payload.list.map((item) => mapTaskRow(item));
				if (more) {
					taskRows.value = taskRows.value.concat(rows);
				} else {
					taskRows.value = rows;
				}
				taskPage.value = requestPage;
				updateTaskHasMore(payload.list.length, payload.count, requestPage);
			})
			.catch((err) => {
				if (requestId != taskListRequestId.value) {
					return;
				}
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
			})
			.finally(() => {
				if (requestId != taskListRequestId.value) {
					return;
				}
				taskLoading.value = false;
			});
	}

	function loadMoreTaskList() {
		loadTaskList(true);
	}

	function onTaskScrollToLower() {
		if (!taskHasMore.value || taskLoadingMore.value || taskLoading.value) {
			return;
		}
		loadMoreTaskList();
	}

	function onTaskLoadMoreTap() {
		if (!taskHasMore.value || taskLoadingMore.value || taskLoading.value) {
			return;
		}
		loadMoreTaskList();
	}

	function onTaskDetail(item: TaskListItem) {
		const query: UTSJSONObject = {
			id: `${item.id}`,
			title: item.title ?? "",
			category_id: item.category_id,
			category_text: item.category_text ?? item.type_text ?? "",
			logo: getTaskLogoUrl(item)
		};
		if (item.project_id != null && item.project_id > 0) {
			query.project_id = item.project_id;
		}
		const cid = item.category_id ?? 0;
		router.push({
			path: cid == 5 || cid == 6 ? "/pages/task/novel-detail" : "/pages/task/detail",
			query: query
		});
	}

	function onParticipateTask(item: TaskListItem) {
		previewTask.value = item;
		taskPreviewVisible.value = true;
	}

	function closeTaskPreview() {
		taskPreviewVisible.value = false;
	}

	function openPreviewRecords() {
		const item = previewTask.value;
		if (item == null) return;
		closeTaskPreview();
		const query: UTSJSONObject = {
			id: item.id ?? 0,
			title: item.title ?? "",
			logo: getTaskLogoUrl(item),
			is_batch_back: item.is_batch_back ?? 0
		};
		router.push({
			path: `${item.id ?? ""}` == "900001" ? "/pages/task/prompt-record" : "/pages/task/record-list",
			query: query
		});
	}

	function continuePreviewTask() {
		const item = previewTask.value;
		if (item == null) return;
		closeTaskPreview();
		const title = `${item.title ?? ""}`;
		const cid = item.category_id ?? 0;
		if (cid == 5 || cid == 6) {
			onTaskDetail(item);
			return;
		}
		if (`${item.id ?? ""}` == "900001") {
			openComposePrompt();
			return;
		}
		const isPromotionTask = title.indexOf("番茄") >= 0 || title.indexOf("红果") >= 0;
		const query: UTSJSONObject = {
			id: item.id,
			task_id: item.id,
			project_id: item.project_id ?? 0,
			category_id: item.category_id ?? 0,
			title: title,
			logo: getTaskLogoUrl(item)
		};
		router.push({
			path: isPromotionTask ? "/pages/task/promotion-content" : "/pages/task/form",
			query: query
		});
	}

	function onBackfill(item: TaskListItem) {
		const itemId = `${item.id ?? ""}`;
		if (itemId == "900001") {
			router.push({
				path: "/pages/task/prompt-record",
				query: {
					id: item.id,
					title: item.title ?? ""
				}
			});
			return;
		}
		const query: UTSJSONObject = {
			title: item.title ?? "",
			id: item.id,
			logo: getTaskLogoUrl(item),
			is_batch_back: item.is_batch_back
		};
		router.push({
			path: "/pages/task/record-list",
			query: query
		});
	}

	function onNotificationsTap() {
		router.push({ path: "/pages/notice/index", query: { audience: "employee" } });
	}

	function syncResignedNotice() {
		getAppSystem()
			.then((res) => {
				const state = parseAppSystemRouteState(res);
				resignedNoticeVisible.value = isResignedEmployeeState(state);
			})
			.catch(() => {
				resignedNoticeVisible.value = false;
			});
	}

	onShow(() => {
		syncTabbarRoutePath();
		syncResignedNotice();
		loadEnterpriseInfo();
		loadPromptPermission();
		loadProjectTypes(true);
	});
</script>

