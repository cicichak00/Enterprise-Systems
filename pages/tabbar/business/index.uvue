		if (permTab.value == "perm") {
			return permDetailLoading.value;
		}
		return projectLoading.value;
	});

	type ProjectTypeBulkState = {
		typeId: number;
		allEnabled: boolean;
	};

	const projectPermList = ref<ProjectPermItem[]>([]);
	/** 跨项目类型缓存已禁用的项目 ID，避免切换子 tab 后保存丢失 */
	const staffDisabledProjectIds = ref<number[]>([]);
	const projectTypeBulkStates = ref<ProjectTypeBulkState[]>([]);
	/** 用户手动切换过的项目，预加载时不覆盖其状态 */
	const staffDisabledTouchedIds = ref<number[]>([]);
	const staffDisabledPreloadRequestId = ref(0);
	const staffDisabledPreloading = ref(false);
	const staffDisabledPreloadPendingSave = ref(false);
	const projectLoading = ref(false);
	const projectLoadingMore = ref(false);
	const projectListRequestId = ref(0);
	const projectPage = ref(1);
	const projectTotal = ref(0);
	const projectHasMore = ref(true);
	const projectLimit = 30;
	const projectPermChanged = ref(false);

	const projectBulkAllEnabled = computed(() => {
		const list = projectPermList.value;
		if (list.length == 0) {
			return false;
		}
		for (let i = 0; i < list.length; i++) {
			if (!list[i].enabled) {
				return false;
			}
		}
		return true;
	});

	function onManagePermSwitchChange(e: UniSwitchChangeEvent) {
		managePermEnabled.value = e.detail.value;
	}

	function onIncomePermSwitchChange(e: UniSwitchChangeEvent) {
		incomePermEnabled.value = e.detail.value;
	}

	function getSplitRateFloor(): number {
		return 5;
	}

	function normalizeSplitRate(val: number): number {
		if (val > 0 && val < getSplitRateFloor()) {
			return getSplitRateFloor();
		}
		return val;
	}

	function syncSplitSlider(next: number, remount: boolean = false) {
		splitRate.value = next;
		splitSliderValue.value = next;
		if (remount) {
			permSliderKey.value = permSliderKey.value + 1;
		}
	}

	function applySplitRateFromSlider(val: number, remountOnClamp: boolean = false) {
		const normalized = normalizeSplitRate(val);
		syncSplitSlider(normalized, remountOnClamp && normalized != val);
	}

	function onSplitRateSliderChange(e: UniSliderChangeEvent) {
		applySplitRateFromSlider(e.detail.value, true);
	}

	function onSplitRateSliderChanging(e: UniSliderChangeEvent) {
		syncSplitSlider(normalizeSplitRate(e.detail.value), false);
	}

	function switchPermTab(tab: string) {
		if (permTab.value == tab) {
			return;
		}
		permTab.value = tab;
		if (tab == "project") {
			loadPermProjectTypes(projectPermList.value.length == 0);
		}
	}

	function getDefaultProjectTypeId(): number {
		const types = projectTypes.value;
		if (types.length > 0) {
			return types[0].id;
		}
		return 0;
	}

	function syncActiveProjectTypeId() {
		const types = projectTypes.value;
		if (types.length == 0) {
			activeProjectTypeId.value = 0;
			return;
		}
		const current = activeProjectTypeId.value;
		const exists = types.find((item) => item.id == current);
		if (exists == null) {
			activeProjectTypeId.value = types[0].id;
		}
	}

	function resetPermProjectTypeFilter() {
		activeProjectTypeId.value = getDefaultProjectTypeId();
	}

	function parsePermProjectTypeList(res: any | null): ProjectTypeFilterItem[] {
		const items: ProjectTypeFilterItem[] = [];
		if (res == null) {
			return items;
		}
		let data: any = res;
		if (!Array.isArray(res)) {
			const envelope = res as UTSJSONObject;
			const code = envelope["code"];
			if (code != null && !isApiSuccess(code)) {
				return items;
			}
			data = envelope["data"] ?? envelope;
		}
		if (!Array.isArray(data)) {
			return items;
		}
		const rows = data as ProjectTypeItem[];
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i];
			const idVal = row.id ?? 0;
			const id = typeof idVal == "number" ? (idVal as number) : parseInt(`${idVal}`);
			if (isNaN(id) || id <= 0) {
				continue;
			}
			const labelRaw = row.label ?? row.title ?? "";
			const label = `${labelRaw}`.trim();
			if (label == "") {
				continue;
			}
			const exists = items.find((item) => item.id == id);
			if (exists != null) {
				continue;
			}
			items.push({ id: id, label: label });
		}
		return items;
	}

	function loadPermProjectTypes(andLoadList: boolean = true) {
		if (andLoadList) {
			pendingPermProjectListLoad.value = true;
		}
		if (projectTypesLoading.value) {
			return;
		}
		if (projectTypesLoaded.value) {
			if (andLoadList) {
				pendingPermProjectListLoad.value = false;
				loadStaffProjectListByCategory();
			}
			return;
		}
		projectTypesLoading.value = true;
		getProjectTypes()
			.then((res) => {
				projectTypes.value = parsePermProjectTypeList(res);
				projectTypesLoaded.value = true;
				syncActiveProjectTypeId();
				if (pendingPermProjectListLoad.value && !projectLoading.value) {
					pendingPermProjectListLoad.value = false;
					loadStaffProjectListByCategory();
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载项目类型失败"), icon: "none" });
				if (pendingPermProjectListLoad.value && !projectLoading.value) {
					pendingPermProjectListLoad.value = false;
					loadStaffProjectListByCategory();
				}
			})
			.finally(() => {
				projectTypesLoading.value = false;
			});
	}

	function isStaffProjectDisabled(projectId: number): boolean {
		return staffDisabledProjectIds.value.indexOf(projectId) >= 0;
	}

	function setStaffProjectDisabled(projectId: number, disabled: boolean) {
		if (projectId <= 0) {
			return;
		}
		const ids = staffDisabledProjectIds.value.slice();
		const idx = ids.indexOf(projectId);
		if (disabled) {
			if (idx < 0) {
				ids.push(projectId);
			}
		} else if (idx >= 0) {
			ids.splice(idx, 1);
		}
		staffDisabledProjectIds.value = ids;
	}

	function syncListToStaffDisabledIds() {
		const ids = staffDisabledProjectIds.value.slice();
		const list = projectPermList.value;
		for (let i = 0; i < list.length; i++) {
			const item = list[i];
			if (item.id <= 0) {
				continue;
			}
			const idx = ids.indexOf(item.id);
			if (!item.enabled) {
				if (idx < 0) {
					ids.push(item.id);
				}
			} else if (idx >= 0) {
				ids.splice(idx, 1);
			}
		}
		staffDisabledProjectIds.value = ids;
	}

	function getProjectTypeBulkEnabled(typeId: number): boolean | null {
		const states = projectTypeBulkStates.value;
		for (let i = 0; i < states.length; i++) {
			if (states[i].typeId == typeId) {
				return states[i].allEnabled;
			}
		}
		return null;
	}

	function setProjectTypeBulkEnabled(typeId: number, allEnabled: boolean) {
		const states = projectTypeBulkStates.value.slice();
		let found = false;
		for (let i = 0; i < states.length; i++) {
			if (states[i].typeId == typeId) {
				states[i].allEnabled = allEnabled;
				found = true;
				break;
			}
		}
		if (!found) {
			states.push({ typeId: typeId, allEnabled: allEnabled });
		}
		projectTypeBulkStates.value = states;
	}

	function clearProjectTypeBulkEnabled(typeId: number) {
		const states = projectTypeBulkStates.value.slice();
		const next: ProjectTypeBulkState[] = [];
		for (let i = 0; i < states.length; i++) {
			if (states[i].typeId != typeId) {
				next.push(states[i]);
			}
		}
		projectTypeBulkStates.value = next;
	}

	function applyBulkStateToPermItems(items: ProjectPermItem[]) {
		const bulk = getProjectTypeBulkEnabled(activeProjectTypeId.value);
		if (bulk == null) {
			return;
		}
		for (let i = 0; i < items.length; i++) {
			items[i].enabled = bulk;
			setStaffProjectDisabled(items[i].id, !bulk);
		}
	}

	function refreshCurrentProjectPermEnabledState() {
		const list = projectPermList.value;
		if (list.length == 0) {
			return;
		}
		const bulk = getProjectTypeBulkEnabled(activeProjectTypeId.value);
		if (bulk != null) {
			for (let i = 0; i < list.length; i++) {
				list[i].enabled = bulk;
			}
			return;
		}
		for (let i = 0; i < list.length; i++) {
			list[i].enabled = !isStaffProjectDisabled(list[i].id);
		}
	}

	function onPermProjectTypeTabChange(value: string | number) {
		if (typeof value == "number") {
			loadStaffProjectListByCategory(value as number);
			return;
		}
		const n = parseInt(`${value}`);
		loadStaffProjectListByCategory(isNaN(n) ? activeProjectTypeId.value : n);
	}

	function loadStaffProjectListByCategory(categoryId: number = activeProjectTypeId.value) {
		activeProjectTypeId.value = categoryId;
		loadStaffProjectList(false);
	}

	function searchStaffProjectList() {
		loadStaffProjectList(false);
	}

	function getPermProjectCategoryId(): string {
		const typeId = activeProjectTypeId.value;
		if (typeId > 0) {
			return `${typeId}`;
		}
		return "";
	}

	function parseStaffProjectListPayload(res: any | null): { list: StaffProjectItem[]; count: number } {
		if (res == null) {
			return { list: [], count: 0 };
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return { list: data as StaffProjectItem[], count: data.length };
		}
		const obj = data as UTSJSONObject;
		const list = obj["list"];
		const rawList =
			list != null && Array.isArray(list) ? (list as StaffProjectItem[]) : ([] as StaffProjectItem[]);
		const countVal = obj["count"] ?? obj["total"] ?? obj["total_count"];
		let count = 0;
		if (countVal != null) {
			const n = parseInt(`${countVal}`);
			count = isNaN(n) ? 0 : n;
		}
		return { list: rawList, count };
	}

	function markStaffProjectTouched(projectId: number) {
		if (projectId <= 0) {
			return;
		}
		if (staffDisabledTouchedIds.value.indexOf(projectId) < 0) {
			staffDisabledTouchedIds.value = staffDisabledTouchedIds.value.concat([projectId]);
		}
	}

	function mergeCurrentProjectListToDisabledIds() {
		const ids = staffDisabledProjectIds.value.slice();
		const list = projectPermList.value;
		for (let i = 0; i < list.length; i++) {
			const projectId = list[i].id;
			if (projectId <= 0) {
				continue;
			}
			const idx = ids.indexOf(projectId);
			if (!list[i].enabled) {
				if (idx < 0) {
					ids.push(projectId);
				}
			} else if (idx >= 0) {
				ids.splice(idx, 1);
			}
		}
		staffDisabledProjectIds.value = ids;
	}

	function seedStaffDisabledFromApiItems(items: StaffProjectItem[]) {
		const ids = staffDisabledProjectIds.value.slice();
		const touched = staffDisabledTouchedIds.value;
		for (let i = 0; i < items.length; i++) {
			const item = items[i];
			const idVal = item.id ?? 0;
			const projectId = typeof idVal == "number" ? (idVal as number) : parseInt(`${idVal}`);
			if (isNaN(projectId) || projectId <= 0) {
				continue;
			}
			if (touched.indexOf(projectId) >= 0) {
				continue;
			}
			const idx = ids.indexOf(projectId);
			if ((item.status ?? 0) == 1) {
				if (idx >= 0) {
					ids.splice(idx, 1);
				}
			} else if (idx < 0) {
				ids.push(projectId);
			}
		}
		staffDisabledProjectIds.value = ids;
	}

	const staffDisabledPreloadLimit = 2000;

	function finishStaffDisabledPreload(requestId: number) {
		if (requestId != staffDisabledPreloadRequestId.value) {
			return;
		}
		staffDisabledPreloading.value = false;
		refreshCurrentProjectPermEnabledState();
		flushStaffDisabledPreloadPendingSave();
	}

	function flushStaffDisabledPreloadPendingSave() {
		if (staffDisabledPreloadPendingSave.value && !staffDisabledPreloading.value) {
			staffDisabledPreloadPendingSave.value = false;
			submitStaffProjectPermConfig();
		}
	}

	function preloadStaffDisabledByPage(staffId: number, page: number, requestId: number) {
		if (requestId != staffDisabledPreloadRequestId.value) {
			return;
		}
		getStaffProjectList({
			id: staffId,
			page: page,
			limit: staffDisabledPreloadLimit
		})
			.then((res) => {
				if (requestId != staffDisabledPreloadRequestId.value) {
					return;
				}
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					finishStaffDisabledPreload(requestId);
					return;
				}
				const payload = parseStaffProjectListPayload(res);
				seedStaffDisabledFromApiItems(payload.list);
				let hasMore = false;
				if (payload.count > 0) {
					hasMore = page * staffDisabledPreloadLimit < payload.count;
				} else {
					hasMore = payload.list.length >= staffDisabledPreloadLimit;
				}
				if (hasMore) {
					preloadStaffDisabledByPage(staffId, page + 1, requestId);
				} else {
					finishStaffDisabledPreload(requestId);
				}
			})
			.catch(() => {
				if (requestId != staffDisabledPreloadRequestId.value) {
					return;
				}
				finishStaffDisabledPreload(requestId);
			});
	}

	function preloadStaffDisabledProjectIds() {
		const staffId = currentStaffId.value;
		if (staffId <= 0) {
			staffDisabledPreloading.value = false;
			flushStaffDisabledPreloadPendingSave();
			return;
		}
		staffDisabledPreloading.value = true;
		const requestId = ++staffDisabledPreloadRequestId.value;
		preloadStaffDisabledByPage(staffId, 1, requestId);
	}

	function mapStaffProjectToPermItem(item: StaffProjectItem, index: number, baseIndex: number = 0): ProjectPermItem {
		const title = item.title ?? "";
		const logo = item.logo ?? "";
		const idVal = item.id ?? baseIndex + index;
		const projectId = typeof idVal == "number" ? (idVal as number) : parseInt(`${idVal}`);
		const safeId = isNaN(projectId) ? baseIndex + index : projectId;
		return {
			id: safeId,
			name: title,
			logo,
			icon: getAvatarText(title),
			iconBg: AVATAR_COLORS[(baseIndex + index) % AVATAR_COLORS.length],
			iconEmoji: false,
			enabled: !isStaffProjectDisabled(safeId)
		};
	}

	function updateProjectHasMore(rawListLength: number, count: number, page: number) {
		if (count > 0) {
			projectHasMore.value = page * projectLimit < count;
			return;
		}
		projectHasMore.value = rawListLength >= projectLimit;
	}

	function loadStaffProjectList(more: boolean = false) {
		const staffId = currentStaffId.value;
		if (staffId <= 0) {
			projectPermList.value = [];
			return;
		}
		if (more) {
			if (projectLoadingMore.value || projectLoading.value || !projectHasMore.value) {
				return;
			}
			projectLoadingMore.value = true;
		} else {
			syncListToStaffDisabledIds();
			mergeCurrentProjectListToDisabledIds();
			projectLoading.value = true;
			projectLoadingMore.value = false;
			projectPage.value = 1;
			projectHasMore.value = true;
			projectPermList.value = [];
		}

		const requestId = ++projectListRequestId.value;
		const requestPage = more ? projectPage.value + 1 : 1;
		getStaffProjectList({
			id: staffId,
			category_id: getPermProjectCategoryId(),
			keyword: projKeyword.value.trim(),
			page: requestPage,
			limit: projectLimit
		})
			.then((res) => {
				if (requestId != projectListRequestId.value) {
					return;
				}
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const payload = parseStaffProjectListPayload(res);
				seedStaffDisabledFromApiItems(payload.list);
				const mapped = payload.list.map((item, index) =>
					mapStaffProjectToPermItem(item, index, more ? projectPermList.value.length : 0)
				);
				applyBulkStateToPermItems(mapped);
				if (more) {
					projectPermList.value = projectPermList.value.concat(mapped);
				} else {
					projectPermList.value = mapped;
				}
				projectPage.value = requestPage;
				projectTotal.value = payload.count;
				updateProjectHasMore(payload.list.length, payload.count, requestPage);
			})
			.catch((err) => {
				if (requestId != projectListRequestId.value) {
					return;
				}
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
			})
			.finally(() => {
				if (requestId != projectListRequestId.value) {
					return;
				}
				projectLoading.value = false;
				projectLoadingMore.value = false;
			});
	}

	function loadMoreStaffProjectList() {
		loadStaffProjectList(true);
	}

	function onProjectPermSwitchChange(id: number, e: UniSwitchChangeEvent) {
		projectPermChanged.value = true;
		clearProjectTypeBulkEnabled(activeProjectTypeId.value);
		const enabled = e.detail.value;
		const list = projectPermList.value;
		for (let i = 0; i < list.length; i++) {
			if (list[i].id == id) {
				list[i].enabled = enabled;
				break;
			}
		}
		setStaffProjectDisabled(id, !enabled);
		markStaffProjectTouched(id);
	}

	function onProjectBulkSwitchChange(e: UniSwitchChangeEvent) {
		projectPermChanged.value = true;
		const enabled = e.detail.value;
		setProjectTypeBulkEnabled(activeProjectTypeId.value, enabled);
		const list = projectPermList.value;
		for (let i = 0; i < list.length; i++) {
			list[i].enabled = enabled;
			setStaffProjectDisabled(list[i].id, !enabled);
		}
	}

	function parseCommissionRate(rate: string | number | null): number {
		if (rate == null) {
			return 0;
		}
		const text = `${rate}`.replace("%", "").trim();
		const n = parseFloat(text);
		if (isNaN(n)) {
			return 0;
		}
		return Math.round(n);
	}

	function normalizeCustomRoleLabel(value: string): string {
		return value
			.replace(/[^\u3400-\u4DBF\u4E00-\u9FFF]/g, "")
			.slice(0, CUSTOM_ROLE_LABEL_MAX_LENGTH);
	}

	function onCustomRoleLabelInput(event: UniInputEvent): string {
		const next = normalizeCustomRoleLabel(`${event.detail.value}`);
		currentEmployeeCustomRoleLabel.value = next;
		return next;
	}

	function onEmployeeBatchRoleLabelInput(event: UniInputEvent): string {
		const next = normalizeCustomRoleLabel(`${event.detail.value}`);
		employeeBatchRoleLabel.value = next;
		return next;
	}

	function getCustomRoleLabelCache(staffId: number): string {
		if (staffId <= 0) {
			return "";
		}
		const value = uni.getStorageSync(`${CUSTOM_ROLE_LABEL_CACHE_PREFIX}${staffId}`);
		return normalizeCustomRoleLabel(value == null ? "" : `${value}`);
	}

	function saveCustomRoleLabelCache(staffId: number, value: string) {
		if (staffId <= 0) {
			return;
		}
		const key = `${CUSTOM_ROLE_LABEL_CACHE_PREFIX}${staffId}`;
		const label = normalizeCustomRoleLabel(value);
		if (label == "") {
			uni.removeStorageSync(key);
			return;
		}
		uni.setStorageSync(key, label);
	}

	function resolveCustomRoleLabel(item: StaffListItem, staffId: number): string {
		const remote = item.role_label_name ?? item.custom_role_label ?? item.role_display_name ?? "";
		const remoteLabel = normalizeCustomRoleLabel(`${remote}`);
		if (remoteLabel != "") {
			saveCustomRoleLabelCache(staffId, remoteLabel);
			return remoteLabel;
		}
		return getCustomRoleLabelCache(staffId);
	}

	function parseStaffDetail(res: any | null): StaffListItem | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (data == null) {
			return null;
		}
		return data as StaffListItem;
	}

	function applyStaffPermDetail(detail: StaffListItem) {
		const name = detail.nickname ?? "";
		if (name != "") {
			currentEmployeeName.value = name;
		}
		const detailRole = normalizeStaffRole(detail);
		currentEmployeeRoleText.value = resolveStaffRoleText(detail, detailRole);
		currentEmployeeCustomRoleLabel.value = resolveCustomRoleLabel(
			detail,
			detail.id ?? currentStaffId.value
		);
		if (detail.status != null) {
			managePermEnabled.value = detail.status == 1;
			initialManagePermEnabled.value = managePermEnabled.value;
		}
		currentEmployeePendingWithdrawalAmount.value = resolvePendingWithdrawalAmount(
			detail,
			currentEmployeePendingWithdrawalAmount.value
		);
		incomePermEnabled.value = (detail.can_view_revenue ?? 0) == 1;
		currentSettlementMethod.value = normalizeSettlementMethod(detail.settlement_method ?? "") || "online";
		initialSettlementMethod.value = currentSettlementMethod.value;
		const stats = detail.stats ?? null;
		const rateRaw = detail.commission_rate ?? (stats != null ? stats.commission_rate ?? null : null);
		const rate = parseCommissionRate(rateRaw);
		syncSplitSlider(normalizeSplitRate(rate), true);
		initialSplitRate.value = normalizeSplitRate(rate);
	}

	function loadStaffPermDetail(staffId: number) {
		if (staffId <= 0) {
			return;
		}
		permDetailLoading.value = true;
		getStaffDetail(staffId)
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const detail = parseStaffDetail(res);
				if (detail == null) {
					uni.showToast({ title: "员工信息为空", icon: "none" });
					return;
				}
				applyStaffPermDetail(detail);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
			})
			.finally(() => {
				permDetailLoading.value = false;
			});
	}

	function resetStaffProjectList() {
		staffDisabledPreloadRequestId.value = staffDisabledPreloadRequestId.value + 1;
		staffDisabledPreloading.value = false;
		staffDisabledPreloadPendingSave.value = false;
		projectPermList.value = [];
		staffDisabledProjectIds.value = [];
		projectTypeBulkStates.value = [];
		projectPermChanged.value = false;
		staffDisabledTouchedIds.value = [];
		projectPage.value = 1;
		projectTotal.value = 0;
		projectHasMore.value = true;
		projectLoading.value = false;
		projectLoadingMore.value = false;
		pendingPermProjectListLoad.value = false;
	}

	function parseAdvancedFlag(value: any | null): boolean {
		if (value === true) {
			return true;
		}
		return value != null && (`${value}` == "1" || `${value}`.toLowerCase() == "true");
	}

	function normalizeAdvancedRole(value: any | null): StaffAdvancedRole {
		const text = `${value ?? ""}`.toLowerCase();
		if (text == "leader" || text == "group_leader" || text == "1") {
			return "leader";
		}
		if (text == "member" || text == "group_member" || text == "2") {
			return "member";
		}
		return "normal";
	}

	function resetAdvancedManageSummary() {
		advancedManageEnabled.value = false;
		advancedManageLoading.value = false;
		advancedManageSaving.value = false;
		advancedManageRole.value = "normal";
		advancedManageLeaderId.value = 0;
		advancedManageLeaderName.value = "";
		advancedManagePersonalRate.value = 0;
		advancedManageTeamRate.value = 0;
		advancedManageCanViewSubordinate.value = false;
		advancedManageMemberIds.value = [];
		advancedManageMemberRows.value = [];
		advancedManageLeaderPersonalRate.value = 100;
		advancedCandidatePopupVisible.value = false;
		advancedCandidates.value = [];
		advancedCandidateSelectedIds.value = [];
	}

	function applyAdvancedManageDetail(data: StaffAdvancedDetail) {
		advancedManageEnabled.value = parseAdvancedFlag(data.advanced_enabled);
		advancedManageRole.value = advancedManageEnabled.value
			? normalizeAdvancedRole(data.role)
			: "normal";
		advancedManageLeaderId.value = data.leader_staff_id ?? 0;
		advancedManageLeaderName.value = data.leader_nickname ?? "";
		advancedManageLeaderPersonalRate.value = parseCommissionRate(data.leader_personal_commission_rate ?? 100);
		advancedManagePersonalRate.value = parseCommissionRate(data.personal_commission_rate ?? 0);
		advancedManageTeamRate.value = parseCommissionRate(data.team_commission_rate ?? 0);
		advancedManageCanViewSubordinate.value = parseAdvancedFlag(data.can_view_subordinate_data);
		const rows = mapGroupMembers(data as StaffListItem);
		advancedManageMemberRows.value = rows;
		advancedManageMemberIds.value = rows.map((item) => item.id);
		currentEmployeeRoleText.value = advancedManageRoleText.value;
	}

	function loadAdvancedManageSummary(staffId: number) {
		if (staffId <= 0) {
			return;
		}
		advancedManageLoading.value = true;
		getStaffAdvancedDetail(staffId)
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					return;
				}
				const obj = res as UTSJSONObject;
				applyAdvancedManageDetail((obj["data"] ?? obj) as StaffAdvancedDetail);
			})
			.catch(() => {})
			.finally(() => {
				advancedManageLoading.value = false;
			});
	}

	function openPermPopup(item: EmployeeCard | null) {
		// H5 的员工列表位于 scroll-view 内。先同步展示管理层，确保点击反馈
		// 不会被后续配置重置或接口请求阻断。
		permPopupVisible.value = true;
		closeRevenueRankPopup();
		cancelEmployeeBatchMode();
		permTab.value = "perm";
		projKeyword.value = "";
		resetPermProjectTypeFilter();
		resetStaffProjectList();
		resetAdvancedManageSummary();
		if (item == null) {
			currentStaffId.value = 0;
			currentEmployeeName.value = "";
			currentEmployeeRoleText.value = "普通员工";
			currentEmployeeCustomRoleLabel.value = "";
			managePermEnabled.value = false;
			initialManagePermEnabled.value = false;
			currentEmployeePendingWithdrawalAmount.value = 0;
			incomePermEnabled.value = false;
			currentSettlementMethod.value = "";
			initialSettlementMethod.value = "";
			syncSplitSlider(0, true);
			initialSplitRate.value = 0;
			return;
		}
		currentStaffId.value = item.id;
		currentEmployeeName.value = item.name;
		currentEmployeeRoleText.value = item.roleText;
		currentEmployeeCustomRoleLabel.value = item.customRoleLabel;
		managePermEnabled.value = item.enabled;
		initialManagePermEnabled.value = item.enabled;
		currentEmployeePendingWithdrawalAmount.value = item.pendingWithdrawalAmount;
		incomePermEnabled.value = item.canViewRevenue;
		currentSettlementMethod.value = item.settlementMethod;
		initialSettlementMethod.value = item.settlementMethod;
		syncSplitSlider(0, true);
		initialSplitRate.value = 0;
		loadStaffPermDetail(item.id);
		loadAdvancedManageSummary(item.id);
		loadPermProjectTypes(false);
		preloadStaffDisabledProjectIds();
	}

	function onAdvancedManageSwitchChange(event: UniSwitchChangeEvent) {
		const next = event.detail.value;
		if (!managePermEnabled.value) {
			advancedManageEnabled.value = false;
			uni.showToast({ title: "离职员工不可开启进阶管理", icon: "none" });
			return;
		}
		if (next) {
			advancedManageEnabled.value = true;
			return;
		}
		if (advancedManageRole.value == "leader" && advancedManageMemberIds.value.length > 0) {
			advancedManageEnabled.value = true;
			uni.showToast({ title: "请先解绑全部组员", icon: "none" });
			return;
		}
		advancedManageEnabled.value = true;
		uni.showModal({
			title: "关闭进阶管理",
			content: "关闭后员工恢复普通员工身份并解除层级关系，仅影响之后的新订单，历史订单不变。确认关闭吗？",
			confirmText: "确认关闭",
			success(res) {
				if (res.confirm) {
					advancedManageEnabled.value = false;
					advancedManageRole.value = "normal";
					advancedManageLeaderId.value = 0;
					advancedManageLeaderName.value = "";
					advancedManageLeaderPersonalRate.value = 100;
					advancedManageTeamRate.value = 0;
					advancedManageCanViewSubordinate.value = false;
					advancedManageMemberIds.value = [];
					advancedManageMemberRows.value = [];
				}
			}
		});
	}

	function selectInlineAdvancedRole(role: StaffAdvancedRole) {
		if (!advancedManageEnabled.value || !managePermEnabled.value || role == "normal") {
			return;
		}
		if (
			advancedManageRole.value == "leader" &&
			role == "member" &&
			advancedManageMemberIds.value.length > 0
		) {
			uni.showToast({ title: "请先解绑全部组员再切换身份", icon: "none" });
			return;
		}
		advancedManageRole.value = role;
		if (role == "leader") {
			advancedManageLeaderId.value = 0;
			advancedManageLeaderName.value = "";
			advancedManageLeaderPersonalRate.value = 100;
		} else {
			advancedManageTeamRate.value = 0;
			advancedManageCanViewSubordinate.value = false;
			advancedManageMemberIds.value = [];
			advancedManageMemberRows.value = [];
		}
	}

	function onInlinePersonalRateChange(event: UniSliderChangeEvent) {
		let next = parseCommissionRate(event.detail.value);
		if (advancedManageRole.value == "member" && next > advancedMemberPersonalRateMax.value) {
			next = advancedMemberPersonalRateMax.value;
			uni.showToast({ title: "组员分成不得高于所属小组长", icon: "none" });
		}
		advancedManagePersonalRate.value = next;
	}

	function onInlineTeamRateChange(event: UniSliderChangeEvent) {
		advancedManageTeamRate.value = parseCommissionRate(event.detail.value);
	}

	function onInlineSubordinatePermissionChange(event: UniSwitchChangeEvent) {
		advancedManageCanViewSubordinate.value = event.detail.value;
	}

	function parseInlineAdvancedCandidates(res: any | null): AdvancedCandidateRow[] {
		if (res == null) {
			return [];
		}
		const envelope = res as UTSJSONObject;
		const raw = envelope["data"] ?? envelope;
		let source: StaffAdvancedCandidate[] = [];
		if (Array.isArray(raw)) {
			source = raw as StaffAdvancedCandidate[];
		} else {
			const obj = raw as UTSJSONObject;
			const list = obj["list"];
			source = list != null && Array.isArray(list) ? list as StaffAdvancedCandidate[] : [];
		}
		const result: AdvancedCandidateRow[] = [];
		for (let i = 0; i < source.length; i++) {
			const item = source[i];
			const id = item.id ?? 0;
			if (id > 0 && (item.status == null || item.status == 1)) {
				const name = item.nickname ?? `员工${id}`;
				const personalRate = parseCommissionRate(item.personal_commission_rate ?? 100);
				result.push({
					id,
					name,
					meta: advancedCandidateType.value == "leader"
						? `在职小组长 · 个人分成 ${personalRate}%`
						: "在职 · 普通员工 · 未归属小组长",
					personalRate,
					disabled: false,
					disabledReason: ""
				});
			}
		}
		return result;
	}

	function mapCurrentAccountStaffCandidates(res: any | null): AdvancedCandidateRow[] {
		const payload = parseStaffListPayload(res);
		const source = payload.list;
		const result: AdvancedCandidateRow[] = [];
		for (let i = 0; i < source.length; i++) {
			const item = source[i];
			const id = item.id ?? 0;
			if (id <= 0) {
				continue;
			}
			const name = item.nickname ?? `员工${id}`;
			const status = item.status == null ? 1 : item.status;
			const role = normalizeStaffRole(item);
			const leaderIdRaw = item["leader_staff_id"];
			const leaderId = leaderIdRaw == null ? 0 : parseInt(`${leaderIdRaw}`);
			const isCurrentMember = advancedManageMemberIds.value.indexOf(id) >= 0;
			let disabled = false;
			let disabledReason = "";
			if (id == currentStaffId.value) {
				disabled = true;
				disabledReason = "当前员工本人不可关联";
			} else if (status != 1) {
				disabled = true;
				disabledReason = "离职员工不可关联";
			} else if (role == "leader") {
				disabled = true;
				disabledReason = "小组长不可作为组员关联";
			} else if (leaderId > 0 && !isCurrentMember) {
				disabled = true;
				disabledReason = "已归属其他小组长";
			} else if (role == "member" && !isCurrentMember) {
				disabled = true;
				disabledReason = leaderId > 0 ? "已归属其他小组长" : "当前身份为组员";
			}
			const sn = item.sn ?? "";
			result.push({
				id,
				name,
				meta: isCurrentMember
					? "当前已关联组员"
					: `在职 · ${role == "normal" ? "普通员工" : role == "leader" ? "小组长" : "组员"}${sn != "" ? " · " + sn : ""}`,
				personalRate: parseCommissionRate(item.commission_rate ?? 0),
				disabled,
				disabledReason
			});
		}
		return result;
	}

	function openInlineAdvancedCandidate(type: "member" | "leader") {
		if (!managePermEnabled.value || advancedCandidateLoading.value) {
			return;
		}
		if (type == "member" && advancedManageRole.value != "leader") {
			uni.showToast({ title: "请先将该员工设置为小组长", icon: "none" });
			return;
		}
		advancedCandidateType.value = type;
		advancedCandidates.value = [];
		advancedCandidateSelectedIds.value = type == "member" ? advancedManageMemberIds.value.slice() : [];
		advancedCandidatePopupVisible.value = true;
		advancedCandidateLoading.value = true;
		const request =
			type == "member"
				? getStaffList({ page: 1, limit: 999 })
				: getStaffAdvancedCandidates({ staff_id: currentStaffId.value, type });
		request
			.then((res) => {
				const rows =
					type == "member"
						? mapCurrentAccountStaffCandidates(res)
						: parseInlineAdvancedCandidates(res);
				if (type == "member") {
					const existing = advancedManageMemberRows.value;
					for (let i = 0; i < existing.length; i++) {
						let exists = false;
						for (let j = 0; j < rows.length; j++) {
							if (rows[j].id == existing[i].id) {
								exists = true;
								break;
							}
						}
						if (!exists) {
							rows.unshift({
								id: existing[i].id,
								name: existing[i].name,
								meta: "当前已关联组员",
								personalRate: 0,
								disabled: false,
								disabledReason: ""
							});
						}
					}
				}
				advancedCandidates.value = rows;
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err as Response, "候选员工加载失败"), icon: "none" });
			})
			.finally(() => {
				advancedCandidateLoading.value = false;
			});
	}

	function closeInlineAdvancedCandidate() {
		advancedCandidatePopupVisible.value = false;
		advancedCandidateSelectedIds.value = [];
	}

	function isInlineAdvancedCandidateSelected(id: number): boolean {
		if (advancedCandidateType.value == "leader") {
			return advancedManageLeaderId.value == id;
		}
		return advancedCandidateSelectedIds.value.indexOf(id) >= 0;
	}

	function selectInlineAdvancedCandidate(item: AdvancedCandidateRow) {
		if (item.disabled) {
			uni.showToast({ title: item.disabledReason, icon: "none" });
			return;
		}
		if (advancedCandidateType.value == "leader") {
			advancedManageLeaderId.value = item.id;
			advancedManageLeaderName.value = item.name;
			advancedManageLeaderPersonalRate.value = item.personalRate;
			if (advancedManagePersonalRate.value > item.personalRate) {
				advancedManagePersonalRate.value = item.personalRate;
			}
			closeInlineAdvancedCandidate();
			return;
		}
		const ids = advancedCandidateSelectedIds.value.slice();
		const index = ids.indexOf(item.id);
		if (index >= 0) {
			ids.splice(index, 1);
		} else {
			ids.push(item.id);
		}
		advancedCandidateSelectedIds.value = ids;
	}

	function toggleInlineAdvancedSelectAll() {
		if (advancedCandidateType.value != "member") {
			return;
		}
		const selectable = advancedSelectableIds.value;
		if (advancedSelectableAllSelected.value) {
			const current = advancedCandidateSelectedIds.value.slice();
			const result: number[] = [];
			for (let i = 0; i < current.length; i++) {
				if (selectable.indexOf(current[i]) < 0) {
					result.push(current[i]);
				}
			}
			advancedCandidateSelectedIds.value = result;
			return;
		}
		const selected = advancedCandidateSelectedIds.value.slice();
		for (let i = 0; i < selectable.length; i++) {
			if (selected.indexOf(selectable[i]) < 0) {
				selected.push(selectable[i]);
			}
		}
		advancedCandidateSelectedIds.value = selected;
	}

	function confirmInlineAdvancedMembers() {
		const ids = advancedCandidateSelectedIds.value.slice();
		const rows: UnbindMemberCard[] = [];
		const existing = advancedManageMemberRows.value;
		for (let i = 0; i < ids.length; i++) {
			let found: UnbindMemberCard | null = null;
			for (let j = 0; j < existing.length; j++) {
				if (existing[j].id == ids[i]) {
					found = existing[j];
					break;
				}
			}
			if (found == null) {
				for (let j = 0; j < advancedCandidates.value.length; j++) {
					const item = advancedCandidates.value[j];
					if (item.id == ids[i]) {
						found = { id: item.id, name: item.name, meta: item.meta };
						break;
					}
				}
			}
			if (found != null) {
				rows.push(found);
			}
		}
		advancedManageMemberIds.value = ids;
		advancedManageMemberRows.value = rows;
		closeInlineAdvancedCandidate();
	}

	function openUnbindPopup(item: EmployeeCard) {
		if (item.groupMembers.length == 0) {
			uni.showToast({ title: "暂无可解绑组员", icon: "none" });
			return;
		}
		closeRevenueRankPopup();
		cancelEmployeeBatchMode();
		unbindLeaderId.value = item.id;
		unbindLeaderName.value = item.name;
		unbindMembers.value = item.groupMembers.slice();
		unbindSelectedIds.value = [];
		unbindPopupVisible.value = true;
	}

	function closeUnbindPopup() {
		if (unbindSaving.value) {
			return;
		}
		unbindPopupVisible.value = false;
		unbindLeaderId.value = 0;
		unbindLeaderName.value = "";
		unbindMembers.value = [];
		unbindSelectedIds.value = [];
	}

	function isUnbindSelected(memberId: number): boolean {
		return unbindSelectedIds.value.indexOf(memberId) >= 0;
	}

	function toggleUnbindMember(memberId: number) {
		const ids = unbindSelectedIds.value.slice();
		const index = ids.indexOf(memberId);
		if (index >= 0) {
			ids.splice(index, 1);
		} else {
			ids.push(memberId);
		}
		unbindSelectedIds.value = ids;
	}

	function toggleUnbindSelectAll() {
		if (unbindAllSelected.value) {
			unbindSelectedIds.value = [];
			return;
		}
		const ids: number[] = [];
		const members = unbindMembers.value;
		for (let i = 0; i < members.length; i++) {
			ids.push(members[i].id);
		}
		unbindSelectedIds.value = ids;
	}

	function runUnbindMembers(memberIds: number[]) {
		if (unbindSaving.value || unbindLeaderId.value <= 0 || memberIds.length == 0) {
			return;
		}
		unbindSaving.value = true;
		unbindStaffGroupMembers({
			leader_staff_id: unbindLeaderId.value,
			member_ids: memberIds
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "解绑失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: "解绑成功", icon: "success" });
				unbindSaving.value = false;
				closeUnbindPopup();
				refreshStaffList(true);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err as Response, "解绑失败"), icon: "none" });
			})
			.finally(() => {
				unbindSaving.value = false;
			});
	}

	function confirmUnbindMembers(memberIds: number[]) {
		uni.showModal({
			title: "确认解绑",
			content: `解绑后将停止统计这些组员后续产生的团队订单，确认解绑 ${memberIds.length} 人吗？`,
			confirmText: "确认解绑",
			confirmColor: "#dc2626",
			success(res) {
				if (res.confirm) {
					runUnbindMembers(memberIds);
				}
			}
		});
	}

	function unbindSingleMember(memberId: number) {
		confirmUnbindMembers([memberId]);
	}

	function submitUnbindMembers() {
		if (unbindSelectedIds.value.length == 0 || unbindSaving.value) {
			return;
		}
		confirmUnbindMembers(unbindSelectedIds.value.slice());
	}

	function onPermCloseTap() {
		closePermPopup();
	}

	function closePermPopup(force: boolean = false) {
		if (!force && projectPermChanged.value) {
			uni.showModal({
				title: "提示",
				content: "项目权限配置尚未保存，确定要关闭吗？",
				confirmText: "确定",
				cancelText: "取消",
				success(res) {
					if (res.confirm) {
						projectPermChanged.value = false;
						permPopupVisible.value = false;
						employeeBatchProjectStaffIds.value = [];
					}
				}
			});
			return;
		}
		permPopupVisible.value = false;
		employeeBatchProjectStaffIds.value = [];
	}

	function syncEmployeeCardPerm(
		staffId: number,
		staffStatus: number,
		canViewRevenue: boolean,
		commissionRate: number,
		statusText: string = "",
		customRoleLabel: string | null = null
	) {
		const cards = employeeCards.value;
		const rateText = `${commissionRate}%`;
		const enabled = staffStatus == 1;
		const tagText = statusText != "" ? statusText : enabled ? "在职" : "离职";
		for (let i = 0; i < cards.length; i++) {
			if (cards[i].id == staffId) {
				cards[i].enabled = enabled;
				cards[i].statusText = tagText;
				cards[i].canViewRevenue = canViewRevenue;
				if (customRoleLabel != null) {
					cards[i].customRoleLabel = normalizeCustomRoleLabel(customRoleLabel);
					cards[i].displayRoleText = cards[i].customRoleLabel != ""
						? cards[i].customRoleLabel
						: cards[i].roleText;
				}
				const stats = cards[i].stats;
				let originalRevenue = 0;
				for (let j = 0; j < stats.length; j++) {
					if (stats[j].label == "推广收益") {
						originalRevenue = parseRevenueAmount(stats[j].value);
						break;
					}
				}
				for (let j = 0; j < stats.length; j++) {
					if (stats[j].label == "分成比例") {
						stats[j].value = rateText;
					} else if (stats[j].label == "企业主收益") {
						stats[j].value = `${formatRevenueAmount(originalRevenue * commissionRate / 100)}元`;
					} else if (stats[j].label == "员工收益") {
						stats[j].value = `${formatRevenueAmount(originalRevenue * (100 - commissionRate) / 100)}元`;
					}
				}
				break;
			}
		}
	}

	function collectDisabledProjectIds(): number[] {
		syncListToStaffDisabledIds();
		mergeCurrentProjectListToDisabledIds();
		return staffDisabledProjectIds.value.slice();
	}

	function saveStaffProjectPermConfig() {
		if (projectLoading.value) {
			return;
		}
		if (permSaving.value && !staffDisabledPreloadPendingSave.value) {
			return;
		}
		if (currentStaffId.value <= 0) {
			uni.showToast({ title: "请先选择员工", icon: "none" });
			return;
		}
		if (projectPermList.value.length == 0) {
			uni.showToast({ title: "暂无项目可保存", icon: "none" });
			return;
		}
		if (staffDisabledPreloading.value) {
			staffDisabledPreloadPendingSave.value = true;
			permSaving.value = true;
			return;
		}
		submitStaffProjectPermConfig();
	}

	function submitStaffProjectPermConfig() {
		if (currentStaffId.value <= 0) {
			permSaving.value = false;
			uni.showToast({ title: "请先选择员工", icon: "none" });
			return;
		}
		if (projectPermList.value.length == 0) {
			permSaving.value = false;
			uni.showToast({ title: "暂无项目可保存", icon: "none" });
			return;
		}

		if (employeeBatchProjectStaffIds.value.length > 0) {
			const ids = employeeBatchProjectStaffIds.value.slice();
			const disabledIds = collectDisabledProjectIds();
			confirmBatchStaffProjectConfig(ids, disabledIds);
			return;
		}

		const staffId = currentStaffId.value;
		permSaving.value = true;
		saveStaffProjectConfig({
			id: staffId,
			disabled_project_ids: collectDisabledProjectIds()
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "保存失败"), icon: "none" });
					return;
				}
				const msg = getApiMessage(envelope, "保存成功");
				uni.showToast({ title: msg, icon: "success" });
				projectPermChanged.value = false;
				loadStaffProjectList(false);
				closePermPopup(true);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "保存失败"), icon: "none" });
			})
			.finally(() => {
				permSaving.value = false;
				staffDisabledPreloadPendingSave.value = false;
			});
	}

	function submitStaffPermConfig() {
		const staffId = currentStaffId.value;
		const staffStatus = managePermEnabled.value ? 1 : 0;
		const canViewRevenue = incomePermEnabled.value;
		const commissionRate = splitRate.value;
		const pendingRecoveryAmount = currentEmployeePendingWithdrawalAmount.value;
		const customRoleLabel = normalizeCustomRoleLabel(currentEmployeeCustomRoleLabel.value);
		permSaving.value = true;
		saveStaffConfig({
			id: staffId,
			status: staffStatus,
			can_view_revenue: canViewRevenue,
			commission_rate: commissionRate,
			role_label_name: customRoleLabel
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "保存失败"), icon: "none" });
					return;
				}
				const detail = parseStaffDetail(res);
				if (detail != null) {
					applyStaffPermDetail(detail);
				}
				saveCustomRoleLabelCache(staffId, customRoleLabel);
				currentEmployeeCustomRoleLabel.value = customRoleLabel;
				const savedStatusText =
					detail != null && detail.status_text != null && `${detail.status_text}` != ""
						? `${detail.status_text}`
						: "";
				syncEmployeeCardPerm(
					staffId,
					staffStatus,
					canViewRevenue,
					commissionRate,
					savedStatusText,
					customRoleLabel
				);
				const msg = getApiMessage(
					envelope,
					staffStatus == 0
						? `离职成功，¥${formatRevenueAmount(pendingRecoveryAmount)} 已回收至企业主收益`
						: "配置成功"
				);
				initialManagePermEnabled.value = staffStatus == 1;
				if (staffStatus == 0) {
					currentEmployeePendingWithdrawalAmount.value = 0;
					const card = findEmployeeCard(staffId);
					if (card != null) {
						card.pendingWithdrawalAmount = 0;
					}
				}
				if (currentSettlementMethod.value != "" && currentSettlementMethod.value != initialSettlementMethod.value) {
					saveStaffSettlementMethod({ ids: [staffId], settlement_method: currentSettlementMethod.value as "offline" | "online" }).then((settlementRes) => {
						const settlementEnvelope = settlementRes as Response | null;
						if (settlementEnvelope != null && settlementEnvelope.code != null && !isApiSuccess(settlementEnvelope.code)) { uni.showToast({ title: getApiMessage(settlementEnvelope, "结算方式保存失败"), icon: "none" }); return; }
						const card = findEmployeeCard(staffId); if (card != null) { card.settlementMethod = currentSettlementMethod.value; card.settlementText = currentSettlementMethod.value == "online" ? "线上结算" : "线下结算"; }
						initialSettlementMethod.value = currentSettlementMethod.value;
						uni.showToast({ title: msg, icon: "success" }); closePermPopup(true);
					}).catch((err) => uni.showToast({ title: getApiMessage(err, "结算方式保存失败"), icon: "none" }));
				} else { uni.showToast({ title: msg, icon: "success" }); closePermPopup(true); }
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "保存失败"), icon: "none" });
			})
			.finally(() => {
				permSaving.value = false;
			});
	}

	function confirmBatchStaffProjectConfig(ids: number[], disabledIds: number[]) {
		const opened: string[] = [];
		const closed: string[] = [];
		const touched = staffDisabledTouchedIds.value;
		const list = projectPermList.value;
		for (let i = 0; i < list.length; i++) {
			if (touched.indexOf(list[i].id) < 0) continue;
			if (list[i].enabled) opened.push(list[i].name);
			else closed.push(list[i].name);
		}
		let content = `将对 ${ids.length} 名员工统一应用当前项目配置。`;
		if (opened.length > 0) content += `\n本次开启：${opened.join("、")}`;
		if (closed.length > 0) content += `\n本次关闭：${closed.join("、")}`;
		content += "\n确认后，所选员工将统一为当前配置；关闭的进行中项目将不可见。";
		uni.showModal({
			title: "确认批量配置？",
			content,
			confirmText: "确认执行",
			cancelText: "返回修改",
			success(res) {
				if (!res.confirm) return;
				permSaving.value = true;
				saveBatchStaffProjectConfig(ids, disabledIds, 0, 0);
			}
		});
	}

	function saveBatchStaffProjectConfig(ids: number[], disabledIds: number[], index: number, successCount: number) {
		if (index >= ids.length) {
			permSaving.value = false;
			staffDisabledPreloadPendingSave.value = false;
			projectPermChanged.value = false;
			employeeBatchProjectStaffIds.value = [];
			closePermPopup(true);
			uni.showToast({ title: `已完成 ${successCount} 名员工的项目配置`, icon: "success" });
			refreshStaffList();
			return;
		}
		saveStaffProjectConfig({ id: ids[index], disabled_project_ids: disabledIds })
			.then((res) => {
				const envelope = res as Response | null;
				const ok = envelope == null || envelope.code == null || isApiSuccess(envelope.code);
				saveBatchStaffProjectConfig(ids, disabledIds, index + 1, successCount + (ok ? 1 : 0));
			})
			.catch(() => {
				saveBatchStaffProjectConfig(ids, disabledIds, index + 1, successCount);
			});
	}

	function submitInlineAdvancedThenStaffConfig() {
		if (advancedManageEnabled.value && advancedManageRole.value == "normal") {
			uni.showToast({ title: "请先设置员工进阶角色", icon: "none" });
			return;
		}
		if (
			advancedManageEnabled.value &&
			advancedManageRole.value == "member" &&
			advancedManageLeaderId.value <= 0
		) {
			uni.showToast({ title: "请选择所属小组长", icon: "none" });
			return;
		}
		if (
			advancedManageEnabled.value &&
			advancedManageRole.value == "member" &&
			advancedManagePersonalRate.value > advancedMemberPersonalRateMax.value
		) {
			uni.showToast({ title: "组员分成不得高于所属小组长", icon: "none" });
			return;
		}
		permSaving.value = true;
		advancedManageSaving.value = true;
		let handedOffToRegularSave = false;
		saveStaffAdvancedConfig({
			id: currentStaffId.value,
			advanced_enabled: advancedManageEnabled.value,
			role: advancedManageEnabled.value ? advancedManageRole.value : "normal",
			leader_staff_id:
				advancedManageEnabled.value && advancedManageRole.value == "member"
					? advancedManageLeaderId.value
					: 0,
			personal_commission_rate: advancedManagePersonalRate.value,
			team_commission_rate:
				advancedManageEnabled.value && advancedManageRole.value == "leader"
					? advancedManageTeamRate.value
					: 0,
			can_view_subordinate_data:
				advancedManageEnabled.value &&
				advancedManageRole.value == "leader" &&
				advancedManageCanViewSubordinate.value,
			member_ids:
				advancedManageEnabled.value && advancedManageRole.value == "leader"
					? advancedManageMemberIds.value.slice()
					: []
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "进阶配置保存失败"), icon: "none" });
					return;
				}
				advancedManageSaving.value = false;
				permSaving.value = false;
				handedOffToRegularSave = true;
				submitStaffPermConfig();
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err as Response, "进阶配置保存失败"), icon: "none" });
			})
			.finally(() => {
				advancedManageSaving.value = false;
				if (!handedOffToRegularSave) {
					permSaving.value = false;
				}
			});
	}

	function continueSavePermConfig() {
		if (managePermEnabled.value && splitRate.value != initialSplitRate.value) {
			uni.showModal({
				title: "提示",
				content: "重新调整将影响该员工的出单比例和数据统计，请确认是否修改？",
				confirmText: "确认",
				cancelText: "取消",
				success(res) {
					if (res.confirm) {
						submitInlineAdvancedThenStaffConfig();
					}
				}
			});
			return;
		}
		submitInlineAdvancedThenStaffConfig();
	}

	function cancelDepartureConfirm() {
		departureConfirmVisible.value = false;
		managePermEnabled.value = true;
	}

	function confirmDepartureSave() {
		if (!departureConfirmVisible.value || permSaving.value) {
			return;
		}
		departureConfirmVisible.value = false;
		continueSavePermConfig();
	}

	function savePermConfig() {
		if (permSaving.value) {
			return;
		}
		if (currentStaffId.value <= 0) {
			uni.showToast({ title: "请先选择员工", icon: "none" });
			return;
		}
		if (permTab.value == "project") {
			saveStaffProjectPermConfig();
			return;
		}
		if (permDetailLoading.value || advancedManageLoading.value) {
			uni.showToast({ title: "员工配置读取中，请稍后再保存", icon: "none" });
			return;
		}
		if (splitRate.value > 0 && splitRate.value < 5) {
			uni.showToast({ title: "分成比例最小为 5%", icon: "none" });
			return;
		}

		if (initialManagePermEnabled.value && !managePermEnabled.value) {
			departureConfirmVisible.value = true;
			return;
		}
		if (splitRate.value > 0 && currentSettlementMethod.value == "") { uni.showToast({ title: "请先选择员工结算方式", icon: "none" }); return; }
		continueSavePermConfig();
	}

	function isApiSuccess(code: number | string | null | undefined): boolean {
		return code == 1 || code == "1" || code == 200 || code == "200";
	}

	function getApiMessage(res: Response | null, fallback: string): string {
		if (res == null) {
			return fallback;
		}
		const msg = res.msg ?? res.message ?? "";
		return msg != "" ? msg : fallback;
	}

	function pickStatValue(stats: StaffStats | null, key: string, fallback: string = "0"): string {
		if (stats == null) {
			return fallback;
		}
		const val = stats[key];
		if (val == null) {
			return fallback;
		}
		return `${val}`;
	}

	function pickStatNumber(stats: StaffStats | null, key: string): number {
		const text = pickStatValue(stats, key, "0");
		const num = parseInt(text);
		if (isNaN(num)) {
			return 0;
		}
		return num;
	}

	function pickStatNumberByKeys(stats: StaffStats | null, keys: string[]): number {
		if (stats == null) {
			return 0;
		}
		for (let i = 0; i < keys.length; i++) {
			const value = stats[keys[i]];
			if (value == null || `${value}`.trim() == "") {
				continue;
			}
			const num = parseInt(`${value}`);
			if (!isNaN(num)) {
				return num;
			}
		}
		return 0;
	}

	function formatTodayRise(today: number | string | null, unit: string = ""): string {
		const n = today != null ? `${today}` : "0";
		if (unit != "") {
			return `${n}${unit} 今日新增`;
		}
		return `${n} 今日新增`;
	}

	function parseRevenueAmount(raw: any | null): number {
		if (raw == null) {
			return 0;
		}
		const text = `${raw}`.replace("¥", "").replace("元", "").trim();
		const value = parseFloat(text);
		return isNaN(value) ? 0 : value;
	}

	function resolvePendingWithdrawalAmount(item: StaffListItem, fallback: number = 0): number {
		const stats = item.stats ?? null;
		const raw =
			item.pending_withdrawal_amount ??
			item.pending_withdraw_amount ??
			item.wallet_withdrawable ??
			item.withdrawable_amount ??
			item.withdrawable ??
			item.wait_withdraw_amount ??
			(stats != null ? stats.pending_withdrawal_amount ?? fallback : fallback);
		return Math.max(0, parseRevenueAmount(raw));
	}

	function formatRevenueAmount(value: number): string {
		return Math.max(0, value).toFixed(2);
	}

	function buildStaffStats(stats: StaffStats | null, rootCommissionRate: string | number | null = null): StatItem[] {
		const promoCount = pickStatNumberByKeys(stats, [
			"total_keyword_count",
			"keyword_count",
			"task_count",
			"promotion_task_count",
			"prompt_count"
		]);
		const promoToday = pickStatNumberByKeys(stats, [
			"total_keyword_count_today",
			"keyword_count_today",
			"task_count_today",
			"promotion_task_count_today",
			"prompt_count_today"
		]);
		const backfillCount = pickStatNumber(stats, "total_backfill_count");
		const backfillToday = pickStatNumber(stats, "total_backfill_count_today");
		const promoRevenue = pickStatValue(stats, "promo_revenue", "0");
		const promoRevenueToday = pickStatValue(stats, "promo_revenue_today", "0");
		let commission = pickStatValue(stats, "commission_rate", "0%");
		if (rootCommissionRate != null) {
			const text = `${rootCommissionRate}`.replace("%", "").trim();
			if (text != "") {
				commission = text;
			}
		}
		const commissionRate = parseCommissionRate(commission);
		const promoRevenueAmount = parseRevenueAmount(promoRevenue);
		const promoRevenueTodayAmount = parseRevenueAmount(promoRevenueToday);
		const enterpriseOwnerRevenue = promoRevenueAmount * commissionRate / 100;
		const enterpriseOwnerRevenueToday = promoRevenueTodayAmount * commissionRate / 100;
		const staffRevenue = promoRevenueAmount - enterpriseOwnerRevenue;
		const staffRevenueToday = promoRevenueTodayAmount - enterpriseOwnerRevenueToday;
		return [
			{
				label: "推广任务",
				value: `${promoCount}个`,
				rise: formatTodayRise(promoToday, "个")
			},
			{
				label: "累计回填",
				value: `${backfillCount}条`,
				rise: formatTodayRise(backfillToday, "条")
			},
			{
				label: "推广收益",
				value: `${promoRevenue}元`,
				rise: formatTodayRise(promoRevenueToday, "元")
			},
			{
				label: "员工收益",
				value: `${formatRevenueAmount(staffRevenue)}元`,
				rise: formatTodayRise(formatRevenueAmount(staffRevenueToday), "元")
			},
			{
				label: "企业主收益",
				value: `${formatRevenueAmount(enterpriseOwnerRevenue)}元`,
				rise: formatTodayRise(formatRevenueAmount(enterpriseOwnerRevenueToday), "元")
			},
			{
				label: "分成比例",
				value: commission.indexOf("%") >= 0 ? commission : `${commission}%`,
				rise: ""
			}
		];
	}

	function getAvatarText(name: string): string {
		const text = name.trim();
		if (text == "") {
			return "员";
		}
		return text.charAt(0);
	}

	function normalizeStaffRole(item: StaffListItem): string {
		const raw = `${item.staff_role ?? item.staff_type ?? item.role ?? ""}`.toLowerCase();
		const text = `${item.staff_role_text ?? item.staff_type_text ?? item.role_text ?? ""}`;
		if (
			raw == "member" ||
			raw == "group_member" ||
			raw == "2" ||
			text.indexOf("组员") >= 0 ||
			text.indexOf("成员") >= 0
		) {
			return "member";
		}
		if (raw == "leader" || raw == "group_leader" || raw == "1" || text.indexOf("组长") >= 0) {
			return "leader";
		}
		return "normal";
	}

	function resolveStaffRoleText(item: StaffListItem, roleKey: string): string {
		if (roleKey == "leader") {
			return "小组长";
		}
		if (roleKey == "member") {
			const leaderName = item.leader_nickname ?? item.leader_name ?? item.group_leader_name ?? "";
			return leaderName != "" ? formatMemberRoleLabel(leaderName) : "组员";
		}
		return "普通员工";
	}

	function formatMemberRoleLabel(leaderName: string): string {
		const name = leaderName.trim();
		if (name == "") {
			return "组员";
		}
		return name.endsWith("组长") ? `${name}-组员` : `${name}组长-组员`;
	}

	function mapGroupMembers(item: StaffListItem): UnbindMemberCard[] {
		const source = item.group_members ?? item.member_list ?? item.members ?? [];
		const result: UnbindMemberCard[] = [];
		for (let i = 0; i < source.length; i++) {
			const member = source[i] as StaffGroupMemberItem;
			const id = member.staff_id ?? member.id ?? 0;
			if (id <= 0) {
				continue;
			}
			const name = member.nickname ?? `员工${id}`;
			const sn = member.sn ?? "";
			const mobile = member.mobile ?? "";
			result.push({
				id,
				name,
				meta: sn != "" ? `协作ID: ${sn}` : (mobile != "" ? mobile : `员工ID: ${id}`)
			});
		}
		return result;
	}

	function normalizeSettlementMethod(value: any | null): StaffSettlementMethod {
		const method = `${value ?? ""}`.trim().toLowerCase();
		if (method == "offline" || method == "line_off" || method == "1") return "offline";
		if (method == "online" || method == "line_on" || method == "2") return "online";
		return "";
	}

	function formatStaffJoinTime(value: string | null | undefined): string {
		const text = `${value ?? ""}`.trim();
		if (text == "") return "--";
		return text.length >= 16 ? text.slice(0, 16) : text;
	}

	function mapStaffToCard(item: StaffListItem, index: number, baseIndex: number = 0): EmployeeCard {
		const name = item.nickname ?? "";
		const sn = item.sn ?? "";
		const status = item.status;
		const enabled = status == null || status == 1;
		const statusText = item.status_text ?? (enabled ? "在职" : "您当前状态已离职，如有疑问请联系前企业主");
		const roleKey = normalizeStaffRole(item);
		const roleText = resolveStaffRoleText(item, roleKey);
		const customRoleLabel = resolveCustomRoleLabel(item, item.id ?? index);
		const groupMembers = mapGroupMembers(item);
		const groupNames = item.group_nickname ?? item.group_name ?? item.team_name ?? "";
		const collabId = sn != "" ? sn : `${item.user_id ?? ""}`;
		const settlementMethod = normalizeSettlementMethod(item.settlement_method ?? "");
		return {
			id: item.id ?? index,
			avatar: getAvatarText(name),
			avatarUrl: item.avatar ?? "",
			color: AVATAR_COLORS[(baseIndex + index) % AVATAR_COLORS.length],
			name,
			enabled,
			statusText,
			collabId,
			joinTime: formatStaffJoinTime(item.join_time ?? item.create_time),
			settlementMethod,
			settlementText: settlementMethod == "online" ? "线上结算" : settlementMethod == "offline" ? "线下结算" : "待设置结算",
			canViewRevenue: (item.can_view_revenue ?? 0) == 1,
			commissionRate: parseCommissionRate(item.commission_rate ?? null),
			pendingWithdrawalAmount: resolvePendingWithdrawalAmount(item),
			byteProjectEnabled: Boolean(item.byte_project_enabled ?? item.has_byte_project ?? item.can_byte_task ?? item.byte_task_enabled ?? false),
			canQuickPrompt: Boolean(item.can_quick_prompt ?? item.quick_prompt_enabled ?? false),
			roleKey,
			roleText,
			customRoleLabel,
			displayRoleText: customRoleLabel != "" ? customRoleLabel : roleText,
			groupNames: groupNames != "" ? groupNames : (groupMembers.length > 0 ? `${groupMembers.length}名组员` : ""),
			groupMembers,
			stats: buildStaffStats(item.stats ?? null, item.commission_rate ?? null)
		};
	}

	function buildLocalPreviewEmployeeCards(): EmployeeCard[] {
		const previewRows = [
			{
				id: 91001,
				name: "陈晓敏",
				collabId: "202608060101",
				roleKey: "normal",
				roleText: "普通员工",
				commissionRate: 35,
				color: "#1f4d8f",
				groupNames: ""
			},
			{
				id: 91002,
				name: "周明远",
				collabId: "202608060102",
				roleKey: "leader",
				roleText: "小组长",
				commissionRate: 50,
				color: "#4668b1",
				groupNames: "增长一组"
			},
			{
				id: 91003,
				name: "林小满",
				collabId: "202608060103",
				roleKey: "member",
				roleText: "周明远组长-组员",
				commissionRate: 35,
				color: "#6b7ca8",
				groupNames: "增长一组"
			}
		];
		const cards: EmployeeCard[] = [];
		const keyword = employeeKeyword.value.trim().toLowerCase();
		const roleFilter = staffRoleOptions[staffRoleIndex.value].value;
		const statusFilter = staffStatusOptions[staffStatusIndex.value].value;
		for (let i = 0; i < previewRows.length; i++) {
			const row = previewRows[i];
			if (roleFilter != "" && roleFilter != row.roleKey) {
				continue;
			}
			if (statusFilter != "" && statusFilter != "1") {
				continue;
			}
			if (
				keyword != "" &&
				row.name.toLowerCase().indexOf(keyword) < 0 &&
				row.collabId.toLowerCase().indexOf(keyword) < 0
			) {
				continue;
			}
			const customRoleLabel = getCustomRoleLabelCache(row.id);
			cards.push({
				id: row.id,
				avatar: getAvatarText(row.name),
				avatarUrl: "",
				color: row.color,
				name: row.name,
				enabled: true,
				statusText: "在职",
				collabId: row.collabId,
				joinTime: `2026-08-${`${6 + i}`.padStart(2, "0")} 10:30`,
				settlementMethod: i == 2 ? "" : (i == 0 ? "online" : "offline"),
				settlementText: i == 2 ? "待设置结算" : (i == 0 ? "线上结算" : "线下结算"),
				canViewRevenue: true,
				commissionRate: row.commissionRate,
				pendingWithdrawalAmount: i == 0 ? 65 : i == 1 ? 40 : 39,
				byteProjectEnabled: i != 2,
				canQuickPrompt: false,
				roleKey: row.roleKey,
				roleText: row.roleText,
				customRoleLabel,
				displayRoleText: customRoleLabel != "" ? customRoleLabel : row.roleText,
				groupNames: row.groupNames,
				groupMembers: [],
				stats: [
					{ label: "推广任务", value: `${12 - i * 2}个`, rise: `${i + 1}个 今日新增` },
					{ label: "累计回填", value: `${8 - i}条`, rise: `${i}条 今日新增` },
					{ label: "推广收益", value: `${100 - i * 20}.00元`, rise: "0.00元 今日新增" },
					{ label: "员工收益", value: `${i == 0 ? "65.00" : i == 1 ? "40.00" : "39.00"}元`, rise: "0.00元 今日新增" },
					{ label: "企业主收益", value: `${i == 0 ? "35.00" : i == 1 ? "40.00" : "21.00"}元`, rise: "0.00元 今日新增" },
					{ label: "分成比例", value: `${row.commissionRate}%`, rise: "新订单即时生效" }
				]
			});
		}
		if (staffOrder.value == "asc") {
			cards.sort((a, b) => a.commissionRate - b.commissionRate);
		} else if (staffOrder.value == "desc") {
			cards.sort((a, b) => b.commissionRate - a.commissionRate);
		} else if (staffOrder.value == "join_desc") {
			cards.sort((a, b) => b.joinTime.localeCompare(a.joinTime));
		} else if (staffOrder.value == "join_asc") {
			cards.sort((a, b) => a.joinTime.localeCompare(b.joinTime));
		}
		return cards;
	}

	type StaffListPayload = {
		list: StaffListItem[];
		count: number;
		isVirtual: number;
	};

	function parseStaffListPayload(res: any | null): StaffListPayload {
		if (res == null) {
			return { list: [], count: 0, isVirtual: 0 };
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return { list: data as StaffListItem[], count: data.length, isVirtual: 0 };
		}
		const obj = data as UTSJSONObject;
		const list = obj["list"];
		const rawList =
			list != null && Array.isArray(list) ? (list as StaffListItem[]) : ([] as StaffListItem[]);
		const countVal = obj["count"] ?? obj["total"] ?? obj["total_count"];
		let count = 0;
		if (countVal != null) {
			const n = parseInt(`${countVal}`);
			count = isNaN(n) ? 0 : n;
		}
		const isVirtualVal = obj["is_virtual"];
		let isVirtual = 0;
		if (isVirtualVal != null) {
			const n = parseInt(`${isVirtualVal}`);
			isVirtual = isNaN(n) ? 0 : n;
		}
		return { list: rawList, count, isVirtual };
	}

	function updateStaffHasMore(rawListLength: number, count: number, page: number) {
		if (count > 0) {
			staffHasMore.value = page * staffLimit < count;
			return;
		}
		staffHasMore.value = rawListLength >= staffLimit;
	}

	function filterStaffList(list: StaffListItem[]): StaffListItem[] {
		const kw = employeeKeyword.value.trim().toLowerCase();
		return list.filter((item) => {
			const roleValue = staffRoleOptions[staffRoleIndex.value].value;
			if (roleValue != "" && normalizeStaffRole(item) != roleValue) {
				return false;
			}
			const statusValue = staffStatusOptions[staffStatusIndex.value].value;
			if (statusValue != "") {
				const itemStatus = item.status == null || item.status == 1 ? "1" : "0";
				if (itemStatus != statusValue) {
					return false;
				}
			}
			if (kw == "") {
				return true;
			}
			const name = (item.nickname ?? "").toLowerCase();
			const sn = (item.sn ?? "").toLowerCase();
			const mobile = (item.mobile ?? "").toLowerCase();
			return name.indexOf(kw) >= 0 || sn.indexOf(kw) >= 0 || mobile.indexOf(kw) >= 0;
		});
	}

	function loadStaffList(more: boolean = false, silent: boolean = false): Promise<void> {
		return new Promise((resolve) => {
			if (more) {
				if (staffLoadingMore.value) {
					resolve();
					return;
				}
			} else if (!silent && (staffLoading.value || staffLoadingMore.value)) {
				resolve();
				return;
			} else if (silent && staffLoadingMore.value) {
				resolve();
				return;
			}
			if (more) {
				if (!staffHasMore.value) {
					resolve();
					return;
				}
				staffLoadingMore.value = true;
			} else {
				if (!silent) {
					staffLoading.value = true;
					employeeCards.value = [];
				}
				staffPage.value = 1;
				staffHasMore.value = true;
			}

			const requestPage = more ? staffPage.value + 1 : 1;
			if (isLocalUiPreview()) {
				const previewCards = buildLocalPreviewEmployeeCards();
				employeeCards.value = previewCards;
				staffTotal.value = previewCards.length;
				staffIsVirtual.value = false;
				staffPage.value = 1;
				staffHasMore.value = false;
				staffLoading.value = false;
				staffLoadingMore.value = false;
				resolve();
				return;
			}
			const listParams: GetStaffListParams = {
				page: requestPage,
				limit: staffLimit
			};
			const kw = employeeKeyword.value.trim();
			if (kw != "") {
				listParams.keyword = kw;
			}
			const order = staffOrder.value.trim();
			if (order == "asc" || order == "desc" || order == "join_desc" || order == "join_asc") {
				listParams.order = order;
			}
			const role = staffRoleOptions[staffRoleIndex.value].value;
			if (role != "") {
				listParams.role = role;
			}
			const status = staffStatusOptions[staffStatusIndex.value].value;
			if (status != "") {
				listParams.status = parseInt(status);
			}
			getStaffList(listParams)
				.then((res) => {
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						showBusinessReadError(envelope, "加载失败");
						return;
					}
					const payload = parseStaffListPayload(res);
					if (!more) {
						staffIsVirtual.value = payload.isVirtual == 1;
					}
					if (payload.count > 0) {
						staffTotal.value = payload.count;
					}
					const filtered = filterStaffList(payload.list);
					const baseIndex = more ? employeeCards.value.length : 0;
					const cards = filtered.map((item, index) => mapStaffToCard(item, index, baseIndex));
				if (more) {
					employeeCards.value = employeeCards.value.concat(cards);
				} else {
					employeeCards.value = cards;
				}
					staffPage.value = requestPage;
					updateStaffHasMore(payload.list.length, payload.count, requestPage);
				})
				.catch((err) => {
					const res = err as Response;
					showBusinessReadError(res, "加载失败");
				})
				.finally(() => {
					staffLoading.value = false;
					staffLoadingMore.value = false;
					resolve();
				});
		});
	}

	function refreshStaffList(silent: boolean = false): Promise<void> {
		return loadStaffList(false, silent);
	}

	function resolvePickerIndex(event: UniPickerChangeEvent): number {
		const value = parseInt(`${event.detail.value}`);
		return isNaN(value) ? 0 : value;
	}

	function onStaffRoleChange(event: UniPickerChangeEvent) {
		staffRoleIndex.value = resolvePickerIndex(event);
		refreshStaffList();
	}

	function onStaffStatusChange(event: UniPickerChangeEvent) {
		staffStatusIndex.value = resolvePickerIndex(event);
		refreshStaffList();
	}

	function loadMoreStaffList() {
		loadStaffList(true);
	}

	function onEmployeeRefresherRefresh() {
		staffRefresherTriggered.value = true;
		refreshStaffList(true).finally(() => {
			staffRefresherTriggered.value = false;
		});
	}

	function onEmployeeRefresherRestore() {
		staffRefresherTriggered.value = false;
	}

	function onEmployeeScrollToLower() {
		if (!staffHasMore.value || staffLoadingMore.value || staffLoading.value) {
			return;
		}
		loadMoreStaffList();
	}

	function onEmployeeLoadMoreTap() {
		if (!staffHasMore.value || staffLoadingMore.value || staffLoading.value) {
			return;
		}
		loadMoreStaffList();
	}

	function mapExpandFieldLabel(row: KeywordExpandItem): string {
		const name = `${row.name ?? row.label ?? ""}`.trim();
		if (name != "") {
			return name;
		}
		const field = `${row.field ?? ""}`.trim();
		return field;
	}

	function mapExpandFieldValue(row: KeywordExpandItem): string {
		return `${row.value ?? row.field_value ?? ""}`.trim();
	}

	function mapExpandFields(expand: KeywordExpandItem[] | null): AccountExpandField[] {
		if (expand == null || expand.length == 0) {
			return [];
		}
		const result: AccountExpandField[] = [];
		for (let i = 0; i < expand.length; i++) {
			const row = expand[i];
			const label = mapExpandFieldLabel(row);
			const value = mapExpandFieldValue(row);
			if (label == "" && value == "") {
				continue;
			}
			result.push({
				label: label != "" ? label : `字段${i + 1}`,
				value: value,
				field: `${row.field ?? ""}`.trim() != "" ? `${row.field ?? ""}`.trim() : `${i}`,
				copyable: false
			});
		}
		return result;
	}

	function pickItemText(item: KeywordAssignableItem, keys: string[]): string {
		const obj = item as UTSJSONObject;
		for (let i = 0; i < keys.length; i++) {
			const value = obj[keys[i]];
			if (value != null && `${value}`.trim() != "") {
				return `${value}`.trim();
			}
		}
		return "";
	}

	function pickExpandValue(expand: AccountExpandField[], keywords: string[]): string {
		for (let i = 0; i < expand.length; i++) {
			const row = expand[i];
			const source = `${row.label} ${row.field}`.toLowerCase();
			for (let j = 0; j < keywords.length; j++) {
				if (source.indexOf(keywords[j].toLowerCase()) >= 0 && row.value != "") {
					return row.value;
				}
			}
		}
		return "";
	}

	function pickFirstText(primary: string, fallback: string): string {
		return primary != "" ? primary : fallback;
	}

	function normalizeAccountStatus(item: KeywordAssignableItem): AccountFilterOption {
		const rawText = pickItemText(item, ["status_text", "audit_status_text", "review_status_text", "publish_status_text"]);
		const rawStatus = pickItemText(item, ["status", "audit_status", "review_status", "publish_status"]);
		const text = `${rawText} ${rawStatus}`.toLowerCase();
		if (text.indexOf("已审核待发布") >= 0 || text.indexOf("待发布") >= 0 || text.indexOf("approved_pending") >= 0) {
			return { label: rawText != "" ? rawText : "已审核待发布", value: "approved_pending" };
		}
		if (text.indexOf("已发布") >= 0 || text.indexOf("published") >= 0) {
			return { label: rawText != "" ? rawText : "已发布", value: "published" };
		}
		if (text.indexOf("审核中") >= 0 || text.indexOf("待审核") >= 0 || text.indexOf("reviewing") >= 0 || rawStatus == "0") {
			return { label: rawText != "" ? rawText : "审核中", value: "reviewing" };
		}
		if (text.indexOf("失败") >= 0 || text.indexOf("驳回") >= 0 || text.indexOf("rejected") >= 0 || rawStatus == "2") {
			return { label: rawText != "" ? rawText : "审核失败", value: "rejected" };
		}
		return { label: rawText != "" ? rawText : "待处理", value: rawStatus };
	}

	function normalizeProjectType(item: KeywordAssignableItem, projectName: string): string {
		const source = `${pickItemText(item, ["project_type_text", "category_name", "type_text", "project_type"])} ${projectName}`.toLowerCase();
		if (source.indexOf("海外") >= 0 && source.indexOf("短剧") >= 0) {
			return "海外短剧";
		}
		if (source.indexOf("海外") >= 0 && source.indexOf("小说") >= 0) {
			return "海外小说";
		}
		if (source.indexOf("品牌") >= 0) {
			return "品牌项目";
		}
		return pickItemText(item, ["project_type_text", "category_name", "type_text"]) || "推广项目";
	}

	function isOverseasProject(typeLabel: string, projectName: string): boolean {
		const source = `${typeLabel} ${projectName}`;
		return source.indexOf("海外小说") >= 0 || source.indexOf("海外短剧") >= 0;
	}

	function buildAccountFields(
		item: KeywordAssignableItem,
		projectName: string,
		staffName: string,
		status: AccountFilterOption,
		typeLabel: string,
		rawExpand: AccountExpandField[]
	): AccountExpandField[] {
		const result: AccountExpandField[] = [];
		const keyword = pickFirstText(pickItemText(item, ["keyword", "keyword_name"]), pickExpandValue(rawExpand, ["关键词"]));
		const code = pickFirstText(
			pickItemText(item, ["command_code", "password_code", "code", "keyword"]),
			pickExpandValue(rawExpand, ["口令码", "口令", "command", "code"])
		);
		if (isOverseasProject(typeLabel, projectName)) {
			result.push({ label: "口令码", value: code || "—", field: "command_code", copyable: false });
			result.push({ label: "推广项目", value: projectName || "—", field: "project", copyable: false });
			result.push({ label: "推广员工", value: staffName || "—", field: "staff", copyable: staffName != "" });
			return result;
		}
		result.push({ label: "关键词", value: keyword || "—", field: "keyword", copyable: keyword != "" });
		result.push({ label: "审核状态", value: status.label, field: "audit_status", copyable: false });
		result.push({ label: "推广项目", value: projectName || "—", field: "project", copyable: false });
		result.push({ label: "推广员工", value: staffName || "—", field: "staff", copyable: staffName != "" });
		const promptTime = pickFirstText(
			pickItemText(item, ["prompt_time", "keyword_time", "submit_time", "create_time", "created_at"]),
			pickExpandValue(rawExpand, ["提词时间", "创建时间", "提交时间"])
		);
		result.push({ label: "提词时间", value: promptTime || "—", field: "prompt_time", copyable: false });
		const failedReason = pickFirstText(
			pickItemText(item, ["audit_fail_reason", "audit_feedback", "reject_reason", "failure_reason"]),
			pickExpandValue(rawExpand, ["审核失败原因", "失败原因", "驳回原因", "审核反馈"])
		);
		if (failedReason != "") {
			result.push({ label: "审核失败原因", value: failedReason, field: "audit_fail_reason", copyable: false });
		}
		const auditTime = pickFirstText(
			pickItemText(item, ["audit_time", "review_time", "approved_at", "updated_at"]),
			pickExpandValue(rawExpand, ["审核时间"])
		);
		if (auditTime != "") {
			result.push({ label: "审核时间", value: auditTime, field: "audit_time", copyable: false });
		}
		return result;
	}

	function pickAssignableProjectName(item: KeywordAssignableItem): string {
		const project = item.project;
		if (project != null) {
			if (typeof project == "string") {
				const text = project.trim();
				if (text != "") {
					return text;
				}
			} else {
				const obj = project as UTSJSONObject;
				const title = obj["title"] ?? obj["name"] ?? obj["project_name"];
				if (title != null && `${title}`.trim() != "") {
					return `${title}`.trim();
				}
			}
		}
		const candidates = [item.project_name, item.project_title, item.title, item.keyword];
		for (let i = 0; i < candidates.length; i++) {
			const text = `${candidates[i] ?? ""}`.trim();
			if (text != "") {
				return text;
			}
		}
		return "";
	}

	function mapAssignableToCard(item: KeywordAssignableItem, index: number): AccountCard {
		const expand = item.expand ?? null;
		const rawExpand = mapExpandFields(expand);
		const projectIdRaw = item.project_id ?? 0;
		const projectId =
			typeof projectIdRaw == "number" ? (projectIdRaw as number) : parseInt(`${projectIdRaw}`);
		const projectName = pickAssignableProjectName(item);
		const status = normalizeAccountStatus(item);
		const staffName = pickFirstText(
			pickItemText(item, ["staff_name", "staff_nickname", "user_nickname", "nickname"]),
			pickExpandValue(rawExpand, ["推广员工", "提交员工", "员工"])
		);
		const staffIdRaw = pickItemText(item, ["staff_id", "user_id"]);
		const parsedStaffId = parseInt(staffIdRaw);
		const projectTypeLabel = normalizeProjectType(item, projectName);
		const applyTime = pickFirstText(
			pickItemText(item, ["apply_time", "claim_time", "receive_time", "create_time", "created_at", "create_at"]),
			pickExpandValue(rawExpand, ["申领时间", "领取时间", "创建时间"])
		);
		return {
			id: item.id ?? index,
			projectId: isNaN(projectId) ? 0 : projectId,
			status: status.label,
			statusKey: status.value,
			staffId: isNaN(parsedStaffId) ? 0 : parsedStaffId,
			staffName,
			project: projectName,
			projectTypeLabel,
			expandFields: buildAccountFields(item, projectName, staffName, status, projectTypeLabel, rawExpand),
			timeLabel: isOverseasProject(projectTypeLabel, projectName) ? "申领时间" : "创建时间",
			createdAt: applyTime
		};
	}

	type AssignableListPayload = {
		list: KeywordAssignableItem[];
		count: number;
	};

	function parseAssignableListPayload(res: any | null): AssignableListPayload {
		if (res == null) {
			return { list: [], count: 0 };
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return { list: data as KeywordAssignableItem[], count: data.length };
		}
		const obj = data as UTSJSONObject;
		const list = obj["list"];
		const rawList =
			list != null && Array.isArray(list)
				? (list as KeywordAssignableItem[])
				: ([] as KeywordAssignableItem[]);
		const countVal = obj["count"] ?? obj["total"] ?? obj["total_count"];
		let count = 0;
		if (countVal != null) {
			const n = parseInt(`${countVal}`);
			count = isNaN(n) ? 0 : n;
		}
		return { list: rawList, count };
	}

	function filterAssignableList(list: KeywordAssignableItem[]): KeywordAssignableItem[] {
		const kw = accountKeyword.value.trim().toLowerCase();
		return list.filter((item) => {
			const statusValue = accountStatusOptions[accountStatusIndex.value].value;
			if (statusValue != "" && normalizeAccountStatus(item).value != statusValue) {
				return false;
			}
			const rawExpand = mapExpandFields(item.expand ?? null);
			const staffName = pickFirstText(
				pickItemText(item, ["staff_name", "staff_nickname", "user_nickname", "nickname"]),
				pickExpandValue(rawExpand, ["推广员工", "提交员工", "员工"])
			);
			const staffOption = accountStaffOptions.value[accountStaffIndex.value];
			if (staffOption != null && staffOption.value != "") {
				const itemStaffId = pickItemText(item, ["staff_id", "user_id"]);
				if (itemStaffId != staffOption.value && staffName != staffOption.label) {
					return false;
				}
			}
			const projectOption = accountProjectOptions.value[accountProjectIndex.value];
			if (projectOption != null && projectOption.value != "") {
				const itemProjectId = `${item.project_id ?? ""}`;
				const projectName = pickAssignableProjectName(item);
				if (itemProjectId != projectOption.value && projectName != projectOption.label) {
					return false;
				}
			}
			const categoryOption = accountCategoryOptions[accountCategoryIndex.value];
			if (categoryOption != null && categoryOption.value != "") {
				const projectName = pickAssignableProjectName(item);
				const categorySource = `${pickItemText(item, ["project_type_text", "category_name", "type_text", "project_type"])} ${projectName}`;
				if (categorySource.indexOf(categoryOption.value) < 0) {
					return false;
				}
			}
			if (kw == "") {
				return true;
			}
			const keyword = `${item.keyword ?? ""}`.toLowerCase();
			const project = pickAssignableProjectName(item).toLowerCase();
			const staff = staffName.toLowerCase();
			const expandRaw = item.expand ?? [];
			let expandText = "";
			for (let i = 0; i < expandRaw.length; i++) {
				const row = expandRaw[i];
				expandText += `${row.name ?? ""}`.toLowerCase();
				expandText += `${row.field ?? ""}`.toLowerCase();
				expandText += `${row.value ?? row.field_value ?? ""}`.toLowerCase();
			}
			return keyword.indexOf(kw) >= 0 || staff.indexOf(kw) >= 0 || project.indexOf(kw) >= 0 || expandText.indexOf(kw) >= 0;
		});
	}

	function syncAccountProjectOptions(list: KeywordAssignableItem[]) {
		const next: AccountFilterOption[] = [{ label: "全部项目", value: "" }];
		for (let i = 0; i < list.length; i++) {
			const projectName = pickAssignableProjectName(list[i]);
			if (projectName == "") {
				continue;
			}
			const projectId = `${list[i].project_id ?? ""}`;
			let exists = false;
			for (let j = 0; j < next.length; j++) {
				if ((projectId != "" && next[j].value == projectId) || next[j].label == projectName) {
					exists = true;
					break;
				}
			}
			if (!exists) {
				next.push({ label: projectName, value: projectId != "" ? projectId : projectName });
			}
		}
		accountProjectOptions.value = next;
		if (accountProjectIndex.value >= next.length) {
			accountProjectIndex.value = 0;
		}
	}

	function loadAccountStaffOptions() {
		if (accountStaffLoaded.value) {
			return;
		}
		accountStaffLoaded.value = true;
		getStaffList({ page: 1, limit: 500 })
			.then((res) => {
				const payload = parseStaffListPayload(res);
				const next: AccountFilterOption[] = [{ label: "全部员工", value: "" }];
				for (let i = 0; i < payload.list.length; i++) {
					const item = payload.list[i];
					const name = `${item.nickname ?? item.sn ?? item.mobile ?? ""}`.trim();
					const id = item.user_id ?? item.id ?? 0;
					if (name != "" && id > 0) {
						next.push({ label: name, value: `${id}` });
					}
				}
				accountStaffOptions.value = next;
			})
			.catch(() => {
				accountStaffLoaded.value = false;
			});
	}

	function onAccountStatusChange(event: UniPickerChangeEvent) {
		accountStatusIndex.value = resolvePickerIndex(event);
		refreshAccountList();
	}

	function onAccountStaffChange(event: UniPickerChangeEvent) {
		accountStaffIndex.value = resolvePickerIndex(event);
		refreshAccountList();
	}

	function selectAccountCategory(index: number) {
		if (index < 0 || index >= accountCategoryOptions.length || accountCategoryIndex.value == index) {
			return;
		}
		accountCategoryIndex.value = index;
		refreshAccountList();
	}

	function onAccountProjectChange(event: UniPickerChangeEvent) {
		accountProjectIndex.value = resolvePickerIndex(event);
		refreshAccountList();
	}

	function onEnterpriseStatusChange(event: UniPickerChangeEvent) {
		enterpriseStatusIndex.value = resolvePickerIndex(event);
		refreshEnterpriseRecordList();
	}

	function onEnterpriseOrderChange(event: UniPickerChangeEvent) {
		enterpriseOrderIndex.value = resolvePickerIndex(event);
	}

	type EnterpriseRecordPayload = {
		list: UTSJSONObject[];
		count: number;
	};

	function pickRecordText(item: UTSJSONObject, keys: string[]): string {
		for (let i = 0; i < keys.length; i++) {
			const value = item[keys[i]];
			if (value == null || typeof value == "object") {
				continue;
			}
			const text = `${value}`.trim();
			if (text != "") {
				return text;
			}
		}
		return "";
	}

	function parseEnterpriseRecordPayload(res: any | null): EnterpriseRecordPayload {
		if (res == null) {
			return { list: [], count: 0 };
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (Array.isArray(data)) {
			return { list: data as UTSJSONObject[], count: data.length };
		}
		const obj = data as UTSJSONObject;
		const listValue = obj["list"] ?? obj["records"] ?? obj["rows"] ?? [];
		const list = Array.isArray(listValue) ? (listValue as UTSJSONObject[]) : ([] as UTSJSONObject[]);
		const countValue = obj["count"] ?? obj["total"] ?? obj["total_count"] ?? list.length;
		const parsedCount = parseInt(`${countValue}`);
		return { list, count: isNaN(parsedCount) ? list.length : parsedCount };
	}

	function normalizeEnterpriseRecordStatus(item: UTSJSONObject, tab: TaskRecordTab): { label: string; tone: string } {
		const label = pickRecordText(item, ["payment_status_text", "settlement_status_text", "status_text", "audit_status_text", "review_status_text", "state_text"]);
		const raw = pickRecordText(item, ["status", "audit_status", "review_status", "state"]);
		const text = (label != "" ? label : raw).trim();
		if (text.indexOf("成功") >= 0 || text.indexOf("通过") >= 0 || text.indexOf("完成") >= 0 || text.indexOf("到账") >= 0) {
			return { label: text, tone: "success" };
		}
		if (text.indexOf("失败") >= 0 || text.indexOf("驳回") >= 0 || text.indexOf("拒绝") >= 0 || text.indexOf("取消") >= 0) {
			return { label: text, tone: "danger" };
		}
		if (text.indexOf("审核") >= 0 || text.indexOf("处理") >= 0 || text.indexOf("待") >= 0) {
			return { label: text, tone: "warning" };
		}
		if (raw == "1") {
			return { label: tab == "backfill" ? "回填成功" : "已到账", tone: "success" };
		}
		if (raw == "2" || raw == "-1") {
			return { label: tab == "backfill" ? "回填失败" : "提现失败", tone: "danger" };
		}
		return { label: text != "" ? text : "待处理", tone: "warning" };
	}

	function pushEnterpriseRecordField(fields: EnterpriseRecordField[], label: string, value: string, copyable: boolean = false) {
		if (value.trim() == "") {
			return;
		}
		fields.push({ label, value, copyable });
	}

	function mapEnterpriseRecordCard(item: UTSJSONObject, index: number, tab: TaskRecordTab): EnterpriseRecordCard {
		const id = pickRecordText(item, ["id", "record_id", "publish_id", "withdraw_id", "order_id"]);
		const recordNo = pickRecordText(item, ["record_no", "withdraw_no", "order_no", "sn", "trade_no"]);
		const staffName = pickRecordText(item, ["staff_name", "staff_nickname", "employee_name", "user_nickname", "nickname"]);
		const status = normalizeEnterpriseRecordStatus(item, tab);
		const fields: EnterpriseRecordField[] = [];
		if (tab == "backfill") {
			const project = pickRecordText(item, ["project_name", "project_title", "project", "title"]);
			const keyword = pickRecordText(item, ["keyword", "keyword_text", "word"]);
			const workUrl = pickRecordText(item, ["work_url", "video_url", "publish_url", "url", "link"]);
			const reason = pickRecordText(item, ["fail_reason", "failure_reason", "reject_reason", "audit_remark", "error_msg"]);
			pushEnterpriseRecordField(fields, "推广员工", staffName);
			pushEnterpriseRecordField(fields, "推广项目", project);
			pushEnterpriseRecordField(fields, "关键词", keyword, true);
			pushEnterpriseRecordField(fields, "作品链接", workUrl, true);
			pushEnterpriseRecordField(fields, "失败原因", reason);
			return {
				id: id != "" ? `backfill-${id}` : `backfill-${index}`,
				title: keyword != "" ? keyword : (project != "" ? project : "作品回填记录"),
				recordNo: recordNo != "" ? `记录号 ${recordNo}` : "",
				status: status.label,
				statusTone: status.tone,
				fields,
				timeLabel: "回填时间",
				createdAt: pickRecordText(item, ["fill_time", "publish_time", "submit_time", "create_time", "created_at"])
			};
		}

		if (tab == "revenue") {
			const project = pickRecordText(item, ["project_title", "project_name", "project", "title"]);
			const keyword = pickRecordText(item, ["keyword", "keyword_text", "word"]);
			const originalRevenue = parseRevenueAmount(pickRecordText(item, [
				"original_order_amount",
				"order_original_amount",
				"original_amount",
				"order_amount",
				"enterprise_profit",
				"promo_revenue",
				"share_profit"
			]));
			const commissionRate = parseCommissionRate(pickRecordText(item, [
				"personal_commission_rate_snapshot",
				"commission_rate_snapshot",
				"commission_rate",
				"user_rate"
			]));
			const enterpriseOwnerRevenue = originalRevenue * commissionRate / 100;
			const staffRevenue = originalRevenue - enterpriseOwnerRevenue;
			const auditTime = pickRecordText(item, ["audit_time", "review_time", "approved_at"]);
			pushEnterpriseRecordField(fields, "推广员工", staffName);
			pushEnterpriseRecordField(fields, "推广项目", project);
			pushEnterpriseRecordField(fields, "关键词", keyword, true);
			pushEnterpriseRecordField(fields, "推广收益", `¥${formatRevenueAmount(originalRevenue)}`);
			pushEnterpriseRecordField(fields, "企业主收益", `¥${formatRevenueAmount(enterpriseOwnerRevenue)}`);
			pushEnterpriseRecordField(fields, "员工收益", `¥${formatRevenueAmount(staffRevenue)}`);
			pushEnterpriseRecordField(fields, "分成比例", `${commissionRate}%`);
			pushEnterpriseRecordField(fields, "审核时间", auditTime);
			return {
				id: id != "" ? `revenue-${id}` : `revenue-${index}`,
				title: project != "" ? project : (keyword != "" ? keyword : "订单收益记录"),
				recordNo: recordNo != "" ? `订单号 ${recordNo}` : "",
				status: "已审核 · 已结算",
				statusTone: "success",
				fields,
				timeLabel: "结算时间",
				createdAt: pickRecordText(item, ["payment_time", "settlement_time", "settled_at", "audit_time", "updated_at"])
			};
		}

		const amountRaw = pickRecordText(item, ["amount", "withdraw_amount", "money", "price"]);
		const method = pickRecordText(item, ["withdraw_method", "payment_method", "channel_name", "channel", "pay_type_text"]);
		const account = pickRecordText(item, ["account", "account_no", "payment_account", "bank_card", "alipay_account"]);
		const remark = pickRecordText(item, ["remark", "audit_remark", "fail_reason", "reject_reason"]);
		pushEnterpriseRecordField(fields, "提现员工", staffName);
		pushEnterpriseRecordField(fields, "提现金额", amountRaw == "" ? "" : `¥${amountRaw}`);
		pushEnterpriseRecordField(fields, "提现方式", method);
		pushEnterpriseRecordField(fields, "收款账户", account, true);
		pushEnterpriseRecordField(fields, "处理说明", remark);
		return {
			id: id != "" ? `withdraw-${id}` : `withdraw-${index}`,
			title: staffName != "" ? staffName : "员工提现记录",
			recordNo: recordNo != "" ? `提现单号 ${recordNo}` : "",
			status: status.label,
			statusTone: status.tone,
			fields,
			timeLabel: "申请时间",
			createdAt: pickRecordText(item, ["apply_time", "submit_time", "create_time", "created_at"])
		};
	}

	function isRevenueRecordEligible(item: UTSJSONObject): boolean {
		const settlement = pickRecordText(item, ["payment_status_text", "settlement_status_text", "settlement_status"]);
		if (settlement != "" && settlement.indexOf("结算") < 0 && settlement.indexOf("完成") < 0 && settlement != "1") {
			return false;
		}
		const audit = pickRecordText(item, ["audit_status_text", "review_status_text", "audit_status"]);
		if (audit != "" && audit.indexOf("通过") < 0 && audit.indexOf("审核") < 0 && audit != "1") {
			return false;
		}
		return true;
	}

	function loadEnterpriseRecordList(more: boolean = false): Promise<void> {
		return new Promise((resolve) => {
			if (taskRecordTab.value == "promotion") {
				resolve();
				return;
			}
			if (more) {
				if (enterpriseRecordLoadingMore.value || !enterpriseRecordHasMore.value) {
					resolve();
					return;
				}
				enterpriseRecordLoadingMore.value = true;
			} else {
				if (enterpriseRecordLoading.value || enterpriseRecordLoadingMore.value) {
					resolve();
					return;
				}
				enterpriseRecordLoading.value = true;
				enterpriseRecordCards.value = [];
				enterpriseRecordPage.value = 1;
				enterpriseRecordTotal.value = 0;
				enterpriseRecordHasMore.value = true;
				enterpriseRecordError.value = "";
			}

			const requestTab = taskRecordTab.value;
			const requestPage = more ? enterpriseRecordPage.value + 1 : 1;
			const params = {
				page: requestPage,
				limit: enterpriseRecordLimit,
				keyword: enterpriseRecordKeyword.value.trim()
			};
			const requestTask = requestTab == "backfill"
				? getEnterpriseBackfillRecordList(params)
				: (requestTab == "revenue" ? getEnterpriseRevenueRecordList(params) : getEnterpriseWithdrawRecordList(params));
			requestTask
				.then((res) => {
					if (requestTab != taskRecordTab.value) {
						return;
					}
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						enterpriseRecordError.value = getApiMessage(envelope, "接口暂未返回记录");
						return;
					}
					const payload = parseEnterpriseRecordPayload(res);
					const baseIndex = more ? enterpriseRecordCards.value.length : 0;
					const rows = requestTab == "revenue" ? payload.list.filter((item) => isRevenueRecordEligible(item)) : payload.list;
					const cards = rows.map((item, index) => mapEnterpriseRecordCard(item, baseIndex + index, requestTab));
					enterpriseRecordCards.value = more ? enterpriseRecordCards.value.concat(cards) : cards;
					enterpriseRecordPage.value = requestPage;
					enterpriseRecordTotal.value = payload.count > 0 ? payload.count : enterpriseRecordCards.value.length;
					enterpriseRecordHasMore.value = payload.count > 0
						? requestPage * enterpriseRecordLimit < payload.count
						: payload.list.length >= enterpriseRecordLimit;
				})
				.catch((err) => {
					if (requestTab == taskRecordTab.value) {
						enterpriseRecordError.value = getApiMessage(err as Response, "接口暂未返回记录");
					}
				})
				.finally(() => {
					enterpriseRecordLoading.value = false;
					enterpriseRecordLoadingMore.value = false;
					resolve();
				});
		});
	}

	function refreshEnterpriseRecordList(): Promise<void> {
		return loadEnterpriseRecordList(false);
	}

	function onEnterpriseRecordScrollToLower() {
		loadEnterpriseRecordList(true);
	}

	function onEnterpriseRecordLoadMoreTap() {
		loadEnterpriseRecordList(true);
	}

	function switchTaskRecordTab(tab: TaskRecordTab) {
		if (taskRecordTab.value == tab) {
			return;
		}
		cancelAccountBatchMode();
		taskRecordTab.value = tab;
		enterpriseRecordKeyword.value = "";
		enterpriseRecordCards.value = [];
		enterpriseRecordError.value = "";
		if (tab == "promotion") {
			refreshAccountList();
		} else {
			refreshEnterpriseRecordList();
		}
	}

	function refreshCurrentTaskRecord() {
		if (taskRecordTab.value == "promotion") {
			loadAccountStaffOptions();
			refreshAccountList();
		} else {
			refreshEnterpriseRecordList();
		}
	}

	function syncPromotionListScope() {
		const expectedRaw = uni.getStorageSync("businessPromotionExpectedTotal");
		const expected = parseInt(`${expectedRaw ?? 0}`);
		accountExpectedTotal.value = isNaN(expected) || expected < 0 ? 0 : expected;
		accountPeriod.value = `${uni.getStorageSync("businessPromotionPeriod") ?? ""}`.trim();
		accountStartDate.value = `${uni.getStorageSync("businessPromotionStartDate") ?? ""}`.trim();
		accountEndDate.value = `${uni.getStorageSync("businessPromotionEndDate") ?? ""}`.trim();
	}

	function isAccountUnfiltered(): boolean {
		return (
			accountKeyword.value.trim() == "" &&
			accountStatusIndex.value == 0 &&
			accountStaffIndex.value == 0 &&
			accountProjectIndex.value == 0
		);
	}

	function resolveAccountTargetTotal(payloadCount: number): number {
		if (isAccountUnfiltered() && accountExpectedTotal.value > 0) {
			return accountExpectedTotal.value;
		}
		return payloadCount > 0 ? payloadCount : accountRawLoadedCount.value;
	}

	function updateAccountHasMore(rawListLength: number, count: number, page: number) {
		if (rawListLength == 0) {
			accountHasMore.value = false;
			return;
		}
		if (count > 0) {
			accountHasMore.value = page * accountLimit < count;
			return;
		}
		accountHasMore.value = rawListLength >= accountLimit;
	}

	function loadAccountList(more: boolean = false): Promise<void> {
		return new Promise((resolve) => {
			if (more) {
				if (accountLoadingMore.value) {
					resolve();
					return;
				}
			} else if (accountLoading.value || accountLoadingMore.value) {
				resolve();
				return;
			}
			if (more) {
				if (!accountHasMore.value) {
					resolve();
					return;
				}
				accountLoadingMore.value = true;
			} else {
				accountLoading.value = true;
				accountCards.value = [];
				accountPage.value = 1;
				accountHasMore.value = true;
				accountRawLoadedCount.value = 0;
				accountAutoLoading.value = false;
			}

			const requestPage = more ? accountPage.value + 1 : 1;
			getEnterprisePromotionKeywordList({
				page: requestPage,
				limit: accountLimit,
				keyword: accountKeyword.value.trim(),
				scope: "enterprise_all",
				period: accountPeriod.value,
				start_date: accountStartDate.value,
				end_date: accountEndDate.value
			})
				.then((res) => {
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						showBusinessReadError(envelope, "加载失败");
						return;
					}
					const payload = parseAssignableListPayload(res);
					accountRawLoadedCount.value += payload.list.length;
					const targetTotal = resolveAccountTargetTotal(payload.count);
					accountTotal.value = targetTotal;
					if (!more) {
						syncAccountProjectOptions(payload.list);
					}
					const filtered = filterAssignableList(payload.list);
					const baseIndex = more ? accountCards.value.length : 0;
					let cards = filtered.map((item, index) => mapAssignableToCard(item, baseIndex + index));
					if (isAccountUnfiltered() && targetTotal > 0) {
						const remaining = Math.max(0, targetTotal - baseIndex);
						if (cards.length > remaining) {
							cards = cards.slice(0, remaining);
						}
					}
					if (more) {
						accountCards.value = accountCards.value.concat(cards);
					} else {
						accountCards.value = cards;
					}
					accountPage.value = requestPage;
					updateAccountHasMore(payload.list.length, payload.count, requestPage);
					if (targetTotal > 0 && accountRawLoadedCount.value >= targetTotal) {
						accountHasMore.value = false;
					}
				})
				.catch((err) => {
					const res = err as Response;
					showBusinessReadError(res, "加载失败");
				})
				.finally(() => {
					accountLoading.value = false;
					accountLoadingMore.value = false;
					const shouldAutoLoad =
						accountHasMore.value &&
						accountTotal.value > 0 &&
						accountRawLoadedCount.value < accountTotal.value;
					accountAutoLoading.value = shouldAutoLoad;
					resolve();
					if (shouldAutoLoad) {
						loadAccountList(true);
					}
				});
		});
	}

	function refreshAccountList(): Promise<void> {
		return loadAccountList(false);
	}

	function loadMoreAccountList() {
		loadAccountList(true);
	}

	function onAccountScrollToLower() {
		if (!accountHasMore.value || accountLoadingMore.value || accountLoading.value) {
			return;
		}
		loadMoreAccountList();
