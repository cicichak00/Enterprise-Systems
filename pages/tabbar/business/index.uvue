	function resetVirtualOrderForm() {
		virtualStaffSelectedIds.value = [];
		virtualStaffPickerDraftIds.value = [];
		virtualStaffPickerKeyword.value = "";
		virtualOrderAmount.value = "";
		virtualOrderAmountInputKey.value += 1;
		virtualKeywordSelectedId.value = 0;
		virtualKeywordSelectedLabel.value = "";
	}

	function sanitizeVirtualOrderAmountInput(raw: string): string {
		let text = raw.replace(/[^\d.]/g, "");
		if (text == "") {
			return "";
		}
		if (text == ".") {
			return "0.";
		}
		const firstDot = text.indexOf(".");
		if (firstDot >= 0) {
			let intPart = text.slice(0, firstDot);
			if (intPart == "") {
				intPart = "0";
			}
			const decPart = text.slice(firstDot + 1).replace(/\./g, "");
			return `${intPart}.${decPart.slice(0, 2)}`;
		}
		return text;
	}

	function applyVirtualOrderAmount(raw: string) {
		const next = sanitizeVirtualOrderAmountInput(raw);
		if (next != virtualOrderAmount.value) {
			virtualOrderAmount.value = next;
		}
		if (next != raw) {
			virtualOrderAmountInputKey.value += 1;
		}
	}

	function onVirtualOrderAmountInput(e: UniInputEvent) {
		applyVirtualOrderAmount(`${e.detail.value ?? ""}`);
	}

	function onVirtualOrderAmountBlur(e: UniInputBlurEvent) {
		let text = `${e.detail.value ?? virtualOrderAmount.value}`.trim().replace(/\.$/, "");
		applyVirtualOrderAmount(text);
	}

	function mapVirtualKeywordOption(item: KeywordListItem, index: number): VirtualKeywordOption {
		const keywordIdRaw = item["keyword_id"] ?? item.id ?? index + 1;
		let id = index + 1;
		if (keywordIdRaw != null) {
			const n = parseInt(`${keywordIdRaw}`);
			id = isNaN(n) ? index + 1 : n;
		}
		const keyword = `${item.keyword ?? ""}`.trim();
		const labelText = `${item["label"] ?? ""}`.trim();
		const label = labelText != "" ? labelText : keyword;
		return {
			id: id,
			label: label
		};
	}

	function updateVirtualKeywordHasMore(rawListLength: number, count: number, page: number) {
		if (count > 0) {
			virtualKeywordHasMore.value = page * virtualKeywordLimit < count;
			return;
		}
		virtualKeywordHasMore.value = rawListLength >= virtualKeywordLimit;
	}

	function loadVirtualKeywordOptions(more: boolean = false) {
		if (more == true) {
			if (virtualKeywordLoadingMore.value || !virtualKeywordHasMore.value) {
				return;
			}
		} else if (virtualKeywordLoading.value || virtualKeywordLoadingMore.value) {
			return;
		}
		if (more == true) {
			virtualKeywordLoadingMore.value = true;
		} else {
			virtualKeywordLoading.value = true;
			virtualKeywordOptions.value = [];
			virtualKeywordPage.value = 1;
			virtualKeywordHasMore.value = true;
		}
		const requestPage = more == true ? virtualKeywordPage.value + 1 : 1;
		const kw = virtualKeywordPickerKeyword.value.trim();
		getVirtualKeywordList({
			page: requestPage,
			limit: virtualKeywordLimit,
			keyword: kw != "" ? kw : undefined
		})
			.then((res) => {
				const payload = parseAssignableListPayload(res);
				const options: VirtualKeywordOption[] = [];
				const baseIndex = more == true ? virtualKeywordOptions.value.length : 0;
				for (let i = 0; i < payload.list.length; i++) {
					const option = mapVirtualKeywordOption(payload.list[i] as KeywordListItem, baseIndex + i);
					if (option.id > 0 && option.label != "") {
						options.push(option);
					}
				}
				if (more == true) {
					virtualKeywordOptions.value = virtualKeywordOptions.value.concat(options);
				} else {
					virtualKeywordOptions.value = options;
				}
				virtualKeywordPage.value = requestPage;
				updateVirtualKeywordHasMore(payload.list.length, payload.count, requestPage);
			})
			.catch(() => {
				if (more != true) {
					virtualKeywordOptions.value = [];
				}
				uni.showToast({ title: "关键词加载失败", icon: "none" });
			})
			.finally(() => {
				virtualKeywordLoading.value = false;
				virtualKeywordLoadingMore.value = false;
			});
	}

	function refreshVirtualKeywordOptions() {
		loadVirtualKeywordOptions(false);
	}

	function onVirtualKeywordScrollToLower() {
		if (!virtualKeywordHasMore.value || virtualKeywordLoadingMore.value || virtualKeywordLoading.value) {
			return;
		}
		loadVirtualKeywordOptions(true);
	}

	function onVirtualKeywordLoadMoreTap() {
