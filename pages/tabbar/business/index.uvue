		loadVirtualKeywordOptions(true);
	}

	function findVirtualKeywordOption(keywordId: number): VirtualKeywordOption | null {
		if (keywordId <= 0) {
			return null;
		}
		const options = virtualKeywordOptions.value;
		for (let i = 0; i < options.length; i++) {
			if (options[i].id == keywordId) {
				return options[i];
			}
		}
		return null;
	}

	function openVirtualKeywordPicker() {
		virtualKeywordPickerKeyword.value = "";
		virtualKeywordPickerVisible.value = true;
		loadVirtualKeywordOptions(false);
	}

	function closeVirtualKeywordPicker() {
		virtualKeywordPickerVisible.value = false;
		virtualKeywordPickerKeyword.value = "";
	}

	function selectVirtualKeyword(keywordId: number) {
		const item = findVirtualKeywordOption(keywordId);
		virtualKeywordSelectedId.value = keywordId;
		virtualKeywordSelectedLabel.value = item != null ? item.label : "";
		closeVirtualKeywordPicker();
	}

	function mapStaffToVirtualOption(item: StaffListItem, index: number): VirtualStaffOption {
		const staffId = item.id ?? 0;
		const userId = item.user_id ?? staffId;
		const name = item.nickname ?? "";
		const sn = item.sn ?? "";
		const mobile = item.mobile ?? "";
		return {
			id: staffId > 0 ? staffId : index + 1,
			userId: userId > 0 ? userId : staffId,
			name: name != "" ? name : `员工${staffId}`,
			collabId: sn != "" ? sn : `${userId}`,
			mobile: mobile
		};
	}

	function loadVirtualStaffOptions() {
		if (virtualStaffLoading.value) {
			return;
		}
		virtualStaffLoading.value = true;
		getStaffList({ page: 1, limit: 2000, status: 1 })
			.then((res) => {
				const payload = parseStaffListPayload(res);
				const options: VirtualStaffOption[] = [];
				for (let i = 0; i < payload.list.length; i++) {
					const option = mapStaffToVirtualOption(payload.list[i], i);
					if (option.id > 0) {
						options.push(option);
					}
				}
				virtualStaffOptions.value = options;
			})
			.catch(() => {
				virtualStaffOptions.value = [];
				uni.showToast({ title: "员工列表加载失败", icon: "none" });
			})
			.finally(() => {
				virtualStaffLoading.value = false;
			});
	}

	function openVirtualOrderPopup() {
		closeRevenueRankPopup();
		resetVirtualOrderForm();
		virtualOrderPopupVisible.value = true;
		if (virtualStaffOptions.value.length == 0) {
			loadVirtualStaffOptions();
		}
		if (virtualKeywordOptions.value.length == 0) {
			loadVirtualKeywordOptions();
		}
	}

	function closeVirtualOrderPopup() {
		virtualOrderPopupVisible.value = false;
		closeVirtualStaffPicker();
		closeVirtualKeywordPicker();
	}

	function findVirtualStaffOption(staffId: number): VirtualStaffOption | null {
		const options = virtualStaffOptions.value;
		for (let i = 0; i < options.length; i++) {
			if (options[i].id == staffId) {
				return options[i];
			}
		}
		return null;
	}

	function openVirtualStaffPicker() {
		virtualStaffPickerDraftIds.value = virtualStaffSelectedIds.value.slice();
		virtualStaffPickerKeyword.value = "";
		virtualStaffPickerVisible.value = true;
		if (virtualStaffOptions.value.length == 0 && !virtualStaffLoading.value) {
			loadVirtualStaffOptions();
		}
	}

	function closeVirtualStaffPicker() {
		virtualStaffPickerVisible.value = false;
		virtualStaffPickerKeyword.value = "";
	}

	function isVirtualStaffPickerSelected(staffId: number): boolean {
		return virtualStaffPickerDraftIds.value.indexOf(staffId) >= 0;
	}

	function toggleVirtualStaffPickerSelect(staffId: number) {
		if (staffId <= 0) {
			return;
		}
		const ids = virtualStaffPickerDraftIds.value.slice();
		const idx = ids.indexOf(staffId);
		if (idx >= 0) {
			ids.splice(idx, 1);
		} else {
			ids.push(staffId);
		}
		virtualStaffPickerDraftIds.value = ids;
	}

	function toggleVirtualStaffSelectAll() {
		const filtered = filteredVirtualStaffOptions.value;
		if (filtered.length == 0) {
			return;
		}
		const ids = virtualStaffPickerDraftIds.value.slice();
		if (virtualStaffPickerAllSelected.value) {
			for (let i = 0; i < filtered.length; i++) {
				const staffId = filtered[i].id;
				const idx = ids.indexOf(staffId);
				if (idx >= 0) {
					ids.splice(idx, 1);
				}
			}
			virtualStaffPickerDraftIds.value = ids;
			return;
		}
		for (let i = 0; i < filtered.length; i++) {
			const staffId = filtered[i].id;
			if (staffId > 0 && ids.indexOf(staffId) < 0) {
				ids.push(staffId);
			}
		}
		virtualStaffPickerDraftIds.value = ids;
	}

	function confirmVirtualStaffPicker() {
		virtualStaffSelectedIds.value = virtualStaffPickerDraftIds.value.slice();
		closeVirtualStaffPicker();
	}

	function resolveVirtualOrderUserIds(): number[] {
		const userIds: number[] = [];
		const ids = virtualStaffSelectedIds.value;
		for (let i = 0; i < ids.length; i++) {
			const option = findVirtualStaffOption(ids[i]);
			if (option == null) {
				continue;
			}
			const userId = option.userId > 0 ? option.userId : option.id;
			if (userId > 0 && userIds.indexOf(userId) < 0) {
				userIds.push(userId);
			}
		}
		return userIds;
	}

	function confirmVirtualOrder() {
		if (virtualOrderSubmitting.value) {
			return;
		}
		const userIds = resolveVirtualOrderUserIds();
		if (userIds.length == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		const amountText = virtualOrderAmount.value.trim().replace(/\.$/, "");
		if (amountText == "") {
			uni.showToast({ title: "请输入虚拟订单金额", icon: "none" });
			return;
		}
		if (!/^\d+(\.\d{1,2})?$/.test(amountText)) {
			uni.showToast({ title: "金额最多保留两位小数", icon: "none" });
			return;
		}
		const amountNum = parseFloat(amountText);
		if (isNaN(amountNum) || amountNum <= 0) {
			uni.showToast({ title: "请输入有效金额", icon: "none" });
			return;
		}
		const keywordOption = findVirtualKeywordOption(virtualKeywordSelectedId.value);
		const keywordId =
			keywordOption != null && keywordOption.id > 0
				? keywordOption.id
				: virtualKeywordSelectedId.value;
		if (keywordId <= 0) {
			uni.showToast({ title: "请选择关键词", icon: "none" });
			return;
		}

		virtualOrderSubmitting.value = true;
		issueVirtualOrder({
			user_ids: userIds,
			staff_revenue_total: amountNum,
			keyword_id: keywordId
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "发放失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: "发放成功", icon: "success" });
				closeVirtualOrderPopup();
				resetVirtualOrderForm();
				refreshStaffList();
			})
			.catch((err) => {
				const envelope = err as Response | null;
				uni.showToast({ title: getApiMessage(envelope, "发放失败"), icon: "none" });
			})
			.finally(() => {
				virtualOrderSubmitting.value = false;
			});
	}

	function selectStaffOrder(order: string) {
		closeRevenueRankPopup();
		if (staffOrder.value == order) {
			return;
		}
		staffOrder.value = order;
		refreshStaffList();
	}

	function cancelEmployeeBatchMode() {
		employeeBatchMode.value = false;
		employeeBatchAction.value = "commission";
		employeeBatchSelectedIds.value = [];
		closeEmployeeBatchRatePopup();
		closeEmployeeBatchRoleLabelPopup();
		closeEmployeeBatchQuickPromptPopup();
		closeEmployeeBatchSettlementPopup();
		quickPromptPrerequisiteVisible.value = false;
		closeRevenueRankPopup();
	}

	function enterEmployeeBatchMode(action: EmployeeBatchAction = "commission") {
		if (employeeCards.value.length == 0) {
			uni.showToast({ title: "暂无可设置员工", icon: "none" });
			return;
		}
		closeRevenueRankPopup();
		employeeBatchAction.value = action;
		employeeCardsCollapsed.value = true;
		employeeBatchMode.value = true;
		employeeBatchSelectedIds.value = [];
	}

	function toggleEmployeeBatchSelect(item: EmployeeCard) {
		if (item.id <= 0) {
			return;
		}
		const ids = employeeBatchSelectedIds.value.slice();
		const idx = ids.indexOf(item.id);
		if (idx >= 0) {
			ids.splice(idx, 1);
		} else {
			ids.push(item.id);
		}
		employeeBatchSelectedIds.value = ids;
	}

	function onEmployeeCardTap(item: EmployeeCard) {
		if (employeeBatchMode.value) {
			toggleEmployeeBatchSelect(item);
		}
	}

	function toggleEmployeeBatchSelectAll() {
		if (employeeBatchAllSelected.value) {
			employeeBatchSelectedIds.value = [];
			return;
		}
		const ids: number[] = [];
		const cards = employeeCards.value;
		for (let i = 0; i < cards.length; i++) {
			if (cards[i].id > 0) {
				ids.push(cards[i].id);
			}
		}
		employeeBatchSelectedIds.value = ids;
	}

	function syncEmployeeBatchSplitSlider(next: number, remount: boolean = false) {
		employeeBatchSplitRate.value = next;
		employeeBatchSplitSliderValue.value = next;
		if (remount) {
			employeeBatchSliderKey.value = employeeBatchSliderKey.value + 1;
		}
	}

	function applyEmployeeBatchSplitFromSlider(val: number, remountOnClamp: boolean = false) {
		const normalized = normalizeSplitRate(val);
		syncEmployeeBatchSplitSlider(normalized, remountOnClamp && normalized != val);
	}

	function onEmployeeBatchSplitChange(e: UniSliderChangeEvent) {
		applyEmployeeBatchSplitFromSlider(e.detail.value, true);
	}

	function onEmployeeBatchSplitChanging(e: UniSliderChangeEvent) {
		syncEmployeeBatchSplitSlider(normalizeSplitRate(e.detail.value), false);
	}

	function getSelectedEmployeeCommissionRates(): number[] {
		const ids = employeeBatchSelectedIds.value;
		const rates: number[] = [];
		for (let i = 0; i < ids.length; i++) {
			const card = findEmployeeCard(ids[i]);
			if (card != null) {
				rates.push(card.commissionRate);
			}
		}
		return rates;
	}

	function getEmployeeBatchDefaultSplitRate(): number {
		const rates = getSelectedEmployeeCommissionRates();
		if (rates.length == 0) {
			return 20;
		}
		let minRate = rates[0];
		for (let i = 1; i < rates.length; i++) {
			if (rates[i] < minRate) {
				minRate = rates[i];
			}
		}
		return normalizeSplitRate(minRate);
	}

	function openEmployeeBatchEditor() {
		if (employeeBatchAction.value == "project") {
			openEmployeeBatchProjectEditor();
			return;
		}
		if (employeeBatchAction.value == "settlement") {
			openEmployeeBatchSettlementPopup();
			return;
		}
		if (employeeBatchAction.value == "quick_prompt") {
			openEmployeeBatchQuickPromptPopup();
			return;
		}
		if (employeeBatchAction.value == "role_label") {
			openEmployeeBatchRoleLabelPopup();
			return;
		}
		openEmployeeBatchRatePopup();
	}

	function openEmployeeBatchProjectEditor() {
		const ids = employeeBatchSelectedIds.value.slice();
		if (ids.length == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		const first = findEmployeeCard(ids[0]);
		if (first == null) {
			uni.showToast({ title: "员工信息无效", icon: "none" });
			return;
		}
		employeeBatchProjectStaffIds.value = ids;
		openPermPopup(first);
		permTab.value = "project";
		currentEmployeeName.value = `批量配置 · ${ids.length} 人`;
		loadPermProjectTypes(true);
	}

	function openEmployeeBatchSettlementPopup() {
		if (employeeBatchSelectedCount.value == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		employeeBatchSettlementMethod.value = "online";
		employeeBatchSettlementPopupVisible.value = true;
	}

	function closeEmployeeBatchSettlementPopup() {
		if (employeeBatchSaving.value) return;
		employeeBatchSettlementPopupVisible.value = false;
	}

	function selectEmployeeBatchSettlement(method: string) {
		if (employeeBatchSaving.value) return;
		employeeBatchSettlementMethod.value = method == "offline" ? "offline" : "online";
	}

	function submitEmployeeBatchSettlement() {
		const ids = employeeBatchSelectedIds.value.slice();
		const method = employeeBatchSettlementMethod.value;
		if (ids.length == 0 || method == "" || employeeBatchSaving.value) return;
		if (isLocalUiPreview()) {
			for (let i = 0; i < ids.length; i++) {
				const card = findEmployeeCard(ids[i]);
				if (card == null) continue;
				card.settlementMethod = method;
				card.settlementText = method == "online" ? "线上结算" : "线下结算";
			}
			closeEmployeeBatchSettlementPopup();
			cancelEmployeeBatchMode();
			uni.showToast({ title: "结算方式已设置", icon: "success" });
			return;
		}
		employeeBatchSaving.value = true;
		saveStaffSettlementMethod({ ids, settlement_method: method })
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "设置失败"), icon: "none" });
					return;
				}
				for (let i = 0; i < ids.length; i++) {
					const card = findEmployeeCard(ids[i]);
					if (card == null) continue;
					card.settlementMethod = method;
					card.settlementText = method == "online" ? "线上结算" : "线下结算";
				}
				employeeBatchSettlementPopupVisible.value = false;
				cancelEmployeeBatchMode();
				uni.showToast({ title: "结算方式已设置", icon: "success" });
			})
			.catch((err) => uni.showToast({ title: getApiMessage(err, "设置失败"), icon: "none" }))
			.finally(() => { employeeBatchSaving.value = false; });
	}

	function openEmployeeBatchRoleLabelPopup() {
		if (employeeBatchSelectedCount.value == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		employeeBatchRoleLabel.value = "";
		employeeBatchRoleLabelMode.value = "set";
		employeeBatchRoleLabelConfirming.value = false;
		employeeBatchRoleLabelPopupVisible.value = true;
	}

	function closeEmployeeBatchRoleLabelPopup() {
		if (employeeBatchSaving.value) {
			return;
		}
		employeeBatchRoleLabelPopupVisible.value = false;
		employeeBatchRoleLabelConfirming.value = false;
	}

	function selectEmployeeBatchRoleLabelMode(mode: string) {
		if (employeeBatchSaving.value) {
			return;
		}
		employeeBatchRoleLabelMode.value = mode == "reset" ? "reset" : "set";
		employeeBatchRoleLabelConfirming.value = false;
	}

	function backEmployeeBatchRoleLabelEditor() {
		if (employeeBatchSaving.value) {
			return;
		}
		employeeBatchRoleLabelConfirming.value = false;
	}

	function submitEmployeeBatchRoleLabel() {
		const ids = employeeBatchSelectedIds.value.slice();
		const label = employeeBatchRoleLabelMode.value == "reset"
			? ""
			: normalizeCustomRoleLabel(employeeBatchRoleLabel.value);
		if (ids.length == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		if (employeeBatchSaving.value) {
			return;
		}
		if (isLocalUiPreview()) {
			employeeBatchSaving.value = true;
			for (let i = 0; i < ids.length; i++) {
				const card = findEmployeeCard(ids[i]);
				if (card == null) {
					continue;
				}
				saveCustomRoleLabelCache(card.id, label);
				syncEmployeeCardPerm(
					card.id,
					card.enabled ? 1 : 0,
					card.canViewRevenue,
					card.commissionRate,
					card.statusText,
					label
				);
			}
			employeeBatchSaving.value = false;
			closeEmployeeBatchRoleLabelPopup();
			cancelEmployeeBatchMode();
			uni.showToast({
				title: label == "" ? `已恢复 ${ids.length} 名员工标签` : `已更新 ${ids.length} 名员工标签`,
				icon: "success"
			});
			return;
		}
		employeeBatchSaving.value = true;
		let successCount = 0;
		let failCount = 0;
		let finished = 0;

		function finishBatchRoleLabelSave() {
			finished = finished + 1;
			if (finished < ids.length) {
				return;
			}
			employeeBatchSaving.value = false;
			closeEmployeeBatchRoleLabelPopup();
			cancelEmployeeBatchMode();
			if (failCount == 0) {
				uni.showToast({ title: `已更新 ${successCount} 名员工标签`, icon: "success" });
				return;
			}
			uni.showToast({ title: `成功 ${successCount} 名，失败 ${failCount} 名`, icon: "none" });
		}

		for (let i = 0; i < ids.length; i++) {
			const card = findEmployeeCard(ids[i]);
			if (card == null) {
				failCount = failCount + 1;
				finishBatchRoleLabelSave();
				continue;
			}
			const staffStatus = card.enabled ? 1 : 0;
			saveStaffConfig({
				id: card.id,
				status: staffStatus,
				can_view_revenue: card.canViewRevenue,
				commission_rate: card.commissionRate,
				role_label_name: label
			})
				.then((res) => {
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						failCount = failCount + 1;
						return;
					}
					saveCustomRoleLabelCache(card.id, label);
					syncEmployeeCardPerm(
						card.id,
						staffStatus,
						card.canViewRevenue,
						card.commissionRate,
						card.statusText,
						label
					);
					successCount = successCount + 1;
				})
				.catch(() => {
					failCount = failCount + 1;
				})
				.finally(() => {
					finishBatchRoleLabelSave();
				});
		}
	}

	function confirmEmployeeBatchRoleLabel() {
		if (employeeBatchSaving.value || employeeBatchSelectedCount.value == 0) {
			return;
		}
		if (employeeBatchRoleLabelMode.value == "set") {
			const label = normalizeCustomRoleLabel(employeeBatchRoleLabel.value);
			employeeBatchRoleLabel.value = label;
			if (label == "") {
				uni.showToast({ title: "请输入 1-5 个汉字", icon: "none" });
				return;
			}
		}
		employeeBatchRoleLabelConfirming.value = true;
	}

	function openEmployeeBatchQuickPromptPopup() {
		if (employeeBatchSelectedCount.value == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		// 产品规则：快捷提词默认关闭，进入编辑页不沿用其他员工状态。
		employeeBatchQuickPromptEnabled.value = false;
		employeeBatchQuickPromptPopupVisible.value = true;
	}

	function closeEmployeeBatchQuickPromptPopup() {
		if (employeeBatchSaving.value) return;
		employeeBatchQuickPromptPopupVisible.value = false;
		quickPromptPrerequisiteVisible.value = false;
	}

	function onEmployeeBatchQuickPromptSwitch(e: UniSwitchChangeEvent) {
		employeeBatchQuickPromptEnabled.value = e.detail.value;
	}

	function finishQuickPromptPreview(enabled: boolean, openByteProjects: boolean) {
		const ids = employeeBatchSelectedIds.value.slice();
		for (let i = 0; i < ids.length; i++) {
			const card = findEmployeeCard(ids[i]);
			if (card == null) continue;
			card.canQuickPrompt = enabled;
			if (openByteProjects) card.byteProjectEnabled = true;
		}
		quickPromptPrerequisiteVisible.value = false;
		closeEmployeeBatchQuickPromptPopup();
		cancelEmployeeBatchMode();
		uni.showToast({ title: enabled ? "快捷提词已开启" : "快捷提词已关闭", icon: "success" });
	}

	function saveEmployeeBatchQuickPrompt(openByteProjects: boolean) {
		const ids = employeeBatchSelectedIds.value.slice();
		const enabled = employeeBatchQuickPromptEnabled.value;
		if (ids.length == 0 || employeeBatchSaving.value) return;
		if (isLocalUiPreview()) {
			finishQuickPromptPreview(enabled, openByteProjects);
			return;
		}
		employeeBatchSaving.value = true;
		saveStaffQuickPromptPermission({
			ids,
			can_quick_prompt: enabled ? 1 : 0,
			enable_byte_projects: openByteProjects ? 1 : 0
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "设置失败"), icon: "none" });
					return;
				}
				employeeBatchSaving.value = false;
				finishQuickPromptPreview(enabled, openByteProjects);
			})
			.catch((err) => uni.showToast({ title: getApiMessage(err, "设置失败"), icon: "none" }))
			.finally(() => { employeeBatchSaving.value = false; });
	}

	function submitEmployeeBatchQuickPrompt() {
		if (employeeBatchSaving.value || employeeBatchSelectedCount.value == 0) return;
		if (employeeBatchQuickPromptEnabled.value && quickPromptMissingByteProjectCount.value > 0) {
			quickPromptPrerequisiteVisible.value = true;
			return;
		}
		saveEmployeeBatchQuickPrompt(false);
	}

	function cancelQuickPromptPrerequisite() {
		// 选择“否”时按规则保持字节项目与快捷提词均为关闭，并关闭操作弹窗。
		employeeBatchQuickPromptEnabled.value = false;
		quickPromptPrerequisiteVisible.value = false;
		closeEmployeeBatchQuickPromptPopup();
		cancelEmployeeBatchMode();
		uni.showToast({ title: "未开启快捷提词", icon: "none" });
	}

	function confirmQuickPromptWithByteProjects() {
		quickPromptPrerequisiteVisible.value = false;
		saveEmployeeBatchQuickPrompt(true);
	}

	function openEmployeeBatchRatePopup() {
		if (employeeBatchSelectedCount.value == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		syncEmployeeBatchSplitSlider(getEmployeeBatchDefaultSplitRate(), true);
		employeeBatchRatePopupVisible.value = true;
	}

	function closeEmployeeBatchRatePopup() {
		employeeBatchRatePopupVisible.value = false;
	}

	function submitEmployeeBatchCommission() {
		const ids = employeeBatchSelectedIds.value.slice();
		const rate = employeeBatchSplitRate.value;
		if (ids.length == 0) {
			uni.showToast({ title: "请选择员工", icon: "none" });
			return;
		}
		if (rate > 0 && rate < 5) {
			uni.showToast({ title: "分成比例最小为 5%", icon: "none" });
			return;
		}
		if (employeeBatchSaving.value) {
			return;
		}

		employeeBatchSaving.value = true;
		let successCount = 0;
		let failCount = 0;
		let finished = 0;

		function finishBatchSave() {
			finished = finished + 1;
			if (finished < ids.length) {
				return;
			}
			employeeBatchSaving.value = false;
			closeEmployeeBatchRatePopup();
			cancelEmployeeBatchMode();
			if (failCount == 0) {
				uni.showToast({ title: `已成功设置 ${successCount} 名员工`, icon: "success" });
				return;
			}
			uni.showToast({
				title: `成功 ${successCount} 名，失败 ${failCount} 名`,
				icon: "none"
			});
		}

		for (let i = 0; i < ids.length; i++) {
			const card = findEmployeeCard(ids[i]);
			if (card == null) {
				failCount = failCount + 1;
				finishBatchSave();
				continue;
			}
			const staffStatus = card.enabled ? 1 : 0;
			saveStaffConfig({
				id: card.id,
				status: staffStatus,
				can_view_revenue: card.canViewRevenue,
				commission_rate: rate,
				role_label_name: card.customRoleLabel
			})
				.then((res) => {
					const envelope = res as Response | null;
					if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
						failCount = failCount + 1;
						return;
					}
					syncEmployeeCardPerm(
						card.id,
						staffStatus,
						card.canViewRevenue,
						rate,
						card.statusText
					);
					card.commissionRate = rate;
					successCount = successCount + 1;
				})
				.catch(() => {
					failCount = failCount + 1;
				})
				.finally(() => {
					finishBatchSave();
				});
		}
	}

	function confirmEmployeeBatchCommission() {
		if (employeeBatchSaving.value || employeeBatchSelectedCount.value == 0) {
			return;
		}
		if (employeeBatchSplitRate.value > 0 && employeeBatchSplitRate.value < 5) {
			uni.showToast({ title: "分成比例最小为 5%", icon: "none" });
			return;
		}
		uni.showModal({
			title: "提示",
			content: `重新调整将影响所选 ${employeeBatchSelectedCount.value} 名员工的出单比例和数据统计，请确认是否修改？`,
			confirmText: "确认",
			cancelText: "取消",
			success(res) {
				if (res.confirm) {
					submitEmployeeBatchCommission();
				}
			}
		});
	}

	function applyResourceTab(tab: string) {
		const target = tab == "account" ? "task" : tab;
		if (target == "employee" || target == "task" || target == "income") {
			if (target == "task" && taskRecordTab.value != "promotion" && taskRecordTab.value != "backfill") {
				taskRecordTab.value = "promotion";
			}
			if (target == "income" && taskRecordTab.value != "revenue" && taskRecordTab.value != "withdraw") {
				taskRecordTab.value = "revenue";
			}
			resourceTab.value = target;
			if (target == "employee") {
				loadStaffList();
			} else {
				syncPromotionListScope();
				refreshCurrentTaskRecord();
			}
		}
	}

	function syncBusinessResourceTab() {
		const tab = uni.getStorageSync("businessResourceTab") as string;
		if (tab == "employee" || tab == "account" || tab == "task" || tab == "income") {
			applyResourceTab(tab);
			uni.removeStorageSync("businessResourceTab");
		}
	}

	function onBusinessResourceTab(tab: string) {
		applyResourceTab(tab);
	}

	const pendingBusinessHomeAction = ref("");

	function applyPendingBusinessHomeAction() {
		const action = pendingBusinessHomeAction.value;
		if (action == "") return;
		if (action == "ranking") {
			pendingBusinessHomeAction.value = "";
			openRevenueRankPopup();
			return;
		}
		if (action == "settlement" && employeeCards.value.length > 0) {
			pendingBusinessHomeAction.value = "";
			enterEmployeeBatchMode("settlement");
			uni.showToast({ title: "请选择需要设置结算方式的员工", icon: "none" });
		}
	}

	function syncBusinessHomeAction() {
		const action = uni.getStorageSync("businessHomeAction") as string;
		if (action != "ranking" && action != "settlement") return;
		uni.removeStorageSync("businessHomeAction");
		applyResourceTab("employee");
		pendingBusinessHomeAction.value = action;
		applyPendingBusinessHomeAction();
	}

	function onStaffAdvancedUpdated() {
		refreshStaffList(true);
		if (permPopupVisible.value && currentStaffId.value > 0) {
			loadAdvancedManageSummary(currentStaffId.value);
		}
	}

	onMounted(() => {
		updatePageHeight();
		uni.$on("business-resource-tab", onBusinessResourceTab);
		uni.$on("staff-advanced-updated", onStaffAdvancedUpdated);
		syncBusinessResourceTab();
		syncBusinessHomeAction();
		if (resourceTab.value == "employee") {
			loadStaffList();
		} else {
			syncPromotionListScope();
			refreshCurrentTaskRecord();
		}
	});

	onShow(() => {
		syncTabbarRoutePath();
		updatePageHeight();
		syncBusinessHomeAction();
		if (resourceTab.value == "employee") {
			refreshStaffList();
		} else {
			syncPromotionListScope();
			refreshCurrentTaskRecord();
		}
	});

	onUnmounted(() => {
		uni.$off("business-resource-tab", onBusinessResourceTab);
		uni.$off("staff-advanced-updated", onStaffAdvancedUpdated);
	});

	watch(resourceTab, (tab) => {
		closeRevenueRankPopup();
		closeVirtualOrderPopup();
		cancelAccountBatchMode();
		cancelEmployeeBatchMode();
		if (tab == "employee") {
			loadStaffList();
		} else if (tab == "task") {
			if (taskRecordTab.value != "promotion" && taskRecordTab.value != "backfill") {
				taskRecordTab.value = "promotion";
			}
			syncPromotionListScope();
			refreshCurrentTaskRecord();
		} else if (tab == "income") {
			if (taskRecordTab.value != "revenue" && taskRecordTab.value != "withdraw") {
				taskRecordTab.value = "revenue";
			}
			syncPromotionListScope();
			refreshCurrentTaskRecord();
		}
	});

	watch(
		() => employeeCards.value.length,
		() => applyPendingBusinessHomeAction()
	);
</script>

