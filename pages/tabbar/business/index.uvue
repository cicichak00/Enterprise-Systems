		return options.filter((item) => {
			const name = item.name.toLowerCase();
			const collabId = item.collabId.toLowerCase();
			const mobile = item.mobile.toLowerCase();
			return name.indexOf(kw) >= 0 || collabId.indexOf(kw) >= 0 || mobile.indexOf(kw) >= 0;
		});
	});

	const virtualStaffPickerAllSelected = computed(() => {
		const options = filteredVirtualStaffOptions.value;
