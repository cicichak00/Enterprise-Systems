	.bs-unbind-footer {
		padding: 24rpx 0;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-unbind-selected {
		flex: 1;
		font-size: 24rpx;
		color: #6b7280;
	}

	.bs-unbind-confirm {
		min-width: 240rpx;
		height: 76rpx;
		padding: 0 28rpx;
		border-radius: 20rpx;
		background-color: #dc2626;
		display: flex;
		align-items: center;
		justify-content: center;

		&--disabled {
			opacity: 0.45;
		}
	}

	.bs-unbind-confirm-text {
		font-size: 27rpx;
		font-weight: 700;
		color: #ffffff;
	}
}

.bs-departure-balance-card {
