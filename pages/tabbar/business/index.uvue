.bs-employment-balance-desc { margin-top: 5rpx; font-size: 19rpx; line-height: 29rpx; color: #7b8798; }
.bs-employment-balance-value { flex-shrink: 0; font-size: 31rpx; font-weight: 800; color: #2458b8; }
.bs-employment-decision-card--leaving .bs-employment-balance-value { color: #dc2626; }
.bs-employment-impact { margin-top: 16rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background-color: #fff2d8; align-items: flex-start; }
