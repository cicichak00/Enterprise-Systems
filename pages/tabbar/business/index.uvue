		onCopyAccountField(field.value);
	}

	function toStaffListPage(mode: string, accountItem: AccountCard | null = null) {
		const query: UTSJSONObject = {
			mode: mode
		};
		if (accountItem != null && accountItem.id > 0) {
			query["keyword_id"] = `${accountItem.id}`;
			if (accountItem.projectId > 0) {
				query["project_id"] = `${accountItem.projectId}`;
			}
		}
		router.push({
			path: "/pages/user/staff-list",
			query: query
		});
	}

