<style lang="scss">
@use "../../../styles/owner-workbench" as owner;
/* Scoped by the business sheet root because popup content is teleported. */
.bs-perm-popup {
 background: owner.$background;
 .bs-perm-header { padding: 16px 54px 12px; background: #fff; }
 .bs-perm-title { font-size: 17px; line-height: 24px; color: owner.$text; }
 .bs-perm-close { width: 30px; height: 30px; top: 12px; right: 14px; background: #f1f3f8; }
 .bs-perm-tabs { margin: 12px 14px; padding: 3px; border: 0; border-radius: 10px; background: #e8ecf8; gap: 4px; }
 .bs-perm-tab { padding: 8px 0; border-radius: 8px; }
 .bs-perm-tab--active { background: #fff; }
 .bs-perm-tab-text { font-size: 13px; line-height: 20px; color: owner.$muted; }
 .bs-perm-tab--active .bs-perm-tab-text { color: owner.$primary; }
 .bs-perm-tab-line { display: none; }
 .bs-perm-form { padding: 0 14px 16px; }
 .bs-perm-switch-row { padding: 14px; border: 0; border-radius: 12px; background: #fff; margin-bottom: 10px; gap: 10px; }
 .bs-perm-switch-copy { min-width: 0; }
 .bs-perm-switch-title, .bs-perm-settlement-title, .bs-perm-slider-label { font-size: 14px; line-height: 21px; color: owner.$text; }
 .bs-perm-switch-desc, .bs-perm-settlement-subtitle, .bs-perm-settlement-desc { font-size: 12px; line-height: 19px; color: owner.$muted; overflow-wrap: anywhere; }
 .bs-perm-balance-inline { padding-top: 8px; margin-top: 8px; border-color: owner.$border; }
 .bs-perm-balance-inline-label { font-size: 12px; color: owner.$muted; }
 .bs-perm-balance-inline-value { font-size: 14px; color: owner.$primary; }
 .bs-perm-settlement-block, .bs-perm-slider-block { padding: 14px; margin: 0 0 10px; border: 0; border-radius: 12px; background: #fff; }
 .bs-perm-settlement-options { gap: 8px; margin-top: 10px; }
 .bs-perm-settlement-option { min-width: 0; padding: 10px; border: 1px solid owner.$border; border-radius: 9px; background: #f8f9fb; gap: 6px; }
 .bs-perm-settlement-option > view:first-child { min-width: 0; flex: 1; }
 .bs-perm-settlement-option--active { border-color: owner.$primary; background: #eef2ff; }
 .bs-perm-settlement-name { font-size: 13px; line-height: 20px; color: owner.$text; }
 .bs-perm-settlement-radio { flex-shrink: 0; }
 .bs-perm-settlement-radio--active { border-color: owner.$primary; background-color: owner.$primary; }
 .bs-perm-settlement-online-tip { font-size: 11px; line-height: 18px; padding: 8px; border-radius: 8px; margin-top: 8px; }
 .bs-perm-slider-value { font-size: 22px; color: owner.$primary; }
 .bs-perm-footer { padding: 12px 14px calc(12px + env(safe-area-inset-bottom)); border-color: owner.$border; }
 .bs-perm-save-btn { height: 44px; border-radius: 10px; background: owner.$primary; box-shadow: none; }
 .bs-perm-save-text { font-size: 15px; line-height: 22px; }
 .bs-perm-panel--project { padding: 0 14px 12px; }
 .bs-perm-search { border-radius: 9px; }
 .bs-perm-search-btn { background: owner.$primary; border-radius: 8px; }
 .bs-perm-project-name { font-size: 13px; color: owner.$text; }
 .bs-perm-employee-name { display: block; margin-top: 4px; font-size: 12px; line-height: 18px; color: owner.$muted; text-align: center; overflow-wrap: anywhere; }
 .bs-advanced-manage-section--compact { padding: 0 14px; border: 0; border-radius: 12px; background: #fff; box-shadow: none; overflow: hidden; }
 .bs-perm-switch-row--advanced { padding: 14px 0; margin: 0; align-items: center; border-radius: 0; }
 .bs-advanced-manage-section--compact .bs-advanced-manage-on { margin: 0; }
 .bs-inline-field { margin: 0; padding: 14px 0; gap: 12px; border-top: 1px solid owner.$border; align-items: flex-start; flex-direction: column; }
 .bs-inline-field--relation { border: 0; border-top: 1px solid owner.$border; border-radius: 0; background: transparent; }
 .bs-inline-field-copy { padding: 0; width: 100%; }
 .bs-inline-field-label { font-size: 14px; line-height: 21px; font-weight: 600; color: owner.$text; }
 .bs-inline-field-desc { margin-top: 4px; font-size: 12px; line-height: 19px; color: owner.$muted; }
 .bs-inline-role-options { width: 100%; padding: 3px; gap: 4px; box-sizing: border-box; border: 0; border-radius: 10px; background: #f2f3f8; }
 .bs-inline-role-option { flex: 1; min-width: 0; height: 38px; padding: 0 12px; font-size: 14px; border-radius: 8px; color: owner.$muted; }
 .bs-inline-role-option--active { background: #fff; color: owner.$primary; box-shadow: 0 2px 6px rgba(30, 40, 70, .06); }
 .bs-inline-select { width: 100%; min-width: 0; min-height: 42px; height: auto; padding: 10px 12px; gap: 8px; box-sizing: border-box; border: 1px solid owner.$border; background: #f8f9fb; border-radius: 8px; font-size: 13px; line-height: 20px; color: owner.$text; }
 .bs-inline-select > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
 .bs-inline-rate { margin: 0; padding: 14px 0; border-color: owner.$border; }
 .bs-inline-rate-value { font-size: 20px; color: owner.$primary; }
 .bs-inline-scale text { font-size: 11px; color: owner.$muted; }
 .bs-inline-note { font-size: 12px; line-height: 19px; color: owner.$muted; }
 .bs-inline-calculation { margin-top: 10px; padding: 12px; border: 0; border-radius: 8px; background: #f6f7fb; }
 .bs-inline-calculation-title { font-size: 12px; line-height: 19px; color: owner.$text; }
 .bs-inline-calculation-result { font-size: 12px; line-height: 20px; color: owner.$primary; }
 .bs-inline-calculation-desc { font-size: 11px; line-height: 18px; color: owner.$muted; }
 .bs-inline-permission { margin: 0; padding: 14px 0; gap: 12px; border: 0; border-top: 1px solid owner.$border; border-radius: 0; background: transparent; }
 .bs-inline-permission .bs-inline-field-copy { width: auto; }
 .bs-advanced-rule-text { margin: 0; padding: 12px 0 14px; border: 0; border-top: 1px solid owner.$border; border-radius: 0; background: transparent; font-size: 11px; line-height: 18px; color: owner.$muted; }

}

.bs-perm-popup.bs-perm-popup--batch-project {
 .bs-perm-header { padding-top: 11px; padding-bottom: 9px; }
 .bs-perm-title { font-size: 16px; line-height: 22px; }
 .bs-perm-employee-name { margin-top: 1px; font-size: 11px; line-height: 16px; }
 .bs-perm-panel--project { padding: 10px 14px 8px; }
 .bs-batch-project-targets { display: flex; flex-direction: row; align-items: flex-start; gap: 7px; margin: 0 0 10px; padding: 8px 10px; border: 0; border-radius: 8px; background: #eef3ff; }
 .bs-batch-project-target-tip { flex: 1; min-width: 0; margin: 0; font-size: 11px; line-height: 17px; color: #596a90; }
 .bs-perm-search { padding-right: 0; }
 .bs-perm-search-field { height: 38px; margin-right: 0; padding: 0 10px; border-radius: 9px; background: #fff; }
 .bs-perm-search-input { height: 36px; font-size: 12px; }
 .bs-perm-search-placeholder { font-size: 12px; }
 .bs-perm-platform-panel { height: 38px; margin: 6px 0 4px; padding-right: 0; border-bottom: 1px solid owner.$border; }
 .bs-perm-platform-item { margin-right: 22px; padding-bottom: 8px; }
 .bs-perm-platform-text { font-size: 12px; line-height: 20px; }
 .bs-perm-bulk-row { min-height: 42px; margin: 0; padding: 0; border-bottom: 1px solid owner.$border; }
 .bs-perm-bulk-title { font-size: 13px; line-height: 20px; }
 .bs-perm-bulk-desc { font-size: 10px; line-height: 16px; color: owner.$muted; }
 .bs-perm-project-list { padding-right: 0; }
 .bs-perm-project-item { min-height: 52px; margin: 0; padding: 7px 0; border-bottom: 1px solid owner.$border; box-sizing: border-box; }
 .bs-perm-project-logo, .bs-perm-project-icon { width: 34px; height: 34px; margin-right: 10px; border-radius: 8px; }
 .bs-perm-project-name { flex: 1; font-size: 13px; line-height: 20px; }
 .bs-perm-footer { padding-top: 9px; padding-bottom: calc(9px + env(safe-area-inset-bottom)); }
 .bs-perm-save-btn { height: 42px; }
}
.bs-batch-action-popup, .bs-revenue-rank-popup { background: owner.$background; padding: 16px 14px calc(16px + env(safe-area-inset-bottom)); }
.bs-batch-action-popup .bs-batch-action-title, .bs-revenue-rank-popup .bs-revenue-rank-popup-title { font-size: 16px; line-height: 24px; color: owner.$text; }
.bs-batch-action-popup .bs-batch-action-list { border-radius: 12px; margin-top: 12px; }
.bs-batch-action-popup .bs-batch-action-item { min-height: 64px; padding: 12px; border-color: owner.$border; }
.bs-batch-action-popup .bs-batch-action-icon { width: 32px; height: 32px; border-radius: 8px; margin-right: 10px; background: #eef2ff; }
.bs-batch-action-popup .bs-batch-action-title { font-size: 14px; }
.bs-batch-action-popup .bs-batch-action-desc { font-size: 12px; line-height: 18px; color: owner.$muted; }
.bs-revenue-rank-popup .bs-revenue-rank-popup-item { padding: 12px; border-radius: 9px; margin-top: 8px; background: #fff; }
.bs-revenue-rank-popup .bs-revenue-rank-popup-item--active { background: #eef2ff; }
.bs-revenue-rank-popup .bs-revenue-rank-popup-item-text { font-size: 14px; line-height: 22px; color: owner.$text; }
.bs-revenue-rank-popup .bs-revenue-rank-popup-item--active .bs-revenue-rank-popup-item-text { color: owner.$primary; }
</style>

<style lang="scss" scoped>
@use "../../../styles/owner-workbench" as owner;
.bs-employee-panel {
 .bs-search-box { height: 42px; margin-bottom: 8px; }
 .bs-search-input { font-size: 13px; }
 .bs-acc-toolbar--emp { margin-bottom: 10px; align-items: center; gap: 6px; }
 .bs-acc-toolbar-emp-left { flex: 1; min-width: 0; }
 .bs-acc-toolbar--emp .bs-btn--outline { height: 32px; padding: 0 10px; background: #ffffff; border: 1px solid #e3e7ef; border-radius: 8px; box-shadow: none; }
 .bs-acc-toolbar--emp .bs-btn--outline:active { background: #f5f7ff; border-color: #d7def7; }
 .bs-btn-text--plain { font-size: 12px; line-height: 18px; font-weight: 500; color: #4b5568; }
 .bs-emp-card-toggle { flex-shrink: 0; padding-right: 0; }
 .bs-emp-card-toggle-text { font-size: 11px; color: #7c8598; }
 .bs-emp-card { padding: 16px; margin-bottom: 12px; border: 1px solid #eef0f5; border-radius: 16px; box-shadow: none; }
 .bs-emp-head { align-items: flex-start; margin: 0; padding: 0; border: 0; }
 .bs-emp-avatar, .bs-emp-avatar-img { width: 40px; height: 40px; border-radius: 13px; }
 .bs-emp-avatar { margin: 2px 10px 0 0; overflow: hidden; }
 .bs-emp-name { display: block; font-size: 15px; line-height: 22px; color: owner.$text; }
 .bs-emp-meta { gap: 4px; margin-top: 6px; }
 .bs-status-tag, .bs-role-tag, .bs-emp-settlement { padding: 1px 5px; margin: 0; border-radius: 4px; }
 .bs-status-text, .bs-role-tag-text, .bs-emp-settlement { font-size: 10px; line-height: 16px; }
 .bs-status-tag--on { background: #edf7f2; }
 .bs-status-tag--on .bs-status-text { color: #398466; }
 .bs-role-tag { max-width: 100%; }
 .bs-role-tag-text { overflow-wrap: anywhere; }
 .bs-emp-settlement { background: #f5f6f9; color: #7c8598; }
 .bs-emp-settlement--unset { background: #fff6eb; color: #a87535; }
 .bs-emp-group { display: block; margin-top: 5px; font-size: 11px; line-height: 17px; color: owner.$muted; overflow-wrap: anywhere; }
 .bs-emp-actions { margin-left: 8px; flex-shrink: 0; padding-top: 2px; }
 .bs-manage-btn { min-width: 48px; height: 30px; padding: 0 9px; border: 1px solid #e8ecfa; border-radius: 8px; background: #f4f6ff; box-shadow: none; box-sizing: border-box; }
 .bs-manage-text { font-size: 12px; line-height: 18px; color: owner.$primary; }
 .bs-emp-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 14px; padding: 12px 0 0; gap: 14px 10px; border-top: 1px solid #f0f2f6; }
 .bs-stat { width: auto; min-width: 0; margin: 0; padding: 0; }
 .bs-stat-label { font-size: 11px; line-height: 18px; color: #8991a2; }
 .bs-stat-value { margin-top: 3px; font-size: 18px; line-height: 25px; font-weight: 600; letter-spacing: -.3px; color: #414d6b; overflow-wrap: anywhere; }
 .bs-stat-rise { margin-top: 2px; font-size: 10px; line-height: 16px; color: #9aa1af; overflow-wrap: anywhere; }
 .bs-emp-footnote { display: flex; flex-direction: column; gap: 2px; margin-top: 13px; padding-top: 10px; border-top: 1px solid #f0f2f6; }
 .bs-emp-id, .bs-emp-join-time { font-size: 10px; line-height: 16px; color: #99a0ae; overflow-wrap: anywhere; }
 .bs-emp-card--collapsed .bs-emp-footnote { margin-top: 10px; padding-top: 8px; }
 .bs-acc-card--batch-active { border-color: owner.$primary; background: #f8faff; }
}
</style>
