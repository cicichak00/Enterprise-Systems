		return employeeBatchSelectedCount.value > 0 && normalizeCustomRoleLabel(employeeBatchRoleLabel.value) != "";
	});

	const employeeBatchSelectedNames = computed(() => {
		const names: string[] = [];
		const ids = employeeBatchSelectedIds.value;
		for (let i = 0; i < ids.length; i++) {
			const card = findEmployeeCard(ids[i]);
			if (card != null && names.length < 3) {
				names.push(card.name);
