<template>
	<cl-page :pt="{ className: 'bs-page' }">
		<view class="bs-page" :style="pageStyle">
			<cl-safe-area type="top"></cl-safe-area>

			<view class="bs-nav-panel">
				<view class="bs-head">
					<text class="bs-title">运营中心</text>
					<!-- <text class="bs-sub">员工 · 账号 · 财务</text> -->
				</view>

				<view class="bs-subtabs bs-subtabs--operations">
					<view
						class="bs-subtab"
						:class="{ 'bs-subtab--active': resourceTab == 'employee' }"
						@tap="resourceTab = 'employee'"
					>
						<text class="bs-subtab-text">员工管理</text>
						<view v-if="resourceTab == 'employee'" class="bs-subtab-line"></view>
					</view>
					<view
						class="bs-subtab"
						:class="{ 'bs-subtab--active': resourceTab == 'task' }"
						@tap="resourceTab = 'task'"
					>
						<text class="bs-subtab-text">任务管理</text>
						<view v-if="resourceTab == 'task'" class="bs-subtab-line"></view>
					</view>
					<view
						class="bs-subtab"
						:class="{ 'bs-subtab--active': resourceTab == 'income' }"
						@tap="resourceTab = 'income'"
					>
						<text class="bs-subtab-text">收益管理</text>
						<view v-if="resourceTab == 'income'" class="bs-subtab-line"></view>
					</view>
				</view>
			</view>

			<view class="bs-main">
			<view class="bs-main-panel">
				<!-- 员工号：筛选固定 + 列表区下拉刷新/上拉加载 -->
				<view v-if="resourceTab == 'employee'" class="bs-employee-panel">
					<view class="bs-emp-filter-wrap">
						<view class="bs-search-box">
							<view class="bs-search-field">
								<cl-icon name="search-line" :size="16" color="#999999"></cl-icon>
								<input
									class="bs-search-input"
									v-model="employeeKeyword"
									placeholder="输入 ID 或昵称"
									placeholder-class="bs-search-input-placeholder"
									confirm-type="search"
									:disabled="employeeBatchMode"
									@confirm="refreshStaffList"
								/>
							</view>
							<view v-if="!employeeBatchMode" class="bs-btn bs-btn--primary" @tap="refreshStaffList">
								<text class="bs-btn-text bs-btn-text--primary">搜索</text>
							</view>
						</view>
						<view v-if="employeeBatchMode" class="bs-acc-batch-tip">
							<text class="bs-acc-batch-tip-text">{{ employeeBatchTipText }}</text>
						</view>
						<view v-if="!employeeBatchMode" class="bs-acc-toolbar bs-acc-toolbar--emp">
							<view class="bs-acc-toolbar-emp-left">
								<view class="bs-btn bs-btn--outline bs-btn--sm bs-btn--rank" @tap="openRevenueRankPopup">
									<text class="bs-btn-text bs-btn-text--outline bs-btn-text--plain">{{ revenueRankLabel }}</text>
									<cl-icon
										class="bs-revenue-rank-arrow"
										:class="{ 'bs-revenue-rank-arrow--open': revenueRankPopupVisible }"
										name="arrow-down-s-line"
										:size="14"
										color="#333333"
									></cl-icon>
								</view>
								<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="openEmployeeBatchActionPopup">
									<text class="bs-btn-text bs-btn-text--outline bs-btn-text--plain">批量操作</text>
									<cl-icon name="arrow-down-s-line" :size="14" color="#333333"></cl-icon>
								</view>
								<view v-if="staffIsVirtual" class="bs-btn bs-btn--outline bs-btn--sm" @tap="onVirtualOrderTap">
									<text class="bs-btn-text bs-btn-text--outline bs-btn-text--plain">虚拟订单</text>
								</view>
							</view>
							<view class="bs-emp-card-toggle" @tap="toggleEmployeeCardDisplay">
								<text class="bs-emp-card-toggle-text">{{ employeeCardsCollapsed ? "展开数据" : "收起数据" }}</text>
								<cl-icon :name="employeeCardsCollapsed ? 'arrow-down-s-line' : 'arrow-up-s-line'" :size="14" color="#2b59c3"></cl-icon>
							</view>
						</view>
						<view v-if="employeeBatchMode" class="bs-acc-batch-bar">
							<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="cancelEmployeeBatchMode">
								<text class="bs-btn-text bs-btn-text--outline">取消</text>
							</view>
							<text class="bs-acc-batch-count">已选 {{ employeeBatchSelectedCount }} 项</text>
							<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="toggleEmployeeBatchSelectAll">
								<text class="bs-btn-text bs-btn-text--outline">{{ employeeBatchAllSelected ? "取消全选" : "全选" }}</text>
							</view>
						</view>
					</view>

					<scroll-view
						class="bs-emp-scroll"
						:class="{ 'bs-emp-scroll--batch': employeeBatchMode }"
						scroll-y="true"
						:show-scrollbar="false"
						:refresher-enabled="true"
						:refresher-triggered="staffRefresherTriggered"
						refresher-default-style="none"
						refresher-background="#f7f8fa"
						:lower-threshold="120"
						@refresherrefresh="onEmployeeRefresherRefresh"
						@refresherrestore="onEmployeeRefresherRestore"
						@refresherabort="onEmployeeRefresherRestore"
						@scrolltolower="onEmployeeScrollToLower"
					>
						<view
							slot="refresher"
							class="bs-emp-refresher"
						>
							<cl-loading v-if="staffRefresherTriggered" :size="20"></cl-loading>
							<text v-else class="bs-emp-refresher-text">下拉刷新</text>
						</view>

						<view class="bs-emp-scroll-inner" :class="{ 'bs-emp-scroll-inner--batch': employeeBatchMode }">
							<view v-if="staffLoading && employeeCards.length == 0" class="bs-emp-empty">
								<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
								<text class="bs-emp-empty-text bs-emp-empty-text--loading">加载中...</text>
							</view>
							<view v-else>
								<view v-if="employeeCards.length == 0" class="bs-emp-empty">
									<text class="bs-emp-empty-text">暂无员工</text>
								</view>

								<view
									class="bs-emp-card"
									v-for="item in employeeCards"
									:key="'emp-' + item.id"
									:class="{
										'bs-acc-card--batch-active': employeeBatchMode && isEmployeeBatchSelected(item.id),
										'bs-emp-card--collapsed': employeeCardsCollapsed || employeeBatchMode
									}"
									@tap="onEmployeeCardTap(item)"
								>
								<view class="bs-emp-head">
									<view
										v-if="employeeBatchMode"
										class="bs-acc-check bs-emp-check"
										:class="{ 'bs-acc-check--checked': isEmployeeBatchSelected(item.id) }"
									>
										<cl-icon
											v-if="isEmployeeBatchSelected(item.id)"
											name="check-line"
											:size="14"
											color="#ffffff"
										></cl-icon>
									</view>
									<view class="bs-emp-avatar" :style="{ backgroundColor: item.color }">
										<image
											v-if="item.avatarUrl != ''"
											class="bs-emp-avatar-img"
											:src="item.avatarUrl"
											mode="aspectFill"
										></image>
										<text v-else class="bs-emp-avatar-text">{{ item.avatar }}</text>
									</view>
									<view class="bs-emp-info">
										<text class="bs-emp-name">{{ item.name }}</text>
										<view class="bs-emp-meta">
										<view
											class="bs-status-tag"
												:class="item.enabled ? 'bs-status-tag--on' : 'bs-status-tag--off'"
											>
											<text class="bs-status-text">{{ item.statusText }}</text>
										</view>
											<view
												class="bs-role-tag"
												:class="'bs-role-tag--' + item.roleKey"
											>
												<text class="bs-role-tag-text">{{ item.displayRoleText }}</text>
											</view>
											<text class="bs-emp-settlement" :class="'bs-emp-settlement--' + (item.settlementMethod || 'unset')">{{ item.settlementText }}</text>
										</view>
										<text v-if="item.groupNames != ''" class="bs-emp-group">关联小组：{{ item.groupNames }}</text>
									</view>
									<view v-if="!employeeBatchMode" class="bs-emp-actions">
										<view
											class="bs-manage-btn"
											role="button"
											@click.stop="openPermPopup(item)"
										>
											<text class="bs-manage-text">管理</text>
										</view>
									</view>
								</view>
								<view v-if="!employeeCardsCollapsed && !employeeBatchMode" class="bs-emp-grid">
									<view class="bs-stat" v-for="(stat, si) in item.stats" :key="si">
										<text class="bs-stat-label">{{ stat.label }}</text>
										<text class="bs-stat-value">{{ stat.value }}</text>
										<text v-if="stat.rise != ''" class="bs-stat-rise">{{ stat.rise }}</text>
									</view>
								</view>
								<view v-if="!employeeCardsCollapsed && !employeeBatchMode" class="bs-emp-footnote">
									<text class="bs-emp-id">协作 ID：{{ item.collabId }}</text>
									<text class="bs-emp-join-time">加入于 {{ item.joinTime }}</text>
								</view>
							</view>

								<view
									v-if="employeeCards.length > 0"
									class="bs-emp-loadmore"
									@tap="onEmployeeLoadMoreTap"
								>
									<cl-loadmore
										:loading="staffLoadingMore"
										:finish="!staffHasMore"
										finish-text="没有更多了"
										loading-text="加载中..."
									></cl-loadmore>
									<text
										v-if="staffHasMore && !staffLoadingMore"
										class="bs-emp-loadmore-hint"
									>上拉或点击加载更多</text>
								</view>
							</view>
						</view>
					</scroll-view>

					<view v-if="employeeBatchMode" class="bs-acc-batch-footer-wrap">
						<view class="bs-acc-batch-footer">
							<view
								class="bs-acc-batch-confirm"
								:class="{ 'bs-acc-batch-confirm--disabled': employeeBatchSelectedCount == 0 }"
								@tap="openEmployeeBatchEditor"
							>
								<text class="bs-acc-batch-confirm-text">{{ employeeBatchConfirmText }}（{{ employeeBatchSelectedCount }}）</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 推广任务 -->
				<view v-else class="bs-account-panel">
				<view v-if="resourceTab == 'task'" class="bs-transfer-shortcuts">
					<view class="bs-transfer-shortcut bs-transfer-shortcut--pending" @tap="openKeywordTransfer('pending')">
						<view class="bs-transfer-shortcut-icon"><cl-icon name="exchange-funds-line" :size="19" color="#2453aa"></cl-icon></view>
						<view class="bs-transfer-shortcut-copy">
							<text class="bs-transfer-shortcut-title">关键词转赠</text>
							<text class="bs-transfer-shortcut-desc">待转赠关键词与归属变更记录</text>
						</view>
						<text class="bs-transfer-shortcut-action">进入</text>
						<cl-icon name="arrow-right-s-line" :size="17" color="#9aa5b5"></cl-icon>
					</view>
				</view>
				<view v-if="resourceTab == 'task'" class="bs-record-tabs">
					<view
						class="bs-record-tab"
						:class="{ 'bs-record-tab--active': taskRecordTab == 'promotion' }"
						@tap="switchTaskRecordTab('promotion')"
					>
						<text class="bs-record-tab-text">推广任务记录</text>
					</view>
					<view
						class="bs-record-tab"
						:class="{ 'bs-record-tab--active': taskRecordTab == 'backfill' }"
						@tap="switchTaskRecordTab('backfill')"
					>
						<text class="bs-record-tab-text">回填记录</text>
					</view>
				</view>
				<view v-else class="bs-record-tabs">
					<view
						class="bs-record-tab"
						:class="{ 'bs-record-tab--active': taskRecordTab == 'revenue' }"
						@tap="switchTaskRecordTab('revenue')"
					>
						<text class="bs-record-tab-text">收益记录</text>
					</view>
					<view
						class="bs-record-tab"
						:class="{ 'bs-record-tab--active': taskRecordTab == 'withdraw' }"
						@tap="switchTaskRecordTab('withdraw')"
					>
						<text class="bs-record-tab-text">提现记录</text>
					</view>
				</view>
				<scroll-view
					v-if="taskRecordTab == 'promotion'"
					class="bs-main-scroll"
					:class="{ 'bs-main-scroll--batch': accountBatchMode }"
					scroll-y="true"
					:show-scrollbar="false"
					:lower-threshold="120"
					@scrolltolower="onAccountScrollToLower"
				>
				<view class="bs-scroll-inner" :class="{ 'bs-scroll-inner--batch': accountBatchMode }">
					<view class="bs-search-box">
						<view class="bs-search-field">
							<cl-icon name="search-line" :size="16" color="#999999"></cl-icon>
							<input
								class="bs-search-input"
								v-model="accountKeyword"
								placeholder="搜索项目/协作者/推广账户"
								placeholder-class="bs-search-input-placeholder"
								confirm-type="search"
								:disabled="accountBatchMode"
								@confirm="refreshAccountList"
							/>
						</view>
						<view v-if="!accountBatchMode" class="bs-btn bs-btn--primary" @tap="refreshAccountList">
							<text class="bs-btn-text bs-btn-text--primary">搜索</text>
						</view>
					</view>
					<view v-if="accountBatchMode" class="bs-acc-batch-tip">
						<text class="bs-acc-batch-tip-text">请选择要转赠的推广任务</text>
					</view>
					<view v-else>
						<view class="bs-task-filter-grid">
							<picker
								class="bs-task-filter-picker"
								mode="selector"
								:range="accountStatusOptions"
								range-key="label"
								:value="accountStatusIndex"
								@change="onAccountStatusChange"
							>
								<view class="bs-task-filter-inner">
									<text class="bs-task-filter-value">{{ accountStatusOptions[accountStatusIndex].label }}</text>
									<cl-icon name="arrow-down-s-line" :size="13" color="#64748b"></cl-icon>
								</view>
							</picker>
							<picker
								class="bs-task-filter-picker"
								mode="selector"
								:range="accountStaffOptions"
								range-key="label"
								:value="accountStaffIndex"
								@change="onAccountStaffChange"
							>
								<view class="bs-task-filter-inner">
									<text class="bs-task-filter-value">{{ accountStaffOptions[accountStaffIndex].label }}</text>
									<cl-icon name="arrow-down-s-line" :size="13" color="#64748b"></cl-icon>
								</view>
							</picker>
						</view>
						<scroll-view class="bs-task-category-scroll" scroll-x="true" :show-scrollbar="false">
							<view class="bs-task-categories">
								<view
									v-for="(category, categoryIndex) in accountCategoryOptions"
									:key="category.value"
									class="bs-task-category"
									:class="{ 'bs-task-category--active': accountCategoryIndex == categoryIndex }"
									@tap="selectAccountCategory(categoryIndex)"
								>
									<text class="bs-task-category-text">{{ category.label }}</text>
								</view>
							</view>
							</scroll-view>
						</view>
						<view v-if="accountBatchMode" class="bs-acc-batch-bar">
						<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="cancelAccountBatchMode">
							<text class="bs-btn-text bs-btn-text--outline">取消</text>
						</view>
						<text class="bs-acc-batch-count">已选 {{ accountBatchSelectedCount }} 项</text>
						<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="toggleAccountBatchSelectAll">
							<text class="bs-btn-text bs-btn-text--outline">{{ accountBatchAllSelected ? "取消全选" : "全选" }}</text>
						</view>
					</view>

					<view v-if="accountLoading && accountCards.length == 0" class="bs-acc-state">
						<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
						<text class="bs-acc-state-text bs-acc-state-text--loading">加载中...</text>
					</view>
					<view v-else-if="!accountLoading && accountCards.length == 0" class="bs-acc-state">
						<text class="bs-acc-state-text">暂无推广任务记录</text>
					</view>

					<view
						class="bs-acc-card"
						v-for="(item, index) in accountCards"
						:key="item.id"
						:class="{ 'bs-acc-card--batch-active': accountBatchMode && isAccountBatchSelected(item.id) }"
						@tap="onAccountCardTap(item)"
					>
						<view class="bs-acc-head">
							<view
								v-if="accountBatchMode"
								class="bs-acc-check"
								:class="{ 'bs-acc-check--checked': isAccountBatchSelected(item.id) }"
							>
								<cl-icon
									v-if="isAccountBatchSelected(item.id)"
									name="check-line"
									:size="14"
									color="#ffffff"
								></cl-icon>
							</view>
							<cl-icon v-else name="user-line" :size="18" color="#999999"></cl-icon>
							<text class="bs-acc-status">{{ item.status }}</text>
						</view>
						<view class="bs-acc-body">
							<view
								class="bs-acc-row"
								:class="{ 'bs-acc-row--copyable': field.copyable }"
								v-for="(field, fieldIndex) in item.expandFields"
								:key="item.id + '-' + field.field + '-' + fieldIndex"
								@tap.stop="onAccountFieldTap(field)"
							>
								<text class="bs-acc-label">{{ field.label }}</text>
								<text class="bs-acc-value">{{ field.value }}</text>
								<text
									v-if="field.copyable && field.value != ''"
									class="bs-acc-copy"
									@tap.stop="onCopyAccountField(field.value)"
								>复制</text>
							</view>
						</view>
						<view class="bs-acc-foot">
							<text class="bs-acc-time">{{ item.timeLabel }}: {{ item.createdAt || "—" }}</text>
							<text class="bs-acc-project-type">{{ item.projectTypeLabel }}</text>
						</view>
					</view>

					<view v-if="accountCards.length > 0" class="bs-acc-loadmore" @tap="onAccountLoadMoreTap">
						<cl-loadmore
							:loading="accountLoadingMore"
							:finish="!accountHasMore"
							finish-text="没有更多了"
							loading-text="加载中..."
						></cl-loadmore>
					</view>
				</view>
				</scroll-view>

				<scroll-view
					v-else
					class="bs-main-scroll"
					scroll-y="true"
					:show-scrollbar="false"
					:lower-threshold="120"
					@scrolltolower="onEnterpriseRecordScrollToLower"
				>
					<view class="bs-scroll-inner bs-record-scroll-inner">
						<view class="bs-search-box">
							<view class="bs-search-field">
								<cl-icon name="search-line" :size="16" color="#999999"></cl-icon>
								<input
									class="bs-search-input"
									v-model="enterpriseRecordKeyword"
									:placeholder="taskRecordTab == 'backfill' ? '搜索关键词' : (taskRecordTab == 'revenue' ? '搜索关键词/昵称/项目名' : '搜索提现昵称/用户ID')"
									placeholder-class="bs-search-input-placeholder"
									confirm-type="search"
									@confirm="refreshEnterpriseRecordList"
								/>
							</view>
							<view class="bs-btn bs-btn--primary" @tap="refreshEnterpriseRecordList">
								<text class="bs-btn-text bs-btn-text--primary">搜索</text>
							</view>
						</view>

						<view v-if="taskRecordTab == 'revenue' || taskRecordTab == 'withdraw'" class="bs-task-filter-grid bs-record-filter-grid">
							<picker
								class="bs-task-filter-picker"
								mode="selector"
								:range="taskRecordTab == 'revenue' ? revenueStatusOptions : withdrawStatusOptions"
								range-key="label"
								:value="enterpriseStatusIndex"
								@change="onEnterpriseStatusChange"
							>
								<view class="bs-task-filter-inner">
									<text class="bs-task-filter-value">{{ enterpriseStatusLabel }}</text>
									<cl-icon name="arrow-down-s-line" :size="13" color="#64748b"></cl-icon>
								</view>
							</picker>
							<picker
								class="bs-task-filter-picker"
								mode="selector"
								:range="enterpriseOrderOptions"
								range-key="label"
								:value="enterpriseOrderIndex"
								@change="onEnterpriseOrderChange"
							>
								<view class="bs-task-filter-inner">
									<text class="bs-task-filter-value">{{ enterpriseOrderOptions[enterpriseOrderIndex].label }}</text>
									<cl-icon name="arrow-down-s-line" :size="13" color="#64748b"></cl-icon>
								</view>
							</picker>
						</view>

						<view v-if="enterpriseRecordLoading && currentEnterpriseRecordCards.length == 0" class="bs-acc-state">
							<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
							<text class="bs-acc-state-text bs-acc-state-text--loading">加载中...</text>
						</view>
						<view v-else-if="enterpriseRecordError != '' && currentEnterpriseRecordCards.length == 0" class="bs-record-error">
							<text class="bs-record-error-title">记录加载失败</text>
							<text class="bs-record-error-text">{{ enterpriseRecordError }}</text>
							<view class="bs-record-retry" @tap="refreshEnterpriseRecordList">
								<text class="bs-record-retry-text">重新加载</text>
							</view>
						</view>
						<view v-else-if="!enterpriseRecordLoading && currentEnterpriseRecordCards.length == 0" class="bs-acc-state">
							<text class="bs-acc-state-text">{{ enterpriseRecordEmptyText }}</text>
						</view>

						<view class="bs-record-card" v-for="item in currentEnterpriseRecordCards" :key="item.id">
							<view class="bs-record-card-head">
								<view class="bs-record-card-title-wrap">
									<text class="bs-record-card-title">{{ item.title }}</text>
									<text class="bs-record-card-no">{{ item.recordNo }}</text>
								</view>
								<text class="bs-record-status" :class="'bs-record-status--' + item.statusTone">{{ item.status }}</text>
							</view>
							<view class="bs-record-card-body">
								<view class="bs-record-field" v-for="(field, fieldIndex) in item.fields" :key="item.id + '-' + fieldIndex">
									<text class="bs-record-field-label">{{ field.label }}</text>
									<text class="bs-record-field-value">{{ field.value || '—' }}</text>
									<text v-if="field.copyable && field.value != ''" class="bs-record-field-copy" @tap.stop="onCopyAccountField(field.value)">复制</text>
								</view>
							</view>
							<view class="bs-record-card-foot">
								<text class="bs-record-card-time">{{ item.timeLabel }} {{ item.createdAt || '—' }}</text>
							</view>
						</view>

						<view v-if="currentEnterpriseRecordCards.length > 0" class="bs-acc-loadmore" @tap="onEnterpriseRecordLoadMoreTap">
							<cl-loadmore
								:loading="enterpriseRecordLoadingMore"
								:finish="!enterpriseRecordHasMore"
								finish-text="没有更多了"
								loading-text="加载中..."
							></cl-loadmore>
						</view>
					</view>
				</scroll-view>

				<view v-if="taskRecordTab == 'promotion' && accountBatchMode" class="bs-acc-batch-footer-wrap">
					<view class="bs-acc-batch-footer">
						<view
							class="bs-acc-batch-confirm"
							:class="{ 'bs-acc-batch-confirm--disabled': accountBatchSelectedCount == 0 }"
							@tap="confirmAccountBatchTransfer"
						>
							<text class="bs-acc-batch-confirm-text">确认转赠（{{ accountBatchSelectedCount }}）</text>
						</view>
					</view>
				</view>
				</view>
			</view>
			</view>
		</view>

		<custom-tabbar :show-spacer="false"></custom-tabbar>

		<cl-popup
			v-model="permPopupVisible"
			direction="bottom"
			size="92%"
			:show-header="false"
			:show-close="false"
			:swipeClose="false"
			:pt="{ className: 'bs-perm-popup-wrap' }"
			:maskClosable="false"
		>
			<view class="bs-perm-popup" :class="{ 'bs-perm-popup--batch-project': employeeBatchProjectStaffIds.length > 0 }">
				<view class="bs-perm-header">
					<text class="bs-perm-title">{{ employeeBatchProjectStaffIds.length > 0 ? "项目管理" : "权限管理" }}</text>
					<text class="bs-perm-employee-name">{{ employeeBatchProjectStaffIds.length > 0 ? "已选 " + employeeBatchProjectStaffIds.length + " 人 · 保存后统一生效" : currentEmployeeName }}</text>
					<view class="bs-perm-close" @tap="onPermCloseTap">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>

				<view v-if="employeeBatchProjectStaffIds.length == 0" class="bs-perm-tabs">
					<view
						class="bs-perm-tab"
						:class="{ 'bs-perm-tab--active': permTab == 'perm' }"
						@tap="switchPermTab('perm')"
					>
						<text class="bs-perm-tab-text">员工权限</text>
						<view v-if="permTab == 'perm'" class="bs-perm-tab-line"></view>
					</view>
					<view
						class="bs-perm-tab"
						:class="{ 'bs-perm-tab--active': permTab == 'project' }"
						@tap="switchPermTab('project')"
					>
						<text class="bs-perm-tab-text">项目管理</text>
						<view v-if="permTab == 'project'" class="bs-perm-tab-line"></view>
					</view>
				</view>

				<view class="bs-perm-body">
					<view class="bs-perm-panel-shell">
					<view v-show="permTab == 'perm'" class="bs-perm-panel bs-perm-panel--perm">
						<view class="bs-perm-form-scroll-wrap">
						<scroll-view class="bs-perm-form-scroll" scroll-y="true" :show-scrollbar="false">
						<view class="bs-perm-form">
						<view class="bs-perm-switch-row bs-perm-switch-row--employment" :class="{ 'bs-perm-switch-row--leaving': initialManagePermEnabled && !managePermEnabled }">
							<view class="bs-perm-switch-copy">
								<text class="bs-perm-switch-title">管理权限</text>
								<text class="bs-perm-switch-desc">{{ managePermEnabled ? "开启后员工状态为在职中，关闭则为离职" : "关闭后员工状态变更为离职" }}</text>
								<view class="bs-perm-balance-inline">
									<text class="bs-perm-balance-inline-label">当前待提现金额</text>
									<text class="bs-perm-balance-inline-value">¥{{ formatRevenueAmount(currentEmployeePendingWithdrawalAmount) }}</text>
								</view>
							</view>
							<view class="bs-perm-native-switch">
								<switch :checked="managePermEnabled" activeBackgroundColor="#2b59c3" backgroundColor="#e8e8e8" @change="onManagePermSwitchChange" />
							</view>
						</view>
						<view class="bs-perm-switch-row">
							<view class="bs-perm-switch-copy">
								<text class="bs-perm-switch-title">收益数据</text>
								<text class="bs-perm-switch-desc">开启后协作者可观看收益数据</text>
							</view>
							<view class="bs-perm-native-switch">
								<switch
									:checked="incomePermEnabled"
									activeBackgroundColor="#2b59c3"
									backgroundColor="#e8e8e8"
									@change="onIncomePermSwitchChange"
								/>
							</view>
						</view>
						<view class="bs-perm-settlement-block">
							<text class="bs-perm-settlement-title">员工结算方式</text>
							<text class="bs-perm-settlement-subtitle">仅调整结算归属与钱包权限，不改变分成比例计算</text>
							<view class="bs-perm-settlement-options">
								<view class="bs-perm-settlement-option" :class="{ 'bs-perm-settlement-option--active': currentSettlementMethod == 'offline' }" @tap="currentSettlementMethod = 'offline'"><view><text class="bs-perm-settlement-name">线下结算</text><text class="bs-perm-settlement-desc">订单可见，收益归企业主</text></view><view class="bs-perm-settlement-radio" :class="{ 'bs-perm-settlement-radio--active': currentSettlementMethod == 'offline' }"></view></view>
								<view class="bs-perm-settlement-option" :class="{ 'bs-perm-settlement-option--active': currentSettlementMethod == 'online' }" @tap="currentSettlementMethod = 'online'"><view><text class="bs-perm-settlement-name">线上结算</text><text class="bs-perm-settlement-desc">订单归员工，可提现</text></view><view class="bs-perm-settlement-radio" :class="{ 'bs-perm-settlement-radio--active': currentSettlementMethod == 'online' }"></view></view>
							</view>
							<text v-if="currentSettlementMethod == 'online'" class="bs-perm-settlement-online-tip">员工钱包允许开启，分成订单可提现，并将新订单数据推送主站</text>
						</view>

						<view class="bs-perm-slider-block">
							<view class="bs-perm-slider-head">
								<view class="bs-perm-slider-head-left">
									<text class="bs-perm-slider-label">分成比例</text>
									<text class="bs-perm-slider-value">{{ splitRate }}%</text>
								</view>
							</view>
							<view class="bs-perm-slider-box">
								<slider
									:key="'perm-split-' + currentStaffId + '-' + permSliderKey"
									class="bs-perm-native-slider"
									:value="splitSliderValue"
									:min="0"
									:max="100"
									:step="1"
									activeColor="#2b59c3"
									activeBackgroundColor="#2b59c3"
									backgroundColor="#e8e8e8"
									block-color="#2b59c3"
									foreColor="#2b59c3"
									:block-size="16"
									:show-value="false"
									@change="onSplitRateSliderChange"
									@changing="onSplitRateSliderChanging"
								/>
							</view>
							<view class="bs-perm-slider-marks">
								<text
									v-for="stop in splitStops"
									:key="stop"
									class="bs-perm-slider-mark"
									:class="{ 'bs-perm-slider-mark--active': splitRate >= stop }"
								>{{ stop }}</text>
							</view>
						</view>

						<view class="bs-advanced-manage-section bs-advanced-manage-section--compact">
							<view class="bs-perm-switch-row bs-perm-switch-row--advanced">
								<view class="bs-perm-switch-copy">
									<text class="bs-perm-switch-title">进阶管理</text>
									<text class="bs-perm-switch-desc">按员工身份与归属关系设置分佣</text>
								</view>
								<view class="bs-perm-native-switch">
									<switch
										:checked="advancedManageEnabled"
										:disabled="advancedManageLoading || advancedManageSaving || !managePermEnabled"
										activeBackgroundColor="#2b59c3"
										backgroundColor="#e8e8e8"
										@change="onAdvancedManageSwitchChange"
									/>
								</view>
							</view>
							<view v-if="advancedManageLoading" class="bs-advanced-manage-loading">
								<cl-loading :size="18"></cl-loading>
								<text class="bs-advanced-manage-loading-text">读取进阶配置中...</text>
							</view>
							<view v-else-if="advancedManageEnabled" class="bs-advanced-manage-on">

								<view class="bs-inline-field">
									<view class="bs-inline-field-copy">
										<view class="bs-inline-step-title">
											<text class="bs-inline-field-label">员工身份</text>
										</view>
										<text class="bs-inline-field-desc">选择身份后设置对应的归属关系</text>
									</view>
									<view class="bs-inline-role-options">
										<view
											class="bs-inline-role-option"
											:class="{ 'bs-inline-role-option--active': advancedManageRole == 'leader' }"
											@tap="selectInlineAdvancedRole('leader')"
										><text>小组长</text></view>
										<view
											class="bs-inline-role-option"
											:class="{ 'bs-inline-role-option--active': advancedManageRole == 'member' }"
											@tap="selectInlineAdvancedRole('member')"
										><text>组员</text></view>
									</view>
								</view>

								<view
									v-if="advancedManageRole == 'leader'"
									class="bs-inline-field bs-inline-field--relation"
								>
									<view class="bs-inline-field-copy">
										<view class="bs-inline-step-title">
											<text class="bs-inline-field-label">关联组员</text>
										</view>
										<text class="bs-inline-field-desc">
											可选择多名在职普通员工
										</text>
									</view>
									<view
										class="bs-inline-select"
										@tap="openInlineAdvancedCandidate('member')"
									>
										<text>{{ advancedManageMemberCount > 0 ? '已选 ' + advancedManageMemberCount + ' 人' : '选择员工' }}</text>
										<cl-icon name="arrow-down-s-line" :size="16" color="#6b7280"></cl-icon>
									</view>
								</view>

								<view v-if="advancedManageRole == 'member'" class="bs-inline-field">
									<view class="bs-inline-field-copy">
										<text class="bs-inline-field-label">所属小组长</text>
										<text class="bs-inline-field-desc">一名组员只能归属一名在职小组长</text>
									</view>
									<view class="bs-inline-select" @tap="openInlineAdvancedCandidate('leader')">
										<text>{{ advancedManageLeaderName || '选择小组长' }}</text>
										<cl-icon name="arrow-down-s-line" :size="16" color="#6b7280"></cl-icon>
									</view>
								</view>

								<view v-if="advancedManageRole != 'normal'" class="bs-inline-rate">
									<view class="bs-inline-rate-head">
										<text class="bs-inline-field-label">{{ advancedManageRole == 'leader' ? '小组长分成比例' : '组员分成比例' }}</text>
										<text class="bs-inline-rate-value">{{ advancedManagePersonalRate }}%</text>
									</view>
									<slider
										:value="advancedManagePersonalRate"
										:min="0"
										:max="advancedManageRole == 'member' ? advancedMemberPersonalRateMax : 100"
										:step="1"
										activeColor="#2b59c3"
										backgroundColor="#e5e7eb"
										block-color="#2b59c3"
										:block-size="18"
										@changing="onInlinePersonalRateChange"
										@change="onInlinePersonalRateChange"
									/>
									<view class="bs-inline-scale">
										<text>0</text><text>20</text><text>40</text><text>60</text><text>80</text><text>100</text>
									</view>
									<text v-if="advancedManageRole == 'member'" class="bs-inline-note">不得高于所属小组长个人分成 {{ advancedMemberPersonalRateMax }}%</text>
								</view>

								<view v-if="advancedManageRole == 'leader'" class="bs-inline-rate">
									<view class="bs-inline-rate-head">
										<text class="bs-inline-field-label">业绩分成比例</text>
										<text class="bs-inline-rate-value">{{ advancedManageTeamRate }}%</text>
									</view>
									<slider
										:value="advancedManageTeamRate"
										:min="0"
										:max="100"
										:step="1"
										activeColor="#2b59c3"
										backgroundColor="#e5e7eb"
										block-color="#2b59c3"
										:block-size="18"
										@changing="onInlineTeamRateChange"
										@change="onInlineTeamRateChange"
									/>
									<view class="bs-inline-scale">
										<text>0</text><text>20</text><text>40</text><text>60</text><text>80</text><text>100</text>
									</view>
									<text class="bs-inline-note">业绩分成比例用于分配小组长收益池，可独立设置 0%-100%。</text>
									<view class="bs-inline-calculation">
										<text class="bs-inline-calculation-title">100 元订单分配示例</text>
										<text class="bs-inline-calculation-result">企业主 {{ advancedEnterpriseShareExample }} 元 · 组员 {{ advancedMemberShareExample }} 元 · 小组长 {{ advancedLeaderShareExample }} 元</text>
										<text class="bs-inline-calculation-desc">先按小组长分成比例划出 {{ advancedManagePersonalRate }} 元，再从该收益池按业绩分成比例分给组员。</text>
									</view>
								</view>

								<view v-if="advancedManageRole == 'leader'" class="bs-inline-permission">
									<view class="bs-inline-field-copy">
										<text class="bs-inline-field-label">小组长权限配置</text>
										<text class="bs-inline-field-desc">允许查看名下组员订单、个人收益和做单统计</text>
									</view>
									<view class="bs-inline-permission-switch">
										<switch
											:checked="advancedManageCanViewSubordinate"
											activeBackgroundColor="#2b59c3"
											backgroundColor="#e8e8e8"
											@change="onInlineSubordinatePermissionChange"
										/>
									</view>
								</view>
							</view>
							<text v-if="advancedManageEnabled" class="bs-advanced-rule-text">保存后，新订单按进阶规则分佣，历史订单不变。关闭后恢复普通员工；小组长需先解除全部关联组员。</text>
						</view>
						</view>
						</scroll-view>
						</view>
						<view v-if="permDetailLoading" class="bs-perm-loading-mask">
							<cl-loading :size="24"></cl-loading>
							<text class="bs-perm-loading-text">加载中...</text>
						</view>
					</view>

					<view v-show="permTab == 'project'" class="bs-perm-panel bs-perm-panel--project">
						<view v-if="employeeBatchProjectStaffIds.length > 0" class="bs-batch-project-targets">
							<cl-icon name="information-line" :size="16" color="#5375ed"></cl-icon>
							<text class="bs-batch-project-target-tip">当前以首位员工配置为模板，修改后将覆盖全部已选员工</text>
						</view>
						<view class="bs-perm-search">
							<view class="bs-perm-search-field">
								<view class="bs-perm-search-icon">
									<cl-icon name="search-line" :size="18" color="#999999"></cl-icon>
								</view>
								<input
									class="bs-perm-search-input"
									v-model="projKeyword"
									placeholder="搜索项目名称"
									placeholder-class="bs-perm-search-placeholder"
									confirm-type="search"
									@confirm="searchStaffProjectList"
								/>
							</view>
							<view v-if="employeeBatchProjectStaffIds.length == 0" class="bs-perm-search-btn" @tap="searchStaffProjectList">
								<text class="bs-perm-search-btn-text">搜索</text>
							</view>
						</view>

						<view class="bs-perm-platform-panel">
							<cl-tabs
								v-model="activeProjectTypeId"
								:list="projectTypeTabList"
								height="64rpx"
								:gutter="0"
								:show-line="false"
                                scroll-align="previous"
								:pt="projectTypeTabsPt"
								@change="onPermProjectTypeTabChange"
							>
								<template #item="{ item, active }">
									<view
										class="bs-perm-platform-item"
										:class="{ 'bs-perm-platform-item--active': active }"
									>
										<text
											class="bs-perm-platform-text"
											:class="{ 'bs-perm-platform-text--active': active }"
										>{{ item.label }}</text>
										<view v-if="active" class="bs-perm-platform-line"></view>
									</view>
								</template>
							</cl-tabs>
							<view
								v-if="projectTypesLoading && projectTypes.length == 0"
								class="bs-perm-platform-loading"
							>
								<text class="bs-perm-platform-text">加载中...</text>
							</view>
						</view>

						<view v-if="projectPermList.length > 0" class="bs-perm-bulk-row">
							<view class="bs-perm-bulk-copy"><text class="bs-perm-bulk-title">{{ employeeBatchProjectStaffIds.length > 0 ? "本分类全选" : "一键操作" }}</text><text v-if="employeeBatchProjectStaffIds.length > 0" class="bs-perm-bulk-desc">统一开启或关闭</text></view>
							<view class="bs-perm-project-switch">
								<view class="bs-perm-native-switch">
									<switch
										:checked="projectBulkAllEnabled"
										activeBackgroundColor="#2b59c3"
										backgroundColor="#e8e8e8"
										@change="onProjectBulkSwitchChange"
									/>
								</view>
							</view>
						</view>

						<view class="bs-perm-project-scroll-wrap">
						<scroll-view
							v-if="!projectLoading || projectLoadingMore"
							class="bs-perm-project-scroll"
							scroll-y="true"
							:show-scrollbar="false"
							@scrolltolower="loadMoreStaffProjectList"
						>
							<view class="bs-perm-project-list">
								<view v-if="projectPermList.length == 0 && !projectLoading" class="bs-perm-project-empty">
									<text class="bs-perm-project-empty-text">暂无项目</text>
								</view>
								<view
									class="bs-perm-project-item"
									v-for="item in projectPermList"
									:key="'proj-' + item.id"
								>
									<image
										v-if="item.logo != ''"
										class="bs-perm-project-logo"
										:src="item.logo"
										mode="aspectFill"
									/>
									<view v-else class="bs-perm-project-icon" :style="{ backgroundColor: item.iconBg }">
										<text
											class="bs-perm-project-icon-text"
											:class="{ 'bs-perm-project-icon-text--emoji': item.iconEmoji }"
										>{{ item.icon }}</text>
									</view>
									<text class="bs-perm-project-name">{{ item.name }}</text>
									<view class="bs-perm-project-switch">
										<view class="bs-perm-native-switch">
											<switch
												:checked="item.enabled"
												activeBackgroundColor="#2b59c3"
												backgroundColor="#e8e8e8"
												@change="onProjectPermSwitchChange(item.id, $event as UniSwitchChangeEvent)"
											/>
										</view>
									</view>
								</view>
								<view
									v-if="!projectLoading && projectPermList.length > 0 && projectLoadingMore"
									class="bs-perm-project-more"
								>
									<text class="bs-perm-project-more-text">加载中...</text>
								</view>
								<view
									v-else-if="!projectLoading && projectPermList.length > 0 && !projectHasMore"
									class="bs-perm-project-more"
								>
									<text class="bs-perm-project-more-text">没有更多了</text>
								</view>
							</view>
						</scroll-view>
						<view v-if="projectLoading && !projectLoadingMore" class="bs-perm-project-loading-mask">
							<cl-loading :size="24"></cl-loading>
							<text class="bs-perm-loading-text">加载中...</text>
						</view>
						</view>
					</view>
					</view>
				</view>

				<view class="bs-perm-footer">
					<view
						class="bs-perm-save-btn"
						:class="{
							'bs-perm-save-btn--disabled': permSaving,
							'bs-perm-save-btn--saving': permSaving
						}"
						@tap="savePermConfig"
					>
						<cl-loading v-if="permSaving" :loading="true" :size="18" color="#ffffff"></cl-loading>
						<text class="bs-perm-save-text">{{ permSaving ? "保存中..." : employeeBatchProjectStaffIds.length > 0 ? "保存并统一到 " + employeeBatchProjectStaffIds.length + " 人" : initialManagePermEnabled && !managePermEnabled ? "确认离职并保存" : "保存设置" }}</text>
					</view>
					<cl-safe-area type="bottom"></cl-safe-area>
				</view>
			</view>
		</cl-popup>

		<cl-popup
			v-model="departureConfirmVisible"
			direction="center"
			size="640rpx"
			:show-header="false"
			:show-close="false"
			:swipe-close="false"
			:mask-closable="false"
			:pt="{ className: 'bs-departure-confirm-wrap' }"
		>
			<view class="bs-departure-confirm">
				<text class="bs-departure-confirm-title">员工状态变动确认</text>
				<view class="bs-departure-confirm-balance">
					<text class="bs-departure-confirm-balance-label">当前员工余额</text>
					<text class="bs-departure-confirm-balance-value">¥{{ formatRevenueAmount(currentEmployeePendingWithdrawalAmount) }}</text>
				</view>
				<text class="bs-departure-confirm-copy">员工离职后，该笔待提现金额将回收至企业主收益里，请确认是否将员工状态变更为离职？</text>
				<text class="bs-departure-confirm-ps">PS：离职回收记录可在“我的”页面企业主收益卡片中查看。</text>
				<view class="bs-departure-confirm-actions">
					<view class="bs-departure-confirm-cancel" @tap="cancelDepartureConfirm"><text>取消</text></view>
					<view class="bs-departure-confirm-submit" @tap="confirmDepartureSave"><text>确认离职</text></view>
				</view>
			</view>
		</cl-popup>

		<cl-popup
			v-model="advancedCandidatePopupVisible"
			direction="bottom"
			size="68%"
			:show-header="false"
			:show-close="false"
			:swipe-close="false"
			:mask-closable="false"
		>
			<view class="bs-perm-popup">
			<view class="bs-inline-picker">
				<view class="bs-inline-picker-head">
					<view class="bs-inline-picker-cancel" @tap="closeInlineAdvancedCandidate">
						<text>取消</text>
					</view>
					<text class="bs-inline-picker-title">{{ advancedCandidateTitle }}</text>
					<view
						v-if="advancedCandidateType == 'member'"
						class="bs-inline-picker-all"
						@tap="toggleInlineAdvancedSelectAll"
					>
						<text>{{ advancedSelectableAllSelected ? "取消全选" : "全选" }}</text>
					</view>
					<view v-else class="bs-inline-picker-all"></view>
				</view>
				<view v-if="advancedCandidateLoading" class="bs-inline-picker-state">
					<cl-loading :loading="true" :size="24"></cl-loading>
					<text>加载中...</text>
				</view>
				<scroll-view v-else class="bs-inline-picker-list" scroll-y="true" :show-scrollbar="false">
					<view
						v-for="item in advancedCandidates"
						:key="'advanced-candidate-' + item.id"
						class="bs-inline-picker-row"
						:class="{ 'bs-inline-picker-row--disabled': item.disabled }"
						@tap="selectInlineAdvancedCandidate(item)"
					>
						<view
							class="bs-inline-picker-check"
							:class="{ 'bs-inline-picker-check--active': isInlineAdvancedCandidateSelected(item.id) }"
						>
							<cl-icon v-if="isInlineAdvancedCandidateSelected(item.id)" name="check-line" :size="13" color="#ffffff"></cl-icon>
						</view>
						<view class="bs-inline-picker-avatar"><text>{{ getAvatarText(item.name) }}</text></view>
						<view class="bs-inline-picker-copy">
							<text class="bs-inline-picker-name">{{ item.name }}</text>
							<text
								class="bs-inline-picker-meta"
								:class="{ 'bs-inline-picker-meta--disabled': item.disabled }"
							>{{ item.disabled ? item.disabledReason : item.meta }}</text>
						</view>
						<text v-if="item.disabled" class="bs-inline-picker-unavailable">不可关联</text>
					</view>
					<view v-if="advancedCandidates.length == 0" class="bs-inline-picker-empty">
						<text>{{ advancedCandidateType == 'leader' ? '暂无可选小组长' : '当前账号下暂无员工' }}</text>
					</view>
				</scroll-view>
				<view v-if="advancedCandidateType == 'member'" class="bs-inline-picker-footer">
					<view class="bs-inline-picker-footer-cancel" @tap="closeInlineAdvancedCandidate">
						<text>取消</text>
					</view>
					<view class="bs-inline-picker-footer-confirm" @tap="confirmInlineAdvancedMembers">
						<text>确认选择（{{ advancedCandidateSelectedIds.length }}）</text>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
			</view>
		</cl-popup>

		<cl-popup
			v-model="employeeBatchActionPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-batch-action-popup-wrap' }"
		>
			<view class="bs-batch-action-popup">
				<view class="bs-batch-rate-header">
					<view class="bs-batch-action-head-copy">
						<text class="bs-batch-rate-title">批量操作</text>
						<text class="bs-batch-action-subtitle">统一管理员工展示与基础配置</text>
					</view>
					<view class="bs-batch-rate-close" @tap="closeEmployeeBatchActionPopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view class="bs-batch-action-list">
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('commission')">
						<view class="bs-batch-action-icon"><cl-icon name="percent-line" :size="18" color="#2b59c3"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<text class="bs-batch-action-title">设置分成</text>
							<text class="bs-batch-action-desc">选择员工后统一调整常规分成比例</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('settlement')">
						<view class="bs-batch-action-icon"><cl-icon name="bank-card-line" :size="18" color="#2b59c3"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<text class="bs-batch-action-title">设置结算方式</text>
							<text class="bs-batch-action-desc">线下结算或线上结算，支持单人及多人设置</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('role_label')">
						<view class="bs-batch-action-icon"><cl-icon name="price-tag-3-line" :size="18" color="#2b59c3"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<text class="bs-batch-action-title">自定义标签</text>
							<text class="bs-batch-action-desc">统一设置姓名旁标签，不改变员工真实角色</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('quick_prompt')">
						<view class="bs-batch-action-icon bs-batch-action-icon--prompt"><cl-icon name="message-3-line" :size="18" color="#7c3aed"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<view class="bs-batch-action-title-row">
								<text class="bs-batch-action-title">快捷提词</text>
								<text class="bs-batch-action-default-tag">默认关闭</text>
							</view>
							<text class="bs-batch-action-desc">控制员工字节项目中的快捷提词组件</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('project')">
						<view class="bs-batch-action-icon"><cl-icon name="apps-2-line" :size="18" color="#2b59c3"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<text class="bs-batch-action-title">项目管理</text>
							<text class="bs-batch-action-desc">统一配置所选员工可使用的项目</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
					<view class="bs-batch-action-item" @tap="selectEmployeeBatchAction('wallet')">
						<view class="bs-batch-action-icon"><cl-icon name="wallet-line" :size="18" color="#2b59c3"></cl-icon></view>
						<view class="bs-batch-action-copy">
							<text class="bs-batch-action-title">设置钱包</text>
							<text class="bs-batch-action-desc">统一调整员工钱包相关权限</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="18" color="#9aa6b6"></cl-icon>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="employeeBatchSettlementPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-batch-rate-popup-wrap' }"
		>
			<view class="bs-batch-rate-popup bs-settlement-popup">
				<view class="bs-batch-rate-header">
					<view class="bs-batch-action-head-copy">
						<text class="bs-batch-label-eyebrow">员工收益归属</text>
						<text class="bs-batch-rate-title">设置结算方式</text>
					</view>
					<view class="bs-batch-rate-close" @tap="closeEmployeeBatchSettlementPopup"><cl-icon name="close-line" :size="18" color="#999999"></cl-icon></view>
				</view>
				<view class="bs-batch-label-selection">
					<view class="bs-batch-label-selection-top"><text class="bs-batch-label-selection-title">应用员工</text><text class="bs-batch-label-selection-count">已选 {{ employeeBatchSelectedCount }} 人</text></view>
					<text class="bs-batch-label-selection-names">{{ employeeBatchSelectedNames }}</text>
				</view>
				<view class="bs-settlement-options">
					<view class="bs-settlement-option" :class="{ 'bs-settlement-option--active': employeeBatchSettlementMethod == 'offline' }" @tap="selectEmployeeBatchSettlement('offline')">
						<view class="bs-settlement-option-head"><text class="bs-settlement-option-title">线下结算</text><cl-icon v-if="employeeBatchSettlementMethod == 'offline'" name="checkbox-circle-fill" :size="19" color="#2b59c3"></cl-icon></view>
						<text class="bs-settlement-option-desc">员工可查看分成订单，但钱包禁止开启；订单收益划分至企业主。</text>
					</view>
					<view class="bs-settlement-option" :class="{ 'bs-settlement-option--active': employeeBatchSettlementMethod == 'online' }" @tap="selectEmployeeBatchSettlement('online')">
						<view class="bs-settlement-option-head"><text class="bs-settlement-option-title">线上结算</text><cl-icon v-if="employeeBatchSettlementMethod == 'online'" name="checkbox-circle-fill" :size="19" color="#2b59c3"></cl-icon></view>
						<text class="bs-settlement-option-desc">员工分成订单可见、可提现并归属员工；订单数据同步主站。</text>
					</view>
				</view>
				<text class="bs-settlement-tip" :class="{ 'bs-settlement-tip--online': employeeBatchSettlementMethod == 'online' }">{{ employeeBatchSettlementMethod == 'online' ? '员工钱包允许开启，分成订单可提现，并将新订单数据推送主站' : '所选员工钱包将关闭且不可开启，订单收益划入企业主' }}</text>
				<view class="bs-batch-rate-confirm" :class="{ 'bs-batch-rate-confirm--disabled': employeeBatchSaving }" @tap="submitEmployeeBatchSettlement">
					<cl-loading v-if="employeeBatchSaving" :loading="true" :size="18" color="#ffffff"></cl-loading>
					<text class="bs-batch-rate-confirm-text">{{ employeeBatchSaving ? "保存中..." : "确认设置" }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="employeeBatchQuickPromptPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-batch-rate-popup-wrap' }"
		>
			<view class="bs-batch-rate-popup bs-quick-prompt-popup">
				<view class="bs-batch-rate-header">
					<view class="bs-batch-action-head-copy">
						<text class="bs-batch-label-eyebrow">字节组件管理</text>
						<text class="bs-batch-rate-title">批量设置快捷提词</text>
					</view>
					<view class="bs-batch-rate-close" @tap="closeEmployeeBatchQuickPromptPopup"><cl-icon name="close-line" :size="18" color="#999999"></cl-icon></view>
				</view>
				<view class="bs-batch-label-selection">
					<view class="bs-batch-label-selection-top"><text class="bs-batch-label-selection-title">应用员工</text><text class="bs-batch-label-selection-count">已选 {{ employeeBatchSelectedCount }} 人</text></view>
					<text class="bs-batch-label-selection-names">{{ employeeBatchSelectedNames }}</text>
				</view>
				<view class="bs-quick-prompt-switch-card">
					<view class="bs-quick-prompt-switch-copy">
						<view class="bs-quick-prompt-title-row"><cl-icon name="message-3-line" :size="19" color="#7c3aed"></cl-icon><text class="bs-quick-prompt-title">快捷提词</text></view>
						<text class="bs-quick-prompt-desc">开启后，员工可在已开放的字节项目中使用组合提词和快捷提词组件。</text>
					</view>
					<switch :checked="employeeBatchQuickPromptEnabled" color="#7c3aed" @change="onEmployeeBatchQuickPromptSwitch" />
				</view>
				<view class="bs-quick-prompt-rule">
					<text class="bs-quick-prompt-rule-title">开启规则</text>
					<text class="bs-quick-prompt-rule-text">开启前将校验员工是否已有字节项目；缺少项目权限时，需要确认是否同时开放字节项目。</text>
				</view>
				<view class="bs-batch-rate-confirm" :class="{ 'bs-batch-rate-confirm--disabled': employeeBatchSaving }" @tap="submitEmployeeBatchQuickPrompt">
					<cl-loading v-if="employeeBatchSaving" :loading="true" :size="18" color="#ffffff"></cl-loading>
					<text class="bs-batch-rate-confirm-text">{{ employeeBatchSaving ? "保存中..." : "确认设置" }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup v-model="quickPromptPrerequisiteVisible" direction="center" size="620rpx" :show-header="false" :show-close="false" :mask-closable="false" :swipe-close="false" :pt="{ className: 'bs-quick-prompt-confirm-wrap' }">
			<view class="bs-quick-prompt-confirm">
				<view class="bs-quick-prompt-confirm-icon"><cl-icon name="exchange-line" :size="28" color="#ffffff"></cl-icon></view>
				<text class="bs-quick-prompt-confirm-title">是否开启字节项目？</text>
				<text class="bs-quick-prompt-confirm-desc">快捷功能主要服务字节任务，当前员工不可见字节系项目，是否同步开启？</text>
				<view class="bs-quick-prompt-visible-card"><text>开放后可见组件</text><view><text>组合提词</text><text>快捷提词</text></view></view>
				<view class="bs-quick-prompt-confirm-actions"><view class="bs-quick-prompt-confirm-cancel" @tap="cancelQuickPromptPrerequisite"><text>暂不开启</text></view><view class="bs-quick-prompt-confirm-submit" @tap="confirmQuickPromptWithByteProjects"><text>同时开放</text></view></view>
			</view>
		</cl-popup>

		<cl-popup
			v-model="employeeBatchRoleLabelPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-batch-rate-popup-wrap' }"
		>
			<view class="bs-batch-rate-popup bs-batch-label-popup">
				<view class="bs-batch-rate-header">
					<view class="bs-batch-label-head-copy">
						<text class="bs-batch-label-eyebrow">员工展示管理</text>
						<text class="bs-batch-rate-title">批量自定义标签</text>
					</view>
					<view class="bs-batch-rate-close" @tap="closeEmployeeBatchRoleLabelPopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view class="bs-batch-label-selection">
					<view class="bs-batch-label-selection-top">
						<text class="bs-batch-label-selection-title">应用员工</text>
						<text class="bs-batch-label-selection-count">已选 {{ employeeBatchSelectedCount }} 人</text>
					</view>
					<text class="bs-batch-label-selection-names">{{ employeeBatchSelectedNames }}</text>
				</view>

				<view v-if="!employeeBatchRoleLabelConfirming" class="bs-batch-label-editor">
					<text class="bs-batch-label-section-title">选择操作方式</text>
					<view class="bs-batch-label-mode-row">
						<view
							class="bs-batch-label-mode"
							:class="{ 'bs-batch-label-mode--active': employeeBatchRoleLabelMode == 'set' }"
							@tap="selectEmployeeBatchRoleLabelMode('set')"
						>
							<text class="bs-batch-label-mode-title">统一自定义</text>
							<text class="bs-batch-label-mode-desc">设置同一个展示标签</text>
						</view>
						<view
							class="bs-batch-label-mode"
							:class="{ 'bs-batch-label-mode--active': employeeBatchRoleLabelMode == 'reset' }"
							@tap="selectEmployeeBatchRoleLabelMode('reset')"
						>
							<text class="bs-batch-label-mode-title">恢复系统标签</text>
							<text class="bs-batch-label-mode-desc">按真实角色自动显示</text>
						</view>
					</view>

					<view v-if="employeeBatchRoleLabelMode == 'set'" class="bs-batch-role-label-field">
						<view class="bs-batch-label-field-head">
							<text class="bs-batch-label-section-title">标签名称</text>
							<text class="bs-role-label-count">{{ employeeBatchRoleLabel.length }}/5</text>
						</view>
						<view class="bs-role-label-input-wrap">
							<input
								:value="employeeBatchRoleLabel"
								class="bs-role-label-input"
								:maxlength="5"
								placeholder="请输入 1-5 个汉字"
								placeholder-class="bs-role-label-placeholder"
								@input="onEmployeeBatchRoleLabelInput"
							/>
						</view>
						<text class="bs-batch-role-label-note">仅支持汉字，最多 5 个字符</text>
					</view>

					<view class="bs-batch-label-preview-card">
						<text class="bs-batch-label-section-title">展示预览</text>
						<view class="bs-batch-label-preview-line">
							<view class="bs-batch-label-avatar"><text class="bs-batch-label-avatar-text">员</text></view>
							<text class="bs-role-label-preview-name">员工姓名</text>
							<view class="bs-role-label-preview-tag">
								<text class="bs-role-label-preview-tag-text">{{ employeeBatchRoleLabelPreview }}</text>
							</view>
						</view>
					</view>

					<view class="bs-batch-label-scope">
						<text class="bs-batch-label-scope-title">影响范围</text>
						<text class="bs-batch-label-scope-text">仅修改员工姓名旁的展示标签，不改变真实角色、权限、分成比例和小组关系。</text>
					</view>
				</view>

				<view v-else class="bs-batch-label-review">
					<text class="bs-batch-label-review-title">请确认本次批量操作</text>
					<view class="bs-batch-label-review-row">
						<text class="bs-batch-label-review-key">操作员工</text>
						<text class="bs-batch-label-review-value">{{ employeeBatchSelectedCount }} 人</text>
					</view>
					<view class="bs-batch-label-review-row">
						<text class="bs-batch-label-review-key">操作内容</text>
						<text class="bs-batch-label-review-value">{{ employeeBatchRoleLabelTargetText }}</text>
					</view>
					<view class="bs-batch-label-review-notice">
						<text class="bs-batch-label-review-notice-text">保存后立即更新所选员工的名称旁标签，业务身份和数据规则保持不变。</text>
					</view>
				</view>

				<view class="bs-batch-label-footer">
					<view class="bs-batch-label-secondary" @tap="employeeBatchRoleLabelConfirming ? backEmployeeBatchRoleLabelEditor() : closeEmployeeBatchRoleLabelPopup()">
						<text class="bs-batch-label-secondary-text">{{ employeeBatchRoleLabelConfirming ? "返回修改" : "取消" }}</text>
					</view>
					<view
						class="bs-batch-label-primary"
						:class="{ 'bs-batch-label-primary--disabled': !employeeBatchRoleLabelCanContinue || employeeBatchSaving }"
						@tap="employeeBatchRoleLabelConfirming ? submitEmployeeBatchRoleLabel() : confirmEmployeeBatchRoleLabel()"
					>
						<cl-loading v-if="employeeBatchSaving" :loading="true" :size="18" color="#ffffff"></cl-loading>
						<text class="bs-batch-label-primary-text">{{ employeeBatchSaving ? "保存中..." : (employeeBatchRoleLabelConfirming ? "确认保存" : "下一步") }}</text>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="employeeBatchRatePopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-batch-rate-popup-wrap' }"
		>
			<view class="bs-batch-rate-popup">
				<view class="bs-batch-rate-header">
					<text class="bs-batch-rate-title">批量设置分成比例</text>
					<view class="bs-batch-rate-close" @tap="closeEmployeeBatchRatePopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<text
					class="bs-batch-rate-desc"
					:class="{ 'bs-batch-rate-desc--compact': employeeBatchCommissionRatesDifferent }"
				>
					将为已选 {{ employeeBatchSelectedCount }} 名员工统一设置分成比例
				</text>
				<text v-if="employeeBatchCommissionRatesDifferent" class="bs-batch-rate-warn">
					当前选中员工分佣比例不同，确认调整后将按新设置比例展示
				</text>
				<view class="bs-perm-slider-block">
					<view class="bs-perm-slider-head">
						<view class="bs-perm-slider-head-left">
							<text class="bs-perm-slider-label">分成比例</text>
							<text class="bs-perm-slider-value">{{ employeeBatchSplitRate }}%</text>
						</view>
					</view>
					<view class="bs-perm-slider-box">
						<slider
							:key="'emp-batch-split-' + employeeBatchSliderKey"
							class="bs-perm-native-slider"
							:value="employeeBatchSplitSliderValue"
							:min="0"
							:max="100"
							:step="1"
							activeColor="#2b59c3"
							activeBackgroundColor="#2b59c3"
							backgroundColor="#e8e8e8"
							block-color="#2b59c3"
							foreColor="#2b59c3"
							:block-size="16"
							:show-value="false"
							@change="onEmployeeBatchSplitChange"
							@changing="onEmployeeBatchSplitChanging"
						/>
					</view>
				</view>
				<view
					class="bs-batch-rate-confirm"
					:class="{ 'bs-batch-rate-confirm--disabled': employeeBatchSaving }"
					@tap="confirmEmployeeBatchCommission"
				>
					<cl-loading v-if="employeeBatchSaving" :loading="true" :size="18" color="#ffffff"></cl-loading>
					<text class="bs-batch-rate-confirm-text">{{ employeeBatchSaving ? "保存中..." : "确认设置" }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="revenueRankPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-revenue-rank-popup-wrap' }"
		>
			<view class="bs-revenue-rank-popup">
				<view class="bs-revenue-rank-popup-head">
					<text class="bs-revenue-rank-popup-title">员工排序</text>
					<view class="bs-revenue-rank-popup-close" @tap="closeRevenueRankPopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view
					class="bs-revenue-rank-popup-item"
					:class="{ 'bs-revenue-rank-popup-item--active': staffOrder == 'asc' }"
					@tap="selectStaffOrder('asc')"
				>
					<text class="bs-revenue-rank-popup-item-text">从低到高</text>
					<cl-icon
						v-if="staffOrder == 'asc'"
						name="check-line"
						:size="18"
						color="#2b59c3"
					></cl-icon>
				</view>
				<view
					class="bs-revenue-rank-popup-item"
					:class="{ 'bs-revenue-rank-popup-item--active': staffOrder == 'desc' }"
					@tap="selectStaffOrder('desc')"
				>
					<text class="bs-revenue-rank-popup-item-text">从高到低</text>
					<cl-icon
						v-if="staffOrder == 'desc'"
						name="check-line"
						:size="18"
						color="#2b59c3"
					></cl-icon>
				</view>
				<view class="bs-revenue-rank-popup-item" :class="{ 'bs-revenue-rank-popup-item--active': staffOrder == 'join_desc' }" @tap="selectStaffOrder('join_desc')">
					<text class="bs-revenue-rank-popup-item-text">最新加入</text>
					<cl-icon v-if="staffOrder == 'join_desc'" name="check-line" :size="18" color="#2b59c3"></cl-icon>
				</view>
				<view class="bs-revenue-rank-popup-item" :class="{ 'bs-revenue-rank-popup-item--active': staffOrder == 'join_asc' }" @tap="selectStaffOrder('join_asc')">
					<text class="bs-revenue-rank-popup-item-text">最早加入</text>
					<cl-icon v-if="staffOrder == 'join_asc'" name="check-line" :size="18" color="#2b59c3"></cl-icon>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="virtualOrderPopupVisible"
			direction="bottom"
			size="auto"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-virtual-order-popup-wrap' }"
		>
			<view class="bs-virtual-order-popup">
				<view class="bs-batch-rate-header">
					<text class="bs-batch-rate-title">发放虚拟订单</text>
					<view class="bs-batch-rate-close" @tap="closeVirtualOrderPopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view class="bs-vo-form">
					<view class="bs-vo-field">
						<text class="bs-vo-label">选择员工</text>
						<view class="bs-vo-select" @tap="openVirtualStaffPicker">
							<text
								class="bs-vo-select-text"
								:class="{ 'bs-vo-select-text--placeholder': virtualStaffSelectedIds.length == 0 }"
							>{{ virtualStaffSelectLabel }}</text>
							<cl-icon name="arrow-down-s-line" :size="16" color="#999999"></cl-icon>
						</view>
					</view>
					<view class="bs-vo-field">
						<text class="bs-vo-label">虚拟订单金额</text>
						<view class="bs-vo-input-wrap">
							<input
								class="bs-vo-input"
								:key="virtualOrderAmountInputKey"
								:value="virtualOrderAmount"
								type="digit"
								inputmode="decimal"
								placeholder="请输入虚拟订单金额"
								placeholder-class="bs-vo-input-placeholder"
								@input="onVirtualOrderAmountInput"
								@blur="onVirtualOrderAmountBlur"
							/>
						</view>
						<text class="bs-vo-field-tip">每位员工均将获得上述设置的虚拟订单金额</text>
					</view>
					<view class="bs-vo-field">
						<text class="bs-vo-label">关键词</text>
						<view class="bs-vo-select" @tap="openVirtualKeywordPicker">
							<text
								class="bs-vo-select-text"
								:class="{ 'bs-vo-select-text--placeholder': virtualKeywordSelectedId == 0 }"
							>{{ virtualKeywordSelectLabel }}</text>
							<cl-icon name="arrow-down-s-line" :size="16" color="#999999"></cl-icon>
						</view>
					</view>
				</view>
				<view
					class="bs-batch-rate-confirm"
					:class="{ 'bs-batch-rate-confirm--disabled': virtualOrderSubmitting }"
					@tap="confirmVirtualOrder"
				>
					<cl-loading v-if="virtualOrderSubmitting" :loading="true" :size="18" color="#ffffff"></cl-loading>
					<text class="bs-batch-rate-confirm-text">{{ virtualOrderSubmitting ? "提交中..." : "确认发放" }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="virtualStaffPickerVisible"
			direction="bottom"
			size="60%"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-vo-staff-picker-wrap' }"
		>
			<view class="bs-vo-staff-picker">
				<view class="bs-vo-staff-picker-head">
					<text class="bs-vo-staff-picker-title">选择员工</text>
					<view class="bs-vo-staff-picker-close" @tap="closeVirtualStaffPicker">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view class="bs-vo-staff-picker-search">
					<cl-icon name="search-line" :size="16" color="#999999"></cl-icon>
					<input
						class="bs-vo-staff-picker-search-input"
						v-model="virtualStaffPickerKeyword"
						placeholder="输入昵称"
						placeholder-class="bs-vo-staff-picker-search-placeholder"
						confirm-type="search"
					/>
				</view>
				<view class="bs-vo-staff-picker-bar">
					<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="toggleVirtualStaffSelectAll">
						<text class="bs-btn-text bs-btn-text--outline bs-btn-text--plain">{{ virtualStaffPickerAllSelected ? "取消全选" : "全选" }}</text>
					</view>
					<text class="bs-vo-staff-picker-count">已选 {{ virtualStaffPickerDraftIds.length }} 人</text>
					<view class="bs-btn bs-btn--outline bs-btn--sm" @tap="confirmVirtualStaffPicker">
						<text class="bs-btn-text bs-btn-text--outline bs-btn-text--plain">确定</text>
					</view>
				</view>
				<scroll-view class="bs-vo-staff-picker-scroll" scroll-y="true" :show-scrollbar="false">
					<view v-if="virtualStaffLoading" class="bs-vo-staff-picker-state">
						<cl-loading :loading="true" :size="24" color="#2b59c3"></cl-loading>
						<text class="bs-vo-staff-picker-state-text">加载中...</text>
					</view>
					<view v-else-if="virtualStaffOptions.length == 0" class="bs-vo-staff-picker-state">
						<text class="bs-vo-staff-picker-state-text">暂无员工</text>
					</view>
					<view v-else-if="filteredVirtualStaffOptions.length == 0" class="bs-vo-staff-picker-state">
						<text class="bs-vo-staff-picker-state-text">无匹配员工</text>
					</view>
					<view
						v-else
						class="bs-vo-staff-item"
						v-for="item in filteredVirtualStaffOptions"
						:key="'vo-staff-' + item.id"
						@tap="toggleVirtualStaffPickerSelect(item.id)"
					>
						<view
							class="bs-acc-check bs-vo-staff-check"
							:class="{ 'bs-acc-check--checked': isVirtualStaffPickerSelected(item.id) }"
						>
							<cl-icon
								v-if="isVirtualStaffPickerSelected(item.id)"
								name="check-line"
								:size="14"
								color="#ffffff"
							></cl-icon>
						</view>
						<view class="bs-vo-staff-item-main">
							<text class="bs-vo-staff-item-name">{{ item.name }}</text>
						</view>
					</view>
				</scroll-view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<cl-popup
			v-model="virtualKeywordPickerVisible"
			direction="bottom"
			size="50%"
			:show-header="false"
			:show-close="false"
			:pt="{ className: 'bs-vo-staff-picker-wrap' }"
		>
			<view class="bs-vo-staff-picker">
				<view class="bs-vo-staff-picker-head">
					<text class="bs-vo-staff-picker-title">选择关键词</text>
					<view class="bs-vo-staff-picker-close" @tap="closeVirtualKeywordPicker">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<view class="bs-vo-staff-picker-search">
					<cl-icon name="search-line" :size="16" color="#999999"></cl-icon>
					<input
						class="bs-vo-staff-picker-search-input"
						v-model="virtualKeywordPickerKeyword"
						placeholder="请输入关键词"
						placeholder-class="bs-vo-staff-picker-search-placeholder"
						confirm-type="search"
						@confirm="refreshVirtualKeywordOptions"
					/>
				</view>
				<scroll-view
					class="bs-vo-staff-picker-scroll"
					scroll-y="true"
					:show-scrollbar="false"
					:lower-threshold="80"
					@scrolltolower="onVirtualKeywordScrollToLower"
				>
					<view v-if="virtualKeywordLoading && virtualKeywordOptions.length == 0" class="bs-vo-staff-picker-state">
						<cl-loading :loading="true" :size="24" color="#2b59c3"></cl-loading>
						<text class="bs-vo-staff-picker-state-text">加载中...</text>
					</view>
					<view v-else-if="virtualKeywordOptions.length == 0" class="bs-vo-staff-picker-state">
						<text class="bs-vo-staff-picker-state-text">{{ virtualKeywordPickerKeyword.trim() != "" ? "无匹配关键词" : "暂无关键词" }}</text>
					</view>
					<view
						v-else
						class="bs-vo-staff-item"
						v-for="item in virtualKeywordOptions"
						:key="'vo-keyword-' + item.id"
						@tap="selectVirtualKeyword(item.id)"
					>
						<view
							class="bs-acc-check bs-vo-staff-check"
							:class="{ 'bs-acc-check--checked': virtualKeywordSelectedId == item.id }"
						>
							<cl-icon
								v-if="virtualKeywordSelectedId == item.id"
								name="check-line"
								:size="14"
								color="#ffffff"
							></cl-icon>
						</view>
						<view class="bs-vo-staff-item-main">
							<text class="bs-vo-staff-item-name">{{ item.label }}</text>
						</view>
					</view>
					<view
						v-if="virtualKeywordOptions.length > 0"
						class="bs-vo-staff-picker-loadmore"
						@tap="onVirtualKeywordLoadMoreTap"
					>
						<cl-loadmore
							:loading="virtualKeywordLoadingMore"
							:finish="!virtualKeywordHasMore"
							finish-text="没有更多了"
							loading-text="加载中..."
						></cl-loadmore>
					</view>
				</scroll-view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>

		<batch-wallet-popup
			v-model="batchWalletPopupVisible"
			@confirm="onBatchWalletConfirm"
		></batch-wallet-popup>

		<cl-popup
			v-model="unbindPopupVisible"
			direction="bottom"
			:show-header="false"
			:show-close="false"
			:swipe-close="false"
			:pt="{ className: 'bs-unbind-popup-wrap', inner: { className: 'bs-unbind-popup-inner' } }"
		>
			<view class="bs-unbind-popup">
				<view class="bs-unbind-popup-head">
					<text class="bs-unbind-popup-cancel" @tap="closeUnbindPopup">取消</text>
					<view class="bs-unbind-popup-title-wrap">
						<text class="bs-unbind-popup-title">解绑组员</text>
						<text class="bs-unbind-popup-sub">{{ unbindLeaderName }}</text>
					</view>
					<text class="bs-unbind-popup-all" @tap="toggleUnbindSelectAll">{{ unbindAllSelected ? "取消全选" : "全选" }}</text>
				</view>
				<scroll-view class="bs-unbind-list" scroll-y="true" :show-scrollbar="false">
					<view
						v-for="member in unbindMembers"
						:key="'unbind-' + member.id"
						class="bs-unbind-row"
						@tap="toggleUnbindMember(member.id)"
					>
						<view class="bs-unbind-check" :class="{ 'bs-unbind-check--checked': isUnbindSelected(member.id) }">
							<cl-icon v-if="isUnbindSelected(member.id)" name="check-line" :size="14" color="#ffffff"></cl-icon>
						</view>
						<view class="bs-unbind-member">
							<text class="bs-unbind-member-name">{{ member.name }}</text>
							<text class="bs-unbind-member-meta">{{ member.meta }}</text>
						</view>
						<text class="bs-unbind-single" @tap.stop="unbindSingleMember(member.id)">解绑</text>
					</view>
				</scroll-view>
				<view class="bs-unbind-footer">
					<text class="bs-unbind-selected">已选 {{ unbindSelectedIds.length }} 人</text>
					<view
						class="bs-unbind-confirm"
						:class="{ 'bs-unbind-confirm--disabled': unbindSelectedIds.length == 0 || unbindSaving }"
						@tap="submitUnbindMembers"
					>
						<text class="bs-unbind-confirm-text">{{ unbindSaving ? "处理中..." : "确认解绑" }}</text>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="uts">
	export default {
		onShow() {
			const tab = uni.getStorageSync("businessResourceTab") as string;
			if (tab == "employee" || tab == "account" || tab == "task" || tab == "income") {
				uni.$emit("business-resource-tab", tab);
				uni.removeStorageSync("businessResourceTab");
			}
		}
	};
</script>

<script lang="ts" setup>
	import { computed, onMounted, onUnmounted, ref, watch } from "vue";
	import { getEnterprisePromotionKeywordList, getVirtualKeywordList } from "@/.cool/api/keyword";
	import {
		getEnterpriseBackfillRecordList,
		getEnterpriseRevenueRecordList,
		getEnterpriseWithdrawRecordList
	} from "@/.cool/api/enterprise-record";
	import { issueVirtualOrder } from "@/.cool/api/order";
	import { getProjectTypes } from "@/.cool/api/project";
	import {
		getStaffAdvancedCandidates,
		getStaffAdvancedDetail,
		getStaffDetail,
		getStaffList,
		getStaffProjectList,
		saveStaffQuickPromptPermission,
		saveStaffConfig,
		saveStaffAdvancedConfig,
		saveStaffProjectConfig,
		saveStaffSettlementMethod,
		unbindStaffGroupMembers,
		type GetStaffListParams
	} from "@/.cool/api/staff";
	import { getApiMessage, isApiSuccess, router } from "@/.cool";
	import type {
		KeywordAssignableItem,
		KeywordExpandItem,
		KeywordListItem,
		Response,
		StaffAdvancedCandidate,
		StaffAdvancedDetail,
		StaffAdvancedRole,
		StaffListItem,
		StaffGroupMemberItem,
		StaffProjectItem,
		StaffStats
	} from "@/.cool";
	import type { ClTabsItem } from "@/uni_modules/cool-ui/types/index";
	import type { ProjectTypeItem } from "@/.cool/types/project";
	import CustomTabbar from "@/components/tabbar.uvue";
	import BatchWalletPopup from "@/components/business/batch-wallet-popup.uvue";
	import { syncTabbarRoutePath } from "@/.cool/store/tabbar";
	import { isLocalUiPreview } from "@/.cool/utils/local-preview";

	type ProjectTypeFilterItem = {
		id: number;
		label: string;
	};

	type StatItem = { label: string; value: string; rise: string };
	type StaffFilterOption = { label: string; value: string };
	type EmployeeBatchAction = "commission" | "role_label" | "quick_prompt" | "settlement" | "project";
	type StaffSettlementMethod = "" | "offline" | "online";
	type UnbindMemberCard = { id: number; name: string; meta: string };
	type AdvancedCandidateRow = {
		id: number;
		name: string;
		meta: string;
		personalRate: number;
		disabled: boolean;
		disabledReason: string;
	};
	type EmployeeCard = {
		id: number;
		avatar: string;
		avatarUrl: string;
		color: string;
		name: string;
		enabled: boolean;
		statusText: string;
		collabId: string;
		joinTime: string;
		settlementMethod: StaffSettlementMethod;
		settlementText: string;
		canViewRevenue: boolean;
		commissionRate: number;
		pendingWithdrawalAmount: number;
		byteProjectEnabled: boolean;
		canQuickPrompt: boolean;
		roleKey: string;
		roleText: string;
		customRoleLabel: string;
		displayRoleText: string;
		groupNames: string;
		groupMembers: UnbindMemberCard[];
		stats: StatItem[];
	};

	type AccountExpandField = {
		label: string;
		value: string;
		field: string;
		copyable: boolean;
	};

	type AccountCard = {
		id: number;
		projectId: number;
		status: string;
		statusKey: string;
		staffId: number;
		staffName: string;
		project: string;
		projectTypeLabel: string;
		expandFields: AccountExpandField[];
		timeLabel: string;
		createdAt: string;
	};

	type AccountFilterOption = {
		label: string;
		value: string;
	};

	type TaskRecordTab = "promotion" | "backfill" | "revenue" | "withdraw";
	type EnterpriseRecordField = {
		label: string;
		value: string;
		copyable: boolean;
	};
	type EnterpriseRecordCard = {
		id: string;
		title: string;
		recordNo: string;
		status: string;
		statusTone: string;
		fields: EnterpriseRecordField[];
		timeLabel: string;
		createdAt: string;
	};

	const AVATAR_COLORS = ["#2b59c3", "#6366f1", "#1e3a5f", "#9ca3af", "#f97316", "#22c55e"];
	const CUSTOM_ROLE_LABEL_MAX_LENGTH = 5;
	const CUSTOM_ROLE_LABEL_CACHE_PREFIX = "enterprise_staff_role_label_";
	function showBusinessReadError(res: Response | null, fallback: string) {
		if (isLocalUiPreview()) {
			return;
		}
		uni.showToast({ title: getApiMessage(res, fallback), icon: "none" });
	}
	type ProjectPermItem = {
		id: number;
		name: string;
		logo: string;
		icon: string;
		iconBg: string;
		iconEmoji: boolean;
		enabled: boolean;
	};

	type VirtualStaffOption = {
		id: number;
		userId: number;
		name: string;
		collabId: string;
		mobile: string;
	};

	type VirtualKeywordOption = {
		id: number;
		label: string;
	};

	const resourceTab = ref<string>("employee");
	const taskRecordTab = ref<TaskRecordTab>("promotion");
	const accountKeyword = ref<string>("");
	const accountCards = ref<AccountCard[]>([]);
	const accountLoading = ref(false);
	const accountLoadingMore = ref(false);
	const accountPage = ref(1);
	const accountHasMore = ref(true);
	const accountLimit = 100;
	const accountExpectedTotal = ref(0);
	const accountTotal = ref(0);
	const accountRawLoadedCount = ref(0);
	const accountAutoLoading = ref(false);
	const accountPeriod = ref("");
	const accountStartDate = ref("");
	const accountEndDate = ref("");
	const accountStatusOptions: AccountFilterOption[] = [
		{ label: "全部状态", value: "" },
		{ label: "已发布", value: "published" },
		{ label: "已审核待发布", value: "approved_pending" },
		{ label: "审核中", value: "reviewing" }
	];
	const accountStatusIndex = ref(0);
	const accountStaffOptions = ref<AccountFilterOption[]>([{ label: "全部员工", value: "" }]);
	const accountStaffIndex = ref(0);
	const accountCategoryOptions: AccountFilterOption[] = [
		{ label: "全部", value: "" },
		{ label: "品牌推文", value: "品牌推文" },
		{ label: "品牌短剧", value: "品牌短剧" },
		{ label: "品牌网盘", value: "品牌网盘" },
		{ label: "品牌应用", value: "品牌应用" }
	];
	const accountCategoryIndex = ref(0);
	const accountProjectOptions = ref<AccountFilterOption[]>([{ label: "全部项目", value: "" }]);
	const accountProjectIndex = ref(0);
	const accountStaffLoaded = ref(false);
	const accountCountText = computed(() => {
		const total = accountTotal.value;
		if (!isAccountUnfiltered()) {
			return accountAutoLoading.value
				? `筛选结果 ${accountCards.value.length} 条 · 加载中`
				: `筛选结果 ${accountCards.value.length} 条`;
		}
		if (accountAutoLoading.value) {
			return `已展示 ${accountCards.value.length} / ${total} 条 · 加载中`;
		}
		if (total > 0) {
			return `已展示 ${accountCards.value.length} / ${total} 条`;
		}
		return `共 ${accountCards.value.length} 条`;
	});
	const accountBatchMode = ref(false);
	const enterpriseRecordKeyword = ref("");
	const enterpriseRecordCards = ref<EnterpriseRecordCard[]>([]);
	const enterpriseRecordLoading = ref(false);
	const enterpriseRecordLoadingMore = ref(false);
	const enterpriseRecordPage = ref(1);
	const enterpriseRecordTotal = ref(0);
	const enterpriseRecordHasMore = ref(true);
	const enterpriseRecordError = ref("");
	const enterpriseRecordLimit = 20;
	const revenueStatusOptions: AccountFilterOption[] = [{ label: "结算状态", value: "settled" }];
	const withdrawStatusOptions: AccountFilterOption[] = [{ label: "提现状态", value: "completed" }];
	const enterpriseOrderOptions: AccountFilterOption[] = [
		{ label: "最新订单时间", value: "desc" },
		{ label: "最早订单时间", value: "asc" }
	];
	const enterpriseStatusIndex = ref(0);
	const enterpriseOrderIndex = ref(0);
	const enterpriseStatusLabel = computed(() => {
		return taskRecordTab.value == "withdraw"
			? withdrawStatusOptions[enterpriseStatusIndex.value].label
			: revenueStatusOptions[enterpriseStatusIndex.value].label;
	});
	const currentEnterpriseRecordCards = computed(() => {
		const list = enterpriseRecordCards.value.slice();
		return enterpriseOrderIndex.value == 1 ? list.reverse() : list;
	});
	const currentEnterpriseRecordTitle = computed(() => {
		if (taskRecordTab.value == "backfill") return "全部员工回填记录";
		if (taskRecordTab.value == "revenue") return "已审核已结算收益记录";
		return "全部员工已完成提现记录";
	});
	const enterpriseRecordEmptyText = computed(() => {
		if (taskRecordTab.value == "backfill") return "暂无回填记录";
		if (taskRecordTab.value == "revenue") return "暂无收益记录";
		return "暂无提现记录";
	});
	const accountBatchSelectedIds = ref<number[]>([]);
	const employeeBatchMode = ref(false);
	const employeeCardsCollapsed = ref(true);
	const employeeBatchSelectedIds = ref<number[]>([]);
	const employeeBatchAction = ref<EmployeeBatchAction>("commission");
