	function isAccountBatchSelected(id: number): boolean {
		return accountBatchSelectedIds.value.indexOf(id) >= 0;
	}

	function cancelAccountBatchMode() {
		accountBatchMode.value = false;
		accountBatchSelectedIds.value = [];
	}

	function enterAccountBatchMode() {
		if (accountCards.value.length == 0) {
			uni.showToast({ title: "暂无可转赠关键词", icon: "none" });
			return;
		}
		accountBatchMode.value = true;
		accountBatchSelectedIds.value = [];
	}

	function openKeywordTransfer(tab: string) {
		const targetTab = tab == "record" ? "record" : "pending";
		uni.navigateTo({
			url: `/pages/task/keyword-transfer?tab=${targetTab}`,
			fail() {
				uni.showToast({ title: "页面打开失败，请重试", icon: "none" });
			}
		});
	}

	function toggleAccountBatchSelect(item: AccountCard) {
		if (item.id <= 0) {
			return;
		}
		const ids = accountBatchSelectedIds.value.slice();
		const idx = ids.indexOf(item.id);
		if (idx >= 0) {
			ids.splice(idx, 1);
		} else {
			ids.push(item.id);
		}
		accountBatchSelectedIds.value = ids;
	}

	function onAccountCardTap(item: AccountCard) {
		if (accountBatchMode.value) {
			toggleAccountBatchSelect(item);
		}
	}

	function toggleAccountBatchSelectAll() {
		if (accountBatchAllSelected.value) {
			accountBatchSelectedIds.value = [];
			return;
		}
		const ids: number[] = [];
		const cards = accountCards.value;
		for (let i = 0; i < cards.length; i++) {
			if (cards[i].id > 0) {
				ids.push(cards[i].id);
			}
		}
		accountBatchSelectedIds.value = ids;
	}

	function resolveBatchSelectionProjectId(ids: number[]): number {
		let projectId = 0;
		const cards = accountCards.value;
		for (let i = 0; i < ids.length; i++) {
			const targetId = ids[i];
			for (let j = 0; j < cards.length; j++) {
				if (cards[j].id != targetId) {
					continue;
				}
				const pid = cards[j].projectId;
				if (pid <= 0) {
					continue;
				}
				if (projectId <= 0) {
					projectId = pid;
				} else if (projectId != pid) {
					return -1;
				}
				break;
			}
		}
		return projectId;
	}

	function confirmAccountBatchTransfer() {
		const ids = accountBatchSelectedIds.value.slice();
		if (ids.length == 0) {
			uni.showToast({ title: "请选择推广任务", icon: "none" });
			return;
		}
		const projectId = resolveBatchSelectionProjectId(ids);
		if (projectId < 0) {
			uni.showToast({ title: "请选择同一项目下的账号", icon: "none" });
			return;
		}
		if (projectId <= 0) {
			uni.showToast({ title: "缺少项目信息，无法批量转赠", icon: "none" });
			return;
		}
		uni.setStorageSync(KEYWORD_ASSIGN_CONTEXT_KEY, {
			keyword_ids: ids,
			project_id: projectId
		});
		cancelAccountBatchMode();
		router.push({
			path: "/pages/user/staff-list",
			query: {
				mode: "batch",
				project_id: `${projectId}`
			}
		});
	}

	function findEmployeeCard(staffId: number): EmployeeCard | null {
		const cards = employeeCards.value;
		for (let i = 0; i < cards.length; i++) {
			if (cards[i].id == staffId) {
				return cards[i];
			}
		}
		return null;
	}

	function isEmployeeBatchSelected(id: number): boolean {
