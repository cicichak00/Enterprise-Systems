		margin-left: 14rpx;
		padding: 5rpx 10rpx;
		border-radius: 8rpx;
		background-color: #fee2e2;
		font-size: 18rpx;
		color: #b91c1c;
		flex-shrink: 0;
	}

	.bs-inline-picker-footer {
		width: 100%;
		padding: 20rpx 32rpx;
		border-top-width: 1rpx;
		border-top-style: solid;
		border-top-color: #f1f5f9;
		background-color: #ffffff;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 20rpx;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.bs-inline-picker-footer-cancel,
	.bs-inline-picker-footer-confirm {
		height: 84rpx;
		border-radius: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		font-size: 27rpx;
		font-weight: 700;
		box-sizing: border-box;
	}

	.bs-inline-picker-footer-cancel {
		width: 180rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #d1d5db;
		background-color: #ffffff;
		color: #4b5563;
		flex-shrink: 0;
	}

	.bs-inline-picker-footer-confirm {
		flex: 1;
		background-color: #7c3aed;
		color: #ffffff;
		box-shadow: 0 10rpx 24rpx rgba(124, 58, 237, 0.24);
	}

	.bs-perm-loading-mask {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: rgba(255, 255, 255, 0.96);
	}

	.bs-perm-loading-text {
		margin-top: 16rpx;
		font-size: 26rpx;
		color: #999999;
	}

	.bs-perm-project-loading-mask {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
		box-sizing: border-box;
	}

	.bs-perm-switch-row {
		padding: 28rpx 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}

	.bs-perm-switch-copy {
		flex: 1;
		min-width: 0;
		padding-right: 24rpx;
	}

	.bs-perm-switch-title {
		display: block;
		font-size: 28rpx;
		font-weight: 700;
		color: #333333;
		line-height: 40rpx;
	}

	.bs-perm-switch-desc {
		display: block;
		margin-top: 6rpx;
		font-size: 22rpx;
		color: #999999;
		line-height: 32rpx;
	}

	.bs-perm-slider-block {
		margin-top: 8rpx;
		padding-top: 32rpx;
		border-top-width: 1rpx;
	}

	.bs-perm-native-switch {
		flex-shrink: 0;
		transform: scale(0.78);
		transform-origin: center right;
	}

	.bs-perm-native-slider {
		width: 100%;
		margin: 0;
	}

	.bs-perm-slider-box {
		margin-top: 20rpx;
		padding: 8rpx 0 4rpx;
	}

	.bs-perm-slider-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.bs-perm-slider-head-left {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		flex: 1;
		min-width: 0;
	}

	.bs-perm-slider-label {
		font-size: 28rpx;
		font-weight: 700;
		color: #333333;
		line-height: 40rpx;
	}

	.bs-perm-slider-value {
		margin-left: 12rpx;
		font-size: 32rpx;
		font-weight: 700;
		color: #2b59c3;
		line-height: 44rpx;
	}

	.bs-perm-slider-marks {
		margin-top: 12rpx;
		padding: 0 4rpx;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}

	.bs-perm-slider-mark {
		font-size: 22rpx;
		color: #bbbbbb;
		line-height: 32rpx;

		&--active {
			color: #2b59c3;
			font-weight: 600;
		}
	}

	.bs-perm-search {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-right: 40rpx;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.bs-perm-search-field {
		flex: 1;
		min-width: 0;
		height: 64rpx;
		padding: 0 20rpx;
		margin-right: 16rpx;
		border-radius: 12rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #e8e8e8;
		background-color: #ffffff;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-perm-search-icon {
		width: 40rpx;
		height: 40rpx;
		margin-right: 8rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bs-perm-search-input {
		flex: 1;
		min-width: 0;
		height: 56rpx;
		font-size: 26rpx;
		color: #333333;
	}

	.bs-perm-search-placeholder {
		color: #cccccc;
		font-size: 26rpx;
	}

	.bs-perm-search-btn {
		padding: 0 28rpx;
		height: 64rpx;
		border-radius: 12rpx;
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.bs-perm-search-btn-text {
		font-size: 24rpx;
		font-weight: 700;
		color: #ffffff;
		line-height: 34rpx;
	}

	.bs-perm-platform-panel {
		width: 100%;
		margin-top: 20rpx;
		margin-bottom: 24rpx;
		padding-right: 40rpx;
		box-sizing: border-box;
		flex-shrink: 0;
		overflow: hidden;
		position: relative;
	}

	.bs-perm-platform-loading {
		position: absolute;
		left: 0;
		top: 0;
		padding-bottom: 12rpx;
	}

	.bs-perm-platform-item {
		position: relative;
		padding-bottom: 12rpx;
		margin-right: 32rpx;
		flex-shrink: 0;
	}

	.bs-perm-platform-text {
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
		white-space: nowrap;
	}

	.bs-perm-platform-text--active,
	.bs-perm-platform-item--active .bs-perm-platform-text {
		color: #333333;
		font-weight: 700;
	}

	.bs-perm-platform-line {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: 36rpx;
		height: 4rpx;
		margin-left: -18rpx;
		border-radius: 4rpx;
		background-color: #333333;
	}

	.bs-perm-platform-panel :deep(.bs-perm-cl-tabs) {
		width: 100%;
	}

	.bs-perm-platform-panel :deep(.cl-tabs__scrollbar) {
		width: 100%;
	}

	.bs-perm-platform-panel :deep(.cl-tabs__inner) {
		align-items: flex-end;
	}

	.bs-perm-platform-panel :deep(.cl-tabs__line),
	.bs-perm-platform-panel :deep(.cl-tabs__slider) {
		display: none;
	}

	.bs-perm-platform-panel :deep(.bs-perm-cl-tabs-item) {
		height: auto !important;
		padding: 0 !important;
		flex-shrink: 0;

		.cl-text {
			display: none;
		}

		&:last-child .bs-perm-platform-item {
			margin-right: 0;
		}
	}

	.bs-perm-bulk-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 16rpx;
		margin-bottom: 24rpx;
		padding-right: 40rpx;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.bs-perm-bulk-title {
		flex: 1;
		min-width: 0;
		font-size: 28rpx;
		font-weight: 700;
		color: #333333;
		line-height: 40rpx;
	}

	.bs-perm-project-scroll {
		width: 100%;
		height: 100%;
		box-sizing: border-box;
	}

	.bs-perm-project-list {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		padding-right: 40rpx;
		box-sizing: border-box;
	}

	.bs-perm-project-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 28rpx;

		&:last-child {
			margin-bottom: 0;
		}
	}

	.bs-perm-project-empty {
		padding: 80rpx 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bs-perm-project-empty-text {
		font-size: 26rpx;
		color: #999999;
	}

	.bs-perm-project-more {
		padding: 24rpx 0 8rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bs-perm-project-more-text {
		font-size: 24rpx;
		color: #999999;
	}

	.bs-perm-project-logo,
	.bs-perm-project-icon {
		width: 68rpx;
		height: 68rpx;
		border-radius: 16rpx;
		flex-shrink: 0;
		margin-right: 20rpx;
	}

	.bs-perm-project-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bs-perm-project-icon-text {
		font-size: 28rpx;
		font-weight: 700;
		color: #ffffff;
		line-height: 36rpx;

		&--emoji {
			font-size: 24rpx;
			font-weight: 400;
		}
	}

	.bs-perm-project-name {
		flex: 1;
		min-width: 0;
		padding-right: 20rpx;
		font-size: 28rpx;
		font-weight: 700;
		color: #333333;
		line-height: 40rpx;
	}

	.bs-perm-project-switch {
		flex-shrink: 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	.bs-perm-footer {
		flex-shrink: 0;
		padding: 24rpx 40rpx;
		border-top-width: 1rpx;
		border-top-style: solid;
		border-top-color: #f0f0f0;
		background-color: #ffffff;
	}

	.bs-perm-save-btn {
		height: 96rpx;
		border-radius: 24rpx;
		background-color: #2b59c3;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		box-shadow: 0 16rpx 40rpx -12rpx rgba(43, 89, 195, 0.45);

		&--disabled {
			opacity: 0.5;
		}

		&--saving {
			opacity: 0.85;
			gap: 12rpx;
		}
	}

	.bs-perm-save-text {
		font-size: 30rpx;
		font-weight: 700;
		color: #ffffff;
		line-height: 42rpx;
	}

	/* v11 企业级视觉规范 */
	.bs-perm-header {
		padding: 26rpx 36rpx 22rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8edf5;
		background-color: #f8fafc;
	}

	.bs-perm-eyebrow {
		display: block;
		text-align: center;
		font-size: 17rpx;
		line-height: 26rpx;
		font-weight: 700;
		letter-spacing: 2rpx;
		color: #6b7a90;
	}

	.bs-perm-title {
		margin-top: 4rpx;
		font-size: 34rpx;
		line-height: 46rpx;
		font-weight: 700;
		color: #172033;
	}

	.bs-perm-context {
		display: block;
		margin-top: 4rpx;
		text-align: center;
		font-size: 21rpx;
		line-height: 31rpx;
		color: #7b8798;
	}

	.bs-perm-close {
		right: 30rpx;
		top: 28rpx;
		background-color: #eef2f7;
	}

	.bs-perm-tabs {
		height: 88rpx;
		padding: 0 32rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8edf5;
		background-color: #ffffff;
		box-sizing: border-box;
	}

	.bs-perm-tab-text {
		font-size: 25rpx;
		font-weight: 500;
		color: #7b8798;
	}

	.bs-perm-tab--active .bs-perm-tab-text {
		font-weight: 700;
		color: #1f4d8f;
	}

	.bs-perm-tab-line {
		width: 44rpx;
		height: 5rpx;
		margin-left: -22rpx;
		background-color: #2b59c3;
	}

	.bs-perm-form {
		padding: 24rpx 28rpx 36rpx;
		background-color: #f4f7fb;
	}

	.bs-role-governance-note {
		margin-bottom: 20rpx;
		padding: 20rpx 22rpx;
		border: 1rpx solid #d9e5f5;
		border-radius: 16rpx;
		background-color: #edf4ff;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		box-sizing: border-box;
	}

	.bs-role-governance-icon {
		width: 44rpx;
		height: 44rpx;
		margin-right: 14rpx;
		border-radius: 12rpx;
		background-color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		pointer-events: auto;
		cursor: pointer;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
	}

	.bs-role-governance-copy {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.bs-role-governance-title {
		font-size: 24rpx;
		line-height: 34rpx;
		font-weight: 700;
		color: #1f4d8f;
	}

	.bs-role-governance-desc {
		margin-top: 4rpx;
		font-size: 21rpx;
		line-height: 32rpx;
		color: #52657e;
	}

	.bs-manage-section-title {
		padding: 22rpx 24rpx 18rpx;
		border-radius: 18rpx 18rpx 0 0;
		background-color: #ffffff;
	}

	.bs-manage-section-mark {
		width: 6rpx;
		height: 38rpx;
		margin-right: 14rpx;
		border-radius: 4rpx;
		background-color: #2b59c3;
	}

	.bs-manage-section-mark--advanced {
		background-color: #2b59c3;
	}

	.bs-manage-section-name {
		font-size: 28rpx;
		color: #172033;
	}

	.bs-manage-section-desc {
		color: #7b8798;
	}

	.bs-role-label-config {
		padding: 0 24rpx 24rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #edf1f6;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
	}

	.bs-role-label-copy {
		display: flex;
		flex-direction: column;
	}

	.bs-role-label-title {
		font-size: 25rpx;
		font-weight: 700;
		color: #24364f;
	}

	.bs-role-label-desc {
		margin-top: 6rpx;
		font-size: 20rpx;
		line-height: 30rpx;
		color: #7b8798;
	}

	.bs-role-label-input-wrap {
		height: 72rpx;
		margin-top: 18rpx;
		padding: 0 20rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #cbd6e4;
		border-radius: 12rpx;
		background-color: #f8fafc;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.bs-role-label-input {
		flex: 1;
		height: 70rpx;
		font-size: 23rpx;
		color: #24364f;
	}

	.bs-role-label-placeholder {
		color: #a3afbf;
	}

	.bs-role-label-count {
		margin-left: 12rpx;
		font-size: 19rpx;
		color: #98a4b5;
		flex-shrink: 0;
	}

	.bs-role-label-preview {
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-role-label-preview-caption {
		font-size: 20rpx;
		color: #8a97a8;
	}

	.bs-role-label-preview-name {
		margin-left: 16rpx;
		font-size: 23rpx;
		font-weight: 700;
		color: #172033;
	}

	.bs-role-label-preview-tag {
		margin-left: 12rpx;
		padding: 5rpx 12rpx;
		border-radius: 8rpx;
		background-color: #eaf1fc;
	}

	.bs-role-label-preview-tag-text {
		font-size: 19rpx;
		font-weight: 600;
		color: #1f4d8f;
	}

	.bs-perm-switch-row {
		padding: 22rpx 24rpx;
		background-color: #ffffff;
		border-bottom-color: #edf1f6;
	}

	.bs-perm-slider-block {
		margin-top: 0;
		padding: 24rpx;
		border-top-width: 0;
		border-radius: 0 0 18rpx 18rpx;
		background-color: #ffffff;
	}

	.bs-perm-slider-value,
	.bs-perm-slider-mark--active {
		color: #1f4d8f;
	}

	.bs-advanced-manage-section {
		margin-top: 24rpx;
		padding: 0 0 24rpx;
		border-radius: 18rpx;
		border-color: #dce4ef;
		background-color: #ffffff;
		box-shadow: 0 8rpx 24rpx rgba(31, 77, 143, 0.05);
		overflow: hidden;
	}

	.bs-advanced-manage-section .bs-manage-section-title {
		padding: 22rpx 24rpx;
		border-radius: 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8edf5;
		background-color: #f8fafc;
	}

	.bs-advanced-manage-loading,
	.bs-advanced-manage-off,
	.bs-advanced-manage-on {
		margin-left: 24rpx;
		margin-right: 24rpx;
	}

	.bs-advanced-manage-off {
		background-color: #f8fafc;
		border-width: 1rpx;
		border-style: solid;
		border-color: #e8edf5;
	}

	.bs-advanced-rule-text {
		border-left-width: 6rpx;
		border-left-style: solid;
		border-left-color: #2b59c3;
		border-radius: 8rpx;
		background-color: #eef5ff;
		color: #4b5d75;
	}

	.bs-inline-step-badge {
		background-color: #e8f0fe;
		color: #1f4d8f;
	}

	.bs-inline-role-options {
		border-width: 1rpx;
		border-style: solid;
		border-color: #dce4ef;
		background-color: #f4f7fb;
	}

	.bs-inline-role-option--active {
		background-color: #2b59c3;
		color: #ffffff;
	}

	.bs-inline-field--relation {
		border-color: #bfd1ee;
		background-color: #f8fbff;
	}

	.bs-inline-field--locked {
		border-color: #e1e7ef;
		background-color: #f8fafc;
	}

	.bs-inline-select {
		border-color: #cbd6e4;
		color: #24364f;
	}

	.bs-inline-rate {
		border-top-color: #e5ebf3;
	}

	.bs-inline-rate-value,
	.bs-inline-note {
		color: #1f4d8f;
	}

	.bs-inline-permission {
		border-width: 1rpx;
		border-style: solid;
		border-color: #e1e7ef;
		background-color: #f8fafc;
	}

	.bs-perm-footer {
		padding: 20rpx 28rpx;
		border-top-color: #dce4ef;
		background-color: #ffffff;
	}

	.bs-perm-save-btn {
		height: 88rpx;
		border-radius: 14rpx;
		background-color: #1f4d8f;
		box-shadow: 0 8rpx 18rpx rgba(31, 77, 143, 0.2);
	}

	.bs-inline-picker {
		background-color: #f4f7fb;
	}

	.bs-inline-picker-head {
		border-bottom-color: #dce4ef;
		background-color: #ffffff;
	}

	.bs-inline-picker-cancel,
	.bs-inline-picker-all {
		color: #1f4d8f;
	}

	.bs-inline-picker-title {
		color: #172033;
	}

	.bs-inline-picker-list {
		background-color: #ffffff;
	}

	.bs-inline-picker-check--active {
		border-color: #2b59c3;
		background-color: #2b59c3;
	}

	.bs-inline-picker-avatar {
		background-color: #e8f0fe;
		color: #1f4d8f;
	}

	.bs-inline-picker-footer-confirm {
		background-color: #1f4d8f;
		box-shadow: 0 8rpx 18rpx rgba(31, 77, 143, 0.2);
	}

	.bs-unbind-popup {
		max-height: 78vh;
		padding: 24rpx 30rpx 0;
		border-radius: 32rpx 32rpx 0 0;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}

	.bs-unbind-popup-head {
		min-height: 78rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-unbind-popup-cancel,
	.bs-unbind-popup-all {
		width: 140rpx;
		font-size: 26rpx;
		color: #6b7280;
	}

	.bs-unbind-popup-all {
		text-align: right;
		color: #2b59c3;
	}

	.bs-unbind-popup-title-wrap {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.bs-unbind-popup-title {
		font-size: 30rpx;
		font-weight: 700;
		color: #111827;
	}

	.bs-unbind-popup-sub {
		margin-top: 4rpx;
		font-size: 21rpx;
		color: #9ca3af;
	}

	.bs-unbind-list {
		max-height: 700rpx;
		margin-top: 12rpx;
	}

	.bs-unbind-row {
		min-height: 108rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f1f5f9;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-unbind-check {
		width: 36rpx;
		height: 36rpx;
		margin-right: 20rpx;
		border-radius: 10rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #cbd5e1;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;

		&--checked {
			border-color: #2b59c3;
			background-color: #2b59c3;
		}
	}

	.bs-unbind-member {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.bs-unbind-member-name {
