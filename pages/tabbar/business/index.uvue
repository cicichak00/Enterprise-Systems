	.bs-batch-label-review-title {
		display: block;
		padding-bottom: 20rpx;
		font-size: 27rpx;
		font-weight: 700;
		color: #172033;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #edf1f6;
	}

	.bs-batch-label-review-row {
		padding-top: 20rpx;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
	}

	.bs-batch-label-review-key {
		font-size: 22rpx;
		color: #7b8798;
	}

	.bs-batch-label-review-value {
		max-width: 68%;
		font-size: 22rpx;
		font-weight: 700;
		text-align: right;
		color: #24364f;
	}

	.bs-batch-label-review-notice {
		margin-top: 24rpx;
		padding: 18rpx 20rpx;
		border-radius: 14rpx;
		background-color: #eef4ff;
	}

	.bs-batch-label-review-notice-text {
		font-size: 20rpx;
		line-height: 30rpx;
		color: #526b8d;
	}

	.bs-batch-label-footer {
		margin-top: 28rpx;
		display: flex;
		flex-direction: row;
		gap: 16rpx;
	}

	.bs-batch-label-secondary,
	.bs-batch-label-primary {
		height: 84rpx;
		border-radius: 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.bs-batch-label-secondary {
		width: 190rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #cdd7e5;
		background-color: #ffffff;
	}

	.bs-batch-label-primary {
		flex: 1;
		background-color: #2b59c3;
	}

	.bs-batch-label-primary--disabled {
		opacity: 0.45;
	}

	.bs-batch-label-secondary-text,
	.bs-batch-label-primary-text {
		font-size: 27rpx;
		font-weight: 700;
	}

	.bs-batch-label-secondary-text {
		color: #52657e;
	}

	.bs-batch-label-primary-text {
		margin-left: 8rpx;
		color: #ffffff;
	}

	.bs-virtual-order-popup {
		padding: 32rpx 30rpx 24rpx;
		background-color: #ffffff;
		border-radius: 24rpx 24rpx 0 0;
	}

	.bs-vo-form {
		margin-top: 8rpx;
	}

	.bs-vo-field {
		margin-bottom: 24rpx;
	}

	.bs-vo-label {
		display: flex;
		margin-bottom: 12rpx;
		font-size: 28rpx;
		color: #333333;
		font-weight: 500;
	}

	.bs-vo-select {
		height: 80rpx;
		padding: 0 24rpx;
		border-radius: 16rpx;
		background-color: #f7f8fa;
		border: 1rpx solid #eeeeee;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		box-sizing: border-box;
	}

	.bs-vo-select-text {
		flex: 1;
		min-width: 0;
		margin-right: 12rpx;
		font-size: 28rpx;
		color: #333333;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;

		&--placeholder {
			color: #cccccc;
		}
	}

	.bs-vo-input-wrap {
		height: 80rpx;
		padding: 0 24rpx;
		border-radius: 16rpx;
		background-color: #f7f8fa;
		border: 1rpx solid #eeeeee;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.bs-vo-input {
		flex: 1;
		height: 72rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.bs-vo-input-placeholder {
		color: #cccccc;
		font-size: 28rpx;
	}

	.bs-vo-field-tip {
		display: flex;
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
	}

	.bs-vo-staff-picker {
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 32rpx 30rpx 0;
		background-color: #ffffff;
		border-radius: 24rpx 24rpx 0 0;
		box-sizing: border-box;
	}

	.bs-vo-staff-picker-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20rpx;
	}

	.bs-vo-staff-picker-title {
		font-size: 32rpx;
		font-weight: 600;
		color: #333333;
	}

	.bs-vo-staff-picker-close {
		width: 48rpx;
		height: 48rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bs-vo-staff-picker-search {
		height: 72rpx;
		padding: 0 24rpx;
		margin-bottom: 16rpx;
		border-radius: 36rpx;
		background-color: #f7f8fa;
		border: 1rpx solid #eeeeee;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.bs-vo-staff-picker-search-input {
		flex: 1;
		height: 56rpx;
		margin-left: 12rpx;
		font-size: 26rpx;
		color: #333333;
	}

	.bs-vo-staff-picker-search-placeholder {
		color: #cccccc;
		font-size: 26rpx;
	}

	.bs-vo-staff-picker-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16rpx;
	}

	.bs-vo-staff-picker-count {
		flex: 1;
		text-align: center;
		font-size: 26rpx;
		color: #666666;
	}

	.bs-vo-staff-picker-scroll {
		flex: 1;
		height: 0;
	}

	.bs-vo-staff-picker-state {
		padding: 80rpx 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.bs-vo-staff-picker-state-text {
		margin-top: 12rpx;
		font-size: 26rpx;
		color: #999999;
	}

	.bs-vo-staff-picker-loadmore {
		padding: 16rpx 0 24rpx;
	}

	.bs-vo-staff-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 20rpx 0;
		border-bottom: 1rpx solid #f0f0f0;
	}

	.bs-vo-staff-check {
		margin-right: 16rpx;
		flex-shrink: 0;
	}

	.bs-vo-staff-item-main {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.bs-vo-staff-item-name {
		font-size: 28rpx;
		color: #333333;
		font-weight: 500;
	}

	.bs-vo-staff-item-id {
		margin-top: 6rpx;
		font-size: 24rpx;
		color: #999999;
	}

	.bs-nav-panel {
		flex-shrink: 0;
		padding: 0 30rpx;
		background-color: #ffffff;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eeeeee;
	}

	.bs-head {
		padding: 16rpx 0 20rpx;
		display: flex;
		flex-direction: row;
		align-items: baseline;

		.bs-title {
			font-size: 40rpx;
			font-weight: 700;
			color: #333333;
		}

		.bs-sub {
			margin-left: 12rpx;
			font-size: 24rpx;
			color: #999999;
		}
	}

	.bs-subtabs {
		margin: 0 -30rpx;
		display: flex;
		flex-direction: row;
	}

	.bs-subtab {
		flex: 1;
		padding: 24rpx 0 20rpx;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		&--active .bs-subtab-text {
			color: #333333;
			font-weight: 700;
		}
	}

	.bs-subtab-text {
		font-size: 28rpx;
		line-height: 40rpx;
		color: #999999;
		font-weight: 500;
	}

	.bs-subtab-line {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: 48rpx;
		height: 6rpx;
		margin-left: -24rpx;
		border-radius: 999rpx;
		background-color: #2b59c3;
	}

	.bs-content {
		padding: 0;
	}

	.bs-emp-empty {
		padding: 60rpx 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.bs-emp-empty-text {
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;

		&--loading {
			margin-top: 16rpx;
		}
	}

	.bs-emp-loadmore {
		margin-top: auto;
		padding: 16rpx 0 8rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
	}

	.bs-emp-loadmore-hint {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #999999;
	}

	.bs-search-box {
		height: 72rpx;
		padding: 0 8rpx 0 24rpx;
		margin-bottom: 20rpx;
		border-radius: 36rpx;
		background-color: #ffffff;
		border: 1rpx solid #eeeeee;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.bs-search-field {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-right: 12rpx;
	}

	.bs-search-input {
		flex: 1;
		height: 56rpx;
		margin-left: 12rpx;
		font-size: 26rpx;
		color: #333333;
	}

	.bs-search-input-placeholder {
		color: #cccccc;
		font-size: 26rpx;
	}

	.bs-btn {
		height: 56rpx;
		padding: 0 28rpx;
		border-radius: 28rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-sizing: border-box;
	}

	.bs-btn--primary {
		background-color: #2b59c3;
		border: 1rpx solid #2b59c3;
	}

	.bs-btn--outline {
		background-color: #ffffff;
		border: 1rpx solid #eeeeee;
	}

	.bs-btn-text {
		font-size: 28rpx;
		font-weight: 600;
		line-height: 28rpx;
	}

	.bs-btn-text--primary {
		color: #ffffff;
	}

	.bs-btn-text--outline {
		margin-left: 8rpx;
		color: #333333;

		&.bs-btn-text--plain {
			margin-left: 0;
		}
	}

	.bs-acc-toolbar {
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
		align-items: center;
		margin-bottom: 20rpx;

		&--emp {
			justify-content: flex-start;
			align-items: center;
			gap: 0;
			width: 100%;
			box-sizing: border-box;

			.bs-btn--sm {
				height: 48rpx;
				padding: 0 12rpx;
				flex-shrink: 0;
			}

			.bs-btn-text {
				font-size: 22rpx;
				line-height: 24rpx;
				font-weight: 400;
				white-space: nowrap;
			}

			.bs-revenue-rank-arrow {
				transform: scale(0.85);
			}
		}

		.bs-btn-text {
			font-weight: 400;
		}
	}

	.bs-acc-toolbar-emp-left {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: nowrap;
		gap: 8rpx;
		flex: 1;
		min-width: 0;
	}

	.bs-emp-card-toggle {
		margin-left: 12rpx;
		height: 48rpx;
		padding: 0 8rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-shrink: 0;
	}

	.bs-emp-card-toggle-text {
		margin-right: 4rpx;
		font-size: 22rpx;
		color: #2b59c3;
	}

	.bs-btn--rank {
		flex-shrink: 0;

		.bs-btn-text {
			white-space: nowrap;
		}
	}

	.bs-revenue-rank-arrow {
		margin-left: 2rpx;

		&--open {
			transform: rotate(180deg) scale(0.85);
		}
	}

	.bs-revenue-rank-popup {
		padding: 32rpx 30rpx 16rpx;
		background-color: #ffffff;
		border-radius: 24rpx 24rpx 0 0;
	}

	.bs-revenue-rank-popup-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16rpx;
	}

	.bs-revenue-rank-popup-title {
		font-size: 32rpx;
		font-weight: 600;
		color: #333333;
	}

	.bs-revenue-rank-popup-close {
		width: 48rpx;
		height: 48rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bs-revenue-rank-popup-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 96rpx;
		padding: 0 8rpx;
		border-bottom: 1rpx solid #f0f0f0;

		&--active {
			.bs-revenue-rank-popup-item-text {
				color: #2b59c3;
				font-weight: 600;
			}
		}

		&:last-child {
			border-bottom-width: 0;
		}
	}

	.bs-revenue-rank-popup-item-text {
		font-size: 30rpx;
		color: #333333;
	}

	.bs-acc-batch-tip {
		margin-bottom: 16rpx;
	}

	.bs-acc-batch-tip-text {
		font-size: 26rpx;
		color: #2b59c3;
	}

	.bs-acc-batch-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20rpx;
	}

	.bs-acc-batch-count {
		flex: 1;
		text-align: center;
		font-size: 26rpx;
		color: #666666;
	}

	.bs-btn--sm {
		height: 56rpx;
		padding: 0 20rpx;
	}

	.bs-acc-batch-footer-wrap {
		height: 0;
		flex-shrink: 0;
		overflow: visible;
	}

	.bs-acc-batch-footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: calc(112rpx + env(safe-area-inset-bottom));
		z-index: 99;
		background-color: #ffffff;
		border-top: 1rpx solid #eeeeee;
		box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
		padding: 16rpx 30rpx;
		box-sizing: border-box;
	}

	.bs-acc-batch-confirm {
		height: 88rpx;
		border-radius: 44rpx;
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;

		&--disabled {
			opacity: 0.5;
		}
	}

	.bs-acc-batch-confirm-text {
		font-size: 30rpx;
		color: #ffffff;
		font-weight: 600;
	}

	.bs-acc-card--batch-active {
		border: 2rpx solid #2b59c3;
		background-color: #f5f8ff;
	}

	.bs-acc-check {
		width: 36rpx;
		height: 36rpx;
		border-radius: 18rpx;
		border: 2rpx solid #cccccc;
		margin-right: 12rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;

		&--checked {
			border-color: #2b59c3;
			background-color: #2b59c3;
		}
	}

	.bs-acc-state {
		padding: 60rpx 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.bs-acc-state-text {
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;

		&--loading {
			margin-top: 16rpx;
		}
	}

	.bs-acc-loadmore {
		padding: 16rpx 0 32rpx;
	}

	.bs-task-filter-grid {
		display: flex;
		flex-direction: row;
		margin-bottom: 16rpx;
		padding: 8rpx;
		border: 1rpx solid #e2e8f0;
		border-radius: 16rpx;
		background-color: #ffffff;
		box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.04);
	}

	.bs-task-filter-picker {
		flex: 1;
		min-width: 0;
		border-right: 1rpx solid #eef2f7;

		&:last-child {
			border-right-width: 0;
		}
	}

	.bs-task-filter-inner {
		height: 58rpx;
		padding: 0 14rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.bs-task-filter-value {
		flex: 1;
		min-width: 0;
		font-size: 22rpx;
		font-weight: 500;
		color: #334155;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.bs-task-category-scroll {
		width: 100%;
		margin: 0 0 16rpx;
		white-space: nowrap;
	}

	.bs-task-categories {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10rpx;
	}

	.bs-task-category {
		height: 52rpx;
		padding: 0 22rpx;
		border-radius: 26rpx;
		background-color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;

		&--active {
			background-color: #edf3ff;
		}
	}

	.bs-task-category-text {
		font-size: 22rpx;
		color: #667085;
	}

	.bs-task-category--active .bs-task-category-text {
		color: #2b59c3;
		font-weight: 600;
	}

	.bs-task-count-row {
		margin-bottom: 18rpx;
		padding: 0 4rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.bs-task-count-title {
		font-size: 24rpx;
		font-weight: 600;
		color: #334155;
	}

	.bs-task-count-value {
		font-size: 22rpx;
		color: #64748b;
	}

	.bs-staff-rule-filters {
		margin-top: 16rpx;
		display: flex;
		flex-direction: row;
		gap: 16rpx;
	}

	.bs-staff-rule-picker {
		flex: 1;
		min-width: 0;
	}

	.bs-staff-rule-picker-inner {
		height: 68rpx;
		padding: 0 20rpx;
		border-radius: 16rpx;
		background-color: #f3f4f6;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.bs-staff-rule-picker-label {
		margin-right: 12rpx;
		font-size: 22rpx;
		color: #9ca3af;
	}

	.bs-staff-rule-picker-value {
		flex: 1;
		font-size: 24rpx;
		font-weight: 600;
		color: #374151;
	}

	.bs-emp-card,
	.bs-acc-card {
		padding: 24rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
		margin-bottom: 20rpx;
	}

	.bs-emp-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 24rpx;
		padding-bottom: 24rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f0f0f0;
	}

	.bs-emp-avatar {
		width: 84rpx;
		height: 84rpx;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 16rpx;
	}

	.bs-emp-avatar-text {
		font-size: 28rpx;
		color: #ffffff;
		font-weight: 600;
	}

	.bs-emp-avatar-img {
		width: 84rpx;
		height: 84rpx;
		border-radius: 50%;
	}

	.bs-emp-info {
		flex: 1;
	}

	.bs-emp-name {
		font-size: 30rpx;
		font-weight: 600;
		color: #333333;
		line-height: 42rpx;
	}

	.bs-emp-meta {
		margin-top: 8rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	.bs-status-tag {
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		margin-right: 12rpx;
		display: flex;
		align-items: center;
		justify-content: center;

		&--on {
			background-color: #ecfdf5;
		}

		&--off {
			background-color: #f3f4f6;
		}
	}

	.bs-status-text {
		font-size: 20rpx;
		line-height: 28rpx;
		color: #22c55e;
	}

	.bs-status-tag--off .bs-status-text {
		color: #999999;
	}

	.bs-emp-card--collapsed {
		padding-top: 18rpx;
		padding-bottom: 18rpx;
	}

	.bs-emp-card--collapsed .bs-emp-head {
		margin-bottom: 0;
