		justify-content: center;

		&.is-disabled {
			opacity: 0.7;
		}
	}

	.lg-submit-text {
		font-size: 30rpx;
		font-weight: 700;
		color: #ffffff;
		line-height: 42rpx;
	}

	.lg-switch {
