<template>
	<cl-page :pt="{ className: 'lg-page' }">
		<view class="lg-page">
			<view class="lg-body">
				<text class="lg-title">账号密码登录</text>
				<text class="lg-sub">使用密码登录企业号</text>
				<view class="lg-field">
					<text class="lg-label">手机号</text>
					<input
						class="lg-input"
						v-model="mobile"
						type="number"
						maxlength="11"
						placeholder="请输入手机号"
						placeholder-class="lg-placeholder"
					/>
				</view>
				<view class="lg-field">
					<text class="lg-label">密码</text>
					<input
						class="lg-input"
						v-model="password"
						:password="hidePassword"
						maxlength="32"
						placeholder="请输入密码"
						placeholder-class="lg-placeholder"
					/>
				</view>
				<view class="lg-agreement" @tap="toggleAgreement">
					<view class="lg-checkbox" :class="{ 'is-checked': agreed }">
						<text v-if="agreed" class="lg-checkbox-mark">✓</text>
					</view>
					<view v-if="protocolList.length > 0" class="lg-agreement-copy">
						<text class="lg-agreement-text">同意</text>
						<template v-for="(item, index) in protocolList" :key="getProtocolKey(item, index)">
							<text v-if="index > 0" class="lg-agreement-text">和</text>
							<text class="lg-agreement-link" @tap.stop="openProtocol(item)">{{ formatProtocolTitle(item.title ?? "") }}</text>
						</template>
					</view>
				</view>
				<view class="lg-submit" :class="{ 'is-disabled': submitting }" @tap="onSubmit">
					<text class="lg-submit-text">{{ submitting ? "登录中..." : "登录" }}</text>
				</view>
				<view class="lg-switch" @tap="toMobileLogin">
					<text class="lg-switch-text">验证码登录</text>
				</view>
			</view>
		</view>

		<cl-popup
			v-model="agreeModalVisible"
			direction="center"
			size="560rpx"
			:show-header="false"
			:show-close="false"
			:mask-closable="true"
			:swipe-close="false"
			:pt="{ className: 'lg-agree-popup-wrap' }"
		>
			<view class="lg-agree-modal">
				<text class="lg-agree-modal-title">同意协议</text>
				<view class="lg-agree-modal-content">
					<view class="lg-agree-modal-line">
						<text class="lg-agree-modal-text">您还没有同意</text>
						<template v-for="(item, index) in protocolList" :key="getProtocolKey(item, index)">
							<text v-if="index > 0" class="lg-agree-modal-text">和</text>
							<text class="lg-agree-modal-link" @tap.stop="openProtocol(item)">{{ formatProtocolTitle(item.title ?? "") }}</text>
						</template>
					</view>
					<text class="lg-agree-modal-desc">请您阅读并点击“同意并登录”即代表您已阅读并同意上述内容</text>
				</view>
				<view class="lg-agree-modal-actions">
					<view class="lg-agree-modal-btn lg-agree-modal-btn--ghost" @tap="closeAgreeModal">
						<text class="lg-agree-modal-btn-text">取消</text>
					</view>
					<view class="lg-agree-modal-btn lg-agree-modal-btn--primary" @tap="onAgreeAndLogin">
						<text class="lg-agree-modal-btn-text lg-agree-modal-btn-text--primary">同意并登录</text>
					</view>
				</view>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="ts" setup>
	import { ref } from "vue";
	import { getAppInfo } from "@/.cool/api/info";
	import { loginByAccount } from "@/.cool/api/login";
	import { router, useStore, isApiSuccess, getApiMessage, type LoginEnvelope, type OAuthAuthorizeProtocolItem, type Response } from "@/.cool";
	import { completeLoginNavigation } from "@/.cool/navigation/afterLogin";

	const { user } = useStore();
	const mobile = ref("");
	const password = ref("");
	const agreed = ref(false);
	const agreeModalVisible = ref(false);
	const submitting = ref(false);
	const hidePassword = ref(true);
	const protocolList = ref<OAuthAuthorizeProtocolItem[]>([]);

	function isValidPhone(phone: string) {
		return /^1[3-9]\d{9}$/.test(phone);
	}

	function toggleAgreement() {
		agreed.value = !agreed.value;
	}

	function formatProtocolTitle(title: string): string {
		const text = title.trim();
		if (text == "") {
			return "";
		}
		if (text.indexOf("《") == 0) {
			return text;
		}
		return `《${text}》`;
	}

	function getProtocolKey(item: OAuthAuthorizeProtocolItem, index: number): string {
		const idVal = item.id;
		if (idVal != null) {
			return `protocol-${idVal}`;
		}
		return `protocol-${index}`;
	}

	function openProtocol(item: OAuthAuthorizeProtocolItem) {
		agreeModalVisible.value = false;
		router.push({
			path: "/pages/protocol/detail",
			query: {
				id: item.id
			}
		});
	}

	function parseProtocolList(data: UTSJSONObject): OAuthAuthorizeProtocolItem[] {
		const protocolRaw = data["protocol"] as OAuthAuthorizeProtocolItem[] | null;
		if (protocolRaw == null || protocolRaw.length == 0) {
			return [];
		}
		const result: OAuthAuthorizeProtocolItem[] = [];
		for (let i = 0; i < protocolRaw.length; i++) {
			const row = protocolRaw[i] as UTSJSONObject;
			const title = `${row["title"] ?? ""}`.trim();
			if (title == "") {
				continue;
			}
			result.push({
				id: row["id"] as number | null,
				title: title,
				content: `${row["content"] ?? ""}`,
				summary: `${row["summary"] ?? ""}`,
				version: `${row["version"] ?? ""}`
			});
		}
		return result;
	}

	function loadLoginProtocols() {
		getAppInfo("login")
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				protocolList.value = parseProtocolList(data);
			})
			.catch(() => {});
	}

	function toMobileLogin() {
		uni.setStorageSync("loginM", mobile.value);
		router.back();
	}

	function closeAgreeModal() {
		agreeModalVisible.value = false;
	}

	function onSubmit() {
		if (submitting.value) {
			return;
		}
		const phone = mobile.value.trim();
		const pwd = password.value.trim();
		if (!isValidPhone(phone)) {
			uni.showToast({ title: "请输入正确的手机号", icon: "none" });
			return;
		}
		if (pwd.length < 6) {
			uni.showToast({ title: "密码长度至少6位", icon: "none" });
			return;
		}
		if (!agreed.value) {
			agreeModalVisible.value = true;
			return;
		}
		doLogin();
	}

	function onAgreeAndLogin() {
		agreed.value = true;
		agreeModalVisible.value = false;
		doLogin();
	}

	function doLogin() {
		if (submitting.value) {
			return;
		}
		const phone = mobile.value.trim();
		const pwd = password.value.trim();
		if (!isValidPhone(phone)) {
			uni.showToast({ title: "请输入正确的手机号", icon: "none" });
			return;
		}
		if (pwd.length < 6) {
			uni.showToast({ title: "密码长度至少6位", icon: "none" });
			return;
		}
		submitting.value = true;
		const pendingRedirect = router.getLoginRedirect();
		uni.showLoading({ title: "登录中..." });
		loginByAccount(phone, pwd)
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as LoginEnvelope;
				if (envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: envelope.msg ?? "登录失败", icon: "none" });
					return;
				}
				uni.setStorageSync("loginM", phone);
				if (!user.applyLoginResponse(envelope)) {
					uni.showToast({
						title: getApiMessage(envelope, "登录失败：未获取到凭证"),
						icon: "none"
					});
					return;
				}
				uni.showToast({ title: "登录成功", icon: "success" });
				completeLoginNavigation(pendingRedirect, phone);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: res.msg ?? res.message ?? "登录失败", icon: "none" });
			})
			.finally(() => {
				submitting.value = false;
				uni.hideLoading();
			});
	}

	const savedMobile = uni.getStorageSync("loginM") as string | null;
	if (savedMobile != null && savedMobile != "") {
		mobile.value = savedMobile;
	}

	onLoad(() => {
		loadLoginProtocols();
	});

	onShow(() => {
		router.preserveLoginRedirect();
	});

	onHide(() => {
		agreeModalVisible.value = false;
	});
</script>

