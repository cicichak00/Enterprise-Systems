<template>
	<cl-page :pt="{ className: 'wtd-page' }">
		<view class="wtd-page">
			<view v-if="pageLoading" class="wtd-loading">
				<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
				<text class="wtd-loading-text">加载中...</text>
			</view>
			<view v-else-if="loadFailed" class="wtd-state">
				<text class="wtd-state-text">加载失败，请返回重试</text>
			</view>
			<view v-else class="wtd-body">
				<view class="wtd-hero">
					<view class="wtd-hero-icon" :style="{ backgroundColor: iconBg }">
						<cl-icon :name="iconName" :size="22" :color="iconColor"></cl-icon>
					</view>
					<text class="wtd-hero-amount" :style="{ color: amountColor }">{{ amountText }}</text>
					<text class="wtd-hero-title">{{ title }}</text>
					<view v-if="statusText != ''" class="wtd-hero-status" :style="{ backgroundColor: statusBg }">
						<text class="wtd-hero-status-text" :style="{ color: statusColor }">{{ statusText }}</text>
					</view>
				</view>
				<view class="wtd-card">
					<view
						class="wtd-row"
						v-for="(row, index) in detailRows"
						:key="index"
					>
						<text class="wtd-row-label">{{ row.label }}</text>
						<text class="wtd-row-value">{{ row.value }}</text>
						<view v-if="index < detailRows.length - 1" class="wtd-row-divider"></view>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</view>
	</cl-page>
</template>
<script lang="ts" setup>
	import { ref } from "vue";
	import { getWalletTransactionDetail } from "@/.cool/api/wallet";
	import { isApiSuccess, getApiMessage } from "@/.cool";
	type DetailRow = {
		label: string;
		value: string;
	};
	const pageLoading = ref(false);
	const loadFailed = ref(false);
	const title = ref("交易详情");
	const amountText = ref("¥0.00");
	const amountColor = ref("#333333");
	const statusText = ref("");
	const statusBg = ref("#f3f4f6");
	const statusColor = ref("#666666");
	const iconName = ref("exchange-line");
	const iconBg = ref("#eef3fc");
	const iconColor = ref("#2b59c3");
	const detailRows = ref<DetailRow[]>([]);
	function pushRow(rows: DetailRow[], label: string, value: string) {
		const val = value.trim();
		if (val == "") {
			return;
		}
		rows.push({ label: label, value: val });
	}
	function statusStyle(status: number) {
		if (status == 1) {
			return { bg: "#ecfdf5", color: "#16a34a" };
		}
		if (status == 2) {
			return { bg: "#fef2f2", color: "#ef4444" };
		}
		return { bg: "#eef3fc", color: "#2b59c3" };
	}
	function applyDetail(data: UTSJSONObject) {
		const direction = data["direction"] as number | null;
		const isIncome = direction == 1;
		iconName.value = isIncome ? "arrow-down-line" : "arrow-up-line";
		iconBg.value = isIncome ? "#ecfdf5" : "#eef3fc";
		iconColor.value = isIncome ? "#22c55e" : "#2b59c3";
		amountColor.value = isIncome ? "#22c55e" : "#333333";
		let amountSigned = `${data["amount_signed"] ?? ""}`.trim();
		if (amountSigned == "") {
			const amount = `${data["amount"] ?? "0"}`;
			amountSigned = isIncome ? `+${amount}` : `-${amount}`;
		}
		amountText.value = amountSigned.indexOf("¥") >= 0 ? amountSigned : `¥${amountSigned}`;
		title.value = `${data["title"] ?? "交易"}`;
		statusText.value = `${data["status_text"] ?? ""}`.trim();
		const status = data["status"] as number | null;
		const st = statusStyle(status != null ? status : 0);
		statusBg.value = st.bg;
		statusColor.value = st.color;
		const relatedUser = data["related_user"] as UTSJSONObject | null;
		let relatedUserText = "";
		if (relatedUser != null) {
			const nickname = `${relatedUser["nickname"] ?? ""}`.trim();
			const sn = `${relatedUser["sn"] ?? ""}`.trim();
			if (nickname != "" && sn != "") {
				relatedUserText = `${nickname}（${sn}）`;
			} else if (nickname != "") {
				relatedUserText = nickname;
			} else if (sn != "") {
				relatedUserText = sn;
			}
		}
		const bankName = `${data["bank_name"] ?? ""}`.trim();
		const cardMask = `${data["card_no_mask"] ?? ""}`.trim();
		let bankText = "";
		if (bankName != "" && cardMask != "") {
			bankText = `${bankName} ${cardMask}`;
		} else if (bankName != "") {
			bankText = bankName;
		} else if (cardMask != "") {
			bankText = cardMask;
		}
		const rows: DetailRow[] = [];
		pushRow(rows, "交易类型", `${data["direction_text"] ?? ""}`);
		pushRow(rows, "业务类型", `${data["biz_type_text"] ?? ""}`);
		pushRow(rows, "交易单号", `${data["transaction_no"] ?? ""}`);
		pushRow(rows, "关联员工", relatedUserText);
		pushRow(rows, "收款账户", bankText);
		pushRow(rows, "备注", `${data["remark"] ?? ""}`);
		pushRow(rows, "创建时间", `${data["create_time"] ?? ""}`);
		pushRow(rows, "完成时间", `${data["finish_time"] ?? ""}`);
		pushRow(rows, "更新时间", `${data["update_time"] ?? ""}`);
		detailRows.value = rows;
	}
	function loadDetail(id: string) {
		if (pageLoading.value) {
			return;
		}
		if (id == "") {
			loadFailed.value = true;
			uni.showToast({ title: "缺少交易 ID", icon: "none" });
			return;
		}
		pageLoading.value = true;
		loadFailed.value = false;
		uni.showLoading({ title: "加载中..." });
		getWalletTransactionDetail(id)
			.then((res) => {
				if (res == null) {
					loadFailed.value = true;
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					loadFailed.value = true;
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				if (data == null) {
					loadFailed.value = true;
					uni.showToast({ title: "暂无详情", icon: "none" });
					return;
				}
				applyDetail(data);
			})
			.catch((err) => {
				loadFailed.value = true;
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				pageLoading.value = false;
				uni.hideLoading();
			});
	}
	onLoad((options) => {
		const idVal = options["id"] as string | null;
		const id = idVal != null ? `${idVal}` : "";
		loadDetail(id);
	});
</script>
<style lang="scss" scoped>
	.wtd-page {
		min-height: 100vh;
		background-color: #f7f8fa;
	}
	.wtd-loading,
	.wtd-state {
		padding: 120rpx 30rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.wtd-loading-text,
	.wtd-state-text {
		margin-top: 20rpx;
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
	}
	.wtd-body {
		padding: 24rpx 30rpx 40rpx;
		box-sizing: border-box;
	}
	.wtd-hero {
		padding: 40rpx 28rpx 36rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 24rpx;
	}
	.wtd-hero-icon {
		width: 88rpx;
		height: 88rpx;
		border-radius: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 20rpx;
	}
	.wtd-hero-amount {
		font-size: 48rpx;
		font-weight: 700;
		line-height: 64rpx;
	}
	.wtd-hero-title {
		margin-top: 12rpx;
		font-size: 28rpx;
		color: #333333;
		line-height: 40rpx;
		font-weight: 600;
		text-align: center;
	}
	.wtd-hero-status {
		margin-top: 16rpx;
		padding: 6rpx 16rpx;
		border-radius: 8rpx;
	}
	.wtd-hero-status-text {
		font-size: 22rpx;
		line-height: 30rpx;
		font-weight: 500;
	}
	.wtd-card {
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		overflow: hidden;
	}
	.wtd-row {
		position: relative;
		padding: 28rpx;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}
	.wtd-row-label {
		width: 168rpx;
		flex-shrink: 0;
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
	}
	.wtd-row-value {
		flex: 1;
		min-width: 0;
		font-size: 26rpx;
		color: #333333;
		line-height: 36rpx;
		font-weight: 500;
		text-align: right;
	}
	.wtd-row-divider {
		position: absolute;
		left: 28rpx;
		right: 28rpx;
		bottom: 0;
		height: 1rpx;
		background-color: #f0f0f0;
	}
</style>
