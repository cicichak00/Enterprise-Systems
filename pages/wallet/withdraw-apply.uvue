<!-- 提现（对齐 h5_works /pages/sub/member/withdraw） -->
<template>
	<cl-page :pt="{ className: 'wda-page' }">
		<view class="wda-page">
			<view class="wda-body">
				<view class="wda-bank" @tap="onSelectBank">
					<text class="wda-bank-label">到账卡号</text>
					<view class="wda-bank-row">
						<view class="wda-bank-info">
							<text class="wda-bank-name">{{ selectedBankLabel }}</text>
							<text class="wda-bank-tip">{{ selectedBank != null ? "2小时到账" : "请先添加收款账户" }}</text>
						</view>
						<cl-icon name="arrow-right-s-line" :size="14" color="#cccccc"></cl-icon>
					</view>
				</view>

				<view class="wda-amount-card">
					<text class="wda-amount-label">提现金额</text>
					<view class="wda-amount-row">
						<text class="wda-amount-symbol">¥</text>
						<input
							:key="amountInputKey"
							class="wda-amount-input"
							type="digit"
							:value="amount"
							:focus="amountInputFocus"
							placeholder=""
							placeholder-class="wda-amount-placeholder"
							@input="onAmountInput"
							@blur="onAmountBlur"
							@focus="onAmountFocus"
						/>
						<text class="wda-amount-all" @tap.stop="onFillAll">全部</text>
					</view>
					<text class="wda-amount-balance">可提现金额 · {{ withdrawableText }}</text>
				</view>

				<view
					class="wda-submit"
					:class="{ 'wda-submit--disabled': !canConfirm || confirming }"
					@tap="onConfirm"
				>
					<view v-if="confirming" class="wda-submit-loading">
						<cl-loading :loading="true" :size="18" color="#ffffff"></cl-loading>
						<text class="wda-submit-text">处理中...</text>
					</view>
					<text v-else class="wda-submit-text">确定</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>

			<cl-popup
				v-model="showBankPopup"
				direction="bottom"
				:show-header="false"
				:show-close="false"
				:mask-closable="true"
				:pt="{ className: 'wda-bank-popup-wrap' }"
			>
				<view class="wda-bank-popup">
					<view class="wda-bank-popup-head">
						<text class="wda-bank-popup-title">选择到账方式</text>
						<view class="wda-bank-popup-close" @tap="closeBankPopup">
							<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
						</view>
					</view>
					<scroll-view class="wda-bank-popup-list" scroll-y="true" :show-scrollbar="false">
						<view
							v-for="(item, index) in bankList"
							:key="item.id != null ? item.id : index"
							class="wda-bank-item"
							:class="{
								'wda-bank-item--active': isBankSelectable(item) && isPopupSelectedBank(item),
								'wda-bank-item--disabled': !isBankSelectable(item)
							}"
							@tap="onChooseBank(item)"
						>
							<image
								v-if="item.bank_ico != null && `${item.bank_ico}` != ''"
								class="wda-bank-item-logo"
								:src="`${item.bank_ico}`"
								mode="aspectFill"
							></image>
							<view v-else class="wda-bank-item-logo wda-bank-item-logo--placeholder">
								<cl-icon name="wallet-3-line" :size="28" color="#e0e0e0"></cl-icon>
							</view>
							<view class="wda-bank-item-main">
								<text
									class="wda-bank-item-name"
									:class="{ 'wda-bank-item-name--active': isBankSelectable(item) && isPopupSelectedBank(item) }"
								>{{ formatBankItemLabel(item) }}</text>
							</view>
							<view
								v-if="isBankStatusAbnormal(item) && item.status_txt != null && `${item.status_txt}` != ''"
								class="wda-bank-item-status"
							>
								<text class="wda-bank-item-status-text">{{ item.status_txt }}</text>
								<view
									v-if="bankStatusRemark(item) != ''"
									class="wda-bank-item-status-tip"
									@tap.stop="onBankStatusTip(item)"
								>
									<cl-icon name="question-line" :size="14" color="#cccccc"></cl-icon>
								</view>
							</view>
							<cl-icon
								v-else-if="isPopupSelectedBank(item)"
								name="checkbox-circle-fill"
								:size="22"
								color="#2b59c3"
							></cl-icon>
						</view>
						<view v-if="bankLoaded && bankList.length == 0" class="wda-bank-empty">
							<text class="wda-bank-empty-text">暂无可用提现账户</text>
						</view>
					</scroll-view>
					<view class="wda-bank-popup-footer">
						<view class="wda-bank-popup-btn wda-bank-popup-btn--ghost" @tap="toAddBankCard">
							<text class="wda-bank-popup-btn-text">新增收款方式</text>
						</view>
						<view class="wda-bank-popup-btn wda-bank-popup-btn--primary" @tap="onConfirmBank">
							<text class="wda-bank-popup-btn-text wda-bank-popup-btn-text--primary">确定</text>
						</view>
					</view>
					<cl-safe-area type="bottom"></cl-safe-area>
				</view>
			</cl-popup>

			<cl-popup
				v-model="showPasswordPopup"
				direction="bottom"
				:show-header="false"
				:show-close="false"
				:mask-closable="true"
				:swipe-close="false"
				:pt="{ className: 'wda-pwd-popup-wrap' }"
				@close="onPasswordPopupClose"
			>
				<view class="wda-pwd-popup">
					<view class="wda-pwd-popup-head">
						<view class="wda-pwd-popup-head-placeholder"></view>
						<text class="wda-pwd-popup-head-title">提现金额</text>
						<view class="wda-pwd-popup-close" @tap="closePasswordPopup">
							<cl-icon name="close-line" :size="16" color="#999999"></cl-icon>
						</view>
					</view>

					<view v-if="taxData != null" class="wda-pwd-summary">
						<view class="wda-pwd-summary-amount">
							<text class="wda-pwd-summary-symbol">¥</text>
							<text class="wda-pwd-summary-value">{{ formatMoney(amount) }}</text>
						</view>
						<view class="wda-pwd-detail-box">
							<view class="wda-pwd-detail-row">
								<text class="wda-pwd-detail-label">到账金额</text>
								<text class="wda-pwd-detail-value">¥{{ formatMoney(actualAmount) }}</text>
							</view>
							<view class="wda-pwd-detail-row wda-pwd-detail-row--tax">
								<text class="wda-pwd-detail-label">预估扣税</text>
								<text class="wda-pwd-detail-value">¥{{ formatMoney(taxAmount) }}</text>
							</view>
						</view>
					</view>

					<view class="wda-pwd-pin" @tap.stop="focusPinInput">
						<view class="wda-pwd-boxes">
							<view
								v-for="index in pinBoxIndexes"
								:key="index"
								class="wda-pwd-box"
								:class="{
									'wda-pwd-box--active': pinInputActive && pinCode.length == index - 1,
									'wda-pwd-box--filled': pinCode.length >= index
								}"
							>
								<text v-if="pinCode.length >= index" class="wda-pwd-mask">*</text>
								<view
									v-else-if="pinInputActive && pinCode.length == index - 1"
									class="wda-pwd-cursor"
								></view>
							</view>
						</view>
						<input
							:key="pinFocusKey"
							class="wda-pwd-input"
							:value="pinCode"
							type="number"
							maxlength="6"
							:focus="pinInputFocus"
							:adjust-position="true"
							@focus="onPinFocus"
							@blur="onPinBlur"
							@input="onPinInput"
						/>
					</view>

					<view
						class="wda-pwd-btn"
						:class="{ 'wda-pwd-btn--disabled': pinCode.length < 6 || submitting }"
						@tap="onSubmitWithdraw"
					>
						<view v-if="submitting" class="wda-pwd-btn-loading">
							<cl-loading :loading="true" :size="18" color="#ffffff"></cl-loading>
							<text class="wda-pwd-btn-text">提交中...</text>
						</view>
						<text v-else class="wda-pwd-btn-text">确认提现</text>
					</view>
					<cl-safe-area type="bottom"></cl-safe-area>
				</view>
			</cl-popup>

			<cl-popup
				v-model="showBankStatusModal"
				direction="center"
				size="560rpx"
				:show-header="false"
				:show-close="false"
				:mask-closable="true"
				:pt="{ className: 'wda-modal-popup-wrap' }"
			>
				<view class="wda-modal-card">
					<text class="wda-modal-title">{{ bankStatusTipTitle }}</text>
					<text class="wda-modal-content">{{ bankStatusTipContent }}</text>
					<view class="wda-modal-actions">
						<view class="wda-modal-btn" @tap="closeBankStatusModal">
							<text class="wda-modal-btn-text">确定</text>
						</view>
					</view>
				</view>
			</cl-popup>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
	import { computed, nextTick, ref } from "vue";
	import { applyStaffWithdraw, calculateStaffWithdrawTax, getStaffBankLists, getStaffWithdrawWallet } from "@/.cool/api/wallet";
	import type {
		StaffBankListItem,
		StaffWithdrawTaxData
	} from "@/.cool/types/wallet";
	import { getApiMessage, isApiSuccess, router } from "@/.cool";

	const pinBoxIndexes = [1, 2, 3, 4, 5, 6];

	const amount = ref("");
	const amountInputKey = ref(0);
	const amountInputFocus = ref(false);
	const amountKeepFocus = ref(false);
	const withdrawableText = ref("0");
	const withdrawableRaw = ref(0);
	const hasWithdrawPassword = ref(false);
	const bankList = ref<StaffBankListItem[]>([]);
	const bankLoaded = ref(false);
	const selectedBank = ref<StaffBankListItem | null>(null);
	const popupSelectedBank = ref<StaffBankListItem | null>(null);
	const showBankPopup = ref(false);
	const showBankStatusModal = ref(false);
	const bankStatusTipTitle = ref("");
	const bankStatusTipContent = ref("");
	const showPasswordPopup = ref(false);
	const pinCode = ref("");
	const pinInputFocus = ref(false);
	const pinInputActive = ref(false);
	const pinFocusKey = ref(0);
	const submitting = ref(false);
	const confirming = ref(false);
	const taxData = ref<StaffWithdrawTaxData | null>(null);

	const selectedBankLabel = computed((): string => {
		const bank = selectedBank.value;
		if (bank == null) {
			return "请选择到账卡号";
		}
		const bankNo = `${bank.bank_no ?? ""}`.replace(/\s/g, "");
		const tail = bankNo.length >= 4 ? bankNo.substring(bankNo.length - 4) : bankNo;
		const name = `${bank.bank ?? ""}`.trim();
		if (tail != "") {
			return `${name}(${tail})`;
		}
		return name != "" ? name : "请选择到账卡号";
	});

	const canConfirm = computed((): boolean => {
		const value = parseFloat(amount.value);
		if (isNaN(value) || value <= 0) {
			return false;
		}
		if (value > withdrawableRaw.value) {
			return false;
		}
		const bank = selectedBank.value;
		if (bank == null || !isBankSelectable(bank)) {
			return false;
		}
		return true;
	});

	const actualAmount = computed((): number | string => {
		const data = taxData.value;
		if (data == null) {
			return 0;
		}
		if (data.actual_amount != null) {
			return data.actual_amount;
		}
		if (data.after_tax_amount != null) {
			return data.after_tax_amount;
		}
		return 0;
	});

	const taxAmount = computed((): number | string => {
		const data = taxData.value;
		if (data == null) {
			return 0;
		}
		if (data.tax_amount != null) {
			return data.tax_amount;
		}
		if (data.tax != null) {
			return data.tax;
		}
		return 0;
	});

	function bankIdText(id: number | string | null | undefined): string {
		if (id == null) {
			return "";
		}
		return `${id}`;
	}

	function isPopupSelectedBank(item: StaffBankListItem): boolean {
		const selected = popupSelectedBank.value;
		if (selected == null) {
			return false;
		}
		const a = bankIdText(selected.id);
		const b = bankIdText(item.id);
		return a != "" && a == b;
	}

	function formatBankItemLabel(item: StaffBankListItem): string {
		const name = `${item.bank ?? ""}`.trim();
		const bankNo = `${item.bank_no ?? ""}`.replace(/\s/g, "");
		if (name == "") {
			return bankNo != "" ? bankNo : "收款账户";
		}
		if (bankNo == "") {
			return name;
		}
		return `${name}(${bankNo})`;
	}

	function isBankStatusAbnormal(item: StaffBankListItem): boolean {
		if (item.is_invalid != null && parseInt(`${item.is_invalid}`) == 1) {
			return true;
		}
		if (item.status != null && !isNaN(parseFloat(`${item.status}`)) && parseInt(`${item.status}`) == 0) {
			return true;
		}
		return false;
	}

	function isBankSelectable(item: StaffBankListItem): boolean {
		if (item == null || item.id == null) {
			return false;
		}
		return !isBankStatusAbnormal(item);
	}

	function bankStatusRemark(item: StaffBankListItem): string {
		return `${item.remarks ?? item.status_tip ?? item.remark ?? ""}`.trim();
	}

	function findFirstSelectable(list: StaffBankListItem[]): StaffBankListItem | null {
		for (let i = 0; i < list.length; i++) {
			if (isBankSelectable(list[i])) {
				return list[i];
			}
		}
		return null;
	}

	function findBankById(list: StaffBankListItem[], id: string): StaffBankListItem | null {
		for (let i = 0; i < list.length; i++) {
			if (bankIdText(list[i].id) == id) {
				return list[i];
			}
		}
		return null;
	}

	function extractBankList(data: UTSJSONObject): StaffBankListItem[] {
		const raw = data["lists"] ?? data["list"] ?? data["records"] ?? data["items"];
		if (raw == null || !Array.isArray(raw)) {
			return [];
		}
		const rows = raw as StaffBankListItem[];
		const list: StaffBankListItem[] = [];
		for (let i = 0; i < rows.length; i++) {
			if (rows[i].id != null) {
				list.push(rows[i]);
			}
		}
		return list;
	}

	function unwrapData(res: any): UTSJSONObject | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const code = envelope["code"];
		if (code != null && !isApiSuccess(code as number | string)) {
			return null;
		}
		return (envelope["data"] ?? envelope) as UTSJSONObject;
	}

	function loadProfile() {
		getStaffWithdrawWallet()
			.then((res) => {
				const data = unwrapData(res);
				if (data == null) {
					return;
				}
				const wallet = (data["wallet"] ?? data) as UTSJSONObject;
				const withdrawable =
					data["wallet_withdrawable"] ??
					wallet["wallet_withdrawable"] ??
					"0";
				withdrawableText.value =
					withdrawable == null || `${withdrawable}` == "" ? "0" : `${withdrawable}`;
				const n = parseFloat(withdrawableText.value);
				withdrawableRaw.value = isNaN(n) ? 0 : n;
				const pwdFlag =
					data["has_withdraw_password"] ??
					wallet["has_withdraw_password"] ??
					wallet["has_withdrawal_password"] ??
					data["has_withdrawal_password"];
				hasWithdrawPassword.value =
					pwdFlag == true || pwdFlag == 1 || `${pwdFlag}` == "1";
				if (amount.value != "") {
					const next = normalizeWithdrawAmount(amount.value);
					if (next != amount.value) {
						amount.value = next;
						amountInputKey.value += 1;
					}
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			});
	}

	function loadBankList() {
		getStaffBankLists({ page_no: 1, page_size: 100 })
			.then((res) => {
				const data = unwrapData(res);
				const list = data != null ? extractBankList(data) : [];
				bankList.value = list;
				const firstSelectable = findFirstSelectable(list);
				const current = selectedBank.value;
				if (current == null) {
					selectedBank.value = firstSelectable;
				} else {
					const matched = findBankById(list, bankIdText(current.id));
					if (matched != null && isBankSelectable(matched)) {
						selectedBank.value = matched;
					} else {
						selectedBank.value = firstSelectable;
					}
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载银行卡失败"), icon: "none" });
			})
			.finally(() => {
				bankLoaded.value = true;
			});
	}

	function getWithdrawableLimit(): number {
		return withdrawableRaw.value;
	}

	function getWithdrawableAmountText(): string {
		return withdrawableText.value;
	}

	function formatWithdrawAmount(value: string | number): string {
		const num = parseFloat(`${value}`);
		if (isNaN(num) || num <= 0) {
			return "";
		}
		const clamped = Math.min(num, getWithdrawableLimit());
		return `${parseFloat(clamped.toFixed(2))}`;
	}

	function restoreAmountFocus() {
		amountInputFocus.value = false;
		nextTick(() => {
			amountInputFocus.value = true;
			amountKeepFocus.value = false;
		});
	}

	function setAmountValue(next: string, raw: string | null = null, keepFocus: boolean = false) {
		amount.value = next;
		if (raw != null && next != raw) {
			if (keepFocus) {
				amountKeepFocus.value = true;
			}
			amountInputKey.value += 1;
			if (keepFocus) {
				restoreAmountFocus();
			}
		}
	}

	function normalizeWithdrawAmount(raw: string): string {
		let value = `${raw ?? ""}`.replace(/[^\d.]/g, "");
		if (value == "") {
			return "";
		}
		const firstDot = value.indexOf(".");
		if (firstDot != -1) {
			let integer = value.substring(0, firstDot).replace(/\./g, "");
			const decimalPart = value.substring(firstDot + 1).replace(/\./g, "");
			const decimal = decimalPart.substring(0, 2);
			const hasTrailingDot = value.endsWith(".") && decimalPart == "";
			if (integer.length > 1) {
				integer = integer.replace(/^0+/, "");
				if (integer == "") {
					integer = "0";
				}
			}
			if (integer == "" && (hasTrailingDot || decimal != "")) {
				integer = "0";
			}
			if (hasTrailingDot) {
				return `${integer != "" ? integer : "0"}.`;
			}
			if (decimal != "") {
				value = `${integer != "" ? integer : "0"}.${decimal}`;
			} else {
				value = integer;
			}
		} else if (value.length > 1) {
			value = value.replace(/^0+/, "");
			if (value == "") {
				value = "0";
			}
		}
		if (value.endsWith(".")) {
			return value;
		}
		const num = parseFloat(value);
		if (isNaN(num)) {
			return "";
		}
		if (num > getWithdrawableLimit()) {
			return getWithdrawableAmountText();
		}
		return value;
	}

	function onAmountFocus() {
		amountInputFocus.value = true;
		amountKeepFocus.value = false;
	}

	function onAmountInput(e: UniInputEvent) {
		const raw = `${e.detail.value ?? ""}`;
		setAmountValue(normalizeWithdrawAmount(raw), raw, true);
	}

	function onAmountBlur() {
		if (amountKeepFocus.value) {
			amountKeepFocus.value = false;
			restoreAmountFocus();
			return;
		}
		amountInputFocus.value = false;
		const raw = amount.value;
		if (raw == "") {
			return;
		}
		let next = raw.endsWith(".") ? raw.substring(0, raw.length - 1) : raw;
		if (next == "") {
			amount.value = "";
			return;
		}
		amount.value = formatWithdrawAmount(next);
	}

	function onFillAll() {
		if (getWithdrawableLimit() <= 0) {
			uni.showToast({ title: "暂无可提现金额", icon: "none" });
			return;
		}
		amount.value = getWithdrawableAmountText();
		amountInputKey.value += 1;
		amountInputFocus.value = false;
	}

	function onSelectBank() {
		if (bankList.value.length == 0) {
			toAddBankCard();
			return;
		}
		popupSelectedBank.value = selectedBank.value;
		showBankPopup.value = true;
	}

	function closeBankPopup() {
		showBankPopup.value = false;
		popupSelectedBank.value = selectedBank.value;
	}

	function onChooseBank(item: StaffBankListItem) {
		if (!isBankSelectable(item)) {
			return;
		}
		popupSelectedBank.value = item;
	}

	function onConfirmBank() {
		const pending = popupSelectedBank.value;
		if (pending == null || !isBankSelectable(pending)) {
			uni.showToast({ title: "请选择到账方式", icon: "none" });
			return;
		}
		selectedBank.value = pending;
		showBankPopup.value = false;
	}

	function onBankStatusTip(item: StaffBankListItem) {
		const content = bankStatusRemark(item);
		if (content == "") {
			return;
		}
		bankStatusTipTitle.value = `${item.status_txt ?? "提示"}`;
		bankStatusTipContent.value = content;
		showBankStatusModal.value = true;
	}

	function closeBankStatusModal() {
		showBankStatusModal.value = false;
	}

	function toAddBankCard() {
		showBankPopup.value = false;
		router.push({ path: "/pages/wallet/bank-card-add" });
	}

	function toSetPassword() {
		router.push({ path: "/pages/wallet/withdrawal-password" });
	}

	function onConfirm() {
		if (confirming.value || !canConfirm.value) {
			return;
		}
		if (selectedBank.value == null) {
			uni.showToast({ title: "请选择到账卡号", icon: "none" });
			return;
		}
		if (!hasWithdrawPassword.value) {
			uni.showModal({
				title: "提示",
				content: "请先设置提现密码",
				confirmText: "去设置",
				success: (res) => {
					if (res.confirm) {
						toSetPassword();
					}
				}
			});
			return;
		}
		const value = parseFloat(amount.value);
		if (isNaN(value) || value <= 0) {
			uni.showToast({ title: "请输入提现金额", icon: "none" });
			return;
		}
		if (value > getWithdrawableLimit()) {
			uni.showToast({ title: "提现金额不能超过可提现金额", icon: "none" });
			return;
		}
		requestTaxPreview();
	}

	function requestTaxPreview() {
		if (confirming.value) {
			return;
		}
		const bank = selectedBank.value;
		if (bank == null || bank.id == null) {
			return;
		}
		confirming.value = true;
		calculateStaffWithdrawTax({
			money: amount.value,
			bank_id: bank.id
		})
			.then((res) => {
				const data = unwrapData(res);
				if (data == null) {
					uni.showToast({ title: getApiMessage(res, "计税失败"), icon: "none" });
					return;
				}
				taxData.value = data as StaffWithdrawTaxData;
				pinCode.value = "";
				showPasswordPopup.value = true;
				nextTick(() => {
					focusPinInput();
				});
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "计税失败"), icon: "none" });
			})
			.finally(() => {
				confirming.value = false;
			});
	}

	function closePasswordPopup() {
		showPasswordPopup.value = false;
		pinCode.value = "";
		taxData.value = null;
		submitting.value = false;
		pinInputFocus.value = false;
		pinInputActive.value = false;
	}

	function onPasswordPopupClose() {
		pinCode.value = "";
		taxData.value = null;
		submitting.value = false;
		pinInputFocus.value = false;
		pinInputActive.value = false;
	}

	function formatMoney(value: number | string | null | undefined): string {
		const num = parseFloat(`${value ?? 0}`);
		if (isNaN(num)) {
			return "0.00";
		}
		return num.toFixed(2);
	}

	function focusPinInput() {
		pinInputFocus.value = false;
		pinFocusKey.value += 1;
		nextTick(() => {
			pinInputFocus.value = true;
			pinInputActive.value = true;
		});
	}

	function onPinFocus() {
		pinInputActive.value = true;
	}

	function onPinBlur() {
		pinInputActive.value = false;
		pinInputFocus.value = false;
	}

	function onPinInput(e: UniInputEvent) {
		pinCode.value = `${e.detail.value ?? ""}`.replace(/\D/g, "").substring(0, 6);
	}

	function onSubmitWithdraw() {
		if (submitting.value || pinCode.value.length < 6) {
			return;
		}
		const bank = selectedBank.value;
		if (bank == null || bank.id == null) {
			uni.showToast({ title: "请选择到账卡号", icon: "none" });
			return;
		}
		submitting.value = true;
		applyStaffWithdraw({
			amount: parseFloat(amount.value),
			bank_id: bank.id,
			password: pinCode.value
		})
			.then((res) => {
				const envelope = res as UTSJSONObject | null;
				const code = envelope != null ? envelope["code"] : null;
				if (code != null && !isApiSuccess(code as number | string)) {
					uni.showToast({ title: getApiMessage(res, "操作失败"), icon: "none" });
					submitting.value = false;
					return;
				}
				uni.showToast({ title: getApiMessage(res, "操作成功"), icon: "success" });
				closePasswordPopup();
				setTimeout(() => {
					uni.navigateBack();
				}, 800);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "网络异常，请稍后重试"), icon: "none" });
				submitting.value = false;
			});
	}

	onShow(() => {
		loadProfile();
		loadBankList();
	});
</script>

