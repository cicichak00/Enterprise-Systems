<template>
	<cl-page :pt="{ className: 'wwd-page' }">
		<view class="wwd-page">
			<view v-if="pageLoading" class="wwd-loading">
				<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
				<text class="wwd-loading-text">加载中...</text>
			</view>
			<view v-else-if="loadFailed" class="wwd-state">
				<text class="wwd-state-text">加载失败，请返回重试</text>
			</view>
			<view v-else class="wwd-body">
				<view class="wwd-hero">
					<view class="wwd-hero-icon">
						<cl-icon name="arrow-up-line" :size="22" color="#2b59c3"></cl-icon>
					</view>
					<text class="wwd-hero-amount">{{ amountText }}</text>
					<text class="wwd-hero-title">{{ title }}</text>
					<view v-if="statusText != ''" class="wwd-hero-status" :style="{ backgroundColor: statusBg }">
						<text class="wwd-hero-status-text" :style="{ color: statusColor }">{{ statusText }}</text>
					</view>
				</view>
				<view class="wwd-card">
					<view class="wwd-row" v-for="(row, index) in detailRows" :key="index">
						<text class="wwd-row-label">{{ row.label }}</text>
						<text class="wwd-row-value">{{ row.value }}</text>
						<view v-if="index < detailRows.length - 1" class="wwd-row-divider"></view>
					</view>
				</view>
				<view v-if="canCancel" class="wwd-cancel-card">
					<text class="wwd-cancel-tip">取消提现需验证提现密码</text>
					<input
						class="wwd-cancel-input"
						v-model="cancelPassword"
						name="wwd-cancel-pin"
						password="true"
						autocomplete="new-password"
						:readonly="cancelPasswordReadonly"
						@focus="onCancelPasswordFocus"
						placeholder="请输入提现密码"
						placeholder-class="wwd-input-placeholder"
					/>
					<view class="wwd-cancel-btn" :class="{ 'wwd-cancel-btn--disabled': cancelling }" @tap="onCancel">
						<text class="wwd-cancel-btn-text">{{ cancelling ? "取消中..." : "取消提现" }}</text>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</view>
	</cl-page>
</template>
<script lang="ts" setup>
	import { ref } from "vue";
	import { cancelWalletWithdrawal, getWalletWithdrawalDetail } from "@/.cool/api/wallet";
	import { isApiSuccess, getApiMessage } from "@/.cool";
	type DetailRow = {
		label: string;
		value: string;
	};
	const pageLoading = ref(false);
	const loadFailed = ref(false);
	const recordId = ref("");
	const title = ref("提现详情");
	const amountText = ref("¥0.00");
	const statusText = ref("");
	const statusBg = ref("#eef3fc");
	const statusColor = ref("#2b59c3");
	const detailRows = ref<DetailRow[]>([]);
	const canCancel = ref(false);
	const cancelling = ref(false);
	const cancelPassword = ref("");
	const cancelPasswordReadonly = ref(true);
	function onCancelPasswordFocus() {
		cancelPasswordReadonly.value = false;
	}
	const cancelAmount = ref("");
	const cancelBankCardId = ref("");
	const cancelRemark = ref("");
	function fieldText(raw: any | null): string {
		if (raw == null) {
			return "";
		}
		const text = `${raw}`.trim();
		if (text == "" || text == "undefined" || text == "null") {
			return "";
		}
		return text;
	}
	function pushRow(rows: DetailRow[], label: string, value: string) {
		let val = value.trim();
		if (val == "undefined" || val == "null") {
			val = "";
		}
		if (val == "") {
			return;
		}
		rows.push({ label: label, value: val });
	}
	function statusStyle(status: number): { bg: string; color: string } {
		if (status == 2) {
			return { bg: "#ecfdf5", color: "#16a34a" };
		}
		if (status == 3) {
			return { bg: "#fef2f2", color: "#ef4444" };
		}
		if (status == 4) {
			return { bg: "#f3f4f6", color: "#999999" };
		}
		if (status == 1) {
			return { bg: "#eef3fc", color: "#2b59c3" };
		}
		return { bg: "#fff7ed", color: "#d97706" };
	}
	function applyDetail(data: UTSJSONObject) {
		const amount = fieldText(data["amount"]);
		const amountDisplay = amount != "" ? amount : "0";
		amountText.value = amountDisplay.indexOf("¥") >= 0 ? amountDisplay : `¥${amountDisplay}`;
		title.value = fieldText(data["title"]) != "" ? fieldText(data["title"]) : "提现";
		statusText.value = fieldText(data["status_text"]);
		const status = data["status"] as number | null;
		const st = statusStyle(status != null ? status : 0);
		statusBg.value = st.bg;
		statusColor.value = st.color;
		canCancel.value = status == 0;
		cancelAmount.value = amount;
		const bankCardId = data["bank_card_id"];
		cancelBankCardId.value = bankCardId != null ? `${bankCardId}` : "";
		cancelRemark.value = fieldText(data["remark"]);
		const bankName = fieldText(data["bank_name"]);
		const cardMask = fieldText(data["card_no_mask"]);
		const accountName = fieldText(data["account_name"]);
		let bankText = "";
		if (bankName != "" && cardMask != "") {
			bankText = `${bankName} ${cardMask}`;
		} else if (bankName != "") {
			bankText = bankName;
		} else if (cardMask != "") {
			bankText = cardMask;
		}
		const rows: DetailRow[] = [];
		pushRow(rows, "提现单号", fieldText(data["withdrawal_no"]) != "" ? fieldText(data["withdrawal_no"]) : fieldText(data["order_no"]));
		pushRow(rows, "收款账户", bankText);
		pushRow(rows, "账户名称", accountName);
		pushRow(rows, "备注", fieldText(data["remark"]));
		pushRow(rows, "驳回原因", fieldText(data["reject_reason"]) != "" ? fieldText(data["reject_reason"]) : fieldText(data["fail_reason"]));
		pushRow(rows, "申请时间", fieldText(data["create_time"]));
		pushRow(rows, "到账时间", fieldText(data["finish_time"]) != "" ? fieldText(data["finish_time"]) : fieldText(data["arrival_time"]));
		pushRow(rows, "更新时间", fieldText(data["update_time"]));
		detailRows.value = rows;
	}
	function doCancel() {
		const pwd = cancelPassword.value.trim();
		if (pwd == "") {
			uni.showToast({ title: "请输入提现密码", icon: "none" });
			return;
		}
		if (cancelBankCardId.value == "") {
			uni.showToast({ title: "缺少银行卡信息", icon: "none" });
			return;
		}
		cancelling.value = true;
		uni.showLoading({ title: "取消中..." });
		const remarkVal = cancelRemark.value.trim();
		cancelWalletWithdrawal(recordId.value, {
			amount: cancelAmount.value,
			bank_card_id: cancelBankCardId.value,
			withdrawal_password: pwd,
			remark: remarkVal != "" ? remarkVal : undefined
		})
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "取消失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: getApiMessage(res, "已取消"), icon: "success" });
				setTimeout(() => {
					uni.navigateBack();
				}, 400);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "取消失败"), icon: "none" });
			})
			.finally(() => {
				cancelling.value = false;
				uni.hideLoading();
			});
	}
	function onCancel() {
		if (cancelling.value) {
			return;
		}
		uni.showModal({
			title: "取消提现",
			content: "确定取消该笔提现申请吗？",
			confirmText: "取消提现",
			confirmColor: "#ef4444",
			success(res) {
				if (res.confirm) {
					doCancel();
				}
			}
		});
	}
	function loadDetail(id: string) {
		if (pageLoading.value) {
			return;
		}
		if (id == "") {
			loadFailed.value = true;
			uni.showToast({ title: "缺少提现 ID", icon: "none" });
			return;
		}
		recordId.value = id;
		pageLoading.value = true;
		loadFailed.value = false;
		uni.showLoading({ title: "加载中..." });
		getWalletWithdrawalDetail(id)
			.then((res) => {
				if (res == null) {
					loadFailed.value = true;
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					loadFailed.value = true;
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				if (data == null) {
					loadFailed.value = true;
					uni.showToast({ title: "暂无详情", icon: "none" });
					return;
				}
				applyDetail(data);
			})
			.catch((err) => {
				loadFailed.value = true;
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				pageLoading.value = false;
				uni.hideLoading();
			});
	}
	onLoad((options) => {
		const idVal = options["id"] as string | null;
		const id = idVal != null ? `${idVal}` : "";
		loadDetail(id);
	});
</script>
<style lang="scss" scoped>
	.wwd-page {
		min-height: 100vh;
		background-color: #f7f8fa;
	}
	.wwd-loading,
	.wwd-state {
		padding: 120rpx 30rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.wwd-loading-text,
	.wwd-state-text {
		margin-top: 20rpx;
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
	}
	.wwd-body {
		padding: 24rpx 30rpx 40rpx;
		box-sizing: border-box;
	}
	.wwd-hero {
		padding: 40rpx 28rpx 36rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 24rpx;
	}
	.wwd-hero-icon {
		width: 88rpx;
		height: 88rpx;
		border-radius: 20rpx;
		background-color: #eef3fc;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.wwd-hero-amount {
		margin-top: 20rpx;
		font-size: 44rpx;
		font-weight: 700;
		color: #333333;
		line-height: 60rpx;
	}
	.wwd-hero-title {
		margin-top: 8rpx;
		font-size: 26rpx;
		color: #666666;
		line-height: 36rpx;
	}
	.wwd-hero-status {
		margin-top: 16rpx;
		padding: 6rpx 20rpx;
		border-radius: 999rpx;
	}
	.wwd-hero-status-text {
		font-size: 24rpx;
		line-height: 34rpx;
	}
	.wwd-card {
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		overflow: hidden;
		margin-bottom: 24rpx;
	}
	.wwd-row {
		position: relative;
		padding: 28rpx;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
	}
	.wwd-row-label {
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
		flex-shrink: 0;
		margin-right: 24rpx;
	}
	.wwd-row-value {
		flex: 1;
		font-size: 26rpx;
		color: #333333;
		line-height: 36rpx;
		text-align: right;
		word-break: break-all;
	}
	.wwd-row-divider {
		position: absolute;
		left: 28rpx;
		right: 28rpx;
		bottom: 0;
		height: 1rpx;
		background-color: #f0f0f0;
	}
	.wwd-cancel-card {
		padding: 28rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
	}
	.wwd-cancel-tip {
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
		margin-bottom: 16rpx;
	}
	.wwd-cancel-input {
		width: 100%;
		height: 80rpx;
		padding: 0 20rpx;
		border-radius: 12rpx;
		background-color: #f7f8fa;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		font-size: 28rpx;
		color: #333333;
		box-sizing: border-box;
		margin-bottom: 20rpx;
	}
	.wwd-input-placeholder {
		color: #999999;
		font-size: 28rpx;
	}
	.wwd-cancel-btn {
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: #fef2f2;
		display: flex;
		align-items: center;
		justify-content: center;
		&--disabled {
			opacity: 0.6;
		}
	}
	.wwd-cancel-btn-text {
		font-size: 28rpx;
		color: #ef4444;
		line-height: 40rpx;
		font-weight: 600;
	}
</style>
