<template>
	<cl-page :pt="{ className: 'wdp-page' }">
		<view class="wdp-page">
			<view class="wdp-body">
				<view class="wdp-card">
					<text class="wdp-tip">{{ pageTip }}</text>
					<input class="wdp-autofill-trap" value="" autocomplete="off" />
					<input class="wdp-autofill-trap" password="true" value="" autocomplete="new-password" />
					<view v-if="hasPassword" class="wdp-field">
						<view class="wdp-label-row">
							<text class="wdp-label">原提现密码</text>
							<text class="wdp-required">*</text>
						</view>
						<input
							class="wdp-input"
							type="digit"
							maxlength="6"
							:value="oldPassword"
							name="wdp-old-pin"
							password="true"
							autocomplete="new-password"
							:readonly="oldPasswordReadonly"
							@focus="onOldPasswordFocus"
							@input="onOldPasswordInput"
							placeholder="请输入6位数字密码"
							placeholder-class="wdp-input-placeholder"
						/>
					</view>
					<view class="wdp-field">
						<view class="wdp-label-row">
							<text class="wdp-label">{{ hasPassword ? "新提现密码" : "提现密码" }}</text>
							<text class="wdp-required">*</text>
						</view>
						<input
							class="wdp-input"
							type="digit"
							maxlength="6"
							:value="password"
							name="wdp-new-pin"
							password="true"
							autocomplete="new-password"
							:readonly="passwordReadonly"
							@focus="onPasswordFocus"
							@input="onPasswordInput"
							placeholder="请输入6位数字密码"
							placeholder-class="wdp-input-placeholder"
						/>
					</view>
					<view class="wdp-field wdp-field--last">
						<view class="wdp-label-row">
							<text class="wdp-label">确认密码</text>
							<text class="wdp-required">*</text>
						</view>
						<input
							class="wdp-input"
							type="digit"
							maxlength="6"
							:value="confirmPassword"
							name="wdp-confirm-pin"
							password="true"
							autocomplete="new-password"
							:readonly="confirmPasswordReadonly"
							@focus="onConfirmPasswordFocus"
							@input="onConfirmPasswordInput"
							placeholder="请再次输入6位数字密码"
							placeholder-class="wdp-input-placeholder"
						/>
					</view>
				</view>
				<view class="wdp-submit" :class="{ 'wdp-submit--disabled': submitting }" @tap="onSubmit">
					<text class="wdp-submit-text">{{ submitting ? "提交中..." : submitText }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</view>
	</cl-page>
</template>
<script lang="ts" setup>
	import { computed, ref } from "vue";
	import { getWallet, setWalletWithdrawalPassword } from "@/.cool/api/wallet";
	import type { WalletWithdrawalPasswordParams } from "@/.cool/types/wallet";
	import { isApiSuccess, getApiMessage } from "@/.cool";
	const hasPassword = ref(false);
	const submitting = ref(false);
	const oldPassword = ref("");
	const password = ref("");
	const confirmPassword = ref("");
	const oldPasswordReadonly = ref(true);
	const passwordReadonly = ref(true);
	const confirmPasswordReadonly = ref(true);
	const pageTip = computed((): string => {
		if (hasPassword.value) {
			return "修改提现密码后，新密码将用于后续提现与取消提现验证。";
		}
		return "设置提现密码后，申请提现与取消提现时需输入该密码进行验证。";
	});
	const submitText = computed((): string => {
		return hasPassword.value ? "确认修改" : "确认设置";
	});
	function onOldPasswordFocus() {
		oldPasswordReadonly.value = false;
	}
	function onPasswordFocus() {
		passwordReadonly.value = false;
	}
	function onConfirmPasswordFocus() {
		confirmPasswordReadonly.value = false;
	}

	function onlySixDigits(raw: string): string {
		const digits = `${raw}`.replace(/[^\d]/g, "");
		return digits.length > 6 ? digits.slice(0, 6) : digits;
	}

	function readInputRaw(e: UniInputEvent): string {
		const detail = e.detail;
		if (detail != null && detail.value != null) {
			return `${detail.value}`;
		}
		return "";
	}

	function onOldPasswordInput(e: UniInputEvent) {
		oldPassword.value = onlySixDigits(readInputRaw(e));
	}

	function onPasswordInput(e: UniInputEvent) {
		password.value = onlySixDigits(readInputRaw(e));
	}

	function onConfirmPasswordInput(e: UniInputEvent) {
		confirmPassword.value = onlySixDigits(readInputRaw(e));
	}
	function readHasWithdrawPassword(): boolean {
		const stored = uni.getStorageSync("userInfo") as UTSJSONObject | null;
		if (stored == null) {
			return false;
		}
		let flag = stored["has_withdraw_password"];
		if (flag == null) {
			const data = stored["data"] as UTSJSONObject | null;
			if (data != null) {
				flag = data["has_withdraw_password"];
			}
		}
		return flag == true || flag == 1 || `${flag}` == "1";
	}

	function applyHasPassword(flag: boolean) {
		hasPassword.value = flag;
		uni.setNavigationBarTitle({
			title: flag ? "修改提现密码" : "设置提现密码"
		});
	}

	function writeHasWithdrawPassword(flag: boolean) {
		const stored = uni.getStorageSync("userInfo") as UTSJSONObject | null;
		if (stored == null) {
			return;
		}
		stored["has_withdraw_password"] = flag;
		const data = stored["data"] as UTSJSONObject | null;
		if (data != null) {
			data["has_withdraw_password"] = flag;
			stored["data"] = data;
		}
		uni.setStorageSync("userInfo", stored);
	}

	function loadStatus() {
		applyHasPassword(readHasWithdrawPassword());
		getWallet()
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				const wallet = data["wallet"] as UTSJSONObject | null;
				if (wallet != null) {
					const pwdFlag = wallet["has_withdrawal_password"] ?? wallet["has_withdraw_password"];
					const next = pwdFlag == true || pwdFlag == 1 || `${pwdFlag}` == "1";
					applyHasPassword(next);
					writeHasWithdrawPassword(next);
				}
			})
			.catch(() => {});
	}
	function validate(): string {
		if (hasPassword.value) {
			const oldPwd = oldPassword.value.trim();
			if (oldPwd == "") {
				return "请输入原提现密码";
			}
			if (oldPwd.length != 6 || !/^\d{6}$/.test(oldPwd)) {
				return "原提现密码须为6位数字";
			}
		}
		const pwd = password.value.trim();
		const confirmPwd = confirmPassword.value.trim();
		if (pwd == "") {
			return "请输入提现密码";
		}
		if (pwd.length != 6 || !/^\d{6}$/.test(pwd)) {
			return "提现密码须为6位数字";
		}
		if (confirmPwd == "") {
			return "请再次输入密码";
		}
		if (confirmPwd.length != 6 || !/^\d{6}$/.test(confirmPwd)) {
			return "确认密码须为6位数字";
		}
		if (pwd != confirmPwd) {
			return "两次输入的密码不一致";
		}
		if (hasPassword.value && pwd == oldPassword.value.trim()) {
			return "新密码不能与原密码相同";
		}
		return "";
	}
	function onSubmit() {
		if (submitting.value) {
			return;
		}
		const err = validate();
		if (err != "") {
			uni.showToast({ title: err, icon: "none" });
			return;
		}
		submitting.value = true;
		uni.showLoading({ title: "提交中..." });
		const params: WalletWithdrawalPasswordParams = {
			password: password.value.trim()
		};
		if (hasPassword.value) {
			params.old_password = oldPassword.value.trim();
		}
		setWalletWithdrawalPassword(params)
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "设置失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: getApiMessage(res, "设置成功"), icon: "success" });
				writeHasWithdrawPassword(true);
				applyHasPassword(true);
				setTimeout(() => {
					uni.navigateBack();
				}, 400);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "设置失败"), icon: "none" });
			})
			.finally(() => {
				submitting.value = false;
				uni.hideLoading();
			});
	}
	onShow(() => {
		loadStatus();
	});
</script>
<style lang="scss" scoped>
	.wdp-page {
		min-height: 100vh;
		background-color: #f7f8fa;
	}
	.wdp-body {
		min-height: 100vh;
		padding: 24rpx 30rpx 40rpx;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}
	.wdp-autofill-trap {
		position: fixed;
		left: -9999px;
		top: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
		z-index: -1;
	}
	.wdp-card {
		padding: 28rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
	}
	.wdp-tip {
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
		margin-bottom: 28rpx;
	}
	.wdp-field {
		margin-bottom: 28rpx;
		&--last {
			margin-bottom: 0;
		}
	}
	.wdp-label-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 12rpx;
	}
	.wdp-label {
		font-size: 26rpx;
		color: #333333;
		line-height: 36rpx;
		font-weight: 500;
	}
	.wdp-required {
		margin-left: 4rpx;
		font-size: 26rpx;
		color: #ef4444;
		line-height: 36rpx;
	}
	.wdp-input {
		width: 100%;
		height: 80rpx;
		padding: 0 20rpx;
		border-radius: 12rpx;
		background-color: #f7f8fa;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		font-size: 28rpx;
		color: #333333;
		box-sizing: border-box;
	}
	.wdp-input-placeholder {
		color: #999999;
		font-size: 28rpx;
	}
	.wdp-submit {
		margin-top: auto;
		padding: 28rpx;
		border-radius: 24rpx;
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;
		&--disabled {
			opacity: 0.6;
		}
	}
	.wdp-submit-text {
		font-size: 30rpx;
		color: #ffffff;
		line-height: 42rpx;
		font-weight: 600;
	}
</style>
