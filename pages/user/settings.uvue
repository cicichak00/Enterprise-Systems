<template>
    <cl-page :pt="{ className: 'st-page' }">
        <view class="st-page">
            <cl-safe-area type="top"></cl-safe-area>
            <view class="st-nav"><text>企业信息</text></view>
            <view class="st-content">
                <view class="st-note">
                    <text class="st-note-title">员工端展示说明</text>
                    <text class="st-note-copy">员工扫码进入小程序后，将看到你设置的名称、Logo 和介绍。</text>
                    <text class="st-note-copy">小程序内不展示「企业号」字样，使用自定义品牌。保存后员工端同步更新。</text>
                </view>
                <view class="st-form">
                    <view class="st-field">
                        <view class="st-label-row"><text class="st-label">企业号名称</text><text class="st-count">{{ miniAppName.length }}/16</text></view>
                        <input class="st-input" v-model="miniAppName" :disabled="pageLoading || saving" maxlength="16" placeholder="填写企业号名称" placeholder-class="st-placeholder" aria-label="企业号名称" />
                    </view>
                    <view class="st-logo-row">
                        <text class="st-label">企业 Logo</text>
                        <view class="st-logo-actions">
                            <view class="st-logo-box"><image v-if="logoDisplaySrc" class="st-logo-image" :src="logoDisplaySrc" mode="aspectFill" /><text v-else class="st-logo-text">{{ logoText }}</text></view>
                            <view class="st-change-btn" role="button" aria-label="更换企业Logo" @tap="onChangeLogo"><text>{{ uploading ? '上传中' : '更换' }}</text></view>
                        </view>
                    </view>
                    <view class="st-field st-field--last">
                        <view class="st-label-row"><text class="st-label">介绍</text><text class="st-count">{{ introText.length }}/140</text></view>
                        <textarea class="st-intro" v-model="introText" :disabled="pageLoading || saving" maxlength="140" :auto-height="false" placeholder="填写企业介绍" placeholder-class="st-placeholder" aria-label="企业介绍" />
                    </view>
                </view>
                <view class="st-save-btn" :class="{ 'st-save-btn--disabled': pageLoading || saving || uploading }" role="button" @tap="onSave"><text>{{ saving ? '保存中' : '保存' }}</text></view>
                <cl-safe-area type="bottom"></cl-safe-area>
            </view>
            <view v-if="pageLoading || saving" class="st-loading-mask"><cl-loading :loading="true" :size="28" color="#5375ed"></cl-loading><text>{{ saving ? '保存中' : '加载中' }}</text></view>
        </view>
    </cl-page>
</template>
<script lang="ts" setup>
	import { ref, watch } from "vue";
	import { getEnterpriseInfo, saveEnterpriseSettings } from "@/.cool/api/enterprise";
	import { normalizePickDisplayPath, toDisplayImageSrc, uploadImage } from "@/.cool/api/upload";
	import type { EnterpriseInfo, Response } from "@/.cool";

	const miniAppName = ref<string>("");
	const introText = ref<string>("");
	const logoUrl = ref<string>("");
	const logoDisplaySrc = ref<string>("");
	const logoText = ref<string>("企");
	const pageLoading = ref(false);
	const saving = ref(false);
    const uploading = ref(false);
	const infoRequesting = ref(false);


	function isApiSuccess(code: number | string | null | undefined): boolean {
		return code == 1 || code == "1" || code == 200 || code == "200";
	}

	function getApiMessage(res: Response | null, fallback: string): string {
		if (res == null) {
			return fallback;
		}
		const msg = res.msg ?? res.message;
		if (msg != null && `${msg}`.trim() != "") {
			return `${msg}`;
		}
		return fallback;
	}

	function getLogoText(name: string): string {
		const text = name.trim();
		if (text == "") {
			return "企";
		}
		return text.charAt(0);
	}

	function refreshLogoDisplay(remoteUrl: string) {
		logoUrl.value = remoteUrl;
		if (remoteUrl.trim() == "") {
			logoDisplaySrc.value = "";
			return;
		}
		toDisplayImageSrc(remoteUrl).then((path) => {
			logoDisplaySrc.value = path != "" ? path : remoteUrl;
		});
	}

	function parseEnterpriseInfo(res: any | null): EnterpriseInfo | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (data == null) {
			return null;
		}
		return data as EnterpriseInfo;
	}

	function applyEnterpriseInfo(info: EnterpriseInfo) {
		const name = info.name ?? "";
		const intro = info.intro ?? "";
		const logo = info.logo ?? "";
		miniAppName.value = name;
		introText.value = intro;
		logoText.value = getLogoText(name);
		refreshLogoDisplay(logo);

	}

	function loadEnterpriseInfo(fullScreen: boolean = true) {
		if (infoRequesting.value) {
			return Promise.resolve();
		}
		infoRequesting.value = true;
		if (fullScreen) {
			pageLoading.value = true;
		}
		return getEnterpriseInfo()
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const info = parseEnterpriseInfo(res);
				if (info == null) {
					uni.showToast({ title: "企业信息为空", icon: "none" });
					return;
				}
				applyEnterpriseInfo(info);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
			})
			.finally(() => {
				infoRequesting.value = false;
				pageLoading.value = false;
			});
	}

	function onChangeLogo() {
		if (pageLoading.value || saving.value || uploading.value) {
			return;
		}
		uni.chooseImage({
			count: 1,
			sizeType: ["compressed"],
			sourceType: ["album", "camera"],
			success: (res) => {
				const paths = res.tempFilePaths;
				if (paths == null || paths.length == 0) {
					return;
				}
				const tempPath = paths[0];
				uploading.value = true;
                uni.showLoading({ title: "上传中..." });
				normalizePickDisplayPath(tempPath)
					.then((displayPath) => {
						logoDisplaySrc.value = displayPath;
						return uploadImage(tempPath);
					})
					.then((url) => {
						refreshLogoDisplay(url);
					})
					.catch((err) => {
						const msg =
							err != null && (err as UTSJSONObject)["message"] != null
								? `${(err as UTSJSONObject)["message"]}`
								: "上传失败";
						refreshLogoDisplay(logoUrl.value);
                        uni.showToast({ title: msg, icon: "none" });
					})
					.finally(() => {
						uploading.value = false;
                        uni.hideLoading();
					});
			}
		});
	}

	function onSave() {
		if (pageLoading.value || saving.value || uploading.value) {
			return;
		}
		const name = miniAppName.value.trim();
		if (name == "") {
			uni.showToast({ title: "请填写企业号名称", icon: "none" });
			return;
		}
		const intro = introText.value.trim();
		if (intro == "") {
			uni.showToast({ title: "请填写介绍", icon: "none" });
			return;
		}

		saving.value = true;
		saveEnterpriseSettings({
			name,
			logo: logoUrl.value,
			intro
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "保存失败"), icon: "none" });
					return Promise.resolve();
				}
				uni.showToast({ title: getApiMessage(envelope, "保存成功"), icon: "success" });
				return loadEnterpriseInfo(false);
			})
			.catch((err) => {
				const res = err as Response;
				uni.showToast({ title: getApiMessage(res, "保存失败"), icon: "none" });
			})
			.finally(() => {
				saving.value = false;
			});
	}

	watch(miniAppName, (val) => {
		logoText.value = getLogoText(val);
	});

	onLoad(() => {
		loadEnterpriseInfo();
	});
</script>

<style lang="scss" scoped>
@use "../../styles/owner-workbench" as owner;
.st-page { position: relative; min-height: 100vh; background: owner.$background; box-sizing: border-box; }
.st-nav { height: 48px; margin: 0 16px; display: flex; flex-direction: row; align-items: center; }
.st-nav > text { @include owner.title; }
.st-content { margin: 0 16px; padding-bottom: 20px; }
.st-note { @include owner.feature; padding: 14px; margin-bottom: 12px; }
.st-note-title { display: block; font-size: 13px; font-weight: 600; line-height: 20px; color: #535d73; }
.st-note-copy { display: block; margin-top: 6px; font-size: 12px; line-height: 20px; color: #7d869c; }
.st-form { @include owner.card; padding: 0 14px; }
.st-field { padding: 16px 0; border-bottom: 1px solid owner.$border; }
.st-field--last { border: 0; }
.st-label-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.st-label { font-size: 13px; font-weight: 500; line-height: 20px; color: owner.$text; }
.st-count { font-size: 11px; line-height: 18px; color: #a2a9b5; }
.st-input, .st-intro { width: 100%; background: #f8f9fb; border: 1px solid owner.$border; border-radius: 8px; padding: 10px 12px; font-size: 14px; line-height: 22px; color: owner.$text; box-sizing: border-box; }
.st-input { height: 42px; }
.st-intro { height: 110px; }
.st-placeholder { font-size: 13px; color: #a2a9b5; }
.st-logo-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid owner.$border; }
.st-logo-actions { display: flex; flex-direction: row; align-items: center; gap: 12px; }
.st-logo-box, .st-logo-image { width: 48px; height: 48px; border-radius: 12px; }
.st-logo-box { background: #eef2ff; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.st-logo-text { color: owner.$primary; font-size: 20px; font-weight: 600; }
.st-change-btn { @include owner.control; padding: 6px 12px; display: flex; align-items: center; justify-content: center; }
.st-change-btn > text { font-size: 12px; line-height: 20px; color: owner.$primary; }
.st-save-btn { margin-top: 16px; min-height: 44px; border-radius: 10px; background: owner.$primary; display: flex; align-items: center; justify-content: center; }
.st-save-btn > text { font-size: 14px; line-height: 22px; font-weight: 600; color: #fff; }
.st-save-btn--disabled { opacity: .55; }
.st-loading-mask { position: fixed; inset: 0; z-index: 999; background: rgba(244,245,247,.8); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
.st-loading-mask > text { font-size: 13px; color: owner.$muted; }
@media (max-width: 360px) { .st-nav, .st-content { margin-left: 12px; margin-right: 12px; } }
@media (min-width: 600px) { .st-nav, .st-content { width: calc(100% - 48px); max-width: 720px; margin-left: auto; margin-right: auto; } }
</style>
