<style lang="scss" scoped>
@use "../../styles/owner-workbench" as owner;

.ac-page {
	background: owner.$background;
	font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
	color: owner.$text;
}

.ac-body { padding: 16px 16px 28px; }
.ac-loading-text { margin-top: 8px; font-size: 12px; line-height: 18px; color: owner.$muted; }

.ac-profile-card {
	margin-bottom: 18px;
	padding: 16px;
	border-radius: 16px;
	border: 1px solid #e2e7f7;
	background: linear-gradient(120deg, #eef2ff 0%, #f4f1ff 100%);
	box-shadow: none;
}
.ac-avatar, .ac-avatar-image { width: 52px; height: 52px; border-radius: 50%; }
.ac-avatar { background: linear-gradient(135deg, #5375ed 0%, #7b61d9 100%); }
.ac-avatar-text { font-size: 22px; line-height: 30px; font-weight: 600; }
.ac-profile-copy { margin-left: 12px; }
.ac-name { margin-right: 8px; font-size: 17px; line-height: 24px; font-weight: 600; color: owner.$text; }
.ac-level { padding: 2px 7px; border-radius: 6px; background: #fff4e8; }
.ac-level-text { font-size: 10px; line-height: 16px; color: #c77822; }
.ac-meta { margin-top: 3px; font-size: 12px; line-height: 18px; color: owner.$muted; }

.ac-section-label {
	display: flex;
	align-items: center;
	margin: 18px 2px 8px;
	font-size: 13px;
	line-height: 20px;
	font-weight: 600;
	color: #5f687b;
}
.ac-section-label:before { content: ''; width: 3px; height: 13px; margin-right: 7px; border-radius: 3px; background: owner.$primary; }
.ac-card { margin-bottom: 4px; border: 1px solid #e7eaf0; border-radius: 14px; box-shadow: none; }
.ac-row { min-height: 54px; padding: 12px 14px; box-sizing: border-box; }
.ac-row-label { font-size: 14px; line-height: 21px; font-weight: 500; color: owner.$text; }
.ac-row-right { margin-left: 16px; }
.ac-row-value { max-width: 210px; margin-right: 4px; font-size: 12px; line-height: 18px; color: owner.$muted; }
.ac-row-divider { left: 14px; right: 14px; height: 1px; background: owner.$border; }
.ac-row-avatar, .ac-row-avatar-img { width: 30px; height: 30px; border-radius: 50%; }
.ac-row-avatar { background: linear-gradient(135deg, #5375ed 0%, #7b61d9 100%); }
.ac-row-avatar-text { font-size: 12px; line-height: 18px; }
.ac-badge { padding: 1px 6px; border-radius: 5px; }
.ac-badge-text { font-size: 10px; line-height: 16px; }
.ac-notice-card { padding: 13px 14px; margin-bottom: 12px; border-radius: 12px; box-shadow: none; border: 1px solid #f5dec2; }
.ac-notice-icon { width: 30px; height: 30px; margin: 0 10px 0 0; }
.ac-notice-icon-text { font-size: 16px; line-height: 22px; }
.ac-notice-title { font-size: 13px; line-height: 20px; }
.ac-notice-sub { margin-top: 2px; font-size: 11px; line-height: 17px; }
.ac-logout { height: 46px; margin-top: 20px; padding: 0; border: 1px solid #f2d7d9; border-radius: 12px; background: #fff; }
.ac-logout-text { font-size: 14px; line-height: 20px; font-weight: 500; color: #e34a51; }

@media (min-width: 600px) { .ac-body { width: calc(100% - 48px); max-width: 960px; margin: 0 auto; } }
</style>
