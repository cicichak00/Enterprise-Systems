<template>
	<cl-page :pt="{ className: 'lpp-page' }">
		<view class="lpp-page">
			<view class="lpp-body">
				<view class="lpp-card">
					<input class="lpp-autofill-trap" value="" autocomplete="off" />
					<input class="lpp-autofill-trap" password="true" value="" autocomplete="new-password" />
					<text class="lpp-tip">向绑定手机号发送验证码，验证通过后可设置新登录密码。</text>
					<view class="lpp-field">
						<view class="lpp-label-row">
							<text class="lpp-label">手机号</text>
						</view>
						<text class="lpp-mobile">{{ mobileDisplay }}</text>
					</view>
					<view class="lpp-field">
						<view class="lpp-label-row">
							<text class="lpp-label">验证码</text>
							<text class="lpp-required">*</text>
						</view>
						<view class="lpp-code-row">
							<input
								:key="codeInputKey"
								class="lpp-input lpp-input--code"
								:value="code"
								type="digit"
								maxlength="6"
								autocomplete="one-time-code"
								placeholder="请输入6位验证码"
								placeholder-class="lpp-input-placeholder"
								@input="onCodeInput"
							/>
							<view
								class="lpp-code-btn"
								:class="{ 'lpp-code-btn--disabled': codeSending || countdown > 0 || mobile == '' }"
								@tap="onSendCode"
							>
								<text class="lpp-code-btn-text">{{ codeBtnText }}</text>
							</view>
						</view>
					</view>
					<view class="lpp-field">
						<view class="lpp-label-row">
							<text class="lpp-label">新密码</text>
							<text class="lpp-required">*</text>
						</view>
						<input
							class="lpp-input"
							v-model="password"
							password="true"
							autocomplete="new-password"
							:readonly="passwordReadonly"
							@focus="onPasswordFocus"
							placeholder="请输入6-32位密码"
							placeholder-class="lpp-input-placeholder"
						/>
					</view>
					<view class="lpp-field lpp-field--last">
						<view class="lpp-label-row">
							<text class="lpp-label">确认密码</text>
							<text class="lpp-required">*</text>
						</view>
						<input
							class="lpp-input"
							v-model="confirmPassword"
							password="true"
							autocomplete="new-password"
							:readonly="confirmPasswordReadonly"
							@focus="onConfirmPasswordFocus"
							placeholder="请再次输入新密码"
							placeholder-class="lpp-input-placeholder"
						/>
					</view>
				</view>
				<view class="lpp-submit" :class="{ 'lpp-submit--disabled': submitting }" @tap="onSubmit">
					<text class="lpp-submit-text">{{ submitting ? "提交中..." : "确认修改" }}</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
	import { computed, ref } from "vue";
	import { setLoginPassword, sendPasswordResetSmsCode } from "@/.cool/api/login";
	import { getApiMessage, isApiSuccess, useStore } from "@/.cool";
	import {
		countInputDigits,
		isValidPhone,
		normalizePhone,
		normalizeSmsCode,
		readInputValue,
		readSmsCodeInput
	} from "@/.cool/utils/phone";

	const { user } = useStore();
	const mobile = ref("");
	const code = ref("");
	const codeInputKey = ref(0);
	const password = ref("");
	const confirmPassword = ref("");
	const submitting = ref(false);
	const codeSending = ref(false);
	const countdown = ref(0);
	const passwordReadonly = ref(true);
	const confirmPasswordReadonly = ref(true);
	let countdownTimer: number | null = null;

	const mobileDisplay = computed((): string => {
		const phone = mobile.value.trim();
		if (phone.length >= 11) {
			return `+86 ${phone.slice(0, 3)} **** ${phone.slice(7)}`;
		}
		if (phone != "") {
			return phone;
		}
		return "未绑定手机号";
	});

	const codeBtnText = computed((): string => {
		if (countdown.value > 0) {
			return `${countdown.value}s`;
		}
		return "获取验证码";
	});

	function onCodeInput(e: UniInputEvent) {
		const raw = readInputValue(e, "");
		code.value = readSmsCodeInput(e);
		if (countInputDigits(raw) > 6) {
			codeInputKey.value += 1;
		}
	}

	function pickMobileFromLocal(): string {
		const info = user.info.value;
		if (info != null && info.phone != "") {
			return `${info.phone}`.trim();
		}
		const stored = uni.getStorageSync("userInfo") as UTSJSONObject | null;
		if (stored != null) {
			const m = `${stored["mobile"] ?? stored["phone"] ?? ""}`.trim();
			if (m != "") {
				return m;
			}
		}
		const loginM = uni.getStorageSync("loginM") as string | null;
		if (loginM != null && `${loginM}`.trim() != "") {
			return `${loginM}`.trim();
		}
		return "";
	}

	function loadMobile() {
		const local = pickMobileFromLocal();
		if (local != "") {
			mobile.value = local;
			return;
		}
		user.fetchProfile()
			.then(() => {
				const fetched = pickMobileFromLocal();
				if (fetched != "") {
					mobile.value = fetched;
				}
			})
			.catch(() => {});
	}

	function startCountdown() {
		countdown.value = 60;
		countdownTimer = setInterval(() => {
			countdown.value -= 1;
			if (countdown.value <= 0 && countdownTimer != null) {
				clearInterval(countdownTimer);
				countdownTimer = null;
			}
		}, 1000) as number;
	}

	function onPasswordFocus() {
		passwordReadonly.value = false;
	}

	function onConfirmPasswordFocus() {
		confirmPasswordReadonly.value = false;
	}

	function onSendCode() {
		if (codeSending.value || countdown.value > 0) {
			return;
		}
		const phone = normalizePhone(mobile.value);
		if (!isValidPhone(phone)) {
			uni.showToast({ title: "未绑定有效手机号", icon: "none" });
			return;
		}
		codeSending.value = true;
		sendPasswordResetSmsCode(phone)
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const codeVal = envelope["code"];
				if (codeVal != null && !isApiSuccess(codeVal)) {
					uni.showToast({ title: getApiMessage(res, "发送失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: "验证码已发送", icon: "none" });
				startCountdown();
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "发送失败"), icon: "none" });
			})
			.finally(() => {
				codeSending.value = false;
			});
	}

	function validate(): string {
		const phone = normalizePhone(mobile.value);
		if (!isValidPhone(phone)) {
			return "未绑定有效手机号";
		}
		const smsCode = normalizeSmsCode(code.value);
		if (smsCode.length != 6) {
			return "请输入6位验证码";
		}
		const pwd = password.value.trim();
		const confirmPwd = confirmPassword.value.trim();
		if (pwd == "") {
			return "请输入新密码";
		}
		if (pwd.length < 6 || pwd.length > 32) {
			return "密码长度需为6-32位";
		}
		if (confirmPwd == "") {
			return "请再次输入新密码";
		}
		if (pwd != confirmPwd) {
			return "两次输入的密码不一致";
		}
		return "";
	}

	function onSubmit() {
		if (submitting.value) {
			return;
		}
		const err = validate();
		if (err != "") {
			uni.showToast({ title: err, icon: "none" });
			return;
		}
		submitting.value = true;
		uni.showLoading({ title: "提交中..." });
		setLoginPassword(normalizeSmsCode(code.value), password.value.trim())
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const codeVal = envelope["code"];
				if (codeVal != null && !isApiSuccess(codeVal)) {
					uni.showToast({ title: getApiMessage(res, "修改失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: getApiMessage(res, "修改成功"), icon: "success" });
				setTimeout(() => {
					uni.navigateBack();
				}, 400);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "修改失败"), icon: "none" });
			})
			.finally(() => {
				submitting.value = false;
				uni.hideLoading();
			});
	}

	onShow(() => {
		loadMobile();
	});

	onUnload(() => {
		if (countdownTimer != null) {
			clearInterval(countdownTimer);
			countdownTimer = null;
		}
	});
</script>

<style lang="scss" scoped>
	.lpp-page {
		min-height: 100vh;
		background-color: #f7f8fa;
	}

	.lpp-body {
		min-height: 100vh;
		padding: 24rpx 30rpx 40rpx;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}

	.lpp-autofill-trap {
		position: fixed;
		left: -9999px;
		top: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
		z-index: -1;
	}

	.lpp-card {
		padding: 28rpx;
		border-radius: 24rpx;
		background-color: #ffffff;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
	}

	.lpp-tip {
		font-size: 24rpx;
		color: #999999;
		line-height: 34rpx;
		margin-bottom: 28rpx;
	}

	.lpp-field {
		margin-bottom: 28rpx;

		&--last {
			margin-bottom: 0;
		}
	}

	.lpp-label-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 12rpx;
	}

	.lpp-label {
		font-size: 26rpx;
		color: #333333;
		line-height: 36rpx;
		font-weight: 500;
	}

	.lpp-required {
		margin-left: 4rpx;
		font-size: 26rpx;
		color: #ef4444;
		line-height: 36rpx;
	}

	.lpp-mobile {
		font-size: 28rpx;
		color: #333333;
		line-height: 40rpx;
	}

	.lpp-code-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.lpp-input {
		width: 100%;
		height: 80rpx;
		padding: 0 20rpx;
		border-radius: 12rpx;
		background-color: #f7f8fa;
		border-width: 1rpx;
		border-style: solid;
		border-color: #eeeeee;
		font-size: 28rpx;
		color: #333333;
		box-sizing: border-box;

		&--code {
			flex: 1;
			min-width: 0;
		}
	}

	.lpp-input-placeholder {
		color: #999999;
		font-size: 28rpx;
	}

	.lpp-code-btn {
		margin-left: 16rpx;
		height: 80rpx;
		padding: 0 24rpx;
		border-radius: 12rpx;
		background-color: rgba(43, 89, 195, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;

		&--disabled {
			opacity: 0.6;
		}
	}

	.lpp-code-btn-text {
		font-size: 24rpx;
		color: #2b59c3;
		line-height: 34rpx;
		white-space: nowrap;
	}

	.lpp-submit {
		margin-top: auto;
		padding: 28rpx;
		border-radius: 24rpx;
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;

		&--disabled {
			opacity: 0.6;
		}
	}

	.lpp-submit-text {
		font-size: 30rpx;
		color: #ffffff;
		line-height: 42rpx;
		font-weight: 600;
	}
</style>
