<template>
	<cl-page :pt="{ className: 'op-page' }" :back-top="false"><view class="op-page">
		<view class="op-header"><cl-safe-area type="top"></cl-safe-area><view class="op-nav"><view class="op-back" @tap="goBack"><cl-icon name="arrow-left-s-line" :size="24" color="#252b3b"></cl-icon></view><view><text>{{ projectName }}</text><small>海外订单 · {{ projectType }}</small></view><view class="op-back"></view></view></view>
		<scroll-view class="op-scroll" scroll-y="true" :show-scrollbar="false"><view class="op-inner">
			<view class="op-summary"><text>项目总收益（当前时间范围）</text><b>{{ amount }}元</b><view><view><text>已结算</text><b>{{ settled }}元</b></view><view><text>待结算</text><b>{{ pending }}元</b></view></view></view>
			<view class="op-section"><view><text>内容作品</text><small>按内容名称查看归因订单</small></view><text>共 {{ contents.length }} 部</text></view>
			<view class="op-grid"><view v-for="item in contents" :key="item.name" class="op-card" @tap="openOrders(item)"><view><text>{{ item.name }}</text><b>明细 ›</b></view><text>订单数 · {{ item.orderCount }}</text><text>已结算 · {{ item.settled }}元</text><text class="pending">待结算 · {{ item.pending }}元</text><text>最近出单 · {{ item.latest }}</text></view></view>
		</view></scroll-view>
	</view></cl-page>
</template>
<script lang="ts" setup>
	import { ref } from "vue";
	type ContentItem={name:string;orderCount:number;settled:string;pending:string;latest:string};
	const projectName=ref("MegaNovel"),projectType=ref("海外小说"),amount=ref("1,680.40"),settled=ref("824.20"),pending=ref("856.20");
	const contents:ContentItem[]=[{name:"The Final Experiment",orderCount:16,settled:"226.53",pending:"522.79",latest:"2026.10.09"},{name:"No Free Room for You",orderCount:11,settled:"120.30",pending:"84.20",latest:"2026.10.09"},{name:"Frozen on Examination Day",orderCount:13,settled:"305.75",pending:"69.68",latest:"2026.10.08"},{name:"Too Late, My Love",orderCount:28,settled:"171.62",pending:"179.53",latest:"2026.10.08"}];
	function goBack(){uni.navigateBack();}
	function openOrders(item:ContentItem){uni.navigateTo({url:`/pages/revenue/overseas-orders?project=${encodeURIComponent(projectName.value)}&content=${encodeURIComponent(item.name)}&count=${item.orderCount}&settled=${item.settled}&pending=${item.pending}`});}
	onLoad((options)=>{const data=options as UTSJSONObject;projectName.value=decodeURIComponent(`${data["name"]??projectName.value}`);projectType.value=decodeURIComponent(`${data["type"]??projectType.value}`);amount.value=`${data["amount"]??amount.value}`;settled.value=`${data["settled"]??settled.value}`;pending.value=`${data["pending"]??pending.value}`;});
</script>
<style lang="scss" scoped>
.op-page{width:100%;height:100vh;display:flex;flex-direction:column;background:#f4f5f7;color:#252b3b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.op-header{background:#fff;border-bottom:1px solid #e7eaf0}.op-nav{height:52px;display:flex;flex-direction:row;align-items:center;justify-content:space-between}.op-back{width:48px;height:48px;display:flex;align-items:center;justify-content:center}.op-nav>view:nth-child(2){flex:1;min-width:0}.op-nav text,.op-nav small{display:block;text-align:center}.op-nav text{font-size:17px;line-height:23px;font-weight:600}.op-nav small{font-size:10px;line-height:15px;color:#8a93a5}.op-scroll{width:100%;flex:1;height:0}.op-inner{width:100%;max-width:960px;margin:0 auto;padding:14px 16px 32px;box-sizing:border-box}.op-summary{padding:16px;border:1px solid #dfe3fb;border-radius:16px;background:linear-gradient(135deg,#f4f5ff,#eeecff)}.op-summary>text{font-size:11px;color:#788196}.op-summary>b{display:block;margin:4px 0 14px;font-size:32px;line-height:40px}.op-summary>view{display:grid;grid-template-columns:repeat(2,1fr);overflow:hidden;border-radius:10px;background:#fff}.op-summary>view>view{padding:11px 14px}.op-summary>view>view+view{border-left:1px solid #e7eaf0}.op-summary view text,.op-summary view b{display:block}.op-summary view text{font-size:11px;color:#8a93a5}.op-summary view b{margin-top:3px;font-size:15px}.op-section{margin:18px 2px 10px;display:flex;flex-direction:row;align-items:flex-end;justify-content:space-between}.op-section text,.op-section small{display:block}.op-section>view>text{font-size:17px;font-weight:600}.op-section small,.op-section>text{font-size:10px;color:#8a93a5}.op-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.op-card{min-width:0;padding:14px;border-radius:13px;background:#fff}.op-card>view{display:flex;flex-direction:row;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:14px}.op-card>view>text{height:42px;overflow:hidden;font-size:14px;line-height:21px;font-weight:600}.op-card>view>b{flex-shrink:0;font-size:11px;color:#6878d8}.op-card>text{display:block;margin-top:5px;font-size:11px;color:#7d8799}.op-card>text.pending{color:#e07132}@media(max-width:360px){.op-inner{padding-left:12px;padding-right:12px}.op-grid{gap:8px}.op-card{padding:11px}}
</style>
