<template>
		<cl-page :pt="{ className: 'rd-page' }" :back-top="false"><view class="rd-page"><view class="rd-header"><cl-safe-area type="top"></cl-safe-area><view class="rd-nav"><view class="rd-back" @tap="goBack"><cl-icon name="arrow-left-s-line" :size="24" color="#1f2937"></cl-icon></view><text>收益明细</text><view class="rd-back"></view></view></view><scroll-view class="rd-scroll" scroll-y="true" :show-scrollbar="false"><view class="rd-inner"><view class="rd-summary"><text class="rd-summary-title">{{ title }}收益</text><text class="rd-summary-sub">按订单已审核时间统计</text><view class="rd-summary-grid"><view><text>推广收益</text><b>¥{{ promoTotal }}</b></view><view><text>企业主收益</text><b>¥{{ enterpriseTotal }}</b></view><view><text>员工收益</text><b>¥{{ staffTotal }}</b></view></view></view><view class="rd-head"><text>收益明细</text><small>共 {{ orders.length }} 条</small></view><view v-if="loading" class="rd-empty"><cl-loading :loading="true" :size="26"></cl-loading></view><view v-else-if="orders.length==0" class="rd-empty"><text>暂无收益明细</text></view><view v-else class="rd-list"><view v-for="item in orders" :key="item.id" class="rd-card"><view class="rd-card-top"><view class="rd-avatar"><text>{{ avatar(item) }}</text></view><view class="rd-user"><text class="rd-name">{{ item.user_nickname || '未命名员工' }}</text><text class="rd-id">员工ID：{{ item.user_sn || item.user_id || '--' }}</text></view><view class="rd-amount"><text class="rd-status" :class="{ 'rd-status--done': settlementStatus(item) == '已结算' }">{{ settlementStatus(item) }}</text><b>¥{{ money(orderRevenue(item)) }}</b><text>推广收益</text></view></view><view class="rd-divider"></view><view class="rd-data"><text>企业主收益 <b>¥{{ money(item.enterprise_profit) }}</b></text><text>员工收益 <b>¥{{ money(item.user_profit) }}</b></text><text>审核时间 <b>{{ auditKey(item) || '--' }}</b></text><text>分佣比例 <b class="blue">{{ item.user_rate || 0 }}%</b></text></view><view class="rd-project">所属项目 <text>{{ item.project_title || '未命名项目' }}</text></view></view></view></view></scroll-view></view></cl-page>
</template>
<script lang="ts" setup>
	import { computed, ref } from "vue";import { getOrderList } from "@/.cool/api/order";import { isApiSuccess } from "@/.cool";import type { OrderListItem,OrderListPayload } from "@/.cool/types/order";
	const dimension=ref("month"),key=ref(""),label=ref(""),loading=ref(false),orders=ref<OrderListItem[]>([]);const title=computed(()=>dimension.value=="day"?key.value:dimension.value=="month"?`${key.value.substring(0,4)}年${parseInt(key.value.substring(5,7))}月`:`${key.value}年`);function pad(value:number):string{return value<10?`0${value}`:`${value}`}function normalizeOrderDate(value:any|null):string{if(value==null||`${value}`.trim()=="")return"";const raw=`${value}`.trim();if(/^\d{10,13}$/.test(raw)){let stamp=parseInt(raw);if(raw.length==10)stamp*=1000;const date=new Date(stamp);return`${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`}const matched=raw.match(/(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);return matched==null?"":`${matched[1]}-${pad(parseInt(matched[2]))}-${pad(parseInt(matched[3]))}`}function auditKey(item:OrderListItem):string{const values:any[]=[item.audit_time,item["audited_at"],item["audit_at"],item["review_time"],item["reviewed_at"]];for(let i=0;i<values.length;i++){const value=normalizeOrderDate(values[i]);if(value!="")return value}return""}function orderRevenue(item:OrderListItem):number{const direct=item.share_profit??item["promo_revenue"]??item["promotion_revenue"]??item["revenue"]??item["amount"];if(direct!=null&&`${direct}`!="")return parseFloat(`${direct}`)||0;return(parseFloat(`${item.enterprise_profit??0}`)||0)+(parseFloat(`${item.user_profit??0}`)||0)}function settlementStatus(item:OrderListItem):string{const direct=`${item["settlement_status_text"]??item.payment_status_text??""}`.trim();if(direct!="")return direct;const raw=`${item["settlement_status"]??item["payment_status"]??item.status??0}`.toLowerCase();return raw=="1"||raw=="settled"||raw=="paid"||raw=="true"?"已结算":"未结算"}function matches(item:OrderListItem):boolean{const date=auditKey(item);return dimension.value=="day"?date==key.value:date.indexOf(key.value)==0}function money(value:any|null):string{return(parseFloat(`${value??0}`)||0).toFixed(2)}function sum(field:string):string{let total=0;for(let i=0;i<orders.value.length;i++)total+=parseFloat(`${(orders.value[i]as any)[field]??0}`)||0;return total.toFixed(2)}const promoTotal=computed(()=>{let total=0;for(let i=0;i<orders.value.length;i++)total+=orderRevenue(orders.value[i]);return total.toFixed(2)}),enterpriseTotal=computed(()=>sum("enterprise_profit")),staffTotal=computed(()=>sum("user_profit"));function avatar(item:OrderListItem):string{return`${item.user_nickname??'未'}`.substring(0,1)}function goBack(){uni.navigateBack()}function load(){loading.value=true;getOrderList({page:1,limit:500,period:"total"}).then(res=>{const env=res as UTSJSONObject;if(env["code"]!=null&&!isApiSuccess(env["code"]))return;const data=(env["data"]??env)as OrderListPayload;const list=data.list??[];orders.value=list.filter((item)=>matches(item))}).catch(()=>{}).finally(()=>{loading.value=false})}onLoad((options)=>{const data=options as UTSJSONObject;dimension.value=`${data["dimension"]??"month"}`;key.value=decodeURIComponent(`${data["key"]??""}`);label.value=decodeURIComponent(`${data["label"]??""}`);load()});
</script>
<style lang="scss" scoped>.rd-page{height:100vh;display:flex;flex-direction:column;background:#f4f6fa}.rd-header{background:#fff}.rd-nav{height:88rpx;display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:700}.rd-back{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}.rd-scroll{flex:1;height:0}.rd-inner{padding:20rpx 24rpx 50rpx}.rd-summary{padding:28rpx;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#204da9,#3865d1)}.rd-summary-title{display:block;font-size:36rpx;font-weight:700}.rd-summary-sub{display:block;margin-top:10rpx;font-size:20rpx}.rd-summary-grid{margin-top:28rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.rd-summary-grid view{padding:18rpx 12rpx;border-radius:14rpx;background:rgba(255,255,255,.18)}.rd-summary-grid text,.rd-summary-grid b{display:block}.rd-summary-grid text{font-size:19rpx}.rd-summary-grid b{margin-top:8rpx;font-size:25rpx}.rd-head{margin:26rpx 2rpx 14rpx;display:flex;align-items:center;justify-content:space-between}.rd-head>text{font-size:31rpx;font-weight:700}.rd-head small{font-size:20rpx;color:#8791a3}.rd-list{display:flex;flex-direction:column;gap:16rpx}.rd-card{padding:22rpx;border-radius:20rpx;background:#fff}.rd-card-top{display:flex;align-items:center}.rd-avatar{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#2b59c3;background:#e9efff}.rd-user{flex:1;margin-left:14rpx}.rd-name,.rd-id{display:block}.rd-name{font-size:27rpx;font-weight:700}.rd-id{margin-top:4rpx;font-size:19rpx;color:#8c96a8}.rd-amount{text-align:right}.rd-amount b,.rd-amount text{display:block}.rd-amount b{font-size:29rpx;color:#2b59c3}.rd-amount text{font-size:18rpx;color:#8b95a6}.rd-amount .rd-status{display:inline-block;margin-bottom:5rpx;padding:3rpx 9rpx;border-radius:8rpx;color:#d97706;background:#fff3df}.rd-amount .rd-status--done{color:#16855b;background:#e9f8f1}.rd-divider{height:1rpx;margin:18rpx -22rpx;background:#edf0f4}.rd-data{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx 12rpx;font-size:20rpx;color:#8892a4}.rd-data b{margin-left:8rpx;color:#293449}.rd-data .blue{color:#2b59c3}.rd-project{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf0f4;font-size:20rpx;color:#8b95a6}.rd-project text{float:right;color:#293449}.rd-empty{height:260rpx;display:flex;align-items:center;justify-content:center;color:#939cac}.rd-nav,.rd-back,.rd-head,.rd-card-top,.rd-avatar,.rd-empty{flex-direction:row}</style>
