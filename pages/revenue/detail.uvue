<template>
		<cl-page :pt="{ className: 'rd-page' }" :back-top="false"><view class="rd-page"><view class="rd-header"><cl-safe-area type="top"></cl-safe-area><view class="rd-nav"><view class="rd-back" @tap="goBack"><cl-icon name="arrow-left-s-line" :size="24" color="#1f2937"></cl-icon></view><text>收益明细</text><view class="rd-back"></view></view></view><scroll-view class="rd-scroll" scroll-y="true" :show-scrollbar="false"><view class="rd-inner"><view class="rd-summary"><text class="rd-summary-kicker">所选周期</text><text class="rd-summary-title">{{ title }}</text><text class="rd-summary-sub">按订单审核通过时间统计</text><view class="rd-summary-grid"><view><text>企业总收益</text><b>¥{{ promoTotal }}</b></view><view><text>推广收益</text><b>¥{{ enterpriseTotal }}</b></view><view><text>员工收益</text><b>¥{{ staffTotal }}</b></view></view></view><view class="rd-head"><view><text>收益明细</text><small>逐笔展示收益分配</small></view><em>共 {{ orders.length }} 条</em></view><view v-if="loading" class="rd-empty"><cl-loading :loading="true" :size="26"></cl-loading></view><view v-else-if="orders.length==0" class="rd-empty"><text>暂无收益明细</text></view><view v-else class="rd-list"><view v-for="item in orders" :key="item.id" class="rd-card"><view class="rd-card-top"><view class="rd-avatar"><text>{{ avatar(item) }}</text></view><view class="rd-user"><text class="rd-name">{{ item.user_nickname || '未命名员工' }}</text><text class="rd-id">员工ID：{{ item.user_sn || item.user_id || '--' }}</text></view><view class="rd-amount"><text class="rd-status" :class="{ 'rd-status--done': settlementStatus(item) == '已结算' }">{{ settlementStatus(item) }}</text><b>¥{{ money(orderRevenue(item)) }}</b><text>企业总收益</text></view></view><view class="rd-data"><view><text>推广收益</text><b>¥{{ money(item.enterprise_profit) }}</b></view><view><text>员工收益</text><b>¥{{ money(item.user_profit) }}</b></view><view><text>审核时间</text><b>{{ auditKey(item) || '--' }}</b></view><view><text>员工分成</text><b class="blue">{{ item.user_rate || 0 }}%</b></view></view><view class="rd-project"><text>所属项目</text><b>{{ item.project_title || '未命名项目' }}</b></view></view></view></view></scroll-view></view></cl-page>
</template>
<script lang="ts" setup>
	import { computed, ref } from "vue";import { getOrderList } from "@/.cool/api/order";import { isApiSuccess } from "@/.cool";import type { OrderListItem,OrderListPayload } from "@/.cool/types/order";
	const dimension=ref("month"),key=ref(""),label=ref(""),loading=ref(false),orders=ref<OrderListItem[]>([]);const title=computed(()=>dimension.value=="day"?key.value:dimension.value=="month"?`${key.value.substring(0,4)}年${parseInt(key.value.substring(5,7))}月`:`${key.value}年`);function pad(value:number):string{return value<10?`0${value}`:`${value}`}function normalizeOrderDate(value:any|null):string{if(value==null||`${value}`.trim()=="")return"";const raw=`${value}`.trim();if(/^\d{10,13}$/.test(raw)){let stamp=parseInt(raw);if(raw.length==10)stamp*=1000;const date=new Date(stamp);return`${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}`}const matched=raw.match(/(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);return matched==null?"":`${matched[1]}-${pad(parseInt(matched[2]))}-${pad(parseInt(matched[3]))}`}function auditKey(item:OrderListItem):string{const values:any[]=[item.audit_time,item["audited_at"],item["audit_at"],item["review_time"],item["reviewed_at"]];for(let i=0;i<values.length;i++){const value=normalizeOrderDate(values[i]);if(value!="")return value}return""}function orderRevenue(item:OrderListItem):number{const direct=item.share_profit??item["promo_revenue"]??item["promotion_revenue"]??item["revenue"]??item["amount"];if(direct!=null&&`${direct}`!="")return parseFloat(`${direct}`)||0;return(parseFloat(`${item.enterprise_profit??0}`)||0)+(parseFloat(`${item.user_profit??0}`)||0)}function settlementStatus(item:OrderListItem):string{const direct=`${item["settlement_status_text"]??item.payment_status_text??""}`.trim();if(direct!="")return direct;const raw=`${item["settlement_status"]??item["payment_status"]??item.status??0}`.toLowerCase();return raw=="1"||raw=="settled"||raw=="paid"||raw=="true"?"已结算":"未结算"}function matches(item:OrderListItem):boolean{const date=auditKey(item);return dimension.value=="day"?date==key.value:date.indexOf(key.value)==0}function money(value:any|null):string{return(parseFloat(`${value??0}`)||0).toFixed(2)}function sum(field:string):string{let total=0;for(let i=0;i<orders.value.length;i++)total+=parseFloat(`${(orders.value[i]as any)[field]??0}`)||0;return total.toFixed(2)}const promoTotal=computed(()=>{let total=0;for(let i=0;i<orders.value.length;i++)total+=orderRevenue(orders.value[i]);return total.toFixed(2)}),enterpriseTotal=computed(()=>sum("enterprise_profit")),staffTotal=computed(()=>sum("user_profit"));function avatar(item:OrderListItem):string{return`${item.user_nickname??'未'}`.substring(0,1)}function goBack(){uni.navigateBack()}function load(){loading.value=true;getOrderList({page:1,limit:500,period:"total"}).then(res=>{const env=res as UTSJSONObject;if(env["code"]!=null&&!isApiSuccess(env["code"]))return;const data=(env["data"]??env)as OrderListPayload;const list=data.list??[];orders.value=list.filter((item)=>matches(item))}).catch(()=>{}).finally(()=>{loading.value=false})}onLoad((options)=>{const data=options as UTSJSONObject;dimension.value=`${data["dimension"]??"month"}`;key.value=decodeURIComponent(`${data["key"]??""}`);label.value=decodeURIComponent(`${data["label"]??""}`);load()});
</script>
<style lang="scss" scoped>.rd-page{width:100%;height:100vh;display:flex;flex-direction:column;background:#f5f6f8;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:#252b3b}.rd-header{background:#fff;border-bottom:1px solid #edf0f4}.rd-nav{height:48px;display:flex;align-items:center;justify-content:space-between;font-size:17px;line-height:24px;font-weight:600}.rd-back{width:48px;height:48px;display:flex;align-items:center;justify-content:center}.rd-scroll{width:100%;flex:1;height:0}.rd-inner{width:100%;max-width:960px;margin:0 auto;padding:14px 16px 32px;box-sizing:border-box}.rd-summary{padding:16px;border:1px solid #e2e7f7;border-radius:14px;color:#252b3b;background:linear-gradient(135deg,#eef2ff 0%,#f5f2ff 100%)}.rd-summary-kicker{display:block;font-size:10px;line-height:16px;color:#7d89a4}.rd-summary-title{display:block;margin-top:2px;font-size:22px;line-height:30px;font-weight:700;color:#315fd1}.rd-summary-sub{display:block;margin-top:2px;font-size:11px;line-height:17px;color:#7d89a4}.rd-summary-grid{margin-top:14px;padding-top:12px;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #dfe5f5}.rd-summary-grid view{min-width:0;padding:0 10px;border-left:1px solid #dfe5f5}.rd-summary-grid view:first-child{padding-left:0;border-left:0}.rd-summary-grid text,.rd-summary-grid b{display:block}.rd-summary-grid text{font-size:10px;line-height:16px;color:#7d89a4}.rd-summary-grid b{margin-top:4px;font-size:14px;line-height:20px;color:#30384b}.rd-head{margin:18px 2px 10px;display:flex;align-items:flex-end;justify-content:space-between}.rd-head>view>text{display:block;font-size:16px;line-height:23px;font-weight:600}.rd-head small{display:block;margin-top:1px;font-size:10px;line-height:16px;color:#8a93a5}.rd-head em{font-style:normal;font-size:11px;line-height:17px;color:#8a93a5}.rd-list{display:flex;flex-direction:column;gap:10px}.rd-card{padding:14px;border:1px solid #e7eaf0;border-radius:14px;background:#fff}.rd-card-top{display:flex;align-items:center}.rd-avatar{width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#315fd1;background:#e9efff}.rd-avatar text{font-size:15px;font-weight:600}.rd-user{flex:1;min-width:0;margin-left:10px}.rd-name,.rd-id{display:block}.rd-name{font-size:14px;line-height:21px;font-weight:600}.rd-id{margin-top:2px;font-size:10px;line-height:16px;color:#8a93a5}.rd-amount{text-align:right}.rd-amount b,.rd-amount text{display:block}.rd-amount b{font-size:17px;line-height:23px;color:#315fd1}.rd-amount text{font-size:10px;line-height:15px;color:#8a93a5}.rd-amount .rd-status{display:inline-block;margin-bottom:3px;padding:1px 6px;border-radius:5px;font-size:10px;line-height:16px;color:#a66b22;background:#fff5e8}.rd-amount .rd-status--done{color:#32805e;background:#eaf7f1}.rd-data{margin-top:12px;padding:12px 0;display:grid;grid-template-columns:repeat(2,1fr);gap:10px 12px;border-top:1px solid #edf0f4;border-bottom:1px solid #edf0f4}.rd-data view{display:flex;flex-direction:column}.rd-data text{font-size:10px;line-height:16px;color:#8a93a5}.rd-data b{margin-top:2px;font-size:12px;line-height:18px;font-weight:500;color:#30384b}.rd-data .blue{color:#315fd1}.rd-project{padding-top:11px;display:flex;flex-direction:row;align-items:center;justify-content:space-between}.rd-project text{font-size:10px;line-height:16px;color:#8a93a5}.rd-project b{max-width:70%;font-size:12px;line-height:18px;font-weight:500;color:#30384b;text-align:right}.rd-empty{height:220px;display:flex;align-items:center;justify-content:center;color:#939cac;font-size:12px}.rd-nav,.rd-back,.rd-head,.rd-card-top,.rd-avatar,.rd-empty{flex-direction:row}@media(max-width:360px){.rd-inner{padding-left:12px;padding-right:12px}.rd-summary-grid view{padding:0 7px}.rd-summary-grid b{font-size:13px}.rd-card{padding:12px}}</style>
