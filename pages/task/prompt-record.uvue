				.cbf-manage-select-count {
					margin-left: 6rpx;
					font-size: 24rpx;
					color: #ff6033;
					line-height: 34rpx;
				}
			}

			.cbf-manage-delete-btn {
				flex-shrink: 0;
				width: 160rpx;
				height: 72rpx;
				border-radius: 36rpx;
				background-color: #ff3333;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;

				&--disabled {
					opacity: 0.6;
				}

				.cbf-manage-delete-text {
					font-size: 28rpx;
					font-weight: 600;
					color: #ffffff;
					line-height: 40rpx;
				}
			}

			.cbf-card-check {
				width: 36rpx;
				height: 36rpx;
				border-radius: 18rpx;
				border-width: 2rpx;
				border-style: solid;
				border-color: #cccccc;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;

				&--checked {
					border-color: #0651f8;
					background-color: #0651f8;
				}
			}
		}
	}
</style>
