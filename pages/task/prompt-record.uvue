				.cbf-manage {
					flex-shrink: 0;
					margin-left: 16rpx;
					height: 72rpx;
					padding: 0 20rpx;
					border-radius: 16rpx;
					background-color: #ffffff;
					border-width: 2rpx;
					border-style: solid;
					border-color: #eeeeee;
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					box-sizing: border-box;

					&--active {
						border-color: #0651f8;
						background-color: #f0f5ff;
					}

					.cbf-manage-icon {
						width: 22rpx;
						height: 22rpx;
						display: flex;
						flex-direction: row;
						flex-wrap: wrap;
						justify-content: space-between;
						align-content: space-between;

						.cbf-manage-dot {
							width: 9rpx;
							height: 9rpx;
							border-radius: 8rpx;
							border: 4rpx solid #333333;
						}
					}

					.cbf-manage-text {
						margin-left: 8rpx;
						font-size: 26rpx;
						color: #333333;
						line-height: 36rpx;
					}

					&--active .cbf-manage-text {
						margin-left: 0;
						color: #0651f8;
					}
				}
			}
		}

		.cbf-search-ph {
			color: #b0b0b0;
			font-size: 26rpx;
		}

		// --- 列表 ---
		.cbf-scroll {
			flex: 1;
			height: 0;

			&--manage {
				padding-bottom: 140rpx;
				box-sizing: border-box;
			}
		}

		.cbf-list {
			padding: 20rpx 24rpx 24rpx;
			box-sizing: border-box;
		}

		.cbf-state {
			padding: 120rpx 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;

			.cbf-state-text {
				margin-top: 16rpx;
				font-size: 26rpx;
				color: #999999;
				line-height: 36rpx;
			}
		}

		// --- 卡片 ---
		.cbf-card {
			margin-bottom: 20rpx;
			padding: 28rpx 24rpx 24rpx;
			background-color: #ffffff;
			border-radius: 20rpx;
			box-sizing: border-box;
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			border-width: 2rpx;
			border-style: solid;
			border-color: transparent;

			&:last-child {
				margin-bottom: 0;
			}

			&--selected {
				background-color: #eef3ff;
				border-color: #0651f8;
			}

			.cbf-card-check {
				width: 40rpx;
				height: 40rpx;
				border-radius: 20rpx;
				border-width: 2rpx;
				border-style: solid;
				border-color: #c8c8c8;
				margin-right: 16rpx;
				margin-top: 6rpx;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				background-color: #ffffff;

				&--checked {
					border-color: #0651f8;
					background-color: #0651f8;
				}
			}

			.cbf-card-main {
				flex: 1;
				min-width: 0;
			}

			.cbf-card-head {
				margin-bottom: 20rpx;

				.cbf-card-head-row {
					display: flex;
					flex-direction: row;
					align-items: flex-start;
					justify-content: space-between;
				}

				.cbf-card-title {
					flex: 1;
					min-width: 0;
					font-size: 32rpx;
					font-weight: 700;
					color: #1a1a1a;
					line-height: 44rpx;
					margin-right: 16rpx;
				}

				.cbf-action-btn {
					flex-shrink: 0;
					height: 48rpx;
					padding: 0 12rpx;
					border-radius: 8rpx;
					border-width: 2rpx;
					border-style: solid;
					border-color: #0651f8;
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					box-sizing: border-box;
					background-color: #ffffff;

					.cbf-action-btn-text {
						font-size: 20rpx;
						color: #0651f8;
						line-height: 28rpx;
					}
				}

				.cbf-card-time {
					display: block;
					margin-top: 8rpx;
					font-size: 24rpx;
					color: #999999;
					line-height: 34rpx;
				}
			}

			.cbf-status-box {
				padding: 20rpx;
				border-radius: 12rpx;
				background-color: #f9fafc;
				box-sizing: border-box;
				margin-bottom: 16rpx;

				.cbf-status-grid {
					display: flex;
					flex-direction: row;
					flex-wrap: wrap;

					.cbf-status-item {
						flex-basis: 50%;
						width: 50%;
						max-width: 50%;
						flex-grow: 0;
						flex-shrink: 0;
						display: flex;
						flex-direction: column;
						align-items: flex-start;
						margin-bottom: 12rpx;
						padding-right: 12rpx;
						box-sizing: border-box;

						&:nth-last-child(-n + 2) {
							margin-bottom: 0;
						}

						.cbf-status-line {
							display: flex;
							flex-direction: row;
							align-items: center;
							width: 100%;
						}

						.cbf-status-name {
							flex-shrink: 1;
							min-width: 0;
							margin-right: 10rpx;

							.cbf-status-name-text {
								font-size: 22rpx;
								color: #666666;
								line-height: 34rpx;
							}
						}

						.cbf-status-val {
							flex-shrink: 0;

							.cbf-status-val-text {
								font-size: 22rpx;
								color: #333333;
								line-height: 34rpx;
							}

							&--reviewing {
								.cbf-status-val-text {
									color: #ff7600;
								}
							}

							&--pass {
								.cbf-status-val-text {
									color: #1aad19;
								}
							}

							&--published {
								.cbf-status-val-text {
									color: #0651f8;
								}
							}

							&--reject {
								.cbf-status-val-text {
									color: #e54d42;
								}
							}

							&--expire {
								.cbf-status-val-text {
									color: #999999;
								}
							}
						}

						.cbf-status-msg {
							margin-top: 4rpx;
							width: 100%;
							font-size: 20rpx;
							color: #e54d42;
							line-height: 28rpx;
						}
					}
				}
			}

			.cbf-card-foot {
				display: flex;
				flex-direction: row;
				align-items: center;
				padding: 20rpx 24rpx;
				border-radius: 12rpx;
				background-color: #F9FAFC;
				box-sizing: border-box;

				.cbf-foot-main {
					flex: 1;
					min-width: 0;

					.cbf-book-name {
						display: block;
						font-size: 28rpx;
						font-weight: 600;
						color: #1a1a1a;
						line-height: 40rpx;
						margin-bottom: 4rpx;
					}

					.cbf-book-meta {
						display: block;
						font-size: 24rpx;
						color: #999999;
						line-height: 34rpx;
					}
				}
			}
		}

		// --- 管理底栏 ---
		.cbf-manage-footer {
			position: fixed;
			left: 0;
