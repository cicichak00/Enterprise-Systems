<template>
	<cl-page :pt="{ className: 'prl-page' }" :back-top="false">
		<view class="prl-page">
			<view class="prl-toolbar">
				<view class="prl-project" @tap="onOpenBrandPopup">
					<image
						v-if="logoUrl != ''"
						class="prl-project-logo"
						:src="logoUrl"
						mode="aspectFill"
					></image>
					<text class="prl-project-name">{{ projectTitle }}</text>
					<cl-icon name="arrow-down-s-line" :size="16" color="#9099b7"></cl-icon>
				</view>
				<view class="prl-add-btn" @tap="onAdd">
					<text class="prl-add-btn-text">新增</text>
				</view>
                <!-- <view class="prl-backfill-btn" v-if="is_batch_back == 1" @tap="onBatchBackfill">
					<text class="prl-add-btn-text">批量回填</text>
				</view> -->
			</view>

			<view class="prl-tabs-wrap">
				<view class="prl-tabs">
					<view
						v-for="(tab, index) in STATUS_TABS"
						:key="tab.key"
						class="prl-tab"
						:class="{ 'prl-tab--active': activeStatus == tab.key }"
						@tap="onTabChange(tab.key)"
					>
						<text
							class="prl-tab-text"
							:class="{ 'prl-tab-text--active': activeStatus == tab.key }"
						>{{ tab.label }}</text>
					</view>
				</view>
			</view>

			<view class="prl-search-bar">
				<view class="prl-search-field">
					<cl-icon name="search-line" :size="16" color="#aeb1bd"></cl-icon>
					<input
						class="prl-search-input"
						v-model="searchKeyword"
						placeholder="请输入剧名、关键词搜索"
						placeholder-class="prl-search-placeholder"
						confirm-type="search"
						@confirm="onSearch"
						@input="onSearchInput"
					/>
				</view>
			</view>

			<scroll-view
				class="prl-list-scroll"
				scroll-y="true"
				:show-scrollbar="false"
				:lower-threshold="120"
				@scrolltolower="onScrollToLower"
			>
				<view class="prl-list-inner">
					<view v-if="loading" class="prl-state">
						<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
						<text class="prl-state-text">加载中...</text>
					</view>
					<view v-else-if="recordList.length == 0" class="prl-state">
						<text class="prl-state-text">{{ searchKeyword.trim() != "" ? "暂无搜索结果" : "暂无参与记录" }}</text>
					</view>
					<view v-else class="prl-cards">
						<view
							class="prl-card"
							v-for="(item, index) in recordList"
							:key="getRowKey(item, index)"
						>
							<view class="prl-card-main">
								<text class="prl-card-title">{{ item.keyword }}</text>
								<view v-if="item.expand != null">
									<view
										v-for="(cell, cellIndex) in item.expand"
										:key="`${getRowKey(item, index)}-expand-${cellIndex}`"
									>
										<text
											v-if="hasText(cell.name) || hasText(cell.field_value) || hasText(cell.value)"
											class="prl-card-line"
										>{{ cell.name }}：{{ hasText(cell.field_value) ? cell.field_value : cell.value }}</text>
									</view>
								</view>
								<text class="prl-card-line">创建时间：{{ item.create_time }}</text>
								<view class="prl-card-status">
									<text class="prl-card-status-label">状态：</text>
									<text
										class="prl-card-status-val"
										:class="getStatusTextClass(item.status)"
									>{{ item.status_text }}</text>
								</view>
								<text v-if="item.status == 2 && item.remark" class="prl-card-remark">驳回原因：{{ item.remark }}</text>
							</view>
							<view v-if="hasRowFooter(item)" class="prl-card-footer">
								<text v-if="hasText(item.book_name)" class="prl-card-footer-title">{{ item.book_name }}</text>
								<text v-else-if="hasText(item.book_title)" class="prl-card-footer-title">{{ item.book_title }}</text>
								<text v-else-if="hasText(item.user_book_name)" class="prl-card-footer-title">{{ item.user_book_name }}</text>
								<text v-if="hasText(item.account_name)" class="prl-card-footer-sub">account_name：{{ item.account_name }}</text>
								<text v-if="hasText(item.account_id)" class="prl-card-footer-sub">account_id：{{ item.account_id }}</text>
							</view>
							<view class="prl-card-actions" v-if="item.status == 1 && item.is_publish == 1 || item.status == 3 && item.is_publish == 1">
								<view class="prl-card-btn prl-card-btn--primary" @tap="onBackfillNow(item)">
									<text class="prl-card-btn-text prl-card-btn-text--white">立即回填</text>
								</view>
								<view v-if="item.publish_count" class="prl-card-btn prl-card-btn--ghost" @tap="onPublishList(item)">
									<text class="prl-card-btn-text">作品数{{item.publish_count}}</text>
								</view>
							</view>
							<view v-if="item.status == 2" class="prl-card-actions">
								<view class="prl-card-btn prl-card-btn--ghost" @tap="onEdit(item)">
									<text class="prl-card-btn-text">编辑</text>
								</view>
								<view
									class="prl-card-btn prl-card-btn--ghost prl-card-btn--danger"
									:class="{ 'prl-card-btn--disabled': deletingId == getRowKey(item, index) }"
									@tap="onDelete(item)"
								>
									<text class="prl-card-btn-text prl-card-btn-text--danger">删除</text>
								</view>
							</view>
						</view>
					</view>
					<view v-if="recordList.length > 0 && !loading" class="prl-loadmore">
						<cl-loadmore
							:loading="loadingMore"
							:finish="!hasMore"
							finish-text="没有更多了"
							loading-text="加载中..."
						></cl-loadmore>
					</view>
					<cl-safe-area type="bottom"></cl-safe-area>
				</view>
			</scroll-view>
		</view>

		<cl-popup
			v-model="brandPopupVisible"
			direction="bottom"
			size="70%"
			:show-header="false"
			:swipeClose="false"
			:mask-closable="true"
		>
			<view class="prl-brand-popup">
				<view class="prl-brand-head">
					<text class="prl-brand-title">选择项目</text>
					<view class="prl-brand-close" @tap="onCloseBrandPopup">
						<cl-icon name="close-line" :size="18" color="#999999"></cl-icon>
					</view>
				</view>
				<text class="prl-brand-tip">仅可选择【已产生关键词】的项目</text>
				<scroll-view class="prl-brand-scroll" scroll-y="true" :show-scrollbar="false">
					<view v-if="brandLoading" class="prl-brand-state">
						<cl-loading :loading="true" :size="24" color="#ff6033"></cl-loading>
						<text class="prl-brand-state-text">加载中...</text>
					</view>
					<view v-else-if="brandList.length == 0" class="prl-brand-state">
						<text class="prl-brand-state-text">暂无可切换项目</text>
					</view>
					<view v-else class="prl-brand-list">
						<view
							v-for="(item, index) in brandList"
							:key="getBrandKey(item, index)"
							class="prl-brand-item"
							:class="{
								'prl-brand-item--active': pendingBrandId == getBrandProjectId(item),
								'prl-brand-item--disabled': !isBrandSelectable(item)
							}"
							@tap="onSelectBrand(item)"
						>
							<image
								v-if="getBrandLogo(item) != ''"
								class="prl-brand-logo"
								:src="getBrandLogo(item)"
								mode="aspectFill"
							></image>
							<text class="prl-brand-name">{{ getBrandName(item) }}</text>
							<view
								v-if="pendingBrandId == getBrandProjectId(item)"
								class="prl-brand-check"
							>
								<cl-icon name="check-line" :size="14" color="#ffffff"></cl-icon>
							</view>
						</view>
					</view>
				</scroll-view>
				<view
					class="prl-brand-confirm"
					:class="{ 'prl-brand-confirm--disabled': brandLoading || pendingBrandId <= 0 }"
					@tap="onConfirmBrandSwitch"
				>
					<text class="prl-brand-confirm-text">确定切换</text>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="ts" setup>
	import { ref } from "vue";
	import { getKeywordList, getSwitchableProjects, removeKeyword } from "@/.cool/api/keyword";
	import { getApiMessage, isApiSuccess, router } from "@/.cool";
	import type { KeywordListItem, KeywordListStatusKey, SwitchableProjectItem } from "@/.cool";

	const STATUS_TABS: Array<{ key: KeywordListStatusKey; label: string }> = [
		{ key: "all", label: "全部" },
		{ key: "reviewing", label: "审核中" },
		{ key: "approved", label: "审核通过" },
		{ key: "expiring", label: "即将过期" },
		{ key: "rejected", label: "已驳回" }
	];

	/** 接口 status：0待审核 1已审核 2审核驳回 3已失效；全部不传 */
	function getStatusApiValue(key: KeywordListStatusKey): string {
		if (key == "reviewing") {
			return "0";
		}
		if (key == "approved") {
			return "1";
		}
		if (key == "rejected") {
			return "2";
		}
		if (key == "expiring") {
			return "3";
		}
		return "";
	}

	/** 状态文案颜色：0审核中 1通过 2驳回 3即将过期/失效 */
	function getStatusTextClass(status: number | string | null): string {
		const n = typeof status == "number" ? (status as number) : parseInt(`${status ?? ""}`);
		if (n == 0) {
			return "prl-card-status-val--reviewing";
		}
		if (n == 1) {
			return "prl-card-status-val--pass";
		}
		if (n == 2) {
			return "prl-card-status-val--reject";
		}
		if (n == 3) {
			return "prl-card-status-val--expire";
		}
		return "";
	}

	const rootId = ref(0);
	const linkId = ref(0);
	const projectTitle = ref("我的词库");
	const logoUrl = ref("");
	const is_batch_back = ref(0);
	const brandPopupVisible = ref(false);
	const brandList = ref<SwitchableProjectItem[]>([]);
	const pendingBrandId = ref(0);
	const brandLoading = ref(false);
	const activeStatus = ref<KeywordListStatusKey>("all");
	const searchKeyword = ref("");
	const recordList = ref<KeywordListItem[]>([]);
	const page = ref(1);
	const limit = 20;
	const hasMore = ref(true);
	const loading = ref(false);
	const loadingMore = ref(false);
	const deletingId = ref("");
	const fetchSeq = ref(0);
	const searchTimer = ref<number>(0);

	function getBrandProjectId(item: SwitchableProjectItem): number {
		const raw = item.project_id ?? item.id;
		if (raw == null) {
			return 0;
		}
		const n = parseInt(`${raw}`);
		return isNaN(n) ? 0 : n;
	}

	function getBrandName(item: SwitchableProjectItem): string {
		const name = item.title ?? item.subtitle ?? item.display_name ?? item.project ?? "";
		return `${name}`.trim();
	}

	function getBrandLogo(item: SwitchableProjectItem): string {
		const logo = item.logo ?? item.icon_url ?? "";
		return `${logo}`.trim();
	}

	function getBrandKey(item: SwitchableProjectItem, index: number): string {
		const id = getBrandProjectId(item);
		if (id > 0) {
			return `${id}`;
		}
		return `${index}`;
	}

	function isBrandSelectable(item: SwitchableProjectItem): boolean {
		const checkedK = item.checkedK;
		if (checkedK != null) {
			return checkedK == true || `${checkedK}` == "1";
		}
		const hasKeyword = item.has_keyword;
		if (hasKeyword != null) {
			return hasKeyword == true || `${hasKeyword}` == "1";
		}
		return true;
	}

	function extractBrandList(data: any): SwitchableProjectItem[] {
		if (data == null) {
			return [];
		}
		if (Array.isArray(data)) {
			return data as SwitchableProjectItem[];
		}
		const obj = data as UTSJSONObject;
		const listRaw = obj["list"] as SwitchableProjectItem[] | null;
		if (listRaw != null) {
			return listRaw;
		}
		const dataRaw = obj["data"] as SwitchableProjectItem[] | null;
		if (dataRaw != null) {
			return dataRaw;
		}
		return [];
	}

	function findBrandByProjectId(projectId: number): SwitchableProjectItem | null {
		for (let i = 0; i < brandList.value.length; i++) {
			const item = brandList.value[i];
			if (getBrandProjectId(item) == projectId) {
				return item;
			}
		}
		return null;
	}

	function applyBrandDisplay(item: SwitchableProjectItem | null) {
		if (item == null) {
			return;
		}
		const name = getBrandName(item);
		if (name != "") {
			projectTitle.value = name;
		}
		const logo = getBrandLogo(item);
		logoUrl.value = logo;
	}

	const defaultProjectInitSeq = ref(0);

	function loadBrandList() {
		brandLoading.value = true;
		getSwitchableProjects()
			.then((res) => {
				if (res == null) {
					brandList.value = [];
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "加载项目失败"), icon: "none" });
					return;
				}
				const data = envelope["data"] ?? envelope;
				brandList.value = extractBrandList(data);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载项目失败"), icon: "none" });
			})
			.finally(() => {
				brandLoading.value = false;
			});
	}

	function applyDefaultBrandItem(item: SwitchableProjectItem): boolean {
		const projectId = getBrandProjectId(item);
		if (projectId <= 0) {
			return false;
		}
		linkId.value = projectId;
		rootId.value = projectId;
		applyBrandDisplay(item);
		return true;
	}

	function ensureDefaultProject(): Promise<boolean> {
		if (linkId.value > 0) {
			return Promise.resolve(true);
		}
		const seq = defaultProjectInitSeq.value + 1;
		defaultProjectInitSeq.value = seq;
		brandLoading.value = true;
		return getSwitchableProjects()
			.then((res) => {
				if (seq != defaultProjectInitSeq.value) {
					return false;
				}
				if (res == null) {
					return false;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "加载项目失败"), icon: "none" });
					return false;
				}
				const data = envelope["data"] ?? envelope;
				const list = extractBrandList(data);
				brandList.value = list;
				if (list.length == 0) {
					return false;
				}
				return applyDefaultBrandItem(list[0]);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载项目失败"), icon: "none" });
				return false;
			})
			.finally(() => {
				if (seq == defaultProjectInitSeq.value) {
					brandLoading.value = false;
				}
			});
	}

	function onOpenBrandPopup() {
		pendingBrandId.value = linkId.value;
		brandPopupVisible.value = true;
		loadBrandList();
	}

	function onCloseBrandPopup() {
		brandPopupVisible.value = false;
	}

	function onSelectBrand(item: SwitchableProjectItem) {
		if (!isBrandSelectable(item)) {
			uni.showToast({ title: "该项目暂未产生关键词", icon: "none" });
			return;
		}
		const projectId = getBrandProjectId(item);
		if (projectId <= 0) {
			return;
		}
		pendingBrandId.value = projectId;
	}

	function onConfirmBrandSwitch() {
		if (brandLoading.value || pendingBrandId.value <= 0) {
			return;
		}
		const selected = findBrandByProjectId(pendingBrandId.value);
		if (selected != null && !isBrandSelectable(selected)) {
			uni.showToast({ title: "请选择已产生关键词的项目", icon: "none" });
			return;
		}
		if (pendingBrandId.value == linkId.value) {
			brandPopupVisible.value = false;
			return;
		}
		if (searchTimer.value > 0) {
			clearTimeout(searchTimer.value);
			searchTimer.value = 0;
		}
		searchKeyword.value = "";
		linkId.value = pendingBrandId.value;
		applyBrandDisplay(selected);
		brandPopupVisible.value = false;
		reload();
	}

	function toNumber(val: any, fallback: number = 0): number {
		if (val == null) {
			return fallback;
		}
		const n = parseInt(`${val}`);
		return isNaN(n) ? fallback : n;
	}

	function hasText(val: string | number | null | undefined): boolean {
		return `${val ?? ""}`.trim() != "";
	}

	function getRowKey(item: KeywordListItem, index: number): string {
		if (item.id != null) {
			return `${item.id}`;
		}
		return `${index}`;
	}

	function hasRowFooter(item: KeywordListItem): boolean {
		return (
			hasText(item.book_name) ||
			hasText(item.book_title) ||
			hasText(item.user_book_name) ||
			hasText(item.account_name) ||
			hasText(item.account_id)
		);
	}

	function extractList(data: UTSJSONObject): KeywordListItem[] {
		const listRaw = data["list"] as KeywordListItem[] | null;
		if (listRaw != null) {
			return listRaw;
		}
		const records = data["records"] as KeywordListItem[] | null;
		if (records != null) {
			return records;
		}
		return [];
	}

	function parseListTotal(data: UTSJSONObject, fallback: number): number {
		const totalVal = data["total"] ?? data["count"];
		if (totalVal == null) {
			return fallback;
		}
		const n = parseInt(`${totalVal}`);
		return isNaN(n) ? fallback : n;
	}
	function fetchList(reset: boolean) {
		if (linkId.value <= 0) {
			if (reset) {
				recordList.value = [];
				hasMore.value = false;
			}
			return;
		}
		if (reset) {
			fetchSeq.value += 1;
			const seq = fetchSeq.value;
			recordList.value = [];
			loading.value = true;
			page.value = 1;
			hasMore.value = true;
		} else {
			if (loadingMore.value || !hasMore.value || loading.value) {
				return;
			}
			loadingMore.value = true;
		}
		const reqPage = reset ? 1 : page.value;
		const seq = reset ? fetchSeq.value : 0;
		const keyword = searchKeyword.value.trim();
		getKeywordList({
			project_id: linkId.value,
			status: getStatusApiValue(activeStatus.value),
			page: reqPage,
			limit: limit,
			keyword: keyword != "" ? keyword : undefined
		})
			.then((res) => {
				if (reset && seq != fetchSeq.value) {
					return;
				}
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "加载失败"), icon: "none" });
					return;
				}
				const data = (envelope["data"] ?? envelope) as UTSJSONObject;
				const rows = extractList(data);
				if (reset) {
					recordList.value = rows;
				} else {
					recordList.value = recordList.value.concat(rows);
				}
				const total = parseListTotal(data, recordList.value.length);
				hasMore.value = recordList.value.length < total;
				if (hasMore.value) {
					page.value = reqPage + 1;
				}
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				if (reset) {
					if (seq == fetchSeq.value) {
						loading.value = false;
					}
				} else {
					loadingMore.value = false;
				}
			});
	}

	function reload() {
		fetchList(true);
	}

	function onTabChange(key: KeywordListStatusKey) {
		if (activeStatus.value == key) {
			return;
		}
		if (searchTimer.value > 0) {
			clearTimeout(searchTimer.value);
			searchTimer.value = 0;
		}
		searchKeyword.value = "";
		activeStatus.value = key;
		reload();
	}

	function onSearch() {
		reload();
	}

	function onSearchInput() {
		if (searchTimer.value > 0) {
			clearTimeout(searchTimer.value);
		}
		searchTimer.value = setTimeout(() => {
			reload();
		}, 300) as number;
	}

	function onScrollToLower() {
		fetchList(false);
	}

	function onPublishList(item: KeywordListItem) {
		const query: UTSJSONObject = {
			project_id: item.project_id,
			title: projectTitle.value,
			keyword: item.keyword,
            keyword_id: item.id
		};
		router.push({
			path: "/pages/task/publish_list",
			query: query
		});
	}

	function onBackfillNow(item: KeywordListItem) {
		const query: UTSJSONObject = {
			id: `${item.id}`,
			title: projectTitle.value,
			keyword: `${item.keyword ?? ""}`,
            create_time: item.create_time,
            project_id: item.project_id
		};
		router.push({
			path: "/pages/task/publish",
			query: query
		});
	}

	function onAdd() {
		const query: UTSJSONObject = {
            id: linkId.value,
		};
		router.push({
			path: "/pages/task/form",
			query: query
		});
	}

	function onEdit(item: KeywordListItem) {
		if (item.id == null) {
			uni.showToast({ title: "缺少记录 ID", icon: "none" });
			return;
		}
		const projectIdRaw = item["project_id"];
		let projectId = linkId.value;
		if (projectIdRaw != null) {
			const n = parseInt(`${projectIdRaw}`);
			if (!isNaN(n) && n > 0) {
				projectId = n;
			}
		}
		const query: UTSJSONObject = {
			id: linkId.value,
			keyword_id: item.id,
			project_id: projectId
		};
		router.push({
			path: "/pages/task/form",
			query: query
		});
	}

	function onBatchBackfill() {
		if (linkId.value <= 0) {
			uni.showToast({ title: "缺少项目 ID", icon: "none" });
			return;
		}
		const query: UTSJSONObject = {
			id: linkId.value,
			project_id: linkId.value,
			title: projectTitle.value
		};
		router.push({
			path: "/pages/task/backfill",
			query: query
		});
	}

	function doDelete(item: KeywordListItem) {
		if (item.id == null) {
			uni.showToast({ title: "缺少记录 ID", icon: "none" });
			return;
		}
		const itemId = `${item.id}`;
		deletingId.value = itemId;
		uni.showLoading({ title: "删除中..." });
		removeKeyword({ keyword_id: item.id })
			.then((res) => {
				if (res == null) {
					return;
				}
				const envelope = res as UTSJSONObject;
				const code = envelope["code"];
				if (code != null && !isApiSuccess(code)) {
					uni.showToast({ title: getApiMessage(res, "删除失败"), icon: "none" });
					return;
				}
				uni.showToast({ title: getApiMessage(res, "删除成功"), icon: "success" });
				reload();
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "删除失败"), icon: "none" });
			})
			.finally(() => {
				deletingId.value = "";
				uni.hideLoading();
			});
	}

	function onDelete(item: KeywordListItem) {
		if (deletingId.value != "") {
			return;
		}
		const keyword = `${item.keyword ?? ""}`.trim();
		const tip = keyword != "" ? keyword : "该记录";
		uni.showModal({
			title: "删除记录",
			content: `确定删除「${tip}」吗？删除后不可恢复。`,
			confirmText: "删除",
			confirmColor: "#ef4444",
			success(res) {
				if (res.confirm) {
					doDelete(item);
				}
			}
		});
	}

	function initPageOptions(options: OnLoadOptions) {
		const idVal = options["id"] as string | null;
		const titleVal = options["title"] as string | null;
		const logoVal = (options["logo"] ?? options["logo_url"]) as string | null;
		const isBatchBackVal = options["is_batch_back"] as string | null;
		if (idVal != null) {
			const lid = parseInt(`${idVal}`);
			const parsedId = isNaN(lid) ? 0 : lid;
			rootId.value = parsedId;
			linkId.value = parsedId;
		}
		if (titleVal != null && `${titleVal}`.trim() != "") {
			projectTitle.value = `${titleVal}`.trim();
		}
		if (logoVal != null && `${logoVal}`.trim() != "") {
			logoUrl.value = `${logoVal}`.trim();
		}
		if (isBatchBackVal != null && `${isBatchBackVal}`.trim() != "") {
			is_batch_back.value = parseInt(`${isBatchBackVal}`);
		}
	}

	onLoad((options) => {
		initPageOptions(options);
		uni.setNavigationBarTitle({
			title: "我的词库"
		});
	});

	onShow(() => {
		if (linkId.value > 0) {
			reload();
			return;
		}
		ensureDefaultProject().then((ok) => {
			if (!ok) {
				uni.showToast({ title: "暂无可切换项目", icon: "none" });
				return;
			}
			reload();
		});
	});
</script>

