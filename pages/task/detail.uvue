		background-color: #eef3fc;
		border-radius: 12rpx;
	}

	.td-course-link-text {
		font-size: 28rpx;
		color: #2b59c3;
		line-height: 40rpx;
		margin-right: 8rpx;
	}

	.td-footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 30;
		padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
		background-color: #ffffff;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
	}

	.td-footer-btn {
		flex: 1;
		height: 88rpx;
		border-radius: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
	}

	.td-footer-btn--light {
		margin-right: 24rpx;
		background-color: #eef3fc;
	}

	.td-footer-btn--primary {
		background-color: #2b59c3;
	}

	.td-footer-btn-text {
		font-size: 28rpx;
		font-weight: 600;
		color: #2b59c3;
		line-height: 40rpx;
	}

	.td-footer-btn-text--white {
		color: #ffffff;
	}
</style>
