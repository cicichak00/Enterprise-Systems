		color: #7b8193;
		line-height: 36rpx;
	}

	.td-top-logo {
		width: 88rpx;
		height: 88rpx;
		border-radius: 16rpx;
		flex-shrink: 0;
		overflow: hidden;
	}

	.td-top-logo--text {
		background-color: #2b59c3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.td-top-logo-text {
		font-size: 36rpx;
		font-weight: 700;
		color: #ffffff;
		line-height: 48rpx;
	}

	.td-top-copy {
		flex: 1;
		min-width: 0;
		margin-left: 24rpx;
	}

	.td-top-title {
		font-size: 36rpx;
		font-weight: 600;
		color: #141b36;
		line-height: 50rpx;
	}

	.td-top-meta {
		margin-top: 8rpx;
		font-size: 22rpx;
		color: #7b8193;
		line-height: 32rpx;
	}

	.td-body {
		flex: 1;
		min-height: 0;
		width: 100%;
		margin-top: 8rpx;
		background-color: #ffffff;
		border-radius: 24rpx 24rpx 0 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}

	.td-tabs {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		padding: 20rpx 24rpx 12rpx;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.td-tab {
		flex: 1;
		min-width: 0;
		margin: 0 4rpx;
		padding: 15rpx 8rpx;
		border-radius: 16rpx;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}

	.td-tab--active {
		background-image: linear-gradient(360deg, #ffffff 0%, #edefff 100%);
	}

	.td-tab-title {
		font-size: 28rpx;
		color: #6a738f;
		line-height: 40rpx;
		text-align: center;
	}

	.td-tab-title--active {
		color: #3951ff;
		font-weight: 600;
	}

	.td-tab-sub {
		margin-top: 2rpx;
		font-size: 18rpx;
		color: #a9adbb;
		line-height: 25rpx;
		text-align: center;
	}

	.td-tab-sub--active {
		color: #7a85d9;
	}

	.td-content-scroll {
		flex: 1;
		height: 0;
	}

	.td-content-inner {
		padding: 8rpx 30rpx 32rpx;
		box-sizing: border-box;
	}

	.td-panel {
		min-height: 200rpx;
		box-sizing: border-box;
	}

	.td-empty {
		padding: 80rpx 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.td-empty-text {
		font-size: 26rpx;
		color: #999999;
		line-height: 36rpx;
	}

	.td-collapse {
		margin-bottom: 16rpx;
		background-color: #f7f8fa;
		border-radius: 12rpx;
		overflow: visible;
	}

	.td-collapse-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 24rpx 20rpx;
		box-sizing: border-box;
	}

	.td-collapse-title {
		font-size: 28rpx;
		font-weight: 600;
		color: #141b36;
		line-height: 40rpx;
	}

	.td-collapse-body {
		padding: 16rpx 20rpx 24rpx;
		background-color: #ffffff;
		box-sizing: border-box;
		overflow: visible;
	}

	.td-collapse-empty {
		padding: 8rpx 0 4rpx;
	}

	.td-collapse-empty-text {
		font-size: 26rpx;
		color: #999999;
		line-height: 1.5;
	}

	.td-rich-wrap {
		width: 100%;
		min-height: 40rpx;
		overflow: visible;
	}

	.td-rich {
		width: 100%;
		max-width: 100%;
		min-height: 40rpx;
		overflow: visible;
		background-color: #ffffff;
	}

	.td-course-link {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
