<template>
    <cl-page :pt="{ className: 'nt-page' }" :back-top="false">
        <view class="nt-page">
            <cl-safe-area type="top"></cl-safe-area>
            <view class="nt-header">
                <view class="nt-nav"><text class="nt-title">消息中心</text><text class="nt-refresh" @tap="refreshMessages">{{ loading || pendingLoading ? '刷新中' : '刷新' }}</text></view>
                <view v-if="!employeeView" class="nt-review" role="button" @tap="openApplications(pendingCount != null && pendingCount > 0)">
                    <view class="nt-review-icon"><cl-icon name="user-add-line" :size="22" color="#5375ed"></cl-icon></view>
                    <view class="nt-review-copy"><text class="nt-review-title">员工加入审核</text><text class="nt-review-sub">{{ pendingLoading ? '加载中' : pendingCount == null ? '查看员工加入申请' : pendingCount > 0 ? pendingCount + ' 个申请待审核' : '暂无待审核申请' }}</text></view>
                    <view class="nt-review-action"><text>{{ pendingCount != null && pendingCount > 0 ? '去审核' : '查看' }}</text><cl-icon name="arrow-right-s-line" :size="14" color="#5375ed"></cl-icon></view>
                </view>
                <view class="nt-filter-row"><view class="nt-tabs"><view v-for="item in categories" :key="item.key" class="nt-tab" :class="{ 'nt-tab--active': activeCategory == item.key }" @tap="selectCategory(item.key)"><text>{{ item.label }}</text></view></view><view class="nt-unread-filter" :class="{ 'nt-unread-filter--active': unreadOnly }" role="button" @tap="toggleUnread"><text>未读</text><view v-if="unreadOnly" class="nt-filter-dot"></view></view></view>
            </view>
            <scroll-view class="nt-scroll" scroll-y="true" :show-scrollbar="false" :lower-threshold="120" @scrolltolower="loadMore">
                <view class="nt-list">
                    <view v-if="loading && noticeList.length == 0" class="nt-state"><cl-loading :loading="true" :size="26" color="#5375ed"></cl-loading><text>加载中</text></view>
                    <view v-else-if="listError" class="nt-state"><text>消息加载失败</text><text class="nt-refresh" @tap="fetchList(true)">重试</text></view>
                    <view v-else-if="noticeList.length == 0" class="nt-state"><view class="nt-state-icon"><cl-icon name="message-3-line" :size="26" color="#89909e"></cl-icon></view><text>{{ unreadOnly ? '暂无未读消息' : '暂无消息' }}</text></view>
                    <view v-for="item in noticeList" :key="item.id" class="nt-card" :class="{ 'nt-card--unread': item.unread }" @tap="openNoticeDetail(item)">
                        <view class="nt-card-head"><view class="nt-icon" :class="{ 'nt-icon--system': item.type != 1 }"><cl-icon :name="item.type == 1 ? 'user-add-line' : 'notification-4-line'" :size="18" :color="item.type == 1 ? '#5375ed' : '#7d869c'"></cl-icon></view><view class="nt-card-heading"><text class="nt-card-title">{{ item.title }}</text><text class="nt-time">{{ item.time }}</text></view><view v-if="item.unread" class="nt-unread-dot"></view></view>
                        <text v-if="item.content" class="nt-card-content">{{ item.content }}</text>
                        <view class="nt-card-foot"><text class="nt-kind">{{ item.type == 1 ? '加入申请' : item.type == 2 ? '审核结果' : '系统通知' }}</text><view v-if="item.type == 1 && !employeeView" class="nt-audit-btn" :class="{ 'nt-audit-btn--pending': item.applyStatus == 0 }" @tap.stop="onGoAudit(item)"><text>{{ auditJumpingId == item.id ? '打开中' : item.applyStatus == 0 ? '去审核' : '查看申请' }}</text><cl-icon name="arrow-right-s-line" :size="13" color="#5375ed"></cl-icon></view><text v-else class="nt-detail-link">查看详情</text></view>
                    </view>
                    <view v-if="noticeList.length > 0 && !loading" class="nt-more" @tap="loadMore"><text>{{ loadingMore ? '加载中' : hasMore ? '加载更多' : '没有更多消息' }}</text></view>
                    <cl-safe-area type="bottom"></cl-safe-area>
                </view>
            </scroll-view>
        </view>
    </cl-page>
</template>

<script lang="ts" setup>
import { computed, ref } from "vue";
import { getMessageDetail, getMessageList } from "@/.cool/api/message";
import { getEnterpriseJoinApplyList } from "@/.cool/api/join";
import { getApiMessage, isApiSuccess, router } from "@/.cool";
import type { MessageListItem } from "@/.cool";

type NoticeItem = { id: number; type: number; title: string; content: string; time: string; unread: boolean; path: string; applyId: string; applyStatus: number };
const employeeView = ref(false);
onLoad((query) => { employeeView.value = query?.audience == "employee"; });
const categories = computed(() => employeeView.value ? [{ key: "all", label: "全部" }, { key: "system", label: "系统通知" }] : [{ key: 'all', label: '全部' }, { key: 'join', label: '加入申请' }, { key: 'system', label: '系统通知' }]);
const activeCategory = ref('all');
const unreadOnly = ref(false);
const noticeList = ref<NoticeItem[]>([]);
const loading = ref(false);
const loadingMore = ref(false);
const listError = ref(false);
const hasMore = ref(false);
const pendingLoading = ref(false);
const pendingCount = ref<number | null>(null);
const auditJumpingId = ref(0);
let nextPage = 1;
let requestVersion = 0;
const limit = 15;
function plainText(value: any): string { return `${value ?? ''}`.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim(); }
function payload(res: any): any {
    if (!res || (res.code != null && !isApiSuccess(res.code))) throw new Error(getApiMessage(res, '加载失败'));
    return res.data ?? res;
}
function mapMessage(item: MessageListItem): NoticeItem {
    const type = Number(item.type ?? 0);
    return { id: Number(item.id ?? 0), type, title: plainText(item.title) || (type == 1 ? '员工加入申请' : '系统通知'), content: plainText(item.content), time: `${item.create_time ?? ''}`.slice(0,16), unread: Number(item.is_read ?? 0) == 0, path: `${item.path ?? ''}`.trim(), applyId: `${item.apply_id ?? item.relation_id ?? ''}`.trim(), applyStatus: item.apply_status != null ? Number(item.apply_status) : -1 };
}
async function loadPending() {
    if (employeeView.value) return;
    if (pendingLoading.value) return;
    pendingLoading.value = true;
    try {
        const data = payload(await getEnterpriseJoinApplyList({ page: 1, limit: 1, status: 0 }));
        const count = data.total ?? data.count;
        pendingCount.value = count != null && Number.isFinite(Number(count)) ? Math.max(0, Number(count)) : null;
    } catch (_) { pendingCount.value = null; }
    finally { pendingLoading.value = false; }
}
function openApplications(pending: boolean = false) { router.push({ path: '/pages/user/applications', query: { status: pending ? 'pending' : 'all' } }); }
function selectCategory(key: string) { if (key == activeCategory.value) return; activeCategory.value = key; fetchList(true); }
function toggleUnread() { unreadOnly.value = !unreadOnly.value; fetchList(true); }
function refreshMessages() { fetchList(true); loadPending(); }
async function fetchList(reset: boolean) {
    if (!reset && (loading.value || loadingMore.value || !hasMore.value)) return;
    const version = ++requestVersion;
    const page = reset ? 1 : nextPage;
    if (reset) { noticeList.value = []; loading.value = true; loadingMore.value = false; } else loadingMore.value = true;
    listError.value = false;
    try {
        const data = payload(await getMessageList({ page, limit, type: activeCategory.value == 'join' ? 1 : activeCategory.value == 'system' ? 0 : undefined, is_read: unreadOnly.value ? 0 : undefined }));
        if (version != requestVersion) return;
        const raw = Array.isArray(data) ? data : data.list ?? data.records ?? [];
        const rows = (raw as MessageListItem[]).map(mapMessage);
        noticeList.value = reset ? rows : noticeList.value.concat(rows);
        const total = data.total ?? data.count;
        hasMore.value = rows.length > 0 && (total != null ? noticeList.value.length < Number(total) : rows.length >= limit);
        nextPage = page + 1;
    } catch (_) { if (version == requestVersion) listError.value = true; }
    finally { if (version == requestVersion) { loading.value = false; loadingMore.value = false; } }
}
function loadMore() { fetchList(false); }
function openNoticeDetail(item: NoticeItem) { if (item.id > 0) router.push({ path: '/pages/notice/detail', query: { id: `${item.id}` } }); }
async function onGoAudit(item: NoticeItem) {
    if (auditJumpingId.value || item.id <= 0) return;
    auditJumpingId.value = item.id;
    try {
        const data = payload(await getMessageDetail(item.id));
        item.unread = false;
        const rawPath = `${data.path ?? item.path ?? ''}`.trim();
        const target = rawPath.startsWith('/') ? rawPath : `/${rawPath}`;
        const applyId = `${data.apply_id ?? data.relation_id ?? item.applyId ?? ''}`.trim();
        if (rawPath && target.startsWith('/pages/')) router.push({ path: target });
        else if (/^\d+$/.test(applyId) && Number(applyId) > 0) router.push({ path: '/pages/user/application-audit', query: { apply_id: applyId } });
        else openApplications();
    } catch (err) { uni.showToast({ title: getApiMessage(err, '打开失败，请重试'), icon: 'none' }); }
    finally { auditJumpingId.value = 0; }
}
onShow(() => { refreshMessages(); });
</script>

<style lang="scss" scoped>
@use "../../styles/owner-workbench" as owner;
.nt-page { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; background: owner.$background; }
.nt-header { padding: 0 16px; flex-shrink: 0; }
.nt-nav { height: 48px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.nt-title { @include owner.title; }
.nt-refresh { font-size: 12px; line-height: 20px; color: owner.$primary; padding: 6px 0; }
.nt-review { @include owner.feature; display: flex; flex-direction: row; align-items: center; padding: 14px 12px; gap: 10px; }
.nt-review-icon { width: 40px; height: 40px; flex-shrink: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.7); }
.nt-review-copy { flex: 1; min-width: 0; }
.nt-review-title { display: block; font-size: 14px; line-height: 21px; color: owner.$text; font-weight: 600; }
.nt-review-sub { display: block; margin-top: 4px; font-size: 12px; line-height: 18px; color: #75809b; }
.nt-review-action { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; gap: 2px; }
.nt-review-action > text { font-size: 12px; color: owner.$primary; }
.nt-filter-row { display: flex; flex-direction: row; align-items: center; gap: 8px; padding: 12px 0; }
.nt-tabs { flex: 1; min-width: 0; display: flex; flex-direction: row; padding: 3px; background: #e9edf4; border-radius: 9px; }
.nt-tab { flex: 1; align-items: center; padding: 6px 0; border-radius: 7px; }
.nt-tab > text { font-size: 12px; line-height: 18px; color: #75809b; white-space: nowrap; }
.nt-tab--active { background: #fff; }
.nt-tab--active > text { color: owner.$primary; font-weight: 600; }
.nt-unread-filter { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 4px; width: 48px; height: 36px; border-radius: 9px; background: #fff; border: 1px solid owner.$border; box-sizing: border-box; }
.nt-unread-filter > text { font-size: 12px; color: #75809b; }
.nt-unread-filter--active { background: #eef2ff; border-color: #dce4ff; }
.nt-unread-filter--active > text { color: owner.$primary; }
.nt-filter-dot { width: 4px; height: 4px; border-radius: 50%; background: owner.$primary; }
.nt-scroll { flex: 1; height: 0; min-height: 0; }
.nt-list { padding: 0 16px 20px; }
.nt-card { @include owner.card; padding: 14px; margin-bottom: 10px; }
.nt-card-head { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.nt-icon { width: 34px; height: 34px; border-radius: 10px; background: #eef2ff; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.nt-icon--system { background: #f2f4f8; }
.nt-card-heading { flex: 1; min-width: 0; }
.nt-card-title { display: block; font-size: 14px; line-height: 21px; font-weight: 600; color: owner.$text; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nt-time { display: block; margin-top: 2px; font-size: 10px; line-height: 16px; color: #a2a9b5; }
.nt-unread-dot { width: 6px; height: 6px; border-radius: 50%; background: owner.$primary; flex-shrink: 0; }
.nt-card-content { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; margin-top: 10px; font-size: 12px; line-height: 20px; color: #7d869c; }
.nt-card-foot { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px solid #f1f3f7; }
.nt-kind { font-size: 10px; line-height: 16px; color: #a2a9b5; }
.nt-audit-btn { display: flex; flex-direction: row; align-items: center; gap: 2px; padding: 5px 8px; border-radius: 7px; background: #f0f3ff; }
.nt-audit-btn > text, .nt-detail-link { font-size: 12px; line-height: 18px; color: owner.$primary; }
.nt-audit-btn--pending { background: #e7edff; }
.nt-state { @include owner.card; min-height: 190px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
.nt-state > text { font-size: 13px; color: #89909e; }
.nt-state .nt-refresh { color: owner.$primary; }
.nt-state-icon { width: 44px; height: 44px; border-radius: 12px; background: #f2f4f8; display: flex; align-items: center; justify-content: center; }
.nt-more { padding: 8px 0 16px; align-items: center; }
.nt-more > text { font-size: 11px; color: #a2a9b5; }
@media (max-width: 360px) { .nt-header { padding-left: 12px; padding-right: 12px; } .nt-list { padding-left: 12px; padding-right: 12px; } .nt-review { padding: 12px 10px; gap: 8px; } .nt-review-icon { width: 34px; height: 34px; } .nt-review-title { font-size: 13px; } .nt-tab > text { font-size: 11px; } }
@media (min-width: 600px) { .nt-header, .nt-list { width: calc(100% - 48px); max-width: 960px; margin-left: auto; margin-right: auto; padding-left: 0; padding-right: 0; box-sizing: border-box; } }
</style>
