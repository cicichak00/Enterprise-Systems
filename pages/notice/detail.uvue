<template>
	<cl-page :pt="{ className: 'nd-page' }">
		<view class="nd-page">
			<view v-if="pageLoading" class="nd-state">
				<cl-loading :loading="true" :size="28" color="#2b59c3"></cl-loading>
				<text class="nd-state-text">加载中...</text>
			</view>

			<scroll-view v-else class="nd-scroll" scroll-y="true" :show-scrollbar="false">
				<view v-if="detailTitle == '' && detailContent == ''" class="nd-state nd-state--full">
					<text class="nd-state-text">暂无消息内容</text>
				</view>
				<view v-else class="nd-body">
					<view class="nd-card">
						<view class="nd-card-head">
							<view class="nd-card-tags">
								<view v-if="typeLabel != ''" class="nd-tag" :style="{ backgroundColor: tagBg }">
									<text class="nd-tag-text" :style="{ color: tagColor }">{{ typeLabel }}</text>
								</view>
								<view v-if="levelLabel != ''" class="nd-tag nd-tag--level">
									<text class="nd-tag-text nd-tag-text--level">{{ levelLabel }}</text>
								</view>
								<view v-if="isUrgent" class="nd-tag nd-tag--urgent">
									<text class="nd-tag-text nd-tag-text--urgent">紧急</text>
								</view>
							</view>
						</view>

						<text class="nd-title">{{ detailTitle }}</text>

						<view class="nd-meta-row">
							<text class="nd-meta">{{ timeText }}</text>
							<text v-if="readTimeText != ''" class="nd-meta nd-meta--read">已读 {{ readTimeText }}</text>
						</view>

						<view class="nd-divider"></view>

						<text class="nd-content">{{ detailContent }}</text>
					</view>
				</view>
				<cl-safe-area type="bottom"></cl-safe-area>
			</scroll-view>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
	import { ref } from "vue";
	import { getMessageDetail } from "@/.cool/api/message";
	import { getApiMessage, isApiSuccess } from "@/.cool";
	import type { MessageDetail, Response } from "@/.cool";

	const pageLoading = ref(false);
	const messageId = ref(0);
	const detailTitle = ref("");
	const detailContent = ref("");
	const typeLabel = ref("");
	const levelLabel = ref("");
	const timeText = ref("");
	const readTimeText = ref("");
	const isUrgent = ref(false);
	const tagBg = ref("#f3f4f6");
	const tagColor = ref("#6b7280");

	function pickField(row: UTSJSONObject, key: string): string {
		const val = row[key];
		return val != null ? `${val}`.trim() : "";
	}

	function toNumber(val: any, fallback: number = 0): number {
		if (val == null) {
			return fallback;
		}
		const n = parseInt(`${val}`);
		return isNaN(n) ? fallback : n;
	}

	function resolveTypeLabel(type: number, typeText: string): string {
		if (typeText != "") {
			return typeText;
		}
		if (type == 1) {
			return "申请加入";
		}
		if (type == 2) {
			return "审核结果";
		}
		return "系统";
	}

	function resolveTypeStyle(type: number): {
		tagBg: string;
		tagColor: string;
	} {
		if (type == 1) {
			return {
				tagBg: "#eef3fc",
				tagColor: "#2b59c3"
			};
		}
		if (type == 2) {
			return {
				tagBg: "#ecfdf5",
				tagColor: "#22c55e"
			};
		}
		return {
			tagBg: "#f3f4f6",
			tagColor: "#6b7280"
		};
	}

	function parseMessageDetail(res: any | null): MessageDetail | null {
		if (res == null) {
			return null;
		}
		const envelope = res as UTSJSONObject;
		const data = envelope["data"] ?? envelope;
		if (data == null) {
			return null;
		}
		return data as MessageDetail;
	}

	function applyMessageDetail(detail: MessageDetail) {
		const row = detail as UTSJSONObject;
		const type = toNumber(row["type"], 0);
		const style = resolveTypeStyle(type);
		tagBg.value = style.tagBg;
		tagColor.value = style.tagColor;

		const title = pickField(row, "title");
		const content = pickField(row, "content");
		const summary = pickField(row, "summary");
		detailTitle.value = title != "" ? title : "消息通知";
		detailContent.value = content != "" ? content : summary;

		typeLabel.value = resolveTypeLabel(type, pickField(row, "type_text"));
		levelLabel.value = pickField(row, "level_text");

		const time = pickField(row, "time_text");
		const createTime = pickField(row, "create_time");
		timeText.value = time != "" ? time : createTime;

		readTimeText.value = pickField(row, "read_time");
		isUrgent.value = row["is_urgent"] == true || toNumber(row["is_urgent"], 0) == 1;
	}

	function loadMessageDetail(id: number) {
		if (pageLoading.value) {
			return;
		}
		if (id <= 0) {
			uni.showToast({ title: "消息不存在", icon: "none" });
			return;
		}
		pageLoading.value = true;
		getMessageDetail(id)
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "加载失败"), icon: "none" });
					return;
				}
				const detail = parseMessageDetail(res);
				if (detail == null) {
					uni.showToast({ title: "消息内容为空", icon: "none" });
					return;
				}
				applyMessageDetail(detail);
			})
			.catch((err) => {
				uni.showToast({ title: getApiMessage(err, "加载失败"), icon: "none" });
			})
			.finally(() => {
				pageLoading.value = false;
			});
	}

	onLoad((options) => {
		const idVal = options["id"] as string | null;
		const id = idVal != null ? toNumber(idVal, 0) : 0;
		messageId.value = id;
		loadMessageDetail(id);
	});
</script>

<style lang="scss" scoped>
	.nd-page {
		min-height: 100vh;
		background-color: #f7f8fa;
		display: flex;
		flex-direction: column;
	}

	.nd-scroll {
		flex: 1;
		height: 100vh;
		width: 100%;
	}

	.nd-body {
		padding: 24rpx 32rpx 40rpx;
	}

	.nd-state {
		padding: 120rpx 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		&--full {
			min-height: 60vh;
		}
	}

	.nd-state-text {
		margin-top: 16rpx;
		font-size: 28rpx;
		color: #999999;
		line-height: 40rpx;
	}

	.nd-card {
		padding: 32rpx 36rpx;
		border-radius: 28rpx;
		background-color: #ffffff;
		box-shadow: 0 2rpx 4rpx rgba(20, 18, 30, 0.04), 0 8rpx 32rpx -20rpx rgba(20, 18, 30, 0.08);
	}

	.nd-card-head {
		margin-bottom: 24rpx;
	}

	.nd-card-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.nd-tag {
		padding: 4rpx 14rpx;
		border-radius: 8rpx;
		margin-right: 12rpx;
		margin-bottom: 8rpx;

		&--level {
			background-color: #f3f4f6;
		}

		&--urgent {
			background-color: rgba(239, 68, 68, 0.12);
		}
	}

	.nd-tag-text {
		font-size: 20rpx;
		font-weight: 700;
		line-height: 28rpx;
		letter-spacing: 0.6rpx;

		&--level {
			color: #666666;
		}

		&--urgent {
			color: #dc2626;
		}
	}

	.nd-title {
		font-size: 34rpx;
		font-weight: 700;
		color: #1a1a1a;
		line-height: 48rpx;
		letter-spacing: -0.2rpx;
	}

	.nd-meta-row {
		margin-top: 20rpx;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.nd-meta {
		font-size: 22rpx;
		color: #bbbbbb;
		line-height: 32rpx;
		font-weight: 500;
		margin-right: 20rpx;

		&--read {
			color: #999999;
		}
	}

	.nd-divider {
		margin: 28rpx 0;
		height: 1rpx;
		background-color: rgba(26, 23, 20, 0.06);
	}

	.nd-content {
		font-size: 28rpx;
		color: #333333;
		line-height: 44rpx;
		word-break: break-all;
	}
</style>

<style lang="scss" scoped>
@use "../../styles/owner-workbench" as owner;
.nd-page { background: owner.$background; height: 100vh; height: 100dvh; min-height: 0; }
.nd-scroll { flex: 1; height: 0; min-height: 0; }
.nd-body { padding: 16px; }
.nd-card { @include owner.card; padding: 16px; }
.nd-card-head { margin-bottom: 10px; }
.nd-card-tags { gap: 6px; flex-wrap: wrap; }
.nd-tag { border-radius: 5px; padding: 3px 6px; }
.nd-tag-text { font-size: 11px; line-height: 17px; }
.nd-title { font-size: 18px; line-height: 27px; font-weight: 600; color: owner.$text; overflow-wrap: anywhere; }
.nd-meta-row { margin-top: 10px; flex-wrap: wrap; gap: 4px 10px; }
.nd-meta { font-size: 11px; line-height: 18px; color: owner.$muted; }
.nd-divider { margin: 14px 0; height: 1px; background: owner.$border; }
.nd-content { font-size: 14px; line-height: 24px; color: #535d73; white-space: pre-wrap; overflow-wrap: anywhere; }
.nd-state { padding: 60px 16px; }
.nd-state-text { font-size: 13px; color: owner.$muted; }
@media (min-width: 600px) { .nd-body { max-width: 960px; width: calc(100% - 48px); margin: 0 auto; padding: 16px 0; } }
</style>
