<template>
	<view class="pw-card">
		<view class="pw-card-head">
			<view class="pw-icon"><cl-icon name="shield-check-line" :size="22" color="#2b59c3"></cl-icon></view>
			<view class="pw-head-copy">
				<text class="pw-title">项目开白</text>
				<text class="pw-desc">完成账号开白后，即可参与品牌应用项目</text>
			</view>
			<view class="pw-status" :class="'pw-status--' + statusType">
				<text class="pw-status-text">{{ statusText }}</text>
			</view>
		</view>

		<view v-if="byteUid != ''" class="pw-account-row">
			<text class="pw-account-label">开白账号 UID</text>
			<text class="pw-account-value">{{ byteUid }}</text>
		</view>
		<view v-if="failReason != ''" class="pw-fail-box">
			<text class="pw-fail-text">未通过原因：{{ failReason }}</text>
		</view>

		<view class="pw-action" :class="{ 'pw-action--disabled': actionDisabled }" @tap="openApplyPopup">
			<cl-loading v-if="loading" :loading="true" :size="18" color="#2b59c3"></cl-loading>
			<text v-else class="pw-action-text">{{ actionText }}</text>
			<cl-icon v-if="!loading && !actionDisabled" name="arrow-right-s-line" :size="18" color="#2b59c3"></cl-icon>
		</view>

		<cl-popup
			v-model="popupVisible"
			direction="bottom"
			size="82%"
			:show-header="false"
			:show-close="false"
			:mask-closable="!submitting"
			:swipe-close="!submitting"
		>
			<view class="pw-popup">
				<view class="pw-popup-head">
					<view>
						<text class="pw-popup-title">申请项目开白</text>
						<text class="pw-popup-sub">请填写参与品牌项目使用的字节账号信息</text>
					</view>
					<view class="pw-close" @tap="closeApplyPopup"><cl-icon name="close-line" :size="22" color="#7b8193"></cl-icon></view>
				</view>

				<scroll-view class="pw-form-scroll" scroll-y="true" :show-scrollbar="false">
					<view class="pw-form">
						<view class="pw-field">
							<text class="pw-label"><text class="pw-required">*</text> 字节 UID</text>
							<text class="pw-tip">请填写参与当前项目所使用账号的 UID</text>
							<input class="pw-input" v-model="byteUid" placeholder="请输入字节 UID" placeholder-class="pw-placeholder" />
						</view>
						<view class="pw-field">
							<text class="pw-label"><text class="pw-required">*</text> 登录手机号</text>
							<input class="pw-input" v-model="mobile" type="number" maxlength="11" placeholder="请输入字节账号登录手机号" placeholder-class="pw-placeholder" />
						</view>
						<view class="pw-field">
							<text class="pw-label"><text class="pw-required">*</text> 账号凭证</text>
							<text class="pw-tip">上传可同时看到账号 UID 与账号信息的完整截图</text>
							<view class="pw-upload" @tap="chooseScreenshot(1)">
								<image v-if="screenshot1Display != ''" class="pw-upload-image" :src="screenshot1Display" mode="aspectFill"></image>
								<template v-else>
									<cl-icon name="camera-line" :size="28" color="#7f8798"></cl-icon>
									<text class="pw-upload-text">上传凭证</text>
								</template>
								<view v-if="uploadingKind == 1" class="pw-upload-mask"><cl-loading :loading="true" :size="22" color="#ffffff"></cl-loading></view>
							</view>
						</view>
						<view class="pw-field">
							<text class="pw-label">补充凭证</text>
							<view class="pw-upload" @tap="chooseScreenshot(2)">
								<image v-if="screenshot2Display != ''" class="pw-upload-image" :src="screenshot2Display" mode="aspectFill"></image>
								<template v-else>
									<cl-icon name="camera-line" :size="28" color="#7f8798"></cl-icon>
									<text class="pw-upload-text">上传凭证</text>
								</template>
								<view v-if="uploadingKind == 2" class="pw-upload-mask"><cl-loading :loading="true" :size="22" color="#ffffff"></cl-loading></view>
							</view>
						</view>
					</view>
				</scroll-view>

				<view class="pw-popup-actions">
					<view class="pw-popup-btn pw-popup-btn--cancel" @tap="closeApplyPopup"><text class="pw-popup-btn-text">取消</text></view>
					<view class="pw-popup-btn pw-popup-btn--submit" :class="{ 'pw-popup-btn--disabled': submitDisabled }" @tap="submitApply">
						<cl-loading v-if="submitting" :loading="true" :size="18" color="#ffffff"></cl-loading>
						<text class="pw-popup-btn-text pw-popup-btn-text--white">{{ submitting ? "提交中..." : "提交申请" }}</text>
					</view>
				</view>
			</view>
		</cl-popup>
	</view>
</template>

<script lang="ts" setup>
	import { computed, ref, watch } from "vue";
	import { getStaffByteTaskInfo, submitStaffByteBinding } from "@/.cool/api/staff";
	import { normalizePickDisplayPath, uploadImage } from "@/.cool/api/upload";
	import { getApiMessage, isApiSuccess } from "@/.cool";
	import type { Response, StaffByteTaskInfo } from "@/.cool";

	const props = defineProps({
		taskId: { type: Number, default: 0 },
		projectId: { type: Number, default: 0 }
	});

	const loading = ref(false);
	const popupVisible = ref(false);
	const byteUid = ref("");
	const mobile = ref("");
	const screenshot1Url = ref("");
	const screenshot2Url = ref("");
	const screenshot1Display = ref("");
	const screenshot2Display = ref("");
	const uploadingKind = ref(0);
	const submitting = ref(false);
	const auditStatus = ref(-1);
	const auditStatusText = ref("");
	const failReason = ref("");

	const statusType = computed(() => {
		if (auditStatus.value == 1) return "success";
		if (auditStatus.value == 2) return "fail";
		if (auditStatus.value == 0) return "pending";
		return "default";
	});

	const statusText = computed(() => {
		if (auditStatusText.value != "") return auditStatusText.value;
		if (auditStatus.value == 1) return "已开白";
		if (auditStatus.value == 2) return "未通过";
		if (auditStatus.value == 0) return "审核中";
		return "未开白";
	});

	const actionDisabled = computed(() => loading.value || auditStatus.value == 0 || auditStatus.value == 1);
	const actionText = computed(() => {
		if (auditStatus.value == 1) return "当前账号已完成开白";
		if (auditStatus.value == 0) return "开白申请审核中";
		if (auditStatus.value == 2) return "重新申请开白";
		return "申请项目开白";
	});
	const submitDisabled = computed(() => submitting.value || uploadingKind.value > 0);

	function parseStatus(raw: any | null): number {
		if (raw == null || `${raw}`.trim() == "") return -1;
		const value = parseInt(`${raw}`);
		return isNaN(value) ? -1 : value;
	}

	function applyInfo(info: StaffByteTaskInfo) {
		byteUid.value = `${info.byte_uid ?? ""}`.trim();
		mobile.value = `${info.mobile ?? ""}`.trim();
		screenshot1Url.value = `${info.screenshot_1 ?? ""}`.trim();
		screenshot2Url.value = `${info.screenshot_2 ?? ""}`.trim();
		screenshot1Display.value = screenshot1Url.value;
		screenshot2Display.value = screenshot2Url.value;
		auditStatus.value = parseStatus(info.audit_status ?? info["whitelist_status"] ?? info["status"]);
		auditStatusText.value = `${info.audit_status_text ?? info["whitelist_status_text"] ?? ""}`.trim();
		failReason.value = `${info.fail_reason ?? info.reject_reason ?? ""}`.trim();
	}

	function loadInfo() {
		if (loading.value || props.taskId <= 0) return;
		loading.value = true;
		getStaffByteTaskInfo(props.taskId, props.projectId)
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) return;
				const obj = (res ?? {}) as UTSJSONObject;
				applyInfo((obj["data"] ?? obj) as StaffByteTaskInfo);
			})
			.catch(() => {})
			.finally(() => { loading.value = false; });
	}

	function openApplyPopup() {
		if (actionDisabled.value) return;
		popupVisible.value = true;
	}

	function closeApplyPopup() {
		if (submitting.value) return;
		popupVisible.value = false;
	}

	function chooseScreenshot(kind: number) {
		if (uploadingKind.value > 0 || submitting.value) return;
		uni.chooseImage({
			count: 1,
			sizeType: ["compressed"],
			sourceType: ["album", "camera"],
			success: (res) => {
				if (res.tempFilePaths.length == 0) return;
				const tempPath = res.tempFilePaths[0];
				uploadingKind.value = kind;
				normalizePickDisplayPath(tempPath)
					.then((displayPath) => {
						if (kind == 1) screenshot1Display.value = displayPath != "" ? displayPath : tempPath;
						else screenshot2Display.value = displayPath != "" ? displayPath : tempPath;
						return uploadImage(tempPath);
					})
					.then((url) => {
						if (kind == 1) screenshot1Url.value = url;
						else screenshot2Url.value = url;
					})
					.catch((err) => {
						if (kind == 1) { screenshot1Url.value = ""; screenshot1Display.value = ""; }
						else { screenshot2Url.value = ""; screenshot2Display.value = ""; }
						uni.showToast({ title: getApiMessage(err, "图片上传失败"), icon: "none" });
					})
					.finally(() => { uploadingKind.value = 0; });
			}
		});
	}

	function validateForm(): string {
		if (byteUid.value.trim() == "") return "请输入字节 UID";
		if (!/^1\d{10}$/.test(mobile.value.trim())) return "请输入正确的登录手机号";
		if (screenshot1Url.value == "") return "请上传账号凭证";
		return "";
	}

	function submitApply() {
		if (submitDisabled.value) return;
		const error = validateForm();
		if (error != "") {
			uni.showToast({ title: error, icon: "none" });
			return;
		}
		submitting.value = true;
		submitStaffByteBinding({
			byte_uid: byteUid.value.trim(),
			mobile: mobile.value.trim(),
			screenshot_1: screenshot1Url.value,
			screenshot_2: screenshot2Url.value,
			task_id: props.taskId,
			project_id: props.projectId
		})
			.then((res) => {
				const envelope = res as Response | null;
				if (envelope != null && envelope.code != null && !isApiSuccess(envelope.code)) {
					uni.showToast({ title: getApiMessage(envelope, "提交失败"), icon: "none" });
					return;
				}
				auditStatus.value = 0;
				auditStatusText.value = "审核中";
				failReason.value = "";
				popupVisible.value = false;
				uni.showToast({ title: "开白申请已提交", icon: "success" });
			})
			.catch((err) => { uni.showToast({ title: getApiMessage(err, "提交失败"), icon: "none" }); })
			.finally(() => { submitting.value = false; });
	}

	watch(() => props.taskId, () => { loadInfo(); }, { immediate: true });
</script>

<style lang="scss" scoped>
	.pw-card { margin: 0 24rpx 20rpx; padding: 26rpx 24rpx 22rpx; border-radius: 22rpx; background: linear-gradient(135deg, #ffffff 0%, #f4f7ff 100%); box-shadow: 0 8rpx 28rpx rgba(43, 89, 195, .1); }
	.pw-card-head { display: flex; flex-direction: row; align-items: center; }
	.pw-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; background-color: #e9efff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
	.pw-head-copy { flex: 1; min-width: 0; margin-left: 18rpx; display: flex; flex-direction: column; }
	.pw-title { font-size: 30rpx; line-height: 42rpx; font-weight: 700; color: #1f2a44; }
	.pw-desc { margin-top: 4rpx; font-size: 22rpx; line-height: 32rpx; color: #7b8193; }
	.pw-status { margin-left: 14rpx; padding: 5rpx 13rpx; border-radius: 999rpx; background-color: #eef1f6; flex-shrink: 0; }
	.pw-status--pending { background-color: #fff7e6; }
	.pw-status--success { background-color: #ecfdf5; }
	.pw-status--fail { background-color: #fef2f2; }
	.pw-status-text { font-size: 20rpx; line-height: 28rpx; color: #667085; }
	.pw-status--pending .pw-status-text { color: #d97706; }
	.pw-status--success .pw-status-text { color: #16a34a; }
	.pw-status--fail .pw-status-text { color: #dc2626; }
	.pw-account-row { margin-top: 22rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background-color: rgba(255,255,255,.8); display: flex; justify-content: space-between; align-items: center; }
	.pw-account-label { font-size: 23rpx; color: #7b8193; }
	.pw-account-value { font-size: 24rpx; font-weight: 600; color: #27314d; }
	.pw-fail-box { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background-color: #fef2f2; }
	.pw-fail-text { font-size: 22rpx; line-height: 32rpx; color: #b42318; }
	.pw-action { height: 72rpx; margin-top: 20rpx; border-radius: 14rpx; background-color: #e9efff; display: flex; align-items: center; justify-content: center; }
	.pw-action--disabled { opacity: .65; }
	.pw-action-text { margin: 0 6rpx; font-size: 25rpx; line-height: 36rpx; font-weight: 600; color: #2b59c3; }
	.pw-popup { height: 100%; padding-top: 26rpx; background-color: #ffffff; border-radius: 28rpx 28rpx 0 0; display: flex; flex-direction: column; box-sizing: border-box; }
	.pw-popup-head { padding: 0 28rpx 22rpx; display: flex; align-items: flex-start; justify-content: space-between; }
	.pw-popup-title { display: block; font-size: 34rpx; line-height: 48rpx; font-weight: 700; color: #20283a; }
	.pw-popup-sub { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 32rpx; color: #7b8193; }
	.pw-close { width: 64rpx; height: 64rpx; border-radius: 50%; background-color: #f4f5f7; display: flex; align-items: center; justify-content: center; }
	.pw-form-scroll { flex: 1; height: 0; }
	.pw-form { padding: 0 28rpx 30rpx; }
	.pw-field { margin-top: 26rpx; display: flex; flex-direction: column; }
	.pw-label { font-size: 27rpx; line-height: 38rpx; font-weight: 600; color: #252d3d; }
	.pw-required { color: #f04438; }
	.pw-tip { margin-top: 6rpx; font-size: 21rpx; line-height: 31rpx; color: #7b8193; }
	.pw-input { height: 88rpx; margin-top: 15rpx; padding: 0 22rpx; border: 1rpx solid #d8dce5; border-radius: 14rpx; font-size: 26rpx; color: #333333; box-sizing: border-box; }
	.pw-placeholder { font-size: 25rpx; color: #a0a6b2; }
	.pw-upload { position: relative; width: 200rpx; height: 200rpx; margin-top: 16rpx; border: 1rpx dashed #c8cfdd; border-radius: 16rpx; background-color: #f7f8fa; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; }
	.pw-upload-image { width: 100%; height: 100%; }
	.pw-upload-text { margin-top: 8rpx; font-size: 22rpx; color: #7f8798; }
	.pw-upload-mask { position: absolute; inset: 0; background-color: rgba(0,0,0,.42); display: flex; align-items: center; justify-content: center; }
	.pw-popup-actions { padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eef0f4; display: flex; gap: 18rpx; }
	.pw-popup-btn { flex: 1; height: 84rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; }
	.pw-popup-btn--cancel { border: 1rpx solid #d8dce5; background-color: #ffffff; }
	.pw-popup-btn--submit { background-color: #2b59c3; }
	.pw-popup-btn--disabled { opacity: .55; }
	.pw-popup-btn-text { margin-left: 6rpx; font-size: 27rpx; font-weight: 600; color: #475467; }
	.pw-popup-btn-text--white { color: #ffffff; }
</style>
